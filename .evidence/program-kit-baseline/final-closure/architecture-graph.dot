digraph ProgramKitFinalArchitecture {
  rankdir=LR;
  "human-led capabilities" -> "Program Kit CLI";
  "Program Kit CLI" -> "Workbench and typed contracts";
  "Workbench and typed contracts" -> "deterministic generated documents";
  "deterministic generated documents" -> "API / Console / Worker hosts";
  "local package manifest" -> "isolated consumers";
  "local package manifest" -> "local publishes";
  "Domain Semantic Engine" -> "Program Kit public contracts" [style=dashed,label="future consumer only"];
}