{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pkid:schema:program-kit:isolated-consumer-set@1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "sourceRoot", "consumers"],
  "properties": {
    "$schema": {
      "const": "pkid:schema:program-kit:isolated-consumer-set@1.0.0"
    },
    "version": {
      "const": "1.0.0"
    },
    "sourceRoot": {
      "type": "string",
      "minLength": 1
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identity", "kind", "packageIds", "operation"],
        "properties": {
          "identity": {
            "type": "string",
            "pattern": "^pkid:consumer:"
          },
          "kind": {
            "enum": ["project", "tool"]
          },
          "projectPath": {
            "type": "string",
            "pattern": "^[^\\\\]+\\.csproj$"
          },
          "packageIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "operation": {
            "enum": ["build", "run"]
          },
          "toolCommand": {
            "type": "string",
            "minLength": 1
          },
          "toolArguments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "project"
                }
              }
            },
            "then": {
              "required": ["projectPath"]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "tool"
                }
              }
            },
            "then": {
              "required": ["toolCommand", "toolArguments"],
              "properties": {
                "operation": {
                  "const": "run"
                },
                "packageIds": {
                  "maxItems": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
