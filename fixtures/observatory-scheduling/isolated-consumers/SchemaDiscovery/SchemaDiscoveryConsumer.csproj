<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>ProgramKit.IsolatedConsumers.SchemaDiscovery</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference
      Include="Orbyss.ProgramKit.Tasks.Core"
      Version="[0.1.0-alpha.1]"
      GeneratePathProperty="true" />
  </ItemGroup>
  <Target Name="VerifyProgramKitSchemaDiscovery" AfterTargets="Build">
    <Error
      Condition="!Exists('$(PkgOrbyss_ProgramKit_Tasks_Core)\schemas\tasks\task-definition.schema.json')"
      Text="The packaged task-definition schema was not discoverable through the exact package path." />
  </Target>
</Project>
