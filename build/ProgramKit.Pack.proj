<Project>
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
  </PropertyGroup>
  <Import
    Project="$(ProgramKitPackageSelectionProps)"
    Condition="'$(ProgramKitPackageSelectionProps)' != '' and
               Exists('$(ProgramKitPackageSelectionProps)')" />
  <Target Name="Pack">
    <Error Condition="'$(ProgramKitPackageProject)' == ''"
           Code="PKPUB001"
           Text="ProgramKitPackageProject must name one explicit manifest-selected project." />
    <Error Condition="'$(PackageOutputPath)' == ''"
           Code="PKPUB002"
           Text="PackageOutputPath must be supplied explicitly." />
    <MSBuild Projects="$(ProgramKitPackageProject)"
             Targets="Pack"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);PackageOutputPath=$(PackageOutputPath)" />
  </Target>
  <Target Name="PackManifestSelection">
    <Error Condition="'$(ProgramKitPackageSelectionProps)' == ''"
           Code="PKPUB003"
           Text="ProgramKitPackageSelectionProps must name the transaction-local canonical package selection." />
    <Error Condition="!Exists('$(ProgramKitPackageSelectionProps)')"
           Code="PKPUB008"
           Text="The transaction-local canonical package selection is absent." />
    <Error Condition="'$(ProgramKitExpectedPackageCount)' == ''"
           Code="PKPUB004"
           Text="ProgramKitExpectedPackageCount must be supplied from the canonical release-package manifest." />
    <Error Condition="'$(PackageOutputPath)' == ''"
           Code="PKPUB002"
           Text="PackageOutputPath must be supplied explicitly." />
    <Error Condition="'$(NoRestore)' != 'true'"
           Code="PKPUB005"
           Text="Aggregate package creation must set NoRestore=true." />
    <Error Condition="'$(NoBuild)' != 'true'"
           Code="PKPUB006"
           Text="Aggregate package creation must set NoBuild=true." />
    <Error Condition="'$(ProgramKitAggregatePackReceiptRoot)' == ''"
           Code="PKPUB009"
           Text="ProgramKitAggregatePackReceiptRoot must name the transaction-local build receipts." />
    <Error
      Condition="'@(_ProgramKitManifestPackageProject->Count())' != '$(ProgramKitExpectedPackageCount)'"
      Code="PKPUB007"
      Text="The manifest-selected project count does not match ProgramKitExpectedPackageCount." />
    <MSBuild
      Projects="@(_ProgramKitManifestPackageProject)"
      Targets="Pack"
      BuildInParallel="true"
      Properties="Configuration=$(Configuration);
                  PackageOutputPath=$(PackageOutputPath);
                  NoRestore=true;
                  NoBuild=true;
                  _IsPacking=true;
                  ProgramKitAggregatePackReceiptRoot=$(ProgramKitAggregatePackReceiptRoot);
                  IncludeSymbols=false" />
  </Target>
</Project>
