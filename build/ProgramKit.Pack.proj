<Project>
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
  </PropertyGroup>
  <Target Name="Pack">
    <Error Condition="'$(ProgramKitPackageProject)' == ''"
           Code="PKPUB001"
           Text="ProgramKitPackageProject must name one explicit manifest-selected project." />
    <Error Condition="'$(PackageOutputPath)' == ''"
           Code="PKPUB002"
           Text="PackageOutputPath must be supplied explicitly." />
    <MSBuild Projects="$(ProgramKitPackageProject)"
             Targets="Pack"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);PackageOutputPath=$(PackageOutputPath)" />
  </Target>
</Project>
