<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Orbyss.ProgramKit</id>
    <version>$version$</version>
    <authors>Orbyss</authors>
    <description>Consumer meta-package for Orbyss Program Kit. Referencing this single package gives a consumer-owned .NET project every Program Kit package that is supported for direct consumer use, pinned to one exact Program Kit version. The command-line tool is distributed separately as Orbyss.ProgramKit.CommandLine.</description>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/orbyss-io/program-kit</projectUrl>
    <repository type="git" url="https://github.com/orbyss-io/program-kit.git" />
    <tags>program-kit orbyss meta-package</tags>
    <dependencies>
      <group targetFramework="net10.0">
        <!-- The supported direct consumer surface: the generated-source
             analyzers and the generated-output integrity build targets.
             Contract and serialization packages arrive transitively at the
             same pinned version. Extend this list only when a package is
             deliberately supported for direct consumer reference. -->
        <dependency id="Orbyss.ProgramKit.GeneratedSourceContract.Analyzers" version="[$version$]" />
        <dependency id="Orbyss.ProgramKit.GeneratedOutputIntegrity.Build" version="[$version$]" />
      </group>
    </dependencies>
  </metadata>
</package>
