--- /dev/null
+++ b/src/specify_cli/python_runtime.py
@@ -0,0 +1,35 @@
+"""One validated product-script interpreter, distinct from the CLI supervisor."""
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+
+CONTRACT_VERSION = 1
+
+
+def resolve_python_interpreter(project_root: Path | None = None) -> str:
+    record = project_root / '.specify/python-runtime.json' if project_root else None
+    saved = json.loads(record.read_text(encoding='utf-8')) if record and record.is_file() else {}
+    if not isinstance(saved, dict) or (saved and saved.get('contractVersion') != CONTRACT_VERSION):
+        raise ValueError('SPECKIT_PYTHON_RUNTIME: unsupported or invalid interpreter record')
+    requested = os.environ.get('SPECKIT_PYTHON') or saved.get('executable') or shutil.which('python')
+    if not isinstance(requested, str) or not requested or not Path(requested).is_absolute() or not Path(requested).is_file():
+        raise ValueError('SPECKIT_PYTHON_RUNTIME: select an absolute Python executable with SPECKIT_PYTHON or provide python on PATH')
+    if saved and os.environ.get('SPECKIT_PYTHON') and os.path.normcase(os.path.abspath(requested)) != os.path.normcase(saved['executable']):
+        raise ValueError('SPECKIT_PYTHON_RUNTIME: selected interpreter differs from generated commands; regenerate integration instructions explicitly')
+    probe = ('import sys,json; assert sys.version_info >= (3,11), "Python >=3.11 is required"; '
+             'import yaml; assert int(yaml.__version__.split(".")[0]) >= 6, "PyYAML >=6 is required"; '
+             'print(json.dumps({"executable":sys.executable,"version":list(sys.version_info[:3]),"yaml":yaml.__version__}))')
+    result = subprocess.run([requested, '-c', probe], capture_output=True, text=True,
+                            encoding='utf-8', errors='replace', timeout=30, check=False)
+    if result.returncode:
+        raise ValueError(f'SPECKIT_PYTHON_RUNTIME: {requested}: {result.stderr or result.stdout}')
+    payload = json.loads(result.stdout)
+    executable = os.path.abspath(payload['executable'])  # Preserve venv symlinks.
+    if record and not saved:
+        record.parent.mkdir(parents=True, exist_ok=True)
+        record.write_text(json.dumps({'contractVersion': CONTRACT_VERSION, **payload}, indent=2) + '\n', encoding='utf-8')
+    return executable
