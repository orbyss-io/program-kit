+"""Core-owned regression coverage for Program Kit's interpreter/worker incident."""
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+from unittest.mock import patch
+
+from specify_cli.workflows.base import StepContext, StepStatus
+from specify_cli.workflows.steps.command import CommandStep
+from tests.parity_helpers import make_repo, install_scripts, install_composition_stack, py_cmd, ps_cmd, run, HAS_POWERSHELL
+
+
+def test_exit_zero_blocked_result_preserves_root_cause(tmp_path):
+    worker = {'status': 'blocked', 'diagnostic': 'PyYAML is required to resolve preset template composition.'}
+    response = {'exit_code': 0, 'stdout': 'worker evidence', 'stderr': '', 'worker_result': worker}
+    with patch.object(CommandStep, '_try_dispatch', return_value=response):
+        result = CommandStep().execute({'id': 'draft', 'command': 'constitution'}, StepContext(project_root=str(tmp_path)))
+    assert result.status == StepStatus.FAILED
+    assert result.output['process_succeeded']
+    assert result.output['worker_result'] == worker
+    assert result.error == worker['diagnostic']
+
+
+def test_exit_zero_without_artifact_is_failed(tmp_path):
+    response = {'exit_code': 0, 'stdout': '', 'stderr': '', 'worker_result': {'status': 'completed', 'diagnostic': ''}}
+    with patch.object(CommandStep, '_try_dispatch', return_value=response):
+        result = CommandStep().execute({'id': 'draft', 'command': 'constitution', 'required_artifacts': ['constitution.md']}, StepContext(project_root=str(tmp_path)))
+    assert result.status == StepStatus.FAILED
+    assert 'did not produce' in result.error
+
+
+def test_engine_persists_blocked_outcome_and_diagnostic(tmp_path):
+    from specify_cli.workflows.engine import WorkflowDefinition, WorkflowEngine, RunState
+    definition = WorkflowDefinition({'workflow': {'id': 'worker-evidence', 'version': '1.0.0'},
+        'steps': [{'id': 'draft', 'type': 'command', 'command': 'constitution'}]})
+    worker = {'status': 'blocked', 'diagnostic': 'PyYAML is required for composition'}
+    response = {'exit_code': 0, 'stdout': 'unchanged original stream', 'stderr': '', 'worker_result': worker}
+    with patch.object(CommandStep, '_try_dispatch', return_value=response):
+        state = WorkflowEngine(tmp_path).execute(definition, run_id='worker-evidence')
+    saved = RunState.load(state.run_id, tmp_path)
+    assert saved.status.value == 'failed'
+    assert saved.step_results['draft']['status'] == 'failed'
+    assert saved.step_results['draft']['output']['worker_result'] == worker
+    assert saved.step_results['draft']['output']['stdout'] == 'unchanged original stream'
+    assert worker['diagnostic'] in saved.error
+
+
+def test_composition_uses_the_recorded_runtime_in_native_shells(tmp_path):
+    repo = make_repo(tmp_path)
+    install_scripts(repo, 'resolve-template')
+    expected = install_composition_stack(repo, 'constitution-template', '# Core\n')
+    import sys
+    selected = shutil.which('python') or sys.executable
+    (repo / '.specify/python-runtime.json').write_text(json.dumps({'contractVersion': 1, 'executable': selected}))
+    commands = [py_cmd(repo, 'resolve-template', 'constitution-template', '--json')]
+    if HAS_POWERSHELL:
+        commands.append(ps_cmd(repo, 'resolve-template', 'constitution-template', '-Json'))
+    bash = Path(os.environ.get('PROGRAM_KIT_BASH', 'C:/Program Files/Git/bin/bash.exe')) if os.name == 'nt' else Path(shutil.which('bash') or '/missing')
+    if bash.is_file():
+        commands.append([str(bash), str(repo / '.specify/scripts/bash/resolve-template.sh'), 'constitution-template', '--json'])
+    for argv in commands:
+        result = run(argv, repo)
+        assert result.returncode == 0, result.stderr
+        # PowerShell preserves native CRLF from fixture files; Python text
+        # reads normalize it. Compare composition content, not newline style.
+        assert json.loads(result.stdout)['TEMPLATE_CONTENT'].replace('\r\n', '\n') == expected
