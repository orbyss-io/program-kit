diff --git a/src/specify_cli/workflows/worker_result.py b/src/specify_cli/workflows/worker_result.py
new file mode 100644
index 0000000..2adcf6e
--- /dev/null
+++ b/src/specify_cli/workflows/worker_result.py
@@ -0,0 +1,27 @@
+"""Worker outcomes are evidence; process exit is not artifact acceptance."""
+from __future__ import annotations
+import hashlib
+from pathlib import Path
+import subprocess
+
+CONTRACT_VERSION = 1
+
+
+def check_artifacts(config, project_root):
+    root = Path(project_root or '.').resolve()
+    records = []
+    for relative in config.get('required_artifacts', []):
+        path = (root / relative).resolve()
+        if not path.is_relative_to(root) or path == root:
+            raise ValueError('Required artifact escapes the workspace')
+        if not path.is_file() or not path.stat().st_size:
+            raise ValueError(f'Worker did not produce required artifact: {relative}')
+        records.append({'path': relative, 'sha256': hashlib.sha256(path.read_bytes()).hexdigest()})
+    validator = config.get('artifact_validator')
+    if validator:
+        from specify_cli.python_runtime import resolve_python_interpreter
+        result = subprocess.run([resolve_python_interpreter(root), *validator], cwd=root,
+            capture_output=True, encoding='utf-8', errors='replace', timeout=120, check=False)
+        if result.returncode:
+            raise ValueError(f'Worker artifact validation failed: {result.stderr or result.stdout}')
+    return records
