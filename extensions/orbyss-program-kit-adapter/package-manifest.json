{
  "schema": "program-kit.spec-kit-adapter-package/v1",
  "id": "orbyss-program-kit-adapter",
  "version": "0.1.0",
  "specKitVersion": "0.15.1",
  "programKitVersion": "1.0.0-alpha.2",
  "runtime": "net10.0",
  "entrypoint": "tools/program-kit-spec-kit-adapter.dll",
  "releaseFiles": "release-files.json",
  "projectConfigTemplate": "config/orbyss-program-kit-adapter-config.template.yml",
  "projectConfigPath": ".specify/extensions/orbyss-program-kit-adapter/orbyss-program-kit-adapter-config.yml",
  "publicContracts": {
    "compatibility": "compatibility.json",
    "diagnosticCatalog": "diagnostic-catalog.json",
    "schemas": "schemas/"
  },
  "ownership": {
    "extensionSource": "spec-kit-extension-managed",
    "extensionReleaseFiles": "adapter-release-owned",
    "projectConfigTemplate": "adapter-release-owned",
    "projectConfig": "consumer-owned",
    "registration": "spec-kit-managed",
    "featureHandoffsAndReviews": "consumer-owned",
    "programKitStateProductsAndEvidence": "program-kit-owned"
  },
  "lifecycle": {
    "update": "stage-validate-activate-with-prior-release-rollback",
    "disable": "registration-only-no-artifact-cleanup",
    "enable": "registration-only-revalidate-before-adapter-use",
    "remove": "specify extension remove orbyss-program-kit-adapter --keep-config",
    "cleanup": "separate-explicit-manifest-proven-candidates-only",
    "specKitUpgrade": "manifest-aware-no-force"
  }
}
