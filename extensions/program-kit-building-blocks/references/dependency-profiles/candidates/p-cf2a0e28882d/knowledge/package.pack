  "facts": {
    "README.md": "# Orbyss.Foundation.Authentication.SpaPkce\n\nThe Orbyss Foundation direct SPA-PKCE API profile packaged as one CShells middleware feature. It owns\nJWT bearer validation, exact-origin CORS, canonical permission enforcement, and stable\nauthentication failures. Activate `Orbyss.Foundation.Authentication.SpaPkce` in exactly one shell\nauthentication profile. The API metadata backchannel may use the shared optional\n`BackchannelAuthority`; browser discovery and token issuer validation remain public-authority based.\n",
    "lib/net10.0/Orbyss.Foundation.Authentication.SpaPkce.xml": "<?xml version=\"1.0\"?>\n<doc>\n    <assembly>\n        <name>Orbyss.Foundation.Authentication.SpaPkce</name>\n    </assembly>\n    <members>\n        <member name=\"T:Orbyss.Foundation.Authentication.SpaPkce.FoundationSpaPkceFeature\">\n            <summary>Composes the direct SPA-PKCE bearer profile into one shell.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Authentication.SpaPkce.FoundationSpaPkceFeature.CorsPolicy\">\n            <summary>Names the exact-origin direct-SPA CORS policy.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.SpaPkce.FoundationSpaPkceFeature.Order\">\n            <inheritdoc />\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.SpaPkce.FoundationSpaPkceFeature.ConfigureServices(Microsoft.Extensions.DependencyInjection.IServiceCollection)\">\n            <inheritdoc />\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.SpaPkce.FoundationSpaPkceFeature.UseMiddleware(Microsoft.AspNetCore.Builder.IApplicationBuilder,Microsoft.Extensions.Hosting.IHostEnvironment)\">\n            <inheritdoc />\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.SpaPkce.FoundationSpaPkceFeature.MapEndpoints(Microsoft.AspNetCore.Routing.IEndpointRouteBuilder,Microsoft.Extensions.Hosting.IHostEnvironment)\">\n            <inheritdoc />\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.SpaPkce.SpaPkceOptionsValidator\">\n            <summary>Validates settings owned by the direct SPA-PKCE profile.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.SpaPkce.SpaPkceOptionsValidator.Validate(System.String,Orbyss.Foundation.Authentication.FoundationWebOptions)\">\n            <inheritdoc />\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.SpaPkce.SpaPkceProfileMarker\">\n            <summary>Identifies the direct SPA-PKCE authentication profile.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.SpaPkce.SpaPkceProfileMarker.Name\">\n            <inheritdoc />\n        </member>\n    </members>\n</doc>\n",
    "orbyss-foundation/feature.json": "{\n  \"schemaVersion\": 2,\n  \"packageId\": \"Orbyss.Foundation.Authentication.SpaPkce\",\n  \"features\": [\n    {\n      \"identity\": \"Orbyss.Foundation.Authentication.SpaPkce\",\n      \"featureDependencies\": [\n        \"Orbyss.Foundation.Authentication\",\n        \"Orbyss.Foundation.WebDefaults\"\n      ],\n      \"runtimeDependencies\": [],\n      \"routes\": [],\n      \"dormant\": true,\n      \"composeForOpenApi\": false,\n      \"requiresContractCoverage\": false,\n      \"dynamicRoutesFromConfiguration\": true\n    }\n  ],\n  \"sourceSha256\": {\n    \"FoundationSpaPkceFeature.cs\": \"85cbe060e0151753bab3eb18798dbadea55f2a0b863ae3610ecc1316a48b8ef7\",\n    \"SpaPkceOptionsValidator.cs\": \"b8962d0fec5376c809aac568c42926da7a9f4c85cd8f1cb2c954a7d9fd14fd71\",\n    \"SpaPkceProfileMarker.cs\": \"1775cbae96726bc22498ba8e4737669cf058b4c0ff2cd0db94432edc5f968ec0\"\n  },\n  \"hostProvidedDependencies\": [\n    {\n      \"packageId\": \"CShells.Abstractions\",\n      \"minimumVersion\": \"0.0.30-preview.159\"\n    },\n    {\n      \"packageId\": \"CShells.AspNetCore.Abstractions\",\n      \"minimumVersion\": \"0.0.30-preview.159\"\n    },\n    {\n      \"packageId\": \"JetBrains.Annotations\",\n      \"minimumVersion\": \"2025.2.4\"\n    },\n    {\n      \"packageId\": \"Microsoft.AspNetCore.Authentication.JwtBearer\",\n      \"minimumVersion\": \"10.0.12\"\n    },\n    {\n      \"packageId\": \"Microsoft.Bcl.Cryptography\",\n      \"minimumVersion\": \"10.0.2\"\n    },\n    {\n      \"packageId\": \"Microsoft.IdentityModel.Abstractions\",\n      \"minimumVersion\": \"8.19.2\"\n    },\n    {\n      \"packageId\": \"Microsoft.IdentityModel.JsonWebTokens\",\n      \"minimumVersion\": \"8.19.2\"\n    },\n    {\n      \"packageId\": \"Microsoft.IdentityModel.Logging\",\n      \"minimumVersion\": \"8.19.2\"\n    },\n    {\n      \"packageId\": \"Microsoft.IdentityModel.Protocols.OpenIdConnect\",\n      \"minimumVersion\": \"8.19.2\"\n    },\n    {\n      \"packageId\": \"Microsoft.IdentityModel.Protocols\",\n      \"minimumVersion\": \"8.19.2\"\n    },\n    {\n      \"packageId\": \"Microsoft.IdentityModel.Tokens\",\n      \"minimumVersion\": \"8.19.2\"\n    },\n    {\n      \"packageId\": \"System.IdentityModel.Tokens.Jwt\",\n      \"minimumVersion\": \"8.19.2\"\n    }\n  ]\n}\n",
    "orbyss-foundation/settings.json": "{\n  \"schemaVersion\": 2,\n  \"packageId\": \"Orbyss.Foundation.Authentication.SpaPkce\",\n  \"packageVersion\": \"0.3.1\",\n  \"sourceSha256\": {\n    \"FoundationSpaPkceFeature.cs\": \"85cbe060e0151753bab3eb18798dbadea55f2a0b863ae3610ecc1316a48b8ef7\",\n    \"SpaPkceOptionsValidator.cs\": \"b8962d0fec5376c809aac568c42926da7a9f4c85cd8f1cb2c954a7d9fd14fd71\",\n    \"SpaPkceProfileMarker.cs\": \"1775cbae96726bc22498ba8e4737669cf058b4c0ff2cd0db94432edc5f968ec0\"\n  },\n  \"contracts\": [\n    {\n      \"schemaVersion\": 2,\n      \"owner\": \"Orbyss.Foundation.Authentication.SpaPkce\",\n      \"scope\": \"spa-pkce\",\n      \"complete\": true,\n      \"sources\": {\n        \"FoundationSpaPkceFeature.cs\": \"85cbe060e0151753bab3eb18798dbadea55f2a0b863ae3610ecc1316a48b8ef7\",\n        \"SpaPkceOptionsValidator.cs\": \"b8962d0fec5376c809aac568c42926da7a9f4c85cd8f1cb2c954a7d9fd14fd71\",\n        \"SpaPkceProfileMarker.cs\": \"1775cbae96726bc22498ba8e4737669cf058b4c0ff2cd0db94432edc5f968ec0\"\n      },\n      \"settings\": [\n        {\n          \"path\": \"Foundation:Web:Authority\",\n          \"required\": true,\n          \"secret\": false,\n          \"constraints\": {\n            \"format\": \"uri\"\n          },\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the OIDC issuer authority.\",\n          \"type\": \"string\",\n          \"default\": \"\"\n        },\n        {\n          \"path\": \"Foundation:Web:BackchannelAuthority\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {},\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"BackchannelAuthority\",\n          \"type\": \"string\",\n          \"default\": \"\"\n        },\n        {\n          \"path\": \"Foundation:Web:ClientId\",\n          \"required\": true,\n          \"secret\": false,\n          \"constraints\": {\n            \"minLength\": 1\n          },\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the registered OAuth client identifier.\",\n          \"type\": \"string\",\n          \"default\": \"\"\n        },\n        {\n          \"path\": \"Foundation:Web:ClientSecret\",\n          \"required\": false,\n          \"secret\": true,\n          \"constraints\": {},\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the confidential BFF client secret.\",\n          \"type\": \"string\"\n        },\n        {\n          \"path\": \"Foundation:Web:Audience\",\n          \"required\": true,\n          \"secret\": false,\n          \"constraints\": {\n            \"minLength\": 1\n          },\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the protected API audience.\",\n          \"type\": \"string\",\n          \"default\": \"\"\n        },\n        {\n          \"path\": \"Foundation:Web:Scopes\",\n          \"required\": true,\n          \"secret\": false,\n          \"constraints\": {\n            \"minItems\": 1,\n            \"uniqueItems\": true,\n            \"items\": {\n              \"type\": \"string\",\n              \"pattern\": \"^[\\\\x21\\\\x23-\\\\x5B\\\\x5D-\\\\x7E]\\u002B$\"\n            }\n          },\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the scopes requested during interactive authentication. Explicit shell configuration replaces these fallback defaults.\",\n          \"type\": \"array\",\n          \"default\": [\n            \"openid\",\n            \"profile\",\n            \"offline_access\",\n            \"orbyss-foundation-api\"\n          ]\n        },\n        {\n          \"path\": \"Foundation:Web:RoleClaim\",\n          \"required\": true,\n          \"secret\": false,\n          \"constraints\": {\n            \"minLength\": 1\n          },\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the provider claim containing normalized application roles.\",\n          \"type\": \"string\",\n          \"default\": \"roles\"\n        },\n        {\n          \"path\": \"Foundation:Web:PermissionClaim\",\n          \"required\": true,\n          \"secret\": false,\n          \"constraints\": {\n            \"minLength\": 1\n          },\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the canonical claim containing application permission identities.\",\n          \"type\": \"string\",\n          \"default\": \"permissions\"\n        },\n        {\n          \"path\": \"Foundation:Web:RolePermissions\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"additionalProperties\": {\n              \"type\": \"array\",\n              \"minItems\": 1,\n              \"items\": {\n                \"type\": \"string\",\n                \"minLength\": 1\n              }\n            }\n          },\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets provider-role to canonical application-permission mappings.\",\n          \"type\": \"object\",\n          \"default\": {}\n        },\n        {\n          \"path\": \"Foundation:Web:ScopePermissions\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"additionalProperties\": {\n              \"type\": \"array\",\n              \"minItems\": 1,\n              \"items\": {\n                \"type\": \"string\",\n                \"minLength\": 1\n              }\n            }\n          },\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets provider-scope to canonical application-permission mappings.\",\n          \"type\": \"object\",\n          \"default\": {}\n        },\n        {\n          \"path\": \"Foundation:Web:AllowedOrigins\",\n          \"required\": true,\n          \"secret\": false,\n          \"constraints\": {\n            \"minItems\": 1,\n            \"items\": {\n              \"type\": \"string\",\n              \"format\": \"uri\"\n            }\n          },\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the exact origins permitted by the direct SPA profile.\",\n          \"type\": \"array\",\n          \"default\": []\n        },\n        {\n          \"path\": \"Foundation:Web:CallbackPath\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {},\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the local OIDC authorization callback path.\",\n          \"type\": \"string\",\n          \"default\": \"/signin-oidc\"\n        },\n        {\n          \"path\": \"Foundation:Web:SignedOutCallbackPath\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {},\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the local callback path used after provider logout.\",\n          \"type\": \"string\",\n          \"default\": \"/signout-callback-oidc\"\n        },\n        {\n          \"path\": \"Foundation:Web:RemoteSignOutPath\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {},\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the path receiving provider-initiated logout notifications.\",\n          \"type\": \"string\",\n          \"default\": \"/signout-oidc\"\n        },\n        {\n          \"path\": \"Foundation:Web:AccessDeniedPath\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {},\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the interactive access-denied path.\",\n          \"type\": \"string\",\n          \"default\": \"/bff/access-denied\"\n        },\n        {\n          \"path\": \"Foundation:Web:CookieName\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {},\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the host-only encrypted session cookie name.\",\n          \"type\": \"string\",\n          \"default\": \"__Host-orbyss-foundation-session\"\n        },\n        {\n          \"path\": \"Foundation:Web:DiscoveryTimeoutSeconds\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"minimum\": 1,\n            \"maximum\": 30\n          },\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the discovery and JWKS readiness budget in seconds.\",\n          \"type\": \"integer\",\n          \"default\": 3\n        },\n        {\n          \"path\": \"Foundation:Web:RemoteAuthenticationTimeoutSeconds\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {},\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the maximum duration of an interactive remote authentication operation.\",\n          \"type\": \"integer\",\n          \"default\": 10\n        },\n        {\n          \"path\": \"Foundation:Web:SessionIdleMinutes\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"minimum\": 1\n          },\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the sliding server session idle lifetime in minutes.\",\n          \"type\": \"integer\",\n          \"default\": 30\n        },\n        {\n          \"path\": \"Foundation:Web:SessionAbsoluteMinutes\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"minimum\": 1\n          },\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the non-extendable server session lifetime in minutes.\",\n          \"type\": \"integer\",\n          \"default\": 480\n        },\n        {\n          \"path\": \"Foundation:Web:AllowHttpForLocalDevelopment\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {},\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets whether loopback/container HTTP is accepted during local development.\",\n          \"type\": \"boolean\",\n          \"default\": false\n        }\n      ],\n      \"semanticConstraints\": [\n        \"ClientSecret must be empty for the public SPA-PKCE profile; a configured secret is rejected and no secret values are emitted.\",\n        \"AllowedOrigins must contain at least one exact absolute origin with root path and no wildcard, query or fragment.\",\n        \"The supported SPA-PKCE structural schema complements this publisher-owned profile contract; it does not replace common authentication validation.\",\n        \"Export never creates a WebApplication, initializes bearer handlers or contacts discovery/identity services.\"\n      ],\n      \"appliesTo\": {\n        \"kind\": \"shell\",\n        \"features\": [\n          \"Orbyss.Foundation.Authentication.SpaPkce\"\n        ],\n        \"configuration\": []\n      },\n      \"typeName\": \"Orbyss.Foundation.Authentication.FoundationWebOptions\"\n    }\n  ],\n  \"assembly\": {\n    \"name\": \"Orbyss.Foundation.Authentication.SpaPkce.dll\",\n    \"sha256\": \"4331fe7908bcbc2a9ea8cefbc5a49fd3015471f026fd07c18ea8f70aa0ec4fc6\"\n  },\n  \"imports\": [\n    {\n      \"typeName\": \"Orbyss.Foundation.Authentication.FoundationWebOptions\",\n      \"packageId\": \"Orbyss.Foundation.Authentication\",\n      \"packageVersion\": \"0.3.1\",\n      \"scope\": \"web\",\n      \"metadataSha256\": \"c6156f836510d3d869a6ee4b06ccc6dc72eecb79d99579fdab57e1d08f6e692f\",\n      \"assembly\": {\n        \"name\": \"Orbyss.Foundation.Authentication.dll\",\n        \"sha256\": \"9f0a93c7569adc50c29ba6b15fc8781bb6c71f230777e6d1949d5be1cafadc65\"\n      }\n    }\n  ]\n}\n"
  }
