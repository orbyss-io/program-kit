32802cc52fe97ce4ac529abfe77332ace2f9857ab\",\n    \"JsonContractDirection.cs\": \"abff4b897a0f0a1e64a471b87bd7d782ea87e70badea2564f13334ab55057613\",\n    \"JsonContractMetadata.cs\": \"d65bbeb3a39e6f4f46ace1b172935c10d5fdfe26d6a7584f1897163e07b4c8cd\",\n    \"JsonContractOperationTransformer.cs\": \"2e0da06b2847c8e2b5e6959a27363bd05a0677d6b5414d41ab0173ff1158f0db\",\n    \"JsonPageOptions.cs\": \"c8096fc696471f9e4670a4ad115f5e25cf6e1d815a5666a8ab199497be09014d\",\n    \"JsonProfileResult.cs\": \"cf770b3a3dd90d9aa909d31df7da3afc8e25f662a7ef7d1140f319e7de37764f\",\n    \"JsonRequestReader.cs\": \"c76387551f72a50bb84c5bd6f5cf94e6a41e09456c3ad839e23736080a5cc351\",\n    \"JsonResponseFactory.cs\": \"4dd8451ea4ce163f30f519274d837628847fdb6bb532efc2b7f83fa9b9ff4de7\"\n  },\n  \"contracts\": [\n    {\n      \"schemaVersion\": 2,\n      \"owner\": \"Orbyss.Foundation.Json.AspNetCore\",\n      \"scope\": \"json-aspnetcore\",\n      \"complete\": true,\n      \"sources\": {\n        \"FoundationJsonEndpointExtensions.cs\": \"2b051b476ec7266e3ac4d2c59575cf4d76d8cfee83489563160afb214b75fcfb\",\n        \"FoundationJsonFeature.cs\": \"e6a75dbc079576ad477a57dd58b3a1dffceba4f572b293f653ff7d29e7dc1e0c\",\n        \"FoundationJsonOptions.cs\": \"ac87eee0ae1958fe20c17a73c27b2da0a914b87e5a80ee0368253c8e36d82559\",\n        \"FoundationJsonRequestExceptionHandler.cs\": \"49c01e2ec35783ca4a86e2c96e3b18f78783326f72f3d75f285183994c8d6c0a\",\n        \"FoundationJsonResponseExceptionHandler.cs\": \"c9a8fb095d17f574dd01f9e1cc25c6e425b1e5bf796a077427e582ade85dbe44\",\n        \"FoundationJsonServiceCollectionExtensions.cs\": \"589a4b2caf5247bc5fa744c0229abfac5bdf370ee4315d5947765cd0495a5ba3\",\n        \"IJsonContractMetadata.cs\": \"3f298dbdc166f07191b84ed717d5740f4c2ccbe23dbfc184eec764f6549846e6\",\n        \"IJsonProfileResult.cs\": \"d6842a0e6efc65588ba23640b9fb96922b3dd7fa1b0fe34f5dcad4b87f4dd197\",\n        \"IJsonRequestReader.cs\": \"556f48fe694968b8ddd306bcc1ddc407c057e96287390703586f172c93c61309\",\n        \"IJsonResponseFactory.cs\": \"8af0ff5ac8fedab9fa4d7400f9ba816a21fefad03c94cec72ab31c801775caa6\",\n        \"JsonAdmissionPipeReader.cs\": \"6871febf985e8b2a74637e8cae4cfd87eff5a3c584afde82a66a91cb481915d3\",\n        \"JsonAdmissionPipeWriter.cs\": \"efbe91d6b132253a6f49a8288b5b3f1a2c15cc50a36e1b41406eec2ae8130c50\",\n        \"JsonAdmissionRequestBodyPipeFeature.cs\": \"50a18586b234d2ef6d46cf9a9717816ba3b7bc443f79173caa23c9572ccbc9e0\",\n        \"JsonAdmissionResponseBodyFeature.cs\": \"4c2e6f06372824f376e823418b9c7674669bcf86dcb84dfa9f79d29c28d493fa\",\n        \"JsonAdmissionResult.cs\": \"f1ad6dadce5f93eb3c7460acfb026ed232b27da3bc571dcc8b09a080ac1eaef1\",\n        \"JsonAdmissionState.cs\": \"44216a09ccfa325bcd7fedca3cdf31bea9aee83353a3b0abcd2206156340f5f1\",\n        \"JsonAdmissionStream.cs\": \"cc1bc4c6c32d3084471110b32802cc52fe97ce4ac529abfe77332ace2f9857ab\",\n        \"JsonContractDirection.cs\": \"abff4b897a0f0a1e64a471b87bd7d782ea87e70badea2564f13334ab55057613\",\n        \"JsonContractMetadata.cs\": \"d65bbeb3a39e6f4f46ace1b172935c10d5fdfe26d6a7584f1897163e07b4c8cd\",\n        \"JsonContractOperationTransformer.cs\": \"2e0da06b2847c8e2b5e6959a27363bd05a0677d6b5414d41ab0173ff1158f0db\",\n        \"JsonPageOptions.cs\": \"c8096fc696471f9e4670a4ad115f5e25cf6e1d815a5666a8ab199497be09014d\",\n        \"JsonProfileResult.cs\": \"cf770b3a3dd90d9aa909d31df7da3afc8e25f662a7ef7d1140f319e7de37764f\",\n        \"JsonRequestReader.cs\": \"c76387551f72a50bb84c5bd6f5cf94e6a41e09456c3ad839e23736080a5cc351\",\n        \"JsonResponseFactory.cs\": \"4dd8451ea4ce163f30f519274d837628847fdb6bb532efc2b7f83fa9b9ff4de7\"\n      },\n      \"settings\": [\n        {\n          \"path\": \"Foundation:Json:Profiles\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"minProperties\": 1,\n            \"maxProperties\": 128\n          },\n          \"binding\": \"Shell configuration binds Foundation:Json to FoundationJsonOptions; native owner validation admits the resulting values.\",\n          \"precedence\": [\n            \"typed source initializer\",\n            \"ordered shell configuration providers\",\n            \"code configuration registered after binding\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Supported Profiles value owned by FoundationJsonOptions.\",\n          \"type\": \"object\",\n          \"default\": {\n            \"strict-request\": {\n              \"Preset\": \"strict-request\",\n              \"MaxBytes\": 2097152,\n              \"MaxDepth\": 32,\n              \"Extensions\": []\n            },\n            \"tolerant-response\": {\n              \"Preset\": \"tolerant-response\",\n              \"MaxBytes\": 1048576,\n              \"MaxDepth\": 32,\n              \"Extensions\": []\n            },\n            \"success-response\": {\n              \"Preset\": \"tolerant-response\",\n              \"MaxBytes\": 1048576,\n              \"MaxDepth\": 32,\n              \"Extensions\": []\n            },\n            \"problem-response\": {\n              \"Preset\": \"tolerant-response\",\n              \"MaxBytes\": 65536,\n              \"MaxDepth\": 32,\n              \"Extensions\": []\n            }\n          }\n        },\n        {\n          \"path\": \"Foundation:Json:Paging\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"type\": \"object\"\n          },\n          \"binding\": \"Shell configuration binds Foundation:Json to FoundationJsonOptions; native owner validation admits the resulting values.\",\n          \"precedence\": [\n            \"typed source initializer\",\n            \"ordered shell configuration providers\",\n            \"code configuration registered after binding\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Supported Paging value owned by FoundationJsonOptions.\",\n          \"type\": \"object\",\n          \"default\": {\n            \"DefaultSize\": 100,\n            \"MaximumSize\": 500\n          }\n        }\n      ],\n      \"semanticConstraints\": [\n        \"The native configuration binder merges named profile keys into source defaults and binds Paging; it does not replace dictionaries as a whole.\",\n        \"Profile values are validated by the owning JsonProfile constructor and selected IJsonProfileExtension registry. Unknown profiles, duplicate typed contracts, incompatible requirements and invalid paging fail before serving.\",\n        \"Extensions name code registrations; metadata export does not initialize application/storage/identity services.\"\n      ],\n      \"appliesTo\": {\n        \"kind\": \"shell\",\n        \"features\": [\n          \"Orbyss.Foundation.Json.AspNetCore\"\n        ],\n        \"configuration\": [\n          \"Foundation:Json\"\n        ]\n      },\n      \"typeName\": \"Orbyss.Foundation.Json.AspNetCore.FoundationJsonOptions\"\n    },\n    {\n      \"schemaVersion\": 2,\n      \"owner\": \"Orbyss.Foundation.Json.AspNetCore\",\n      \"scope\": \"json-configured-profile\",\n      \"complete\": true,\n      \"sources\": {\n        \"FoundationJsonEndpointExtensions.cs\": \"2b051b476ec7266e3ac4d2c59575cf4d76d8cfee83489563160afb214b75fcfb\",\n        \"FoundationJsonFeature.cs\": \"e6a75dbc079576ad477a57dd58b3a1dffceba4f572b293f653ff7d29e7dc1e0c\",\n        \"FoundationJsonOptions.cs\": \"ac87eee0ae1958fe20c17a73c27b2da0a914b87e5a80ee0368253c8e36d82559\",\n        \"FoundationJsonRequestExceptionHandler.cs\": \"49c01e2ec35783ca4a86e2c96e3b18f78783326f72f3d75f285183994c8d6c0a\",\n        \"FoundationJsonResponseExceptionHandler.cs\": \"c9a8fb095d17f574dd01f9e1cc25c6e425b1e5bf796a077427e582ade85dbe44\",\n        \"FoundationJsonServiceCollectionExtensions.cs\": \"589a4b2caf5247bc5fa744c0229abfac5bdf370ee4315d5947765cd0495a5ba3\",\n        \"IJsonContractMetadata.cs\": \"3f298dbdc166f07191b84ed717d5740f4c2ccbe23dbfc184eec764f6549846e6\",\n        \"IJsonProfileResult.cs\": \"d6842a0e6efc65588ba23640b9fb96922b3dd7fa1b0fe34f5dcad4b87f4dd197\",\n        \"IJsonRequestReader.cs\": \"556f48fe694968b8ddd306bcc1ddc407c057e96287390703586f172c93c61309\",\n        \"IJsonResponseFactory.cs\": \"8af0ff5ac8fedab9fa4d7400f9ba816a21fefad03c94cec72ab31c801775caa6\",\n        \"JsonAdmissionPipeReader.cs\": \"6871febf985e8b2a74637e8cae4cfd87eff5a3c584afde82a66a91cb481915d3\",\n        \"JsonAdmissionPipeWriter.cs\": \"efbe91d6b132253a6f49a8288b5b3f1a2c15cc50a36e1b41406eec2ae8130c50\",\n        \"JsonAdmissionRequestBodyPipeFeature.cs\": \"50a18586b234d2ef6d46cf9a9717816ba3b7bc443f79173caa23c9572ccbc9e0\",\n        \"JsonAdmissionResponseBodyFeature.cs\": \"4c2e6f06372824f376e823418b9c7674669bcf86dcb84dfa9f79d29c28d493fa\",\n        \"JsonAdmissionResult.cs\": \"f1ad6dadce5f93eb3c7460acfb026ed232b27da3bc571dcc8b09a080ac1eaef1\",\n        \"JsonAdmissionState.cs\": \"44216a09ccfa325bcd7fedca3cdf31bea9aee83353a3b0abcd2206156340f5f1\",\n        \"JsonAdmissionStream.cs\": \"cc1bc4c6c32d3084471110b32802cc52fe97ce4ac529abfe77332ace2f9857ab\",\n        \"JsonContractDirection.cs\": \"abff4b897a0f0a1e64a471b87bd7d782ea87e70badea2564f13334ab55057613\",\n        \"JsonContractMetadata.cs\": \"d65bbeb3a39e6f4f46ace1b172935c10d5fdfe26d6a7584f1897163e07b4c8cd\",\n        \"JsonContractOperationTransformer.cs\": \"2e0da06b2847c8e2b5e6959a27363bd05a0677d6b5414d41ab0173ff1158f0db\",\n        \"JsonPageOptions.cs\": \"c8096fc696471f9e4670a4ad115f5e25cf6e1d815a5666a8ab199497be09014d\",\n        \"JsonProfileResult.cs\": \"cf770b3a3dd90d9aa909d31df7da3afc8e25f662a7ef7d1140f319e7de37764f\",\n        \"JsonRequestReader.cs\": \"c76387551f72a50bb84c5bd6f5cf94e6a41e09456c3ad839e23736080a5cc351\",\n        \"JsonResponseFactory.cs\": \"4dd8451ea4ce163f30f519274d837628847fdb6bb532efc2b7f83fa9b9ff4de7\"\n      },\n      \"settings\": [\n        {\n          \"path\": \"Foundation:Json:Profiles:{profileName}:Preset\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"enum\": [\n              \"strict-request\",\n              \"tolerant-response\"\n            ]\n          },\n          \"binding\": \"The shell binder merges each named profile into FoundationJsonOptions.Profiles; JsonProfileSettings defaults and native admission belong to the imported Json owner.\",\n          \"precedence\": [\n            \"typed source profile defaults\",\n            \"ordered shell configuration providers\",\n            \"code configuration registered after binding\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Fixed admission preset of one configured or custom named profile.\",\n          \"type\": \"string\",\n          \"default\": \"strict-request\"\n        },\n        {\n          \"path\": \"Foundation:Json:Profiles:{profileName}:MaxBytes\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"minimum\": 1,\n            \"maximum\": 16777216\n          },\n          \"binding\": \"The shell binder merges each named profile into FoundationJsonOptions.Profiles; JsonProfileSettings defaults and native admission belong to the imported Json owner.\",\n          \"precedence\": [\n            \"typed source profile defaults\",\n            \"ordered shell configuration providers\",\n            \"code configuration registered after binding\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Maximum encoded bytes of one configured or custom named profile.\",\n          \"type\": \"integer\",\n          \"default\": 1048576\n        },\n        {\n          \"path\": \"Foundation:Json:Profiles:{profileName}:MaxDepth\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"minimum\": 1,\n            \"maximum\": 64\n          },\n          \"binding\": \"The shell binder merges each named profile into FoundationJsonOptions.Profiles; JsonProfileSettings defaults and native admission belong to the imported Json owner.\",\n          \"precedence\": [\n            \"typed source profile defaults\",\n            \"ordered shell configuration providers\",\n            \"code configuration registered after binding\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Maximum nesting depth of one configured or custom named profile.\",\n          \"type\": \"integer\",\n          \"default\": 32\n        },\n        {\n          \"path\": \"Foundation:Json:Profiles:{profileName}:Extensions\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"uniqueItems\": true\n          },\n          \"binding\": \"The shell binder merges each named profile into FoundationJsonOptions.Profiles; JsonProfileSettings defaults and native admission belong to the imported Json owner.\",\n          \"precedence\": [\n            \"typed source profile defaults\",\n            \"ordered shell configuration providers\",\n            \"code configuration registered after binding\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Explicit registered extension identities for one configured or custom named profile.\",\n          \"type\": \"array\",\n          \"default\": []\n        }\n      ],\n      \"semanticConstraints\": [\n        \"Imported defaults describe a newly constructed JsonProfileSettings value. The parent Profiles default graph describes the source overrides of the four built-in named profiles.\",\n        \"JsonProfile rejects invalid presets and bounds; extension identities must be non-null, distinct and registered by code with at most one selected resolver.\",\n        \"The required problem-response profile is projected into FoundationProblemResponseOptions at shell activation: MaxBytes must be at least512, MaxDepth at least3 and Preset must be tolerant-response. Generic profile bounds still apply; other names do not inherit these problem-response restrictions.\",\n        \"The native dictionary binder merges named keys rather than replacing the profile registry; profile requirements and stateless extension admission are validated before serving.\"\n      ],\n      \"appliesTo\": {\n        \"kind\": \"shell\",\n        \"features\": [\n          \"Orbyss.Foundation.Json.AspNetCore\"\n        ],\n        \"configuration\": [\n          \"Foundation:Json:Profiles\"\n        ]\n      },\n      \"typeName\": \"Orbyss.Foundation.Json.JsonProfileSettings\"\n    },\n    {\n      \"schemaVersion\": 2,\n      \"owner\": \"Orbyss.Foundation.Json.AspNetCore\",\n      \"scope\": \"json-paging\",\n      \"complete\": true,\n      \"sources\": {\n        \"FoundationJsonEndpointExtensions.cs\": \"2b051b476ec7266e3ac4d2c59575cf4d76d8cfee83489563160afb214b75fcfb\",\n        \"FoundationJsonFeature.cs\": \"e6a75dbc079576ad477a57dd58b3a1dffceba4f572b293f653ff7d29e7dc1e0c\",\n        \"FoundationJsonOptions.cs\": \"ac87eee0ae1958fe20c17a73c27b2da0a914b87e5a80ee0368253c8e36d82559\",\n        \"FoundationJsonRequestExceptionHandler.cs\": \"49c01e2ec35783ca4a86e2c96e3b18f78783326f72f3d75f285183994c8d6c0a\",\n        \"FoundationJsonResponseExceptionHandler.cs\": \"c9a8fb095d17f574dd01f9e1cc25c6e425b1e5bf796a077427e582ade85dbe44\",\n        \"FoundationJsonServiceCollectionExtensions.cs\": \"589a4b2caf5247bc5fa744c0229abfac5bdf370ee4315d5947765cd0495a5ba3\",\n        \"IJsonContractMetadata.cs\": \"3f298dbdc166f07191b84ed717d5740f4c2ccbe23dbfc184eec764f6549846e6\",\n        \"IJsonProfileResult.cs\": \"d6842a0e6efc65588ba23640b9fb96922b3dd7fa1b0fe34f5dcad4b87f4dd197\",\n        \"IJsonRequestReader.cs\": \"556f48fe694968b8ddd306bcc1ddc407c057e96287390703586f172c93c61309\",\n        \"IJsonResponseFactory.cs\": \"8af0ff5ac8fedab9fa4d7400f9ba816a21fefad03c94cec72ab31c801775caa6\",\n        \"JsonAdmissionPipeReader.cs\": \"6871febf985e8b2a74637e8cae4cfd87eff5a3c584afde82a66a91cb481915d3\",\n        \"JsonAdmissionPipeWriter.cs\": \"efbe91d6b132253a6f49a8288b5b3f1a2c15cc50a36e1b41406eec2ae8130c50\",\n        \"JsonAdmissionRequestBodyPipeFeature.cs\": \"50a18586b234d2ef6d46cf9a9717816ba3b7bc443f79173caa23c9572ccbc9e0\",\n        \"JsonAdmissionResponseBodyFeature.cs\": \"4c2e6f06372824f376e823418b9c7674669bcf86dcb84dfa9f79d29c28d493fa\",\n        \"JsonAdmissionResult.cs\": \"f1ad6dadce5f93eb3c7460acfb026ed232b27da3bc571dcc8b09a080ac1eaef1\",\n        \"JsonAdmissionState.cs\": \"44216a09ccfa325bcd7fedca3cdf31bea9aee83353a3b0abcd2206156340f5f1\",\n        \"JsonAdmissionStream.cs\": \"cc1bc4c6c32d3084471110b32802cc52fe97ce4ac529abfe77332ace2f9857ab\",\n        \"JsonContractDirection.cs\": \"abff4b897a0f0a1e64a471b87bd7d782ea87e70badea2564f13334ab55057613\",\n        \"JsonContractMetadata.cs\": \"d65bbeb3a39e6f4f46ace1b172935c10d5fdfe26d6a7584f1897163e07b4c8cd\",\n        \"JsonContractOperationTransformer.cs\": \"2e0da06b2847c8e2b5e6959a27363bd05a0677d6b5414d41ab0173ff1158f0db\",\n        \"JsonPageOptions.cs\": \"c8096fc696471f9e4670a4ad115f5e25cf6e1d815a5666a8ab199497be09014d\",\n        \"JsonProfileResult.cs\": \"cf770b3a3dd90d9aa909d31df7da3afc8e25f662a7ef7d1140f319e7de37764f\",\n        \"JsonRequestReader.cs\": \"c76387551f72a50bb84c5bd6f5cf94e6a41e09456c3ad839e23736080a5cc351\",\n        \"JsonResponseFactory.cs\": \"4dd8451ea4ce163f30f519274d837628847fdb6bb532efc2b7f83fa9b9ff4de7\"\n      },\n      \"settings\": [\n        {\n          \"path\": \"Foundation:Json:Paging:DefaultSize\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"minimum\": 1\n          },\n          \"binding\": \"Shell configuration binds Foundation:Json:Paging to JsonPageOptions; native owner validation admits the resulting values.\",\n          \"precedence\": [\n            \"typed source initializer\",\n            \"ordered shell configuration providers\",\n            \"code configuration registered after binding\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Supported DefaultSize value owned by JsonPageOptions.\",\n          \"type\": \"integer\",\n          \"default\": 100\n        },\n        {\n          \"path\": \"Foundation:Json:Paging:MaximumSize\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"minimum\": 1,\n            \"maximum\": 10000\n          },\n          \"binding\": \"Shell configuration binds Foundation:Json:Paging to JsonPageOptions; native owner validation admits the resulting values.\",\n          \"precedence\": [\n            \"typed source initializer\",\n            \"ordered shell configuration providers\",\n            \"code configuration registered after binding\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Supported MaximumSize value owned by JsonPageOptions.\",\n          \"type\": \"integer\",\n          \"default\": 500\n        }\n      ],\n      \"semanticConstraints\": [\n        \"DefaultSize must be positive; MaximumSize must be at least DefaultSize and no greater than10000. Both count and independently configured response bytes apply.\"\n      ],\n      \"appliesTo\": {\n        \"kind\": \"shell\",\n        \"features\": [\n          \"Orbyss.Foundation.Json.AspNetCore\"\n        ],\n        \"configuration\": [\n          \"Foundation:Json:Paging\"\n        ]\n      },\n      \"typeName\": \"Orbyss.Foundation.Json.AspNetCore.JsonPageOptions\"\n    }\n  ],\n  \"assembly\": {\n    \"name\": \"Orbyss.Foundation.Json.AspNetCore.dll\",\n    \"sha256\": \"5f67da6c7ecd29e451e4fd4990921b6d02164a52b2eb5a9db50663bcab12ce0f\"\n  },\n  \"imports\": [\n    {\n      \"typeName\": \"Orbyss.Foundation.Json.JsonProfileSettings\",\n      \"packageId\": \"Orbyss.Foundation.Json\",\n      \"packageVersion\": \"0.3.1\",\n      \"scope\": \"json-profile\",\n      \"metadataSha256\": \"dcb79f6f89e0abf40ddd46dd20a689d47ee2206b629622a6c50d059619b8824b\",\n      \"assembly\": {\n        \"name\": \"Orbyss.Foundation.Json.dll\",\n        \"sha256\": \"9e4fabbb37265a33c5654d08502f7414c65858d1d09d7566a3337b12d0c5f386\"\n      }\n    }\n  ]\n}\n"
  }
