  "facts": {
    "README.md": "# Orbyss.Foundation.Mcp.AspNetCore\n\nThe single endpoint-only `CShells.IWebShellFeature` that owns Orbyss Foundation's stateless Streamable\nHTTP transport. Independently selected bounded-context features contribute explicit closed-world\ntool types to the same server. This avoids SDK-global tool registration accidentally creating\ndifferent endpoints with shared catalogs.\n\nThe endpoint is always protected by the host default or configured named policy. Authentication,\nauthorization middleware, CORS, host filtering, rate limiting, and error formatting remain owned\nby selected host features. Bearer authentication is the normal remote-client composition.\n",
    "lib/net10.0/Orbyss.Foundation.Mcp.AspNetCore.xml": "<?xml version=\"1.0\"?>\n<doc>\n    <assembly>\n        <name>Orbyss.Foundation.Mcp.AspNetCore</name>\n    </assembly>\n    <members>\n        <member name=\"T:Orbyss.Foundation.Mcp.AspNetCore.FoundationMcpFeature\">\n            <summary>Composes one authenticated stateless MCP transport for selected tool contributors.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Mcp.AspNetCore.FoundationMcpFeature.#ctor(CShells.ShellSettings)\">\n            <summary>Composes one authenticated stateless MCP transport for selected tool contributors.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Mcp.AspNetCore.FoundationMcpFeature.ConfigureServices(Microsoft.Extensions.DependencyInjection.IServiceCollection)\">\n            <inheritdoc />\n        </member>\n        <member name=\"M:Orbyss.Foundation.Mcp.AspNetCore.FoundationMcpFeature.MapEndpoints(Microsoft.AspNetCore.Routing.IEndpointRouteBuilder,Microsoft.Extensions.Hosting.IHostEnvironment)\">\n            <inheritdoc />\n        </member>\n        <member name=\"M:Orbyss.Foundation.Mcp.AspNetCore.FoundationMcpFeature.ValidateOptions(Orbyss.Foundation.Mcp.AspNetCore.FoundationMcpWebOptions)\">\n            <summary>Rejects unsafe routes at shell startup.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Mcp.AspNetCore.FoundationMcpWebOptions\">\n            <summary>Configures the shared authenticated stateless MCP transport endpoint.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Mcp.AspNetCore.FoundationMcpWebOptions.SectionName\">\n            <summary>Names the shell configuration section.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Mcp.AspNetCore.FoundationMcpWebOptions.Route\">\n            <summary>Gets or sets the fixed Streamable HTTP route.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Mcp.AspNetCore.FoundationMcpWebOptions.Policy\">\n            <summary>Gets or sets the policy; null or whitespace uses the host default policy.</summary>\n        </member>\n    </members>\n</doc>\n",
    "orbyss-foundation/feature.json": "{\n  \"schemaVersion\": 2,\n  \"packageId\": \"Orbyss.Foundation.Mcp.AspNetCore\",\n  \"features\": [\n    {\n      \"identity\": \"Orbyss.Foundation.Mcp.AspNetCore\",\n      \"featureDependencies\": [],\n      \"runtimeDependencies\": [],\n      \"routes\": [],\n      \"dormant\": true,\n      \"composeForOpenApi\": false,\n      \"requiresContractCoverage\": false,\n      \"dynamicRoutesFromConfiguration\": true\n    }\n  ],\n  \"sourceSha256\": {\n    \"FoundationMcpFeature.cs\": \"09164ea5356f68ce50d3012ba60958c806e12cc08e368646274413002449a4f3\",\n    \"FoundationMcpWebOptions.cs\": \"acc15d4a3e044e358175a33582478df95dabcf30955bcf88ddc1ba426644f3ed\"\n  },\n  \"hostProvidedDependencies\": [\n    {\n      \"packageId\": \"CShells.Abstractions\",\n      \"minimumVersion\": \"0.0.30-preview.159\"\n    },\n    {\n      \"packageId\": \"CShells.AspNetCore.Abstractions\",\n      \"minimumVersion\": \"0.0.30-preview.159\"\n    },\n    {\n      \"packageId\": \"JetBrains.Annotations\",\n      \"minimumVersion\": \"2025.2.4\"\n    },\n    {\n      \"packageId\": \"Microsoft.Extensions.AI.Abstractions\",\n      \"minimumVersion\": \"10.8.3\"\n    },\n    {\n      \"packageId\": \"ModelContextProtocol.AspNetCore\",\n      \"minimumVersion\": \"2.2.0\"\n    },\n    {\n      \"packageId\": \"ModelContextProtocol.Core\",\n      \"minimumVersion\": \"2.2.0\"\n    },\n    {\n      \"packageId\": \"ModelContextProtocol\",\n      \"minimumVersion\": \"2.2.0\"\n    }\n  ]\n}\n",
    "orbyss-foundation/settings.json": "{\n  \"schemaVersion\": 2,\n  \"packageId\": \"Orbyss.Foundation.Mcp.AspNetCore\",\n  \"packageVersion\": \"0.3.1\",\n  \"sourceSha256\": {\n    \"FoundationMcpFeature.cs\": \"09164ea5356f68ce50d3012ba60958c806e12cc08e368646274413002449a4f3\",\n    \"FoundationMcpWebOptions.cs\": \"acc15d4a3e044e358175a33582478df95dabcf30955bcf88ddc1ba426644f3ed\"\n  },\n  \"contracts\": [\n    {\n      \"schemaVersion\": 2,\n      \"owner\": \"Orbyss.Foundation.Mcp.AspNetCore\",\n      \"scope\": \"mcp-transport\",\n      \"complete\": true,\n      \"sources\": {\n        \"FoundationMcpFeature.cs\": \"09164ea5356f68ce50d3012ba60958c806e12cc08e368646274413002449a4f3\",\n        \"FoundationMcpWebOptions.cs\": \"acc15d4a3e044e358175a33582478df95dabcf30955bcf88ddc1ba426644f3ed\"\n      },\n      \"settings\": [\n        {\n          \"path\": \"Foundation:Mcp:Route\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"minLength\": 2,\n            \"maxLength\": 128\n          },\n          \"binding\": \"Shell configuration binds Foundation:Mcp to FoundationMcpWebOptions; native owner validation admits the resulting values.\",\n          \"precedence\": [\n            \"typed source initializer\",\n            \"ordered shell configuration providers\",\n            \"code configuration registered after binding\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Supported Route value owned by FoundationMcpWebOptions.\",\n          \"type\": \"string\",\n          \"default\": \"/orbyss-foundation/mcp\"\n        },\n        {\n          \"path\": \"Foundation:Mcp:Policy\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"nullable\": true\n          },\n          \"binding\": \"Shell configuration binds Foundation:Mcp to FoundationMcpWebOptions; native owner validation admits the resulting values.\",\n          \"precedence\": [\n            \"typed source initializer\",\n            \"ordered shell configuration providers\",\n            \"code configuration registered after binding\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Supported Policy value owned by FoundationMcpWebOptions.\",\n          \"type\": \"string\",\n          \"default\": null\n        }\n      ],\n      \"semanticConstraints\": [\n        \"Route must be a fixed absolute path without trailing slash, double-slash, braces, query or fragment.\",\n        \"Policy null or whitespace uses native default authorization; a nonempty value selects an application-registered named policy. Stateless transport always remains authenticated.\"\n      ],\n      \"appliesTo\": {\n        \"kind\": \"shell\",\n        \"features\": [\n          \"Orbyss.Foundation.Mcp.AspNetCore\"\n        ],\n        \"configuration\": [\n          \"Foundation:Mcp\"\n        ]\n      },\n      \"typeName\": \"Orbyss.Foundation.Mcp.AspNetCore.FoundationMcpWebOptions\"\n    }\n  ],\n  \"assembly\": {\n    \"name\": \"Orbyss.Foundation.Mcp.AspNetCore.dll\",\n    \"sha256\": \"750cd97dbde283c6ecc69cbfb7a99d94b3182cafbe983673b88427ae7567c930\"\n  },\n  \"imports\": []\n}\n"
  }
