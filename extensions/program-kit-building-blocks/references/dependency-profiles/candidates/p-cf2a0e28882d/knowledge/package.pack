    "[Content_Types].xml": "603043d59dee554187eacd0a3dee5070b5b1b540a33b1f079da81f1a28a8fe69",
    "package/services/metadata/core-properties/nuget.psmdcp": "6ef2b328999e65ce2a3f720099a9afaae1ab93a067e0b6ab336a5d02b8a12a0d"
  },
  "facts": {
    "README.md": "# Orbyss.Foundation.Web.Discovery\n\nOptional `IWebShellFeature`, identity `Orbyss.Foundation.Web.Discovery`. Add its NuGet package to the\nconsumer feature/bundle closure and enable that exact identity in the **public root shell only**.\nDo not map root robots/sitemap resources in a tenant/path-prefixed shell: generate per-origin\nprojections instead. It registers no Host middleware and replaces no exception/authentication\nfeatures. Enabling it deliberately exposes the manifest's exact routes anonymously; keep private\napplication endpoints in their own authenticated features. Avoid duplicate route owners.\n\nThe default catalogue reads `web/generated/orbyss-foundation/publication.json` below the content root.\nOverride through shell setting `Foundation:Web:Discovery:OutputDirectory`. Generate with\n`ui_profile.py build`; deploy the manifest and public files as a coherent read-only unit. Invalid\nhashes, duplicate/templated routes, linked/traversing paths, nonpublic visibility, unsupported\ntypes and excessive payloads fail before endpoints are mapped. A catalogue snapshot lasts one\nshell generation. This is not a general static-file middleware or directory browser.\n\nRegister a consumer-owned `IPublicDocumentCatalog` to replace the file adapter. All catalogue\noutput is explicitly public. HEAD/GET are supported; content type and noindex headers are owned\nby this feature. CSP, cache policy, security headers, authentication and exception formatting\nremain the application's selected independent features. The complete public content exists in\nthe initial response; JavaScript is not required for metadata or content retrieval.\n",
    "lib/net10.0/Orbyss.Foundation.Web.Discovery.xml": "<?xml version=\"1.0\"?>\n<doc>\n    <assembly>\n        <name>Orbyss.Foundation.Web.Discovery</name>\n    </assembly>\n    <members>\n        <member name=\"T:Orbyss.Foundation.Web.Discovery.DiscoveryOptions\">\n            <summary>Configures the shell's generated public-content source, relative to the content root.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Web.Discovery.DiscoveryOptions.SectionName\">\n            <summary>Identifies the shell configuration section.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Web.Discovery.DiscoveryOptions.OutputDirectory\">\n            <summary>Gets or sets the generated directory containing publication.json and public/.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Web.Discovery.FilePublicDocumentCatalog\">\n            <summary>Loads a bounded, hash-checked public projection without serving arbitrary files.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Web.Discovery.FilePublicDocumentCatalog.#ctor(System.String,System.String)\">\n            <summary>Loads a bounded, hash-checked public projection without serving arbitrary files.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Web.Discovery.FilePublicDocumentCatalog.ManifestProfile\">\n            <summary>Uses an immutable typed admission profile for the public manifest contract.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Web.Discovery.FilePublicDocumentCatalog.ReadDocuments\">\n            <summary>Reads and validates the whole projection before any route is mapped.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Web.Discovery.FilePublicDocumentCatalog.ValidateRoute(System.String)\">\n            <summary>Rejects route templates, encodings and ambiguous paths for all catalogue adapters.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Web.Discovery.FilePublicDocumentCatalog.ValidateContentType(System.String)\">\n            <summary>Rejects header injection and unsupported response types for all catalogue adapters.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Web.Discovery.FilePublicDocumentCatalog.ResolveInside(System.String,System.String)\">\n            <summary>Resolves only literal descendants, refusing linked ancestors and traversal.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Web.Discovery.FoundationDiscoveryFeature\">\n            <summary>Composes an optional public document projection into one shell, leaving the Host neutral.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Web.Discovery.FoundationDiscoveryFeature.#ctor(CShells.ShellSettings)\">\n            <summary>Composes an optional public document projection into one shell, leaving the Host neutral.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Web.Discovery.FoundationDiscoveryFeature.ConfigureServices(Microsoft.Extensions.DependencyInjection.IServiceCollection)\">\n            <inheritdoc />\n        </member>\n        <member name=\"M:Orbyss.Foundation.Web.Discovery.FoundationDiscoveryFeature.MapEndpoints(Microsoft.AspNetCore.Routing.IEndpointRouteBuilder,Microsoft.Extensions.Hosting.IHostEnvironment)\">\n            <inheritdoc />\n        </member>\n        <member name=\"T:Orbyss.Foundation.Web.Discovery.PublicationManifest\">\n            <summary>Describes the versioned, explicitly public build projection.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Web.Discovery.PublicationManifest.Version\">\n            <summary>Gets or sets the format version.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Web.Discovery.PublicationManifest.Resources\">\n            <summary>Gets or sets the complete literal route allowlist.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Web.Discovery.PublicationResource\">\n            <summary>Describes one hashed file deliberately placed in the public projection.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Web.Discovery.PublicationResource.Route\">\n            <summary>Gets or sets the literal root-relative route.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Web.Discovery.PublicationResource.File\">\n            <summary>Gets or sets the public-relative file location.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Web.Discovery.PublicationResource.ContentType\">\n            <summary>Gets or sets the allowlisted media type.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Web.Discovery.PublicationResource.Sha256\">\n            <summary>Gets or sets the expected SHA-256.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Web.Discovery.PublicationResource.Index\">\n            <summary>Gets or sets explicit indexing permission.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Web.Discovery.PublicationResource.Visibility\">\n            <summary>Gets or sets the explicit public-only visibility marker.</summary>\n        </member>\n    </members>\n</doc>\n",
    "orbyss-foundation/feature.json": "{\n  \"schemaVersion\": 2,\n  \"packageId\": \"Orbyss.Foundation.Web.Discovery\",\n  \"features\": [\n    {\n      \"identity\": \"Orbyss.Foundation.Web.Discovery\",\n      \"featureDependencies\": [],\n      \"runtimeDependencies\": [],\n      \"routes\": [],\n      \"dormant\": true,\n      \"composeForOpenApi\": false,\n      \"requiresContractCoverage\": false,\n      \"dynamicRoutesFromConfiguration\": true\n    }\n  ],\n  \"sourceSha256\": {\n    \"DiscoveryOptions.cs\": \"b4b412263d527c5fe49f4b131ac0ccab4205704f8fd5bcef929b30dc0cb0f2df\",\n    \"FilePublicDocumentCatalog.cs\": \"eeb099b623d5abeeb1f4bf548f7c29b355e2097b4b8aefc6a3689599095ad03b\",\n    \"FoundationDiscoveryFeature.cs\": \"ef974aef9b7022b8baf0861063f3bfa734d961284871d3b509a9275e32ea58d1\",\n    \"PublicationManifest.cs\": \"056f9cbf79cc0471aadb44f3d1eb5d75cca9b10ea6541bbca10864f10d4baa5c\",\n    \"PublicationResource.cs\": \"6136b5f6177846b70c2a9d1fb886ecacbc3ede96f111d26d2c96cf4cb4da58c3\"\n  },\n  \"hostProvidedDependencies\": [\n    {\n      \"packageId\": \"CShells.Abstractions\",\n      \"minimumVersion\": \"0.0.30-preview.159\"\n    },\n    {\n      \"packageId\": \"CShells.AspNetCore.Abstractions\",\n      \"minimumVersion\": \"0.0.30-preview.159\"\n    },\n    {\n      \"packageId\": \"JetBrains.Annotations\",\n      \"minimumVersion\": \"2025.2.4\"\n    }\n  ]\n}\n",
    "orbyss-foundation/settings.json": "{\n  \"schemaVersion\": 2,\n  \"packageId\": \"Orbyss.Foundation.Web.Discovery\",\n  \"packageVersion\": \"0.3.1\",\n  \"sourceSha256\": {\n    \"DiscoveryOptions.cs\": \"b4b412263d527c5fe49f4b131ac0ccab4205704f8fd5bcef929b30dc0cb0f2df\",\n    \"FilePublicDocumentCatalog.cs\": \"eeb099b623d5abeeb1f4bf548f7c29b355e2097b4b8aefc6a3689599095ad03b\",\n    \"FoundationDiscoveryFeature.cs\": \"ef974aef9b7022b8baf0861063f3bfa734d961284871d3b509a9275e32ea58d1\",\n    \"PublicationManifest.cs\": \"056f9cbf79cc0471aadb44f3d1eb5d75cca9b10ea6541bbca10864f10d4baa5c\",\n    \"PublicationResource.cs\": \"6136b5f6177846b70c2a9d1fb886ecacbc3ede96f111d26d2c96cf4cb4da58c3\"\n  },\n  \"contracts\": [\n    {\n      \"schemaVersion\": 2,\n      \"owner\": \"Orbyss.Foundation.Web.Discovery\",\n      \"scope\": \"web-discovery\",\n      \"complete\": true,\n      \"sources\": {\n        \"DiscoveryOptions.cs\": \"b4b412263d527c5fe49f4b131ac0ccab4205704f8fd5bcef929b30dc0cb0f2df\",\n        \"FilePublicDocumentCatalog.cs\": \"eeb099b623d5abeeb1f4bf548f7c29b355e2097b4b8aefc6a3689599095ad03b\",\n        \"FoundationDiscoveryFeature.cs\": \"ef974aef9b7022b8baf0861063f3bfa734d961284871d3b509a9275e32ea58d1\",\n        \"PublicationManifest.cs\": \"056f9cbf79cc0471aadb44f3d1eb5d75cca9b10ea6541bbca10864f10d4baa5c\",\n        \"PublicationResource.cs\": \"6136b5f6177846b70c2a9d1fb886ecacbc3ede96f111d26d2c96cf4cb4da58c3\"\n      },\n      \"settings\": [\n        {\n          \"path\": \"Foundation:Web:Discovery:OutputDirectory\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {},\n          \"binding\": \"Shell configuration binds Foundation:Web:Discovery to DiscoveryOptions; native owner validation admits the resulting values.\",\n          \"precedence\": [\n            \"typed source initializer\",\n            \"ordered shell configuration providers\",\n            \"code configuration registered after binding\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Supported OutputDirectory value owned by DiscoveryOptions.\",\n          \"type\": \"string\",\n          \"default\": \"web/generated/orbyss-foundation\"\n        }\n      ],\n      \"semanticConstraints\": [\n        \"OutputDirectory is relative to application content root and must resolve within it. Native publication/asset admission validates the files when selected at runtime. Metadata export reads only source.\"\n      ],\n      \"appliesTo\": {\n        \"kind\": \"shell\",\n        \"features\": [\n          \"Orbyss.Foundation.Web.Discovery\"\n        ],\n        \"configuration\": [\n          \"Foundation:Web:Discovery\"\n        ]\n      },\n      \"typeName\": \"Orbyss.Foundation.Web.Discovery.DiscoveryOptions\"\n    }\n  ],\n  \"assembly\": {\n    \"name\": \"Orbyss.Foundation.Web.Discovery.dll\",\n    \"sha256\": \"848b07b95f980238daab04fba0fd3b83916b465aaf58c579a1b1a99f8ba7fc9e\"\n  },\n  \"imports\": []\n}\n"
  }
}
