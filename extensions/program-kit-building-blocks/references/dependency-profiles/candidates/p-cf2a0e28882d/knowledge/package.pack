    "lib/net10.0/Orbyss.Foundation.Tasks.Abstractions.xml": "5ff49d274e148a44581eb63570a7f271b83880cd83d9475a68fc71e066a0bfa1",
    "[Content_Types].xml": "70b483c5066b0f062f2102cd8f0c4b2fde9e919b5a9204689dd67e64b0cc518e",
    "package/services/metadata/core-properties/nuget.psmdcp": "0115e814e3947c67d552eec8a9072c8c063e761c4e7a93e16a3439f2ff69d419"
  },
  "facts": {
    "README.md": "# Orbyss.Foundation.Tasks.Abstractions\n\nContracts for startup, background, and recurring work owned by one CShells shell generation.\n\nImplement `IStartupTask`, `IBackgroundTask`, or `IRecurringTask` in a feature package and register it with the\nmatching `AddFoundation*Task<TTask>` extension. Enable the `FoundationTasks` feature in the shell. Startup tasks\nrun in a shell scope before activation completes; background and recurring tasks are cancelled and awaited when\nthat shell generation drains.\n\nDo not register shell work with `AddHostedService`: the Generic Host starts only root-provider hosted services.",
    "lib/net10.0/Orbyss.Foundation.Tasks.Abstractions.xml": "<?xml version=\"1.0\"?>\n<doc>\n    <assembly>\n        <name>Orbyss.Foundation.Tasks.Abstractions</name>\n    </assembly>\n    <members>\n        <member name=\"T:Orbyss.Foundation.Tasks.IBackgroundTask\">\n            <summary>\n            Runs for the lifetime of one shell generation. The returned task must represent the complete operation.\n            </summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Tasks.IBackgroundTask.ExecuteAsync(System.Threading.CancellationToken)\">\n            <summary>Runs the background operation until completion or shell cancellation.</summary>\n            <param name=\"cancellationToken\">Signals that the owning shell generation is stopping.</param>\n            <returns>A task that represents the complete background operation.</returns>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Tasks.IFoundationTask\">\n            <summary>Identifies work owned by one CShells shell generation.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Tasks.IFoundationTask.Id\">\n            <summary>A stable identity used in diagnostics.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Tasks.IRecurringTask\">\n            <summary>Runs periodically for one shell generation and once per host replica.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Tasks.IRecurringTask.Interval\">\n            <summary>Gets the delay between completed recurring executions.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Tasks.IRecurringTask.InitialDelay\">\n            <summary>Gets the delay before the first recurring execution.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Tasks.IRecurringTask.ExecuteAsync(System.Threading.CancellationToken)\">\n            <summary>Runs one occurrence of the recurring operation.</summary>\n            <param name=\"cancellationToken\">Signals that the owning shell generation is stopping.</param>\n            <returns>A task that represents the occurrence.</returns>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Tasks.IStartupTask\">\n            <summary>Runs once while a shell generation is activating.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Tasks.IStartupTask.ExecuteAsync(System.Threading.CancellationToken)\">\n            <summary>Runs the shell startup operation.</summary>\n            <param name=\"cancellationToken\">Signals that shell activation was cancelled.</param>\n            <returns>A task that represents the startup operation.</returns>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Tasks.TaskServiceCollectionExtensions\">\n            <summary>Registers Orbyss Foundation task implementations with a shell service collection.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Tasks.TaskServiceCollectionExtensions.AddFoundationStartupTask``1(Microsoft.Extensions.DependencyInjection.IServiceCollection)\">\n            <summary>Registers a scoped task that runs once during shell activation.</summary>\n            <typeparam name=\"TTask\">The startup-task implementation.</typeparam>\n            <param name=\"services\">The shell service collection.</param>\n            <returns>The supplied service collection.</returns>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Tasks.TaskServiceCollectionExtensions.AddFoundationBackgroundTask``1(Microsoft.Extensions.DependencyInjection.IServiceCollection)\">\n            <summary>Registers a shell-singleton task that runs for the shell generation lifetime.</summary>\n            <typeparam name=\"TTask\">The background-task implementation.</typeparam>\n            <param name=\"services\">The shell service collection.</param>\n            <returns>The supplied service collection.</returns>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Tasks.TaskServiceCollectionExtensions.AddFoundationRecurringTask``1(Microsoft.Extensions.DependencyInjection.IServiceCollection)\">\n            <summary>Registers a shell-singleton task that runs on a recurring interval.</summary>\n            <typeparam name=\"TTask\">The recurring-task implementation.</typeparam>\n            <param name=\"services\">The shell service collection.</param>\n            <returns>The supplied service collection.</returns>\n        </member>\n    </members>\n</doc>\n"
  }
}
{
  "id": "Orbyss.Foundation.Web.Discovery",
