    "[Content_Types].xml": "603043d59dee554187eacd0a3dee5070b5b1b540a33b1f079da81f1a28a8fe69",
    "package/services/metadata/core-properties/nuget.psmdcp": "77abb35c0b0ab8eb48c28e23845d368e4d2d54f4f1f0bb7b4f454afb3c1fc3ad"
