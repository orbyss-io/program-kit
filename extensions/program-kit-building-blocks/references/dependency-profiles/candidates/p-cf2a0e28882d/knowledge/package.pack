882bbda02dab0b7df9869c10240\",\n        \"BffAuthenticatedUserResponse.cs\": \"1544165ebd40a38c628828507ca47aa63520acd0c90c61545a10913683539bc1\",\n        \"BffCookieOptionsValidator.cs\": \"771cf46c1cca7d8297809a40ec0adf3f9f0c6aa3cb2bb6e8c89e05770a0d598b\",\n        \"BffCookieProfileMarker.cs\": \"65cad9fabf6e8cd9ea43d3b8009275b65c618ceba4175ae4433e138deaf9d5b8\",\n        \"BffSignedOutResponse.cs\": \"08b7b279562ae9bdfcaba3d5d3839e09a580f46aac6ef1547a717cdd4b8acd29\",\n        \"BffUserResponse.cs\": \"f455b6ee0a3e392253849d159f88b635b9f46b29c1317bf1f861cfcaa3663538\",\n        \"DistributedTicketStore.cs\": \"73a7283f763cb5375454e45ec44838ed072fdde80e8fc7ee7bfac112d4b06583\",\n        \"FoundationBffCookieFeature.cs\": \"01f1f2b7039a65a504fca2fb3d73eb07ff772406d8b6ff194c645b657d82a00f\",\n        \"PendingValidatedIdentityProjection.cs\": \"0ee050ca083bb0be192442fbf5ff69d48b8de2d76b938b496de5eb2af58406a6\",\n        \"ValidatedIdentityTicketProjection.cs\": \"6effc67087a7ad6819b2ffe6a7647a09636b325186ef5e06561098629b08c403\"\n      },\n      \"settings\": [\n        {\n          \"path\": \"Foundation:Web:Authority\",\n          \"required\": true,\n          \"secret\": false,\n          \"constraints\": {\n            \"format\": \"uri\"\n          },\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the OIDC issuer authority.\",\n          \"type\": \"string\",\n          \"default\": \"\"\n        },\n        {\n          \"path\": \"Foundation:Web:BackchannelAuthority\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {},\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"BackchannelAuthority\",\n          \"type\": \"string\",\n          \"default\": \"\"\n        },\n        {\n          \"path\": \"Foundation:Web:ClientId\",\n          \"required\": true,\n          \"secret\": false,\n          \"constraints\": {\n            \"minLength\": 1\n          },\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the registered OAuth client identifier.\",\n          \"type\": \"string\",\n          \"default\": \"\"\n        },\n        {\n          \"path\": \"Foundation:Web:ClientSecret\",\n          \"required\": true,\n          \"secret\": true,\n          \"constraints\": {},\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the confidential BFF client secret.\",\n          \"type\": \"string\"\n        },\n        {\n          \"path\": \"Foundation:Web:Audience\",\n          \"required\": true,\n          \"secret\": false,\n          \"constraints\": {\n            \"minLength\": 1\n          },\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the protected API audience.\",\n          \"type\": \"string\",\n          \"default\": \"\"\n        },\n        {\n          \"path\": \"Foundation:Web:Scopes\",\n          \"required\": true,\n          \"secret\": false,\n          \"constraints\": {\n            \"minItems\": 1,\n            \"uniqueItems\": true,\n            \"items\": {\n              \"type\": \"string\",\n              \"pattern\": \"^[\\\\x21\\\\x23-\\\\x5B\\\\x5D-\\\\x7E]\\u002B$\"\n            }\n          },\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the scopes requested during interactive authentication. Explicit shell configuration replaces these fallback defaults.\",\n          \"type\": \"array\",\n          \"default\": [\n            \"openid\",\n            \"profile\",\n            \"offline_access\",\n            \"orbyss-foundation-api\"\n          ]\n        },\n        {\n          \"path\": \"Foundation:Web:RoleClaim\",\n          \"required\": true,\n          \"secret\": false,\n          \"constraints\": {\n            \"minLength\": 1\n          },\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the provider claim containing normalized application roles.\",\n          \"type\": \"string\",\n          \"default\": \"roles\"\n        },\n        {\n          \"path\": \"Foundation:Web:PermissionClaim\",\n          \"required\": true,\n          \"secret\": false,\n          \"constraints\": {\n            \"minLength\": 1\n          },\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the canonical claim containing application permission identities.\",\n          \"type\": \"string\",\n          \"default\": \"permissions\"\n        },\n        {\n          \"path\": \"Foundation:Web:RolePermissions\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"additionalProperties\": {\n              \"type\": \"array\",\n              \"minItems\": 1,\n              \"items\": {\n                \"type\": \"string\",\n                \"minLength\": 1\n              }\n            }\n          },\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets provider-role to canonical application-permission mappings.\",\n          \"type\": \"object\",\n          \"default\": {}\n        },\n        {\n          \"path\": \"Foundation:Web:ScopePermissions\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"additionalProperties\": {\n              \"type\": \"array\",\n              \"minItems\": 1,\n              \"items\": {\n                \"type\": \"string\",\n                \"minLength\": 1\n              }\n            }\n          },\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets provider-scope to canonical application-permission mappings.\",\n          \"type\": \"object\",\n          \"default\": {}\n        },\n        {\n          \"path\": \"Foundation:Web:AllowedOrigins\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {},\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the exact origins permitted by the direct SPA profile.\",\n          \"type\": \"array\",\n          \"default\": []\n        },\n        {\n          \"path\": \"Foundation:Web:CallbackPath\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {},\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the local OIDC authorization callback path.\",\n          \"type\": \"string\",\n          \"default\": \"/signin-oidc\"\n        },\n        {\n          \"path\": \"Foundation:Web:SignedOutCallbackPath\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {},\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the local callback path used after provider logout.\",\n          \"type\": \"string\",\n          \"default\": \"/signout-callback-oidc\"\n        },\n        {\n          \"path\": \"Foundation:Web:RemoteSignOutPath\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {},\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the path receiving provider-initiated logout notifications.\",\n          \"type\": \"string\",\n          \"default\": \"/signout-oidc\"\n        },\n        {\n          \"path\": \"Foundation:Web:AccessDeniedPath\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {},\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the interactive access-denied path.\",\n          \"type\": \"string\",\n          \"default\": \"/bff/access-denied\"\n        },\n        {\n          \"path\": \"Foundation:Web:CookieName\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {},\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the host-only encrypted session cookie name.\",\n          \"type\": \"string\",\n          \"default\": \"__Host-orbyss-foundation-session\"\n        },\n        {\n          \"path\": \"Foundation:Web:DiscoveryTimeoutSeconds\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"minimum\": 1,\n            \"maximum\": 30\n          },\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the discovery and JWKS readiness budget in seconds.\",\n          \"type\": \"integer\",\n          \"default\": 3\n        },\n        {\n          \"path\": \"Foundation:Web:RemoteAuthenticationTimeoutSeconds\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {},\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the maximum duration of an interactive remote authentication operation.\",\n          \"type\": \"integer\",\n          \"default\": 10\n        },\n        {\n          \"path\": \"Foundation:Web:SessionIdleMinutes\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"minimum\": 1\n          },\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the sliding server session idle lifetime in minutes.\",\n          \"type\": \"integer\",\n          \"default\": 30\n        },\n        {\n          \"path\": \"Foundation:Web:SessionAbsoluteMinutes\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"minimum\": 1\n          },\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the non-extendable server session lifetime in minutes.\",\n          \"type\": \"integer\",\n          \"default\": 480\n        },\n        {\n          \"path\": \"Foundation:Web:AllowHttpForLocalDevelopment\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {},\n          \"binding\": \"This selected profile contributes validation to the common shell-bound FoundationWebOptions; types and defaults are imported from the exact owning Authentication metadata and native implementation assembly.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets whether loopback/container HTTP is accepted during local development.\",\n          \"type\": \"boolean\",\n          \"default\": false\n        }\n      ],\n      \"semanticConstraints\": [\n        \"ClientSecret must be nonblank for the confidential BFF profile; configured secret values are never emitted.\",\n        \"CallbackPath, SignedOutCallbackPath, RemoteSignOutPath and AccessDeniedPath must be distinct ignoring case and must not replace the fixed BFF session endpoints.\",\n        \"All four callback/access-denied paths must be literal local absolute paths without trailing slash, repeated slash, dot-segments, whitespace/control characters, escaping, query, fragment or route parameters.\",\n        \"Native OIDC/cookie options also validate their protocol-specific requirements; the exporter never starts handlers or contacts identity services.\"\n      ],\n      \"appliesTo\": {\n        \"kind\": \"shell\",\n        \"features\": [\n          \"Orbyss.Foundation.Authentication.BffCookie\"\n        ],\n        \"configuration\": []\n      },\n      \"typeName\": \"Orbyss.Foundation.Authentication.FoundationWebOptions\"\n    }\n  ],\n  \"assembly\": {\n    \"name\": \"Orbyss.Foundation.Authentication.BffCookie.dll\",\n    \"sha256\": \"d518ada6a329988fcca7a2806c72a6af711c1f892b8987a7b455f5e6d93e7b8f\"\n  },\n  \"imports\": [\n    {\n      \"typeName\": \"Orbyss.Foundation.Authentication.FoundationWebOptions\",\n      \"packageId\": \"Orbyss.Foundation.Authentication\",\n      \"packageVersion\": \"0.3.1\",\n      \"scope\": \"web\",\n      \"metadataSha256\": \"c6156f836510d3d869a6ee4b06ccc6dc72eecb79d99579fdab57e1d08f6e692f\",\n      \"assembly\": {\n        \"name\": \"Orbyss.Foundation.Authentication.dll\",\n        \"sha256\": \"9f0a93c7569adc50c29ba6b15fc8781bb6c71f230777e6d1949d5be1cafadc65\"\n      }\n    }\n  ]\n}\n"
