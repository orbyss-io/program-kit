  "payloadFiles": {
    "_rels/.rels": "26c886a189f3f8a8c0594ba60bebad20c185e32aaffbcc446b630af713399d2c",
    "Orbyss.Foundation.Web.HostedPages.nuspec": "f5e9a86993e737d138d853fe6dce9430d563607f650c7aaba2f13a3a2531112f",
    "README.md": "eec41f81b55ae7c23787095ea53abe7276a7d68aa1f4e68d1f5596d637c103f8",
    "lib/net10.0/Orbyss.Foundation.Web.HostedPages.dll": "b7ee090099f0de48150a21ffb7be9505c0a6ba03cfb3e2e1e14ee6abefbbc06f",
    "lib/net10.0/Orbyss.Foundation.Web.HostedPages.xml": "810ec881d246b7f1418de73e11d302ed39c7d6b9685dc76bcf2f18f9442e302e",
