  "facts": {
    "README.md": "# Orbyss.Foundation.Identity.Keycloak.Admin\n\nKeycloak Admin REST adapter split into opt-in CShell features. Portable application workflows use\nthe interfaces from `Orbyss.Foundation.Identity.Admin.Abstractions`; Keycloak-only administration stays\nbehind explicitly named Keycloak interfaces.\n\nAvailable shell features:\n\n- `Orbyss.Foundation.Identity.Keycloak.Admin.Users`\n- `Orbyss.Foundation.Identity.Keycloak.Admin.Applications`\n- `Orbyss.Foundation.Identity.Keycloak.Admin.Scopes`\n- `Orbyss.Foundation.Identity.Keycloak.Admin.Access`\n- `Orbyss.Foundation.Identity.Keycloak.Admin.Enrollment`\n- `Orbyss.Foundation.Identity.Keycloak.Admin.Sessions`\n- `Orbyss.Foundation.Identity.Keycloak.Admin.AuthenticationFlows`\n- `Orbyss.Foundation.Identity.Keycloak.Admin.IdentityProviders`\n- `Orbyss.Foundation.Identity.Keycloak.Admin.Organizations`\n- `Orbyss.Foundation.Identity.Keycloak.Admin.RealmOperations`\n\nConfigure `Foundation:Identity:Keycloak:Admin`. Use a confidential service-account client with only\nthe realm-management permissions required by the enabled features. The adapter intentionally does\nnot support admin username/password authentication.\n",
    "lib/net10.0/Orbyss.Foundation.Identity.Keycloak.Admin.xml": "<?xml version=\"1.0\"?>\n<doc>\n    <assembly>\n        <name>Orbyss.Foundation.Identity.Keycloak.Admin</name>\n    </assembly>\n    <members>\n        <member name=\"T:Orbyss.Foundation.Identity.Keycloak.Admin.AccessToken\">\n            <summary>Holds a Keycloak service-account token and its absolute expiry.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Keycloak.Admin.AccessToken.#ctor(System.String,System.DateTimeOffset)\">\n            <summary>Holds a Keycloak service-account token and its absolute expiry.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Identity.Keycloak.Admin.FoundationKeycloakAccessAdminFeature\">\n            <summary>Composes portable role and group administration backed by Keycloak.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Keycloak.Admin.FoundationKeycloakAccessAdminFeature.#ctor(CShells.ShellSettings)\">\n            <summary>Composes portable role and group administration backed by Keycloak.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Keycloak.Admin.FoundationKeycloakAccessAdminFeature.ConfigureServices(Microsoft.Extensions.DependencyInjection.IServiceCollection)\">\n            <inheritdoc />\n        </member>\n        <member name=\"T:Orbyss.Foundation.Identity.Keycloak.Admin.FoundationKeycloakApplicationsAdminFeature\">\n            <summary>Composes portable application administration backed by Keycloak.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Keycloak.Admin.FoundationKeycloakApplicationsAdminFeature.#ctor(CShells.ShellSettings)\">\n            <summary>Composes portable application administration backed by Keycloak.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Keycloak.Admin.FoundationKeycloakApplicationsAdminFeature.ConfigureServices(Microsoft.Extensions.DependencyInjection.IServiceCollection)\">\n            <inheritdoc />\n        </member>\n        <member name=\"T:Orbyss.Foundation.Identity.Keycloak.Admin.FoundationKeycloakAuthenticationFlowsAdminFeature\">\n            <summary>Composes Keycloak-specific authentication-flow administration.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Keycloak.Admin.FoundationKeycloakAuthenticationFlowsAdminFeature.#ctor(CShells.ShellSettings)\">\n            <summary>Composes Keycloak-specific authentication-flow administration.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Keycloak.Admin.FoundationKeycloakAuthenticationFlowsAdminFeature.ConfigureServices(Microsoft.Extensions.DependencyInjection.IServiceCollection)\">\n            <inheritdoc />\n        </member>\n        <member name=\"T:Orbyss.Foundation.Identity.Keycloak.Admin.FoundationKeycloakEnrollmentAdminFeature\">\n            <summary>Composes portable credential and enrollment administration backed by Keycloak.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Keycloak.Admin.FoundationKeycloakEnrollmentAdminFeature.#ctor(CShells.ShellSettings)\">\n            <summary>Composes portable credential and enrollment administration backed by Keycloak.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Keycloak.Admin.FoundationKeycloakEnrollmentAdminFeature.ConfigureServices(Microsoft.Extensions.DependencyInjection.IServiceCollection)\">\n            <inheritdoc />\n        </member>\n        <member name=\"T:Orbyss.Foundation.Identity.Keycloak.Admin.FoundationKeycloakIdentityProvidersAdminFeature\">\n            <summary>Composes Keycloak-specific identity-provider administration.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Keycloak.Admin.FoundationKeycloakIdentityProvidersAdminFeature.#ctor(CShells.ShellSettings)\">\n            <summary>Composes Keycloak-specific identity-provider administration.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Keycloak.Admin.FoundationKeycloakIdentityProvidersAdminFeature.ConfigureServices(Microsoft.Extensions.DependencyInjection.IServiceCollection)\">\n            <inheritdoc />\n        </member>\n        <member name=\"T:Orbyss.Foundation.Identity.Keycloak.Admin.FoundationKeycloakOrganizationsAdminFeature\">\n            <summary>Composes Keycloak-specific organization administration.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Keycloak.Admin.FoundationKeycloakOrganizationsAdminFeature.#ctor(CShells.ShellSettings)\">\n            <summary>Composes Keycloak-specific organization administration.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Keycloak.Admin.FoundationKeycloakOrganizationsAdminFeature.ConfigureServices(Microsoft.Extensions.DependencyInjection.IServiceCollection)\">\n            <inheritdoc />\n        </member>\n        <member name=\"T:Orbyss.Foundation.Identity.Keycloak.Admin.FoundationKeycloakRealmOperationsFeature\">\n            <summary>Composes explicitly high-privilege Keycloak realm operations.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Keycloak.Admin.FoundationKeycloakRealmOperationsFeature.#ctor(CShells.ShellSettings)\">\n            <summary>Composes explicitly high-privilege Keycloak realm operations.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Keycloak.Admin.FoundationKeycloakRealmOperationsFeature.ConfigureServices(Microsoft.Extensions.DependencyInjection.IServiceCollection)\">\n            <inheritdoc />\n        </member>\n        <member name=\"T:Orbyss.Foundation.Identity.Keycloak.Admin.FoundationKeycloakScopesAdminFeature\">\n            <summary>Composes portable scope and claim-mapping administration backed by Keycloak.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Keycloak.Admin.FoundationKeycloakScopesAdminFeature.#ctor(CShells.ShellSettings)\">\n            <summary>Composes portable scope and claim-mapping administration backed by Keycloak.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Keycloak.Admin.FoundationKeycloakScopesAdminFeature.ConfigureServices(Microsoft.Extensions.DependencyInjection.IServiceCollection)\">\n            <inheritdoc />\n        </member>\n        <member name=\"T:Orbyss.Foundation.Identity.Keycloak.Admin.FoundationKeycloakSessionsAdminFeature\">\n            <summary>Composes portable session administration backed by Keycloak.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Keycloak.Admin.FoundationKeycloakSessionsAdminFeature.#ctor(CShells.ShellSettings)\">\n            <summary>Composes portable session administration backed by Keycloak.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Keycloak.Admin.FoundationKeycloakSessionsAdminFeature.ConfigureServices(Microsoft.Extensions.DependencyInjection.IServiceCollection)\">\n            <inheritdoc />\n        </member>\n        <member name=\"T:Orbyss.Foundation.Identity.Keycloak.Admin.FoundationKeycloakUsersAdminFeature\">\n            <summary>Composes portable user administration backed by Keycloak.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Keycloak.Admin.FoundationKeycloakUsersAdminFeature.#ctor(CShells.ShellSettings)\">\n            <summary>Composes portable user administration backed by Keycloak.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Keycloak.Admin.FoundationKeycloakUsersAdminFeature.ConfigureServices(Microsoft.Extensions.DependencyInjection.IServiceCollection)\">\n            <inheritdoc />\n        </member>\n        <member name=\"T:Orbyss.Foundation.Identity.Keycloak.Admin.IKeycloakAuthenticationFlowAdministration\">\n            <summary>Keycloak-specific authentication-flow administration.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Keycloak.Admin.IKeycloakAuthenticationFlowAdministration.GetFlowsAsync(System.Threading.CancellationToken)\">\n            <summary>Gets every authentication flow in the configured realm.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Keycloak.Admin.IKeycloakAuthenticationFlowAdministration.CreateFlowAsync(System.String,System.String,System.String,System.Boolean,System.Threading.CancellationToken)\">\n            <summary>Creates a top-level or nested authentication flow and returns its identifier.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Keycloak.Admin.IKeycloakAuthenticationFlowAdministration.CopyFlowAsync(System.String,System.String,System.Threading.CancellationToken)\">\n            <summary>Copies an authentication flow under a new name and returns its identifier.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Keycloak.Admin.IKeycloakAuthenticationFlowAdministration.DeleteFlowAsync(System.String,System.Threading.CancellationToken)\">\n            <summary>Deletes an authentication flow by identifier.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Keycloak.Admin.IKeycloakAuthenticationFlowAdministration.GetExecutionsAsync(System.String,System.Threading.CancellationToken)\">\n            <summary>Gets the execution tree for an authentication-flow alias.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Keycloak.Admin.IKeycloakAuthenticationFlowAdministration.AddExecutionAsync(System.String,System.String,System.Threading.CancellationToken)\">\n            <summary>Adds an authenticator execution to a flow and returns its identifier.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Keycloak.Admin.IKeycloakAuthenticationFlowAdministration.UpdateExecutionAsync(System.String,System.Text.Json.JsonElement,System.Threading.CancellationToken)\">\n            <summary>Updates the requirement and settings represented by a flow execution.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Identity.Keycloak.Admin.IKeycloakIdentityProviderAdministration\">\n            <summary>Keycloak-specific external identity-provider and mapper administration.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Keycloak.Admin.IKeycloakIdentityProviderAdministration.GetAllAsync(System.Threading.CancellationToken)\">\n            <summary>Gets all external identity-provider representations.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Keycloak.Admin.IKeycloakIdentityProviderAdministration.GetAsync(System.String,System.Threading.CancellationToken)\">\n            <summary>Gets an external provider by alias, or returns null when absent.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Keycloak.Admin.IKeycloakIdentityProviderAdministration.CreateAsync(System.Text.Json.JsonElement,System.Threading.CancellationToken)\">\n            <summary>Creates an external identity provider and returns its identifier.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Keycloak.Admin.IKeycloakIdentityProviderAdministration.UpdateAsync(System.String,System.Text.Json.JsonElement,System.Threading.CancellationToken)\">\n            <summary>Updates an external identity provider by alias.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Keycloak.Admin.IKeycloakIdentityProviderAdministration.DeleteAsync(System.String,System.Threading.CancellationToken)\">\n            <summary>Deletes an external identity provider by alias.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Keycloak.Admin.IK