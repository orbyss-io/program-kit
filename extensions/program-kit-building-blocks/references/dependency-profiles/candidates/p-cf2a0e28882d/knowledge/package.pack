    "lib/net10.0/Orbyss.Foundation.DomainEvents.Abstractions.xml": "5e2c64a84f96fca60c47500a67d1d0ba75bed817fdd20ab9574014ce1d8cf59c",
    "[Content_Types].xml": "70b483c5066b0f062f2102cd8f0c4b2fde9e919b5a9204689dd67e64b0cc518e",
    "package/services/metadata/core-properties/nuget.psmdcp": "4503367df209a4ff120201d75843f259606c27b7769768173ed26c50d710d937"
  },
  "facts": {
    "README.md": "# Orbyss.Foundation.DomainEvents.Abstractions\n\nThis package defines awaited, typed, in-process domain-event publication for Orbyss Foundation features.\nDomain-owned `.Core` projects may reference it without depending on the dispatcher implementation,\nCShells, persistence, transport, or a message broker.\n\nDomain events are immutable past-tense business facts. They are not durable integration messages.\nDo not use this package to promise post-commit, cross-process, retryable, or exactly-once delivery.\nThose requirements belong to the separately governed Integration Events capability and a durable\noutbox implementation.\n\nActivatable packages implement the relevant `IDomainEventHandler<TEvent>` contracts and register\nthem with their own feature composition. They do not reference the concrete dispatcher package;\n`shells.json` activates that runtime implementation independently.\n\nHandlers must be independent. Registration order is not a business workflow contract; use an\nexplicit orchestrator when actions require ordering, returned results, compensation, or lifecycle\nstate.\n",
    "lib/net10.0/Orbyss.Foundation.DomainEvents.Abstractions.xml": "<?xml version=\"1.0\"?>\n<doc>\n    <assembly>\n        <name>Orbyss.Foundation.DomainEvents.Abstractions</name>\n    </assembly>\n    <members>\n        <member name=\"T:Orbyss.Foundation.DomainEvents.DomainEventContext\">\n            <summary>Provides delivery metadata without contaminating the domain-owned event contract.</summary>\n            <param name=\"DispatchId\">Identifies the complete top-level dispatch including nested events.</param>\n            <param name=\"PublicationId\">Identifies this individual publication.</param>\n            <param name=\"CausationId\">Identifies the publication whose handler emitted this nested event.</param>\n            <param name=\"PublishedAt\">Records when in-process publication started.</param>\n            <param name=\"Depth\">Records zero-based nested publication depth.</param>\n        </member>\n        <member name=\"M:Orbyss.Foundation.DomainEvents.DomainEventContext.#ctor(System.Guid,System.Guid,System.Nullable{System.Guid},System.DateTimeOffset,System.Int32)\">\n            <summary>Provides delivery metadata without contaminating the domain-owned event contract.</summary>\n            <param name=\"DispatchId\">Identifies the complete top-level dispatch including nested events.</param>\n            <param name=\"PublicationId\">Identifies this individual publication.</param>\n            <param name=\"CausationId\">Identifies the publication whose handler emitted this nested event.</param>\n            <param name=\"PublishedAt\">Records when in-process publication started.</param>\n            <param name=\"Depth\">Records zero-based nested publication depth.</param>\n        </member>\n        <member name=\"P:Orbyss.Foundation.DomainEvents.DomainEventContext.DispatchId\">\n            <summary>Identifies the complete top-level dispatch including nested events.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.DomainEvents.DomainEventContext.PublicationId\">\n            <summary>Identifies this individual publication.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.DomainEvents.DomainEventContext.CausationId\">\n            <summary>Identifies the publication whose handler emitted this nested event.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.DomainEvents.DomainEventContext.PublishedAt\">\n            <summary>Records when in-process publication started.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.DomainEvents.DomainEventContext.Depth\">\n            <summary>Records zero-based nested publication depth.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.DomainEvents.IDomainEvent\">\n            <summary>Marks an immutable business fact for awaited in-process publication.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.DomainEvents.IDomainEventHandler`1\">\n            <summary>Handles one in-process domain-event type.</summary>\n            <typeparam name=\"TEvent\">The domain-owned event type.</typeparam>\n        </member>\n        <member name=\"M:Orbyss.Foundation.DomainEvents.IDomainEventHandler`1.HandleAsync(`0,Orbyss.Foundation.DomainEvents.DomainEventContext,System.Threading.CancellationToken)\">\n            <summary>Handles a published business fact in the current operation scope.</summary>\n            <param name=\"domainEvent\">The immutable domain event.</param>\n            <param name=\"context\">Technical metadata for this publication.</param>\n            <param name=\"cancellationToken\">Signals cancellation of the publishing operation.</param>\n            <returns>A task that completes when handling has finished.</returns>\n        </member>\n        <member name=\"T:Orbyss.Foundation.DomainEvents.IDomainEventPublisher\">\n            <summary>Publishes domain events to awaited handlers in the current process and scope.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.DomainEvents.IDomainEventPublisher.PublishAsync``1(``0,System.Threading.CancellationToken)\">\n            <summary>Publishes a business fact without providing durability or cross-process delivery.</summary>\n            <typeparam name=\"TEvent\">The domain-owned event type.</typeparam>\n            <param name=\"domainEvent\">The immutable domain event.</param>\n            <param name=\"cancellationToken\">Signals cancellation of the publishing operation.</param>\n            <returns>A task that completes after every handler has completed.</returns>\n        </member>\n    </members>\n</doc>\n"
  }
}
