  "facts": {
    "README.md": "# Orbyss Foundation Execution\n\nRegisters a replaceable `TimeProvider` and `IExecutionDeadlineFactory`. Dispose each operation deadline\nand each stage. Remaining time uses monotonic timestamps; UTC clock adjustments do not extend an operation.\nEvery stage is capped by the outer remaining time, including retries. Caller cancellation is reported by\nthe token; `IsExpired` identifies time expiry separately. Disposing a deadline cancels its owned stages.\nThese mechanisms do not map cancellation to rollback, commit certainty or application outcomes.\n",
    "lib/net10.0/Orbyss.Foundation.Execution.xml": "<?xml version=\"1.0\"?>\n<doc>\n    <assembly>\n        <name>Orbyss.Foundation.Execution</name>\n    </assembly>\n    <members>\n        <member name=\"T:Orbyss.Foundation.Execution.ExecutionDeadline\">\n            <summary>Owns its expiry timer and linked cancellation sources; remaining time is monotonic.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Execution.ExecutionDeadline.timeProvider\">\n            <summary>The injected timestamp and timer authority.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Execution.ExecutionDeadline.started\">\n            <summary>The monotonic timestamp captured when this stage begins.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Execution.ExecutionDeadline.duration\">\n            <summary>The stage's immutable local cap.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Execution.ExecutionDeadline.parent\">\n            <summary>The parent retains the complete operation budget.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Execution.ExecutionDeadline.expiry\">\n            <summary>Owns timer-driven local expiry.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Execution.ExecutionDeadline.cancellation\">\n            <summary>Combines caller/parent cancellation and local expiry.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Execution.ExecutionDeadline.disposed\">\n            <summary>Guards single disposal and rejects new stages after closure.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Execution.ExecutionDeadline.#ctor(System.TimeProvider,System.TimeSpan,System.Threading.CancellationToken,Orbyss.Foundation.Execution.Core.IExecutionDeadline)\">\n            <summary>Creates a stage linked to its caller without altering any parent deadline.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Execution.ExecutionDeadline.Token\">\n            <inheritdoc />\n        </member>\n        <member name=\"P:Orbyss.Foundation.Execution.ExecutionDeadline.Remaining\">\n            <inheritdoc />\n        </member>\n        <member name=\"P:Orbyss.Foundation.Execution.ExecutionDeadline.IsExpired\">\n            <inheritdoc />\n        </member>\n        <member name=\"M:Orbyss.Foundation.Execution.ExecutionDeadline.BeginStage(System.TimeSpan,System.Threading.CancellationToken)\">\n            <inheritdoc />\n        </member>\n        <member name=\"M:Orbyss.Foundation.Execution.ExecutionDeadline.Dispose\">\n            <inheritdoc />\n        </member>\n        <member name=\"T:Orbyss.Foundation.Execution.FoundationExecutionFeature\">\n            <summary>Registers independently selected deadline mechanics for a shell.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Execution.FoundationExecutionFeature.ConfigureServices(Microsoft.Extensions.DependencyInjection.IServiceCollection)\">\n            <inheritdoc />\n        </member>\n        <member name=\"T:Orbyss.Foundation.Execution.FoundationExecutionServiceCollectionExtensions\">\n            <summary>Registers a replaceable clock and deadline factory without process-global configuration.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Execution.FoundationExecutionServiceCollectionExtensions.AddFoundationExecution(Microsoft.Extensions.DependencyInjection.IServiceCollection)\">\n            <summary>Adds the owned TimeProvider deadline implementation to a provider.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Execution.TimeProviderDeadlineFactory\">\n            <summary>Creates monotonic deadlines using one injected clock and its timer implementation.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Execution.TimeProviderDeadlineFactory.#ctor(System.TimeProvider)\">\n            <summary>Creates monotonic deadlines using one injected clock and its timer implementation.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Execution.TimeProviderDeadlineFactory.Create(System.TimeSpan,System.Threading.CancellationToken)\">\n            <inheritdoc />\n        </member>\n    </members>\n</doc>\n",
    "orbyss-foundation/feature.json": "{\n  \"schemaVersion\": 2,\n  \"packageId\": \"Orbyss.Foundation.Execution\",\n  \"features\": [\n    {\n      \"identity\": \"Orbyss.Foundation.Execution\",\n      \"featureDependencies\": [],\n      \"runtimeDependencies\": [],\n      \"routes\": [],\n      \"dormant\": true,\n      \"composeForOpenApi\": false,\n      \"requiresContractCoverage\": false\n    }\n  ],\n  \"sourceSha256\": {\n    \"ExecutionDeadline.cs\": \"33e45ae9b5d16219c12ac9b0b3ade782e894e1687d2f0d8a3a55adb2cfe5f483\",\n    \"FoundationExecutionFeature.cs\": \"76ddb2fc2801c86b5aa283e4bfa5cf7515bc1083432e4507e6346922599dce9e\",\n    \"FoundationExecutionServiceCollectionExtensions.cs\": \"ff11c40c9087b95ba9fa56e8a373a010c61c3c87276752c739bbc1b96d0b01a9\",\n    \"TimeProviderDeadlineFactory.cs\": \"3695cc52ba6fd6f51723b92aae9dd1b8c5b42b8c691243f94a31276eda4b4d3e\"\n  },\n  \"hostProvidedDependencies\": [\n    {\n      \"packageId\": \"CShells.Abstractions\",\n      \"minimumVersion\": \"0.0.30-preview.159\"\n    },\n    {\n      \"packageId\": \"JetBrains.Annotations\",\n      \"minimumVersion\": \"2025.2.4\"\n    },\n    {\n      \"packageId\": \"Microsoft.Extensions.Configuration.Abstractions\",\n      \"minimumVersion\": \"10.0.0\"\n    },\n    {\n      \"packageId\": \"Microsoft.Extensions.Configuration\",\n      \"minimumVersion\": \"10.0.0\"\n    },\n    {\n      \"packageId\": \"Microsoft.Extensions.DependencyInjection.Abstractions\",\n      \"minimumVersion\": \"10.0.12\"\n    },\n    {\n      \"packageId\": \"Microsoft.Extensions.Options\",\n      \"minimumVersion\": \"10.0.0\"\n    },\n    {\n      \"packageId\": \"Microsoft.Extensions.Primitives\",\n      \"minimumVersion\": \"10.0.0\"\n    }\n  ]\n}\n"
  }
}
