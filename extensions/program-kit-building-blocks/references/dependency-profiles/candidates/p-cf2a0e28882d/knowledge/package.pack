    "lib/net10.0/Orbyss.Foundation.Identity.Admin.Abstractions.xml": "34990626bb136815069fe04e14c31f9ee481fc46d8ddf0f7218b7c36997b39b2",
    "[Content_Types].xml": "70b483c5066b0f062f2102cd8f0c4b2fde9e919b5a9204689dd67e64b0cc518e",
