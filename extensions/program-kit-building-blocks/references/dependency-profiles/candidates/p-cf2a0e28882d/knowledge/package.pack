  "facts": {
    "README.md": "# Orbyss.Foundation.Authentication.TokenExchange\n\nProvider-neutral OAuth 2.0 Token Exchange (RFC 8693) packaged as a CShells feature. It supports\nnamed token endpoints, resource/audience downscoping, exact scopes, and optional actor tokens. The\nservice exposes the standard wire contract and keeps provider-specific enablement or policy in the\nselected identity adapter.\n\nApplication code requests delegation through `ITokenExchangeService`; it never constructs a\nprovider realm URL or depends on a provider SDK.\n",
    "lib/net10.0/Orbyss.Foundation.Authentication.TokenExchange.xml": "<?xml version=\"1.0\"?>\n<doc>\n    <assembly>\n        <name>Orbyss.Foundation.Authentication.TokenExchange</name>\n    </assembly>\n    <members>\n        <member name=\"T:Orbyss.Foundation.Authentication.TokenExchange.FoundationTokenExchangeFeature\">\n            <summary>Composes provider-neutral OAuth token exchange into one shell.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.TokenExchange.FoundationTokenExchangeFeature.#ctor(CShells.ShellSettings)\">\n            <summary>Composes provider-neutral OAuth token exchange into one shell.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.TokenExchange.FoundationTokenExchangeFeature.ConfigureServices(Microsoft.Extensions.DependencyInjection.IServiceCollection)\">\n            <inheritdoc />\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.TokenExchange.ITokenExchangeService\">\n            <summary>Exchanges subject and optional actor tokens through named RFC 8693 policies.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.TokenExchange.ITokenExchangeService.ExchangeAsync(System.String,Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeRequest,System.Threading.CancellationToken)\">\n            <summary>Performs one bounded, non-cached token exchange.</summary>\n            <param name=\"registration\">The exact configured exchange-policy name.</param>\n            <param name=\"request\">The standards-based exchange request.</param>\n            <param name=\"cancellationToken\">Cancels token-endpoint I/O.</param>\n            <returns>The issued token and its server-provided metadata.</returns>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeOptions\">\n            <summary>Defines named provider-neutral RFC 8693 token-exchange registrations.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeOptions.SectionName\">\n            <summary>Gets the configuration section containing token-exchange registrations.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeOptions.Registrations\">\n            <summary>Gets registrations keyed by an application-owned exchange-policy name.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeOptionsValidator\">\n            <summary>Rejects incomplete or unsafe token-exchange registrations.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeOptionsValidator.#ctor(Microsoft.Extensions.Hosting.IHostEnvironment)\">\n            <summary>Rejects incomplete or unsafe token-exchange registrations.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeOptionsValidator.Validate(System.String,Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeOptions)\">\n            <inheritdoc />\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeOptionsValidator.ValidateEndpoint(System.String,System.Boolean,System.String,System.Collections.Generic.ICollection{System.String})\">\n            <summary>Validates transport and URI constraints for one token endpoint.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeOptionsValidator.Require(System.String,System.String,System.Collections.Generic.ICollection{System.String})\">\n            <summary>Adds a path-specific validation failure for a missing value.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeRegistration\">\n            <summary>Configures one OAuth RFC 8693 token-exchange client.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeRegistration.TokenEndpoint\">\n            <summary>Gets or sets the absolute OAuth token endpoint.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeRegistration.ClientId\">\n            <summary>Gets or sets the OAuth client identifier performing exchange.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeRegistration.ClientSecret\">\n            <summary>Gets or sets the OAuth client secret supplied by a deployment secret provider.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeRegistration.ClientAuthenticationMethod\">\n            <summary>Gets or sets `client_secret_basic` or `client_secret_post`.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeRegistration.TimeoutSeconds\">\n            <summary>Gets or sets the token-endpoint request timeout, in seconds.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeRegistration.AllowHttpForLocalDevelopment\">\n            <summary>Gets or sets whether loopback HTTP is accepted during local development.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeRequest\">\n            <summary>Defines one standards-based OAuth token-exchange request.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeRequest.SubjectToken\">\n            <summary>Gets or sets the token representing the subject being delegated.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeRequest.SubjectTokenType\">\n            <summary>Gets or sets the URI identifying the subject-token type.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeRequest.RequestedTokenType\">\n            <summary>Gets or sets the requested output-token type URI.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeRequest.Audience\">\n            <summary>Gets or sets an optional logical target audience.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeRequest.Resource\">\n            <summary>Gets or sets an optional absolute target resource URI.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeRequest.Scopes\">\n            <summary>Gets or sets exact scopes used to downscope the exchanged token.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeRequest.ActorToken\">\n            <summary>Gets or sets an optional token representing the acting party.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeRequest.ActorTokenType\">\n            <summary>Gets or sets the URI identifying the actor-token type.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeResult\">\n            <summary>Represents a successful RFC 8693 token-exchange result.</summary>\n            <param name=\"AccessToken\">The opaque issued token.</param>\n            <param name=\"IssuedTokenType\">The URI identifying the issued token type.</param>\n            <param name=\"TokenType\">The authorization scheme for an issued access token.</param>\n            <param name=\"ExpiresAt\">The local absolute expiry when the server supplied a lifetime.</param>\n            <param name=\"Scopes\">The exact scopes returned by the authorization server.</param>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeResult.#ctor(System.String,System.String,System.String,System.Nullable{System.DateTimeOffset},System.Collections.Generic.IReadOnlyList{System.String})\">\n            <summary>Represents a successful RFC 8693 token-exchange result.</summary>\n            <param name=\"AccessToken\">The opaque issued token.</param>\n            <param name=\"IssuedTokenType\">The URI identifying the issued token type.</param>\n            <param name=\"TokenType\">The authorization scheme for an issued access token.</param>\n            <param name=\"ExpiresAt\">The local absolute expiry when the server supplied a lifetime.</param>\n            <param name=\"Scopes\">The exact scopes returned by the authorization server.</param>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeResult.AccessToken\">\n            <summary>The opaque issued token.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeResult.IssuedTokenType\">\n            <summary>The URI identifying the issued token type.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeResult.TokenType\">\n            <summary>The authorization scheme for an issued access token.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeResult.ExpiresAt\">\n            <summary>The local absolute expiry when the server supplied a lifetime.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeResult.Scopes\">\n            <summary>The exact scopes returned by the authorization server.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeService\">\n            <summary>Performs standards-based OAuth token exchange without provider coupling.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeService.#ctor(System.Net.Http.IHttpClientFactory,Microsoft.Extensions.Options.IOptions{Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeOptions},System.TimeProvider)\">\n            <summary>Performs standards-based OAuth token exchange without provider coupling.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeService.HttpClientName\">\n            <summary>Names the isolated HTTP client used for token-exchange traffic.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeService.ExchangeAsync(System.String,Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeRequest,System.Threading.CancellationToken)\">\n            <inheritdoc />\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeService.ValidateRequest(Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeRequest)\">\n            <summary>Validates paired actor fields and exact RFC request values before any I/O.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeService.CreateMessage(Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeRegistration,Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeRequest)\">\n            <summary>Creates one authenticated RFC 8693 form request.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeService.ReadResult(System.Text.Json.JsonElement)\">\n            <summary>Projects a successful standard token-exchange response.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeService.Add(System.Collections.Generic.ICollection{System.Collections.Generic.KeyValuePair{System.String,System.String}},System.String,System.String)\">\n            <summary>Adds a non-empty optional form field.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeService.RequireAbsoluteUri(System.String,System.String)\">\n            <summary>Requires an absolute URI token-type identifier.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeService.RequiredString(System.Text.Json.JsonElement,System.String)\">\n            <summary>Reads one required non-empty string from a successful response.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeService.FormEncode(System.String)\">\n            <summary>Encodes a client credential for the OAuth HTTP Basic convention.</summary>\n        </member>\n    </members>\n</doc>\n",
    "orbyss-foundation/feature.json": "{\n  \"schemaVersion\": 2,\n  \"packageId\": \"Orbyss.Foundation.Authentication.TokenExchange\",\n  \"features\": [\n    {\n      \"identity\": \"Orbyss.Foundation.Authentication.TokenExchange\",\n      \"featureDependencies\": [],\n      \"runtimeDependencies\": [],\n      \"routes\": [],\n      \"dormant\": true,\n      \"composeForOpenApi\": false,\n      \"requiresContractCoverage\": false\n    }\n  ],\n  \"sourceSha256\": {\n    \"FoundationTokenExchangeFeature.cs\": \"0e9a36fe79df7ae98d3e48579a2ba1fd623f78c78fd4d0aa5bdff6e888c32202\",\n    \"ITokenExchangeService.cs\": \"00cab2e4100e07129d47d85938958d10d982a2460cd61e08884b3ac7dd8a2f8c\",\n    \"TokenExchangeOptions.cs\": \"92a61da16435cb9c4c88e24f636bfebf78d4f436182c49dc0cff31397a769b15\",\n    \"TokenExchangeOptionsValidator.cs\": \"ed62ceafbb08b8e77da08070bf4ab2124b8e18d8d391e86163e1ade9b59923b7\",\n    \"TokenExchangeRegistration.cs\": \"6ca7f579c582404661c4c78f4dc94b0bf1c261457c5951755d399c5d7ad1be1d\",\n    \"TokenExchangeRequest.cs\": \"d2b5c61d6a563f1725567fb9280d1edc82f83d5fc76211eaa4344a52f489f470\",\n    \"TokenExchangeResult.cs\": \"bd30fdf96437c253e43203bac0eb0797a2d2cf874fdaa17aff73fd7177be42dd\",\n    \"TokenExchangeService.cs\": \"7a4a42be8fd0001eee2f459f158428effe53c81d455072b392598460bf3276e3\"\n  },\n  \"hostProvidedDependencies\": [\n    {\n      \"packageId\": \"CShells.Abstractions\",\n      \"minimumVersion\": \"0.0.30-preview.159\"\n    },\n    {\n      \"packageId\": \"JetBrains.Annotations\",\n      \"minimumVersion\": \"2025.2.4\"\n    }\n  ]\n}\n",
    "orbyss-foundation/settings.json": "{\n  \"schemaVersion\": 2,\n  \"packageId\": \"Orbyss.Foundation.Authentication.TokenExchange\",\n  \"packageVersion\": \"0.3.1\",\n  \"sourceSha256\": {\n    \"FoundationTokenExchangeFeature.cs\": \"0e9a36fe79df7ae98d3e48579a2ba1fd623f78c78fd4d0aa5bdff6e888c32202\",\n    \"ITokenExchangeService.cs\": \"00cab2e4100e07129d47d85938958d10d982a2460cd61e08884b3ac7dd8a2f8c\",\n    \"TokenExchangeOptions.cs\": \"92a61da16435cb9c4c88e24f636bfebf78d4f436182c49dc0cff31397a769b15\",\n    \"TokenExchangeOptionsValidator.cs\": \"ed62ceafbb08b8e77da08070bf4ab2124b8e18d8d391e86163e1ade9b59923b7\",\n    \"TokenExchangeRegistration.cs\": \"6ca7f579c582404661c4c78f4dc94b0bf1c261457c5951755d399c5d7ad1be1d\",\n    \"TokenExchangeRequest.cs\": \"d2b5c61d6a563f1725567fb9280d1edc82f83d5fc76211eaa4344a52f489f470\",\n    \"TokenExchangeResult.cs\": \"bd30fdf96437c253e43203bac0eb0797a2d2cf874fdaa17aff73fd7177be42dd\",\n    \"TokenExchangeService.cs\": \"7a4a42be8fd0001eee2f459f158428effe53c81d455072b392598460bf3276e3\"\n  },\n  \"contracts\": [\n    {\n      \"schemaVersion\": 2,\n      \"owner\": \"Orbyss.Foundation.Authentication.TokenExchange\",\n      \"scope\": \"token-exchange\",\n      \"complete\": true,\n      \"sources\": {\n        \"FoundationTokenExchangeFeature.cs\": \"0e9a36fe79df7ae98d3e48579a2ba1fd623f78c78fd4d0aa5bdff6e888c32202\",\n        \"ITokenExchangeService.cs\": \"00cab2e4100e07129d47d85938958d10d982a2460cd61e08884b3ac7dd8a2f8c\",\n        \"TokenExchangeOptions.cs\": \"92a61da16435cb9c4c88e24f636bfebf78d4f436182c49dc0cff31397a769b15\",\n        \"TokenExchangeOptionsValidator.cs\": \"ed62ceafbb08b8e77da08070bf4ab2124b8e18d8d391e86163e1ade9b59923b7\",\n        \"TokenExchangeRegistration.cs\": \"6ca7f579c582404661c4c78f4dc94b0bf1c261457c5951755d399c5d7ad1be1d\",\n        \"TokenExchangeRequest.cs\": \"d2b5c61d6a563f1725567fb9280d1edc82f83d5fc76211eaa4344a52f489f470\",\n        \"TokenExchangeResult.cs\": \"bd30fdf96437c253e43203bac0eb0797a2d2cf874fdaa17aff73fd7177be42dd\",\n        \"TokenExchangeService.cs\": \"7a4a42be8fd0001eee2f459f158428effe53c81d455072b392598460bf3276e3\"\n      },\n      \"settings\": [\n        {\n          \"path\": \"Foundation:Authentication:TokenExchange:Registrations\",\n          \"required\": true,\n          \"secret\": false,\n          \"constraints\": {\n            \"minProperties\": 1\n          },\n          \"binding\": \"The selected shell feature binds this section from ShellSettings.GetConfigurationRoot using the native .NET configuration binder. Options are consumed within that shell provider generation; recompose/restart the shell to replace cached options.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets registrations keyed by an application-owned exchange-policy name.\",\n          \"type\": \"object\",\n          \"default\": {}\n        }\n      ],\n      \"semanticConstraints\": [\n        \"Endpoints/base addresses must be absolute HTTPS without query/fragment. Loopback HTTP is accepted only in Development with the explicit development override.\",\n        \"Named registration keys must not be blank and are compared ordinally.\",\n        \"Required string settings must not be empty or whitespace.\",\n        \"Configuration is metadata only; token clients and downstream requests are never initialized or executed by export.\"\n      ],\n      \"appliesTo\": {\n        \"kind\": \"shell\",\n        \"features\": [\n          \"Orbyss.Foundation.Authentication.TokenExchange\"\n        ],\n        \"configuration\": [\n          \"Foundation:Authentication:TokenExchange\"\n        ]\n      },\n      \"typeName\": \"Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeOptions\"\n    },\n    {\n      \"schemaVersion\": 2,\n      \"owner\": \"Orbyss.Foundation.Authentication.TokenExchange\",\n      \"scope\": \"token-exchange-registration\",\n      \"complete\": true,\n      \"sources\": {\n        \"FoundationTokenExchangeFeature.cs\": \"0e9a36fe79df7ae98d3e48579a2ba1fd623f78c78fd4d0aa5bdff6e888c32202\",\n        \"ITokenExchangeService.cs\": \"00cab2e4100e07129d47d85938958d10d982a2460cd61e08884b3ac7dd8a2f8c\",\n        \"TokenExchangeOptions.cs\": \"92a61da16435cb9c4c88e24f636bfebf78d4f436182c49dc0cff31397a769b15\",\n        \"TokenExchangeOptionsValidator.cs\": \"ed62ceafbb08b8e77da08070bf4ab2124b8e18d8d391e86163e1ade9b59923b7\",\n        \"TokenExchangeRegistration.cs\": \"6ca7f579c582404661c4c78f4dc94b0bf1c261457c5951755d399c5d7ad1be1d\",\n        \"TokenExchangeRequest.cs\": \"d2b5c61d6a563f1725567fb9280d1edc82f83d5fc76211eaa4344a52f489f470\",\n        \"TokenExchangeResult.cs\": \"bd30fdf96437c253e43203bac0eb0797a2d2cf874fdaa17aff73fd7177be42dd\",\n        \"TokenExchangeService.cs\": \"7a4a42be8fd0001eee2f459f158428effe53c81d455072b392598460bf3276e3\"\n      },\n      \"settings\": [\n        {\n          \"path\": \"Foundation:Authentication:TokenExchange:Registrations:*:TokenEndpoint\",\n          \"required\": true,\n          \"secret\": false,\n          \"constraints\": {\n            \"format\": \"uri\"\n          },\n          \"binding\": \"The selected shell feature binds this section from ShellSettings.GetConfigurationRoot using the native .NET configuration binder. Options are consumed within that shell provider generation; recompose/restart the shell to replace cached options.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the absolute OAuth token endpoint.\",\n          \"type\": \"string\",\n          \"default\": \"\"\n        },\n        {\n          \"path\": \"Foundation:Authentication:TokenExchange:Registrations:*:ClientId\",\n          \"required\": true,\n          \"secret\": false,\n          \"constraints\": {\n            \"minLength\": 1\n          },\n          \"binding\": \"The selected shell feature binds this section from ShellSettings.GetConfigurationRoot using the native .NET configuration binder. Options are consumed within that shell provider generation; recompose/restart the shell to replace cached options.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the OAuth client identifier performing exchange.\",\n          \"type\": \"string\",\n          \"default\": \"\"\n        },\n        {\n          \"path\": \"Foundation:Authentication:TokenExchange:Registrations:*:ClientSecret\",\n          \"required\": true,\n          \"secret\": true,\n          \"constraints\": {},\n          \"binding\": \"The selected shell feature binds this section from ShellSettings.GetConfigurationRoot using the native .NET configuration binder. Options are consumed within that shell provider generation; recompose/restart the shell to replace cached options.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the OAuth client secret supplied by a deployment secret provider.\",\n          \"type\": \"string\"\n        },\n        {\n          \"path\": \"Foundation:Authentication:TokenExchange:Registrations:*:ClientAuthenticationMethod\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"enum\": [\n              \"client_secret_basic\",\n              \"client_secret_post\"\n            ]\n          },\n          \"binding\": \"The selected shell feature binds this section from ShellSettings.GetConfigurationRoot using the native .NET configuration binder. Options are consumed within that shell provider generation; recompose/restart the shell to replace cached options.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets \\u0060client_secret_basic\\u0060 or \\u0060client_secret_post\\u0060.\",\n          \"type\": \"string\",\n          \"default\": \"client_secret_basic\"\n        },\n        {\n          \"path\": \"Foundation:Authentication:TokenExchange:Registrations:*:TimeoutSeconds\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"minimum\": 1,\n            \"maximum\": 60\n          },\n          \"binding\": \"The selected shell feature binds this section from ShellSettings.GetConfigurationRoot using the native .NET configuration binder. Options are consumed within that shell provider generation; recompose/restart the shell to replace cached options.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the token-endpoint request timeout, in seconds.\",\n          \"type\": \"integer\",\n          \"default\": 10\n        },\n        {\n          \"path\": \"Foundation:Authentication:TokenExchange:Registrations:*:AllowHttpForLocalDevelopment\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {},\n          \"binding\": \"The selected shell feature binds this section from ShellSettings.GetConfigurationRoot using the native .NET configuration binder. Options are consumed within that shell provider generation; recompose/restart the shell to replace cached options.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets whether loopback HTTP is accepted during local development.\",\n          \"type\": \"boolean\",\n          \"default\": false\n        }\n      ],\n      \"semanticConstraints\": [\n        \"Endpoints/base addresses must be absolute HTTPS without query/fragment. Loopback HTTP is accepted only in Development with the explicit development override.\",\n        \"Named registration keys must not be blank and are compared ordinally.\",\n        \"Required string settings must not be empty or whitespace.\",\n        \"Configuration is metadata only; token clients and downstream requests are never initialized or executed by export.\"\n      ],\n      \"appliesTo\": {\n        \"kind\": \"shell\",\n        \"features\": [\n          \"Orbyss.Foundation.Authentication.TokenExchange\"\n        ],\n        \"configuration\": [\n          \"Foundation:Authentication:TokenExchange\"\n        ]\n      },\n      \"typeName\": \"Orbyss.Foundation.Authentication.TokenExchange.TokenExchangeRegistration\"\n    }\n  ],\n  \"assembly\": {\n    \"name\": \"Orbyss.Foundation.Authentication.TokenExchange.dll\",\n    \"sha256\": \"21197e5cb1b12a081e761ba03b51f8244d62c0eef51be410a14853397cb9d186\"\n  },\n  \"imports\": []\n}\n"
