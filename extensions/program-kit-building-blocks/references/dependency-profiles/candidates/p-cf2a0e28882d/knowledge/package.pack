  "facts": {
    "README.md": "# Orbyss.Foundation.Tasks\n\n`FoundationTasks` is the CShells feature that starts and drains Orbyss Foundation task contracts with each shell\ngeneration. The package owns cancellation, fault logging, recurring timers, and asynchronous shutdown; feature\npackages own the task implementations and register them through `Orbyss.Foundation.Tasks.Abstractions`.\n\nThe manager is a shell singleton. Startup tasks are resolved from an async scope, while background and recurring\ntasks must be shell-safe singletons. A recurring task must declare a positive interval.",
    "lib/net10.0/Orbyss.Foundation.Tasks.xml": "<?xml version=\"1.0\"?>\n<doc>\n    <assembly>\n        <name>Orbyss.Foundation.Tasks</name>\n    </assembly>\n    <members>\n        <member name=\"T:Orbyss.Foundation.Tasks.FoundationTasksFeature\">\n            <summary>Composes Orbyss Foundation task lifecycle services into one CShells generation.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Tasks.FoundationTasksFeature.ConfigureServices(Microsoft.Extensions.DependencyInjection.IServiceCollection)\">\n            <inheritdoc />\n        </member>\n        <member name=\"T:Orbyss.Foundation.Tasks.IShellTaskManager\">\n            <summary>Starts and drains all tasks owned by one shell generation.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Tasks.IShellTaskManager.StartAsync(System.Threading.CancellationToken)\">\n            <summary>Runs startup tasks and starts background and recurring tasks.</summary>\n            <param name=\"cancellationToken\">Signals that shell activation was cancelled.</param>\n            <returns>A task that represents task-system startup.</returns>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Tasks.IShellTaskManager.StopAsync(System.Threading.CancellationToken)\">\n            <summary>Cancels and awaits all running shell tasks.</summary>\n            <param name=\"cancellationToken\">Bounds the time allowed for task-system shutdown.</param>\n            <returns>A task that represents task-system shutdown.</returns>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Tasks.ShellTaskManager\">\n            <summary>Owns startup, background, and recurring tasks for one shell generation.</summary>\n            <param name=\"serviceProvider\">The shell-generation service provider.</param>\n            <param name=\"backgroundTasks\">The shell-singleton background tasks.</param>\n            <param name=\"recurringTasks\">The shell-singleton recurring tasks.</param>\n            <param name=\"logger\">The lifecycle logger.</param>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Tasks.ShellTaskManager.#ctor(System.IServiceProvider,System.Collections.Generic.IEnumerable{Orbyss.Foundation.Tasks.IBackgroundTask},System.Collections.Generic.IEnumerable{Orbyss.Foundation.Tasks.IRecurringTask},Microsoft.Extensions.Logging.ILogger{Orbyss.Foundation.Tasks.ShellTaskManager})\">\n            <summary>Owns startup, background, and recurring tasks for one shell generation.</summary>\n            <param name=\"serviceProvider\">The shell-generation service provider.</param>\n            <param name=\"backgroundTasks\">The shell-singleton background tasks.</param>\n            <param name=\"recurringTasks\">The shell-singleton recurring tasks.</param>\n            <param name=\"logger\">The lifecycle logger.</param>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Tasks.ShellTaskManager.sync\">\n            <summary>Serializes task-system startup and shutdown state transitions.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Tasks.ShellTaskManager.backgroundTasks\">\n            <summary>The background tasks owned by this shell generation.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Tasks.ShellTaskManager.recurringTasks\">\n            <summary>The recurring tasks owned by this shell generation.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Tasks.ShellTaskManager.lifetimeCancellation\">\n            <summary>Cancels work when the owning shell generation drains.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Tasks.ShellTaskManager.runningTasks\">\n            <summary>The observed background and recurring task executions.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Tasks.ShellTaskManager.stopTask\">\n            <summary>The shared idempotent shutdown operation.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Tasks.ShellTaskManager.started\">\n            <summary>Indicates whether startup has already begun.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Tasks.ShellTaskManager.StartAsync(System.Threading.CancellationToken)\">\n            <inheritdoc />\n        </member>\n        <member name=\"M:Orbyss.Foundation.Tasks.ShellTaskManager.StopAsync(System.Threading.CancellationToken)\">\n            <inheritdoc />\n        </member>\n        <member name=\"M:Orbyss.Foundation.Tasks.ShellTaskManager.DisposeAsync\">\n            <inheritdoc />\n        </member>\n        <member name=\"M:Orbyss.Foundation.Tasks.ShellTaskManager.RunStartupTasksAsync(System.Threading.CancellationToken)\">\n            <summary>Runs scoped startup tasks in registration order.</summary>\n            <param name=\"cancellationToken\">Signals that shell activation was cancelled.</param>\n            <returns>A task that represents all startup tasks.</returns>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Tasks.ShellTaskManager.RunBackgroundTaskAsync(Orbyss.Foundation.Tasks.IBackgroundTask,System.Threading.CancellationToken)\">\n            <summary>Runs and observes one background task.</summary>\n            <param name=\"task\">The background task.</param>\n            <param name=\"cancellationToken\">Signals that the shell generation is stopping.</param>\n            <returns>A task that represents the complete background operation.</returns>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Tasks.ShellTaskManager.RunRecurringTaskAsync(Orbyss.Foundation.Tasks.IRecurringTask,System.Threading.CancellationToken)\">\n            <summary>Runs and observes one recurring task until cancellation.</summary>\n            <param name=\"task\">The recurring task.</param>\n            <param name=\"cancellationToken\">Signals that the shell generation is stopping.</param>\n            <returns>A task that represents the recurring loop.</returns>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Tasks.ShellTaskManager.StopCoreAsync(System.Threading.CancellationToken)\">\n            <summary>Cancels and awaits all observed task executions once.</summary>\n            <param name=\"cancellationToken\">Bounds the time allowed for shutdown.</param>\n            <returns>A task that represents shutdown.</returns>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Tasks.StartShellTasksInitializer\">\n            <summary>Starts Orbyss Foundation tasks during shell initialization.</summary>\n            <param name=\"taskManager\">The shell-generation task manager.</param>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Tasks.StartShellTasksInitializer.#ctor(Orbyss.Foundation.Tasks.IShellTaskManager)\">\n            <summary>Starts Orbyss Foundation tasks during shell initialization.</summary>\n            <param name=\"taskManager\">The shell-generation task manager.</param>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Tasks.StartShellTasksInitializer.InitializeAsync(System.Threading.CancellationToken)\">\n            <inheritdoc />\n        </member>\n        <member name=\"T:Orbyss.Foundation.Tasks.StopShellTasksTerminator\">\n            <summary>Drains Orbyss Foundation tasks during shell termination.</summary>\n            <param name=\"taskManager\">The shell-generation task manager.</param>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Tasks.StopShellTasksTerminator.#ctor(Orbyss.Foundation.Tasks.IShellTaskManager)\">\n            <summary>Drains Orbyss Foundation tasks during shell termination.</summary>\n            <param name=\"taskManager\">The shell-generation task manager.</param>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Tasks.StopShellTasksTerminator.TerminateAsync(System.Threading.CancellationToken)\">\n            <inheritdoc />\n        </member>\n    </members>\n</doc>\n",
    "orbyss-foundation/feature.json": "{\n  \"schemaVersion\": 2,\n  \"packageId\": \"Orbyss.Foundation.Tasks\",\n  \"features\": [\n    {\n      \"identity\": \"FoundationTasks\",\n      \"featureDependencies\": [],\n      \"runtimeDependencies\": [],\n      \"routes\": [],\n      \"dormant\": true,\n      \"composeForOpenApi\": false,\n      \"requiresContractCoverage\": false\n    }\n  ],\n  \"sourceSha256\": {\n    \"FoundationTasksFeature.cs\": \"01af38acc33258065adf2cd5e4f5f635f84d4a53010c3346dca94523ca1e7eb7\",\n    \"IShellTaskManager.cs\": \"71b0724a8702282d5264c5484db8628f16d380161011daaf276fedcd6e3ac13b\",\n    \"ShellTaskManager.cs\": \"6a2da1de31f19692195890f85ae1a4b7471fc07f275a5e9fad1750e3c0ad8b6f\",\n    \"StartShellTasksInitializer.cs\": \"12a7305fe61675ee8ecbec582ca7332fc809444688c2759e35f3f5f9b2ad0dbb\",\n    \"StopShellTasksTerminator.cs\": \"d09be2447cb5edb75402b14f1471f640369bbf512b558fb0af93c1d9e9d6ca85\"\n  },\n  \"hostProvidedDependencies\": [\n    {\n      \"packageId\": \"CShells.Abstractions\",\n      \"minimumVersion\": \"0.0.30-preview.159\"\n    },\n    {\n      \"packageId\": \"JetBrains.Annotations\",\n      \"minimumVersion\": \"2025.2.4\"\n    },\n    {\n      \"packageId\": \"Microsoft.Extensions.Configuration.Abstractions\",\n      \"minimumVersion\": \"10.0.0\"\n    },\n    {\n      \"packageId\": \"Microsoft.Extensions.Configuration\",\n      \"minimumVersion\": \"10.0.0\"\n    },\n    {\n      \"packageId\": \"Microsoft.Extensions.DependencyInjection.Abstractions\",\n      \"minimumVersion\": \"10.0.12\"\n    },\n    {\n      \"packageId\": \"Microsoft.Extensions.Logging.Abstractions\",\n      \"minimumVersion\": \"10.0.12\"\n    },\n    {\n      \"packageId\": \"Microsoft.Extensions.Options\",\n      \"minimumVersion\": \"10.0.0\"\n    },\n    {\n      \"packageId\": \"Microsoft.Extensions.Primitives\",\n      \"minimumVersion\": \"10.0.0\"\n    }\n  ]\n}\n"
  }
