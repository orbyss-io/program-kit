  "facts": {
    "README.md": "# Orbyss.Foundation.Authentication.DPoP\n\nProvider-neutral RFC 9449 resource-server enforcement packaged as a CShells middleware feature for\nthe SPA-PKCE bearer profile. It validates ES256 proof signatures, public JWK thumbprint binding,\nHTTP method and public target URI, access-token hash, proof age, and per-proof replay uniqueness.\nDPoP-bound tokens cannot fall back to bearer use, and required deployments reject unbound tokens.\n\nThe default replay store is atomic within one process. Multi-instance resource servers must replace\n`IDPoPReplayStore` with a shared implementation whose reservation operation is atomic across all\ninstances; the public contract makes that deployment requirement explicit without coupling the\nfeature to a particular cache or database.\n\nSet `RequireNonce` when a resource server should challenge clients with a single-use `DPoP-Nonce`.\n`IDPoPNonceStore` is replaceable for the same clustered-deployment reason; missing, expired, or\nconsumed nonces fail with `use_dpop_nonce` and receive a fresh challenge header.\n\nOutbound clients use `ECDsaDPoPProofGenerator` with either a new ephemeral P-256 key or imported\nPKCS#8 key material. The generator owns its key, exposes its binding thumbprint, removes query and\nfragment from `htu`, and emits `ath` and a server nonce when supplied. Persisted private-key bytes\nremain consumer-owned secret material and must be protected at rest.\n\nThe public origin is explicit so reverse-proxy headers cannot redefine proof targets. The feature\ndoes not contain identity-provider product logic; provider adapters enable DPoP-bound token issuance.\n",
    "lib/net10.0/Orbyss.Foundation.Authentication.DPoP.xml": "<?xml version=\"1.0\"?>\n<doc>\n    <assembly>\n        <name>Orbyss.Foundation.Authentication.DPoP</name>\n    </assembly>\n    <members>\n        <member name=\"T:Orbyss.Foundation.Authentication.DPoP.DPoPAuthorizationHeaderMiddleware\">\n            <summary>Normalizes the RFC 9449 authorization scheme for standard JWT signature validation.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DPoP.DPoPAuthorizationHeaderMiddleware.#ctor(Microsoft.AspNetCore.Http.RequestDelegate)\">\n            <summary>Normalizes the RFC 9449 authorization scheme for standard JWT signature validation.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DPoP.DPoPAuthorizationHeaderMiddleware.InvokeAsync(Microsoft.AspNetCore.Http.HttpContext)\">\n            <summary>Captures the proof and lets the existing bearer handler validate the access token first.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.DPoP.DPoPJwtBearerPostConfigure\">\n            <summary>Chains DPoP proof validation after ordinary issuer/signature/audience/lifetime validation.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DPoP.DPoPJwtBearerPostConfigure.#ctor(Orbyss.Foundation.Authentication.DPoP.DPoPProofValidator)\">\n            <summary>Chains DPoP proof validation after ordinary issuer/signature/audience/lifetime validation.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DPoP.DPoPJwtBearerPostConfigure.PostConfigure(System.String,Microsoft.AspNetCore.Authentication.JwtBearer.JwtBearerOptions)\">\n            <inheritdoc />\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.DPoP.DPoPOptions\">\n            <summary>Configures provider-neutral RFC 9449 resource-server validation.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Authentication.DPoP.DPoPOptions.SectionName\">\n            <summary>Gets the shell configuration section containing DPoP settings.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.DPoP.DPoPOptions.Required\">\n            <summary>Gets or sets whether every authenticated request must use a DPoP-bound token.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.DPoP.DPoPOptions.PublicOrigin\">\n            <summary>Gets or sets the externally visible origin used to validate `htu`.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.DPoP.DPoPOptions.ProofMaxAgeSeconds\">\n            <summary>Gets or sets the maximum accepted age of a proof, in seconds.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.DPoP.DPoPOptions.ClockSkewSeconds\">\n            <summary>Gets or sets the permitted proof-clock skew, in seconds.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.DPoP.DPoPOptions.AllowHttpForLocalDevelopment\">\n            <summary>Gets or sets whether loopback HTTP is accepted during local development.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.DPoP.DPoPOptions.RequireNonce\">\n            <summary>Gets or sets whether each proof must carry a server-issued single-use nonce.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.DPoP.DPoPOptions.NonceLifetimeSeconds\">\n            <summary>Gets or sets how long an issued nonce remains usable, in seconds.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.DPoP.DPoPOptionsValidator\">\n            <summary>Rejects unsafe or ambiguous DPoP resource-server settings.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DPoP.DPoPOptionsValidator.#ctor(Microsoft.Extensions.Hosting.IHostEnvironment)\">\n            <summary>Rejects unsafe or ambiguous DPoP resource-server settings.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DPoP.DPoPOptionsValidator.Validate(System.String,Orbyss.Foundation.Authentication.DPoP.DPoPOptions)\">\n            <inheritdoc />\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.DPoP.DPoPProofRequest\">\n            <summary>Describes one outbound RFC 9449 proof.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.DPoP.DPoPProofRequest.Method\">\n            <summary>Gets or sets the outbound HTTP method.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.DPoP.DPoPProofRequest.TargetUri\">\n            <summary>Gets or sets the absolute target URI; query and fragment are excluded from `htu`.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.DPoP.DPoPProofRequest.AccessToken\">\n            <summary>Gets or sets the access token whose hash is emitted as `ath`, when applicable.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.DPoP.DPoPProofRequest.Nonce\">\n            <summary>Gets or sets a server-provided `DPoP-Nonce` value.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.DPoP.DPoPProofRequest.ProofIdentifier\">\n            <summary>Gets or sets an explicit proof identifier; a random identifier is used when omitted.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.DPoP.DPoPProofRequest.IssuedAt\">\n            <summary>Gets or sets an explicit issuance time; the configured time provider is used when omitted.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.DPoP.DPoPProofValidator\">\n            <summary>Validates ES256 RFC 9449 proofs and their access-token confirmation binding.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DPoP.DPoPProofValidator.#ctor(Microsoft.Extensions.Options.IOptions{Orbyss.Foundation.Authentication.DPoP.DPoPOptions},System.TimeProvider,Orbyss.Foundation.Authentication.DPoP.IDPoPReplayStore,Orbyss.Foundation.Authentication.DPoP.IDPoPNonceStore)\">\n            <summary>Validates ES256 RFC 9449 proofs and their access-token confirmation binding.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DPoP.DPoPProofValidator.Validate(Microsoft.AspNetCore.Http.HttpContext,System.String)\">\n            <summary>Returns a stable failure code or null when the request satisfies the DPoP contract.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DPoP.DPoPProofValidator.ValidateClaims(Microsoft.AspNetCore.Http.HttpContext,System.String,System.Text.Json.JsonElement,System.String,Orbyss.Foundation.Authentication.DPoP.DPoPOptions)\">\n            <summary>Validates request binding, freshness, access-token hash, and replay uniqueness.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DPoP.DPoPProofValidator.ReadBoundThumbprint(System.String)\">\n            <summary>Reads the verified access token's RFC 7800 JWK thumbprint binding.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DPoP.DPoPProofValidator.TryReadPublicKey(System.Text.Json.JsonElement,System.Security.Cryptography.ECDsa@,System.String@)\">\n            <summary>Imports the proof's public ES256 key and computes its RFC 7638 thumbprint.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DPoP.DPoPProofValidator.TryString(System.Text.Json.JsonElement,System.String,System.String@)\">\n            <summary>Reads one required non-empty JSON string.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DPoP.DPoPProofValidator.Base64UrlDecode(System.String)\">\n            <summary>Decodes an unpadded base64url value.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DPoP.DPoPProofValidator.Base64UrlEncode(System.ReadOnlySpan{System.Byte})\">\n            <summary>Encodes an unpadded base64url value.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.DPoP.DPoPRequestState\">\n            <summary>Names private request items shared between DPoP normalization and token validation.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Authentication.DPoP.DPoPRequestState.AccessToken\">\n            <summary>Stores the original DPoP-scheme access token.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Authentication.DPoP.DPoPRequestState.Proof\">\n            <summary>Stores the request's unique DPoP proof.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.DPoP.ECDsaDPoPProofGenerator\">\n            <summary>Owns a P-256 key and creates ES256 RFC 9449 proofs.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Authentication.DPoP.ECDsaDPoPProofGenerator.sync\">\n            <summary>Serializes access to the owned cryptographic key.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Authentication.DPoP.ECDsaDPoPProofGenerator.signingKey\">\n            <summary>Holds the client private key for the generator lifetime.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Authentication.DPoP.ECDsaDPoPProofGenerator.timeProvider\">\n            <summary>Supplies deterministic or system issuance times.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Authentication.DPoP.ECDsaDPoPProofGenerator.publicJwk\">\n            <summary>Holds the public JWK emitted in every proof header.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DPoP.ECDsaDPoPProofGenerator.#ctor(System.Security.Cryptography.ECDsa,System.TimeProvider)\">\n            <summary>Initializes an owning proof generator around validated P-256 key material.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.DPoP.ECDsaDPoPProofGenerator.JwkThumbprint\">\n            <inheritdoc />\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DPoP.ECDsaDPoPProofGenerator.CreateEphemeral(System.TimeProvider)\">\n            <summary>Creates a new process-local P-256 proof key.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DPoP.ECDsaDPoPProofGenerator.ImportPkcs8(System.ReadOnlySpan{System.Byte},System.TimeProvider)\">\n            <summary>Imports a persisted PKCS#8 P-256 private key.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DPoP.ECDsaDPoPProofGenerator.ExportPkcs8PrivateKey\">\n            <summary>Exports the owned private key for consumer-controlled, protected persistence.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DPoP.ECDsaDPoPProofGenerator.CreateProof(Orbyss.Foundation.Authentication.DPoP.DPoPProofRequest)\">\n            <inheritdoc />\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DPoP.ECDsaDPoPProofGenerator.Dispose\">\n            <inheritdoc />\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DPoP.ECDsaDPoPProofGenerator.Base64Url(System.ReadOnlySpan{System.Byte})\">\n            <summary>Encodes an unpadded base64url value.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.DPoP.FoundationDPoPFeature\">\n            <summary>Composes RFC 9449 proof-of-possession enforcement into a bearer API shell.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DPoP.FoundationDPoPFeature.#ctor(CShells.ShellSettings)\">\n            <summary>Composes RFC 9449 proof-of-possession enforcement into a bearer API shell.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.DPoP.FoundationDPoPFeature.Order\">\n            <inheritdoc />\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DPoP.FoundationDPoPFeature.ConfigureServices(Microsoft.Extensions.DependencyInjection.IServiceCollection)\">\n            <inheritdoc />\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DPoP.FoundationDPoPFeature.UseMiddleware(Microsoft.AspNetCore.Builder.IApplicationBuilder,Microsoft.Extensions.Hosting.IHostEnvironment)\">\n            <inheritdoc />\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.DPoP.IDPoPNonceStore\">\n            <summary>Issues and atomically consumes opaque resource-server DPoP nonces.</summary>\n            <remarks>\n            Distributed deployments that require nonces should replace the default in-memory implementation\n            with a shared, atomic store.\n            </remarks>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DPoP.IDPoPNonceStore.Issue(System.DateTimeOffset)\">\n            <summary>Creates a cryptographically random nonce valid until the supplied instant.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DPoP.IDPoPNonceStore.TryConsume(System.String)\">\n            <summary>Returns true only when an unexpired nonce is consumed for the first time.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.DPoP.IDPoPProofGenerator\">\n            <summary>Creates outbound RFC 9449 proofs using one stable client-held key.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.DPoP.IDPoPProofGenerator.JwkThumbprint\">\n            <summary>Gets the RFC 7638 thumbprint used to bind access tokens to this key.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DPoP.IDPoPProofGenerator.CreateProof(Orbyss.Foundation.Authentication.DPoP.DPoPProofRequest)\">\n            <summary>Creates a signed proof for one token or resource request.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.DPoP.IDPoPReplayStore\">\n            <summary>Atomically reserves accepted DPoP proof identifiers until their replay window expires.</summary>\n            <remarks>\n            Distributed deployments should replace the default in-memory implementation with a shared store\n            whose reservation operation is atomic across every resource-server instance.\n            </remarks>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DPoP.IDPoPReplayStore.TryUse(System.String,System.String,System.DateTimeOffset)\">\n            <summary>Returns true only when this proof identifier was reserved for the first time.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.DPoP.InMemoryDPoPNonceStore\">\n            <summary>Provides process-local, single-use DPoP nonces for single-instance deployments.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DPoP.InMemoryDPoPNonceStore.#ctor(System.TimeProvider)\">\n            <summary>Provides process-local, single-use DPoP nonces for single-instance deployments.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Authentication.DPoP.InMemoryDPoPNonceStore.expiries\">\n            <summary>Tracks opaque nonce values until consumption or expiry.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DPoP.InMemoryDPoPNonceStore.Issue(System.DateTimeOffset)\">\n            <inheritdoc />\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DPoP.InMemoryDPoPNonceStore.TryConsume(System.String)\">\n            <inheritdoc />\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.DPoP.InMemoryDPoPReplayStore\">\n            <summary>Provides process-local, atomic DPoP replay protection for single-instance deployments.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DPoP.InMemoryDPoPReplayStore.#ctor(System.TimeProvider)\">\n            <summary>Provides process-local, atomic DPoP replay protection for single-instance deployments.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Authentication.DPoP.InMemoryDPoPReplayStore.expiries\">\n            <summary>Tracks reserved proof identifiers until the end of their acceptance window.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DPoP.InMemoryDPoPReplayStore.TryUse(System.String,System.String,System.DateTimeOffset)\">\n            <inheritdoc />\n        </member>\n    </members>\n</doc>\n",
    "orbyss-foundation/feature.json": "{\n  \"schemaVersion\": 2,\n  \"packageId\": \"Orbyss.Foundation.Authentication.DPoP\",\n  \"features\": [\n    {\n      \"identity\": \"Orbyss.Foundation.Authentication.DPoP\",\n      \"featureDependencies\": [\n        \"Orbyss.Foundation.Authentication.SpaPkce\"\n      ],\n      \"runtimeDependencies\": [],\n      \"routes\": [],\n      \"dormant\": true,\n      \"composeForOpenApi\": false,\n      \"requiresContractCoverage\": false\n    }\n  ],\n  \"sourceSha256\": {\n    \"DPoPAuthorizationHeaderMiddleware.cs\": \"90c7dfffa5f96377d99cd8d7342e4f0c6e2f62034b3e8d12925cb132993140b5\",\n    \"DPoPJwtBearerPostConfigure.cs\": \"e9d10b6735da33999a358b1498904b573e9f0e9489f49e19483ee1a9b72dda5c\",\n    \"DPoPOptions.cs\": \"f82983dc6b521d37d3fd9225276a00bd693f7a00418c526b7db8cd44fa3eb537\",\n    \"DPoPOptionsValidator.cs\": \"826ded3b493148cea45303d35dbeb7b53f92c30eb9db25e508fc3823ecada60e\",\n    \"DPoPProofRequest.cs\": \"d412d5d2d1313e989163c8a231cd081ecc930c1bae4913e1735fbd8509cabb79\",\n    \"DPoPProofValidator.cs\": \"f4149238c757fd70b5adf5470f37e6602379ecac185742b857b444e3560c6dbf\",\n    \"DPoPRequestState.cs\": \"ed34d8bd9144e621ead9c8310ceb10e4385b33d0e079985bc59da42702afd227\",\n    \"ECDsaDPoPProofGenerator.cs\": \"0660ba72e9eb95bc308e831a9e3022073c5ff6bf54958c3ac570bb361822bea4\",\n    \"FoundationDPoPFeature.cs\": \"f125238bb1a07a6ea81de6a63ab9401f9408e807ddbd29693867d20f34cb69be\",\n    \"IDPoPNonceStore.cs\": \"9592f63a59119e83b4d048e663ead1836488d8013f49f41e2aa2f1b5351d2cc5\",\n    \"IDPoPProofGenerator.cs\": \"32147271ca36fca7fd7b3124ab7edcfa1cbd04e75b285e2f02c1ceaab2f39dcf\",\n    \"IDPoPReplayStore.cs\": \"b0de04e3584bb1106c16dab17968da96734b6ff555e6805109bd15cd0ba09b67\",\n    \"InMemoryDPoPNonceStore.cs\": \"8b6788981fe456e3979c3a5b1bdde5295687307ce8eebe8728108f9f0731c82b\",\n    \"InMemoryDPoPReplayStore.cs\": \"c94e53fef96cadd23ed21a6529f5b48e71204b13113b38a017bbdae789c4b78f\"\n  },\n  \"hostProvidedDependencies\": [\n    {\n      \"packageId\": \"CShells.Abstractions\",\n      \"minimumVersion\": \"0.0.30-preview.159\"\n    },\n    {\n      \"packageId\": \"CShells.AspNetCore.Abstractions\",\n      \"minimumVersion\": \"0.0.30-preview.159\"\n    },\n    {\n      \"packageId\": \"JetBrains.Annotations\",\n      \"minimumVersion\": \"2025.2.4\"\n    },\n    {\n      \"packageId\": \"Microsoft.AspNetCore.Authentication.JwtBearer\",\n      \"minimumVersion\": \"10.0.12\"\n    },\n    {\n      \"packageId\": \"Microsoft.Bcl.Cryptography\",\n      \"minimumVersion\": \"10.0.2\"\n    },\n    {\n      \"packageId\": \"Microsoft.IdentityModel.Abstractions\",\n      \"minimumVersion\": \"8.19.2\"\n    },\n    {\n      \"packageId\": \"Microsoft.IdentityModel.JsonWebTokens\",\n      \"minimumVersion\": \"8.19.2\"\n    },\n    {\n      \"packageId\": \"Microsoft.IdentityModel.Logging\",\n      \"minimumVersion\": \"8.19.2\"\n    },\n    {\n      \"packageId\": \"Microsoft.IdentityModel.Protocols.OpenIdConnect\",\n      \"minimumVersion\": \"8.19.2\"\n    },\n    {\n      \"packageId\": \"Microsoft.IdentityModel.Protocols\",\n      \"minimumVersion\": \"8.19.2\"\n    },\n    {\n      \"packageId\": \"Microsoft.IdentityModel.Tokens\",\n      \"minimumVersion\": \"8.19.2\"\n    },\n    {\n      \"packageId\": \"System.IdentityModel.Tokens.Jwt\",\n      \"minimumVersion\": \"8.19.2\"\n    }\n  ]\n}\n",
    "orbyss-foundation/settings.json": "{\n  \"schemaVersion\": 2,\n  \"packageId\": \"Orbyss.Foundation.Authentication.DPoP\",\n  \"packageVersion\": \"0.3.1\",\n  \"sourceSha256\": {\n    \"DPoPAuthorizationHeaderMiddleware.cs\": \"90c7dfffa5f96377d99cd8d7342e4f0c6e2f62034b3e8d12925cb132993140b5\",\n    \"DPoPJwtBearerPostConfigure.cs\": \"e9d10b6735da33999a358b1498904b573e9f0e9489f49e19483ee1a9b72dda5c\",\n    \"DPoPOptions.cs\": \"f82983dc6b521d37d3fd9225276a00bd693f7a00418c526b7db8cd44fa3eb537\",\n    \"DPoPOptionsValidator.cs\": \"826ded3b493148cea45303d35dbeb7b53f92c30eb9db25e508fc3823ecada60e\",\n    \"DPoPProofRequest.cs\": \"d412d5d2d1313e989163c8a231cd081ecc930c1bae4913e1735fbd8509cabb79\",\n    \"DPoPProofValidator.cs\": \"f4149238c757fd70b5adf5470f37e6602379ecac185742b857b444e3560c6dbf\",\n    \"DPoPRequestState.cs\": \"ed34d8bd9144e621ead9c8310ceb10e4385b33d0e079985bc59da42702afd227\",\n    \"ECDsaDPoPProofGenerator.cs\": \"0660ba72e9eb95bc308e831a9e3022073c5ff6bf54958c3ac570bb361822bea4\",\n    \"FoundationDPoPFeature.cs\": \"f125238bb1a07a6ea81de6a63ab9401f9408e807ddbd29693867d20f34cb69be\",\n    \"IDPoPNonceStore.cs\": \"9592f63a59119e83b4d048e663ead1836488d8013f49f41e2aa2f1b5351d2cc5\",\n    \"IDPoPProofGenerator.cs\": \"32147271ca36fca7fd7b3124ab7edcfa1cbd04e75b285e2f02c1ceaab2f39dcf\",\n    \"IDPoPReplayStore.cs\": \"b0de04e3584bb1106c16dab17968da96734b6ff555e6805109bd15cd0ba09b67\",\n    \"InMemoryDPoPNonceStore.cs\": \"8b6788981fe456e3979c3a5b1bdde5295687307ce8eebe8728108f9f0731c82b\",\n    \"InMemoryDPoPReplayStore.cs\": \"c94e53fef96cadd23ed21a6529f5b48e71204b13113b38a017bbdae789c4b78f\"\n  },\n  \"contracts\": [\n    {\n      \"schemaVersion\": 2,\n      \"owner\": \"Orbyss.Foundation.Authentication.DPoP\",\n      \"scope\": \"dpop\",\n      \"complete\": true,\n      \"sources\": {\n        \"DPoPAuthorizationHeaderMiddleware.cs\": \"90c7dfffa5f96377d99cd8d7342e4f0c6e2f62034b3e8d12925cb132993140b5\",\n        \"DPoPJwtBearerPostConfigure.cs\": \"e9d10b6735da33999a358b1498904b573e9f0e9489f49e19483ee1a9b72dda5c\",\n        \"DPoPOptions.cs\": \"f82983dc6b521d37d3fd9225276a00bd693f7a00418c526b7db8cd44fa3eb537\",\n        \"DPoPOptionsValidator.cs\": \"826ded3b493148cea45303d35dbeb7b53f92c30eb9db25e508fc3823ecada60e\",\n        \"DPoPProofRequest.cs\": \"d412d5d2d1313e989163c8a231cd081ecc930c1bae4913e1735fbd8509cabb79\",\n        \"DPoPProofValidator.cs\": \"f4149238c757fd70b5adf5470f37e6602379ecac185742b857b444e3560c6dbf\",\n        \"DPoPRequestState.cs\": \"ed34d8bd9144e621ead9c8310ceb10e4385b33d0e079985bc59da42702afd227\",\n        \"ECDsaDPoPProofGenerator.cs\": \"0660ba72e9eb95bc308e831a9e3022073c5ff6bf54958c3ac570bb361822bea4\",\n        \"FoundationDPoPFeature.cs\": \"f125238bb1a07a6ea81de6a63ab9401f9408e807ddbd29693867d20f34cb69be\",\n        \"IDPoPNonceStore.cs\": \"9592f63a59119e83b4d048e663ead1836488d8013f49f41e2aa2f1b5351d2cc5\",\n        \"IDPoPProofGenerator.cs\": \"32147271ca36fca7fd7b3124ab7edcfa1cbd04e75b285e2f02c1ceaab2f39dcf\",\n        \"IDPoPReplayStore.cs\": \"b0de04e3584bb1106c16dab17968da96734b6ff555e6805109bd15cd0ba09b67\",\n        \"InMemoryDPoPNonceStore.cs\": \"8b6788981fe456e3979c3a5b1bdde5295687307ce8eebe8728108f9f0731c82b\",\n        \"InMemoryDPoPReplayStore.cs\": \"c94e53fef96cadd23ed21a6529f5b48e71204b13113b38a017bbdae789c4b78f\"\n      },\n      \"settings\": [\n        {\n          \"path\": \"Foundation:Authentication:DPoP:Required\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {},\n          \"binding\": \"The selected shell feature binds this section from ShellSettings.GetConfigurationRoot using the native .NET configuration binder. Options are consumed within that shell provider generation; recompose/restart the shell to replace cached options.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets whether every authenticated request must use a DPoP-bound token.\",\n          \"type\": \"boolean\",\n          \"default\": true\n        },\n        {\n          \"path\": \"Foundation:Authentication:DPoP:PublicOrigin\",\n          \"required\": true,\n          \"secret\": false,\n          \"constraints\": {\n            \"format\": \"uri\"\n          },\n          \"binding\": \"The selected shell feature binds this section from ShellSettings.GetConfigurationRoot using the native .NET configuration binder. Options are consumed within that shell provider generation; recompose/restart the shell to replace cached options.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the externally visible origin used to validate \\u0060htu\\u0060.\",\n          \"type\": \"string\",\n          \"default\": \"\"\n        },\n        {\n          \"path\": \"Foundation:Authentication:DPoP:ProofMaxAgeSeconds\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"minimum\": 10,\n            \"maximum\": 300\n          },\n          \"binding\": \"The selected shell feature binds this section from ShellSettings.GetConfigurationRoot using the native .NET configuration binder. Options are consumed within that shell provider generation; recompose/restart the shell to replace cached options.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the maximum accepted age of a proof, in seconds.\",\n          \"type\": \"integer\",\n          \"default\": 60\n        },\n        {\n          \"path\": \"Foundation:Authentication:DPoP:ClockSkewSeconds\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"minimum\": 0,\n            \"maximum\": 30\n          },\n          \"binding\": \"The selected shell feature binds this section from ShellSettings.GetConfigurationRoot using the native .NET configuration binder. Options are consumed within that shell provider generation; recompose/restart the shell to replace cached options.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the permitted proof-clock skew, in seconds.\",\n          \"type\": \"integer\",\n          \"default\": 5\n        },\n        {\n          \"path\": \"Foundation:Authentication:DPoP:AllowHttpForLocalDevelopment\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {},\n          \"binding\": \"The selected shell feature binds this section from ShellSettings.GetConfigurationRoot using the native .NET configuration binder. Options are consumed within that shell provider generation; recompose/restart the shell to replace cached options.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets whether loopback HTTP is accepted during local development.\",\n          \"type\": \"boolean\",\n          \"default\": false\n        },\n        {\n          \"path\": \"Foundation:Authentication:DPoP:RequireNonce\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {},\n          \"binding\": \"The selected shell feature binds this section from ShellSettings.GetConfigurationRoot using the native .NET configuration binder. Options are consumed within that shell provider generation; recompose/restart the shell to replace cached options.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets whether each proof must carry a server-issued single-use nonce.\",\n          \"type\": \"boolean\",\n          \"default\": false\n        },\n        {\n          \"path\": \"Foundation:Authentication:DPoP:NonceLifetimeSeconds\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"minimum\": 10,\n            \"maximum\": 300\n          },\n          \"binding\": \"The selected shell feature binds this section from ShellSettings.GetConfigurationRoot using the native .NET configuration binder. Options are consumed within that shell provider generation; recompose/restart the shell to replace cached options.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets how long an issued nonce remains usable, in seconds.\",\n          \"type\": \"integer\",\n          \"default\": 60\n        }\n      ],\n      \"semanticConstraints\": [\n        \"PublicOrigin must be an exact absolute HTTPS origin with root path and no query/fragment; loopback HTTP requires Development and the explicit override.\",\n        \"Required selects DPoP-bound-token admission for authenticated requests; RequireNonce adds the server-issued single-use nonce requirement.\",\n        \"Replay/nonce storage implementation is separately registered application composition; settings export neither resolves nor initializes it.\"\n      ],\n      \"appliesTo\": {\n        \"kind\": \"shell\",\n        \"features\": [\n          \"Orbyss.Foundation.Authentication.DPoP\"\n        ],\n        \"configuration\": [\n          \"Foundation:Authentication:DPoP\"\n        ]\n      },\n      \"typeName\": \"Orbyss.Foundation.Authentication.DPoP.DPoPOptions\"\n    }\n  ],\n  \"assembly\": {\n    \"name\": \"Orbyss.Foundation.Authentication.DPoP.dll\",\n    \"sha256\": \"dcaf3f45c11a6b7e861308ebb1af7e619855d71625063eeebd0e9af7826abcff\"\n  },\n  \"imports\": []\n}\n"
  }
