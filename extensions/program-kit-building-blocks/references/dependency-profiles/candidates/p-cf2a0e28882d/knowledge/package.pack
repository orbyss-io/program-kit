1e437c6923038bbc5b30827493e9b7486dd79180f809abcaf9b395ea\",\n        \"JsonProfileSettings.cs\": \"afdce8c5489ccc86cfb8fd5845fb7fca1210986cf0c453b9e72f48ed72769d21\",\n        \"JsonResponseContractException.cs\": \"4359c334f78f42c9d776c3bda9f4eed51b42508a84b56b38931d12c486ce4510\",\n        \"RawJsonNumber.cs\": \"ac04414581bb6ad01d3df7dd57947210a39cbbbafef1f26b65701231275ba2ca\",\n        \"RawJsonNumberConverter.cs\": \"b415dd752f25c840f37c74214ffebd26894eae2c327c65ad77d6e8d17896cab4\",\n        \"ValueSequenceJsonConverter.cs\": \"011d58b549a4e9418b5036e8197389b1c51be0c0b9ed81827552488a456a3db5\",\n        \"ValueSequenceJsonConverterFactory.cs\": \"a5a6f77f48d2ce4ece75e65b5bb2139a718f9a3899bbd11f60e3479c357aad88\",\n        \"ValueSequenceJsonExtension.cs\": \"16c5e3f78b1a10adae8a999b88f3350f2511ed5db7e7f98573287a3828614559\"\n      },\n      \"settings\": [\n        {\n          \"path\": \"JsonProfileSettings:Preset\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"enum\": [\n              \"strict-request\",\n              \"tolerant-response\"\n            ]\n          },\n          \"binding\": \"Code constructs JsonProfileSettings; ASP.NET shell binding belongs to the separate Json.AspNetCore owner.\",\n          \"precedence\": [\n            \"property initializer\",\n            \"explicit caller assignment\"\n          ],\n          \"reload\": \"immutable\",\n          \"description\": \"Fixed admission preset.\",\n          \"type\": \"string\",\n          \"default\": \"strict-request\"\n        },\n        {\n          \"path\": \"JsonProfileSettings:MaxBytes\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"minimum\": 1,\n            \"maximum\": 16777216\n          },\n          \"binding\": \"Code constructs JsonProfileSettings; ASP.NET shell binding belongs to the separate Json.AspNetCore owner.\",\n          \"precedence\": [\n            \"property initializer\",\n            \"explicit caller assignment\"\n          ],\n          \"reload\": \"immutable\",\n          \"description\": \"Maximum encoded bytes.\",\n          \"type\": \"integer\",\n          \"default\": 1048576\n        },\n        {\n          \"path\": \"JsonProfileSettings:MaxDepth\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"minimum\": 1,\n            \"maximum\": 64\n          },\n          \"binding\": \"Code constructs JsonProfileSettings; ASP.NET shell binding belongs to the separate Json.AspNetCore owner.\",\n          \"precedence\": [\n            \"property initializer\",\n            \"explicit caller assignment\"\n          ],\n          \"reload\": \"immutable\",\n          \"description\": \"Maximum nesting depth.\",\n          \"type\": \"integer\",\n          \"default\": 32\n        },\n        {\n          \"path\": \"JsonProfileSettings:Extensions\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"uniqueItems\": true\n          },\n          \"binding\": \"Code constructs JsonProfileSettings; ASP.NET shell binding belongs to the separate Json.AspNetCore owner.\",\n          \"precedence\": [\n            \"property initializer\",\n            \"explicit caller assignment\"\n          ],\n          \"reload\": \"immutable\",\n          \"description\": \"Explicitly registered extension identities.\",\n          \"type\": \"array\",\n          \"default\": []\n        }\n      ],\n      \"semanticConstraints\": [\n        \"JsonProfile rejects invalid presets and bounds before creating immutable serializer options.\",\n        \"Extensions must be non-null, unique and registered by code; at most one selected resolver is allowed.\",\n        \"Converter overlap fails when type metadata is resolved; these declarations do not enumerate application contracts.\"\n      ],\n      \"appliesTo\": {\n        \"kind\": \"code\",\n        \"features\": [],\n        \"configuration\": []\n      },\n      \"typeName\": \"Orbyss.Foundation.Json.JsonProfileSettings\"\n    }\n  ],\n  \"assembly\": {\n    \"name\": \"Orbyss.Foundation.Json.dll\",\n    \"sha256\": \"9e4fabbb37265a33c5654d08502f7414c65858d1d09d7566a3337b12d0c5f386\"\n  },\n  \"imports\": []\n}\n"
