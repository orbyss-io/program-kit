  },
  "facts": {
    "README.md": "# Orbyss.Foundation.Web.Discovery.Abstractions\n\n`IPublicDocumentCatalog` and `PublicDocument` are framework/provider-neutral contracts. Implement\na catalogue to adapt another CMS or renderer without changing the shell feature or Host. Every\nreturned document is deliberately anonymous/public. Never implement this interface over a private\ncontent repository without an explicit public projection. The catalogue is sampled once per shell\ngeneration; publish new content through a new generation/deployment, not mutable response bodies.\n",
    "lib/net10.0/Orbyss.Foundation.Web.Discovery.Abstractions.xml": "<?xml version=\"1.0\"?>\n<doc>\n    <assembly>\n        <name>Orbyss.Foundation.Web.Discovery.Abstractions</name>\n    </assembly>\n    <members>\n        <member name=\"T:Orbyss.Foundation.Web.Discovery.IPublicDocumentCatalog\">\n            <summary>Supplies an immutable, explicitly public document snapshot for one shell generation.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Web.Discovery.IPublicDocumentCatalog.ReadDocuments\">\n            <summary>Reads validated public documents; private application content must never be returned.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Web.Discovery.PublicDocument\">\n            <summary>Represents content deliberately approved for anonymous publication at an exact route.</summary>\n            <param name=\"Route\">The root-relative, literal route without query, wildcards or parameters.</param>\n            <param name=\"ContentType\">The explicit response media type.</param>\n            <param name=\"Content\">The immutable snapshot of the response body.</param>\n            <param name=\"Index\">Whether the document may be indexed; this is not authorization.</param>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Web.Discovery.PublicDocument.#ctor(System.String,System.String,System.ReadOnlyMemory{System.Byte},System.Boolean)\">\n            <summary>Represents content deliberately approved for anonymous publication at an exact route.</summary>\n            <param name=\"Route\">The root-relative, literal route without query, wildcards or parameters.</param>\n            <param name=\"ContentType\">The explicit response media type.</param>\n            <param name=\"Content\">The immutable snapshot of the response body.</param>\n            <param name=\"Index\">Whether the document may be indexed; this is not authorization.</param>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Web.Discovery.PublicDocument.Route\">\n            <summary>The root-relative, literal route without query, wildcards or parameters.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Web.Discovery.PublicDocument.ContentType\">\n            <summary>The explicit response media type.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Web.Discovery.PublicDocument.Content\">\n            <summary>The immutable snapshot of the response body.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Web.Discovery.PublicDocument.Index\">\n            <summary>Whether the document may be indexed; this is not authorization.</summary>\n        </member>\n    </members>\n</doc>\n"
  }
}
