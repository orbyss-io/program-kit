  "facts": {
    "README.md": "# Orbyss.Foundation.Authentication.DownstreamApi\n\nProvider-neutral authenticated downstream HTTP calls packaged as a CShells feature. A named API\nuses either an application-only client-credentials identity or an RFC 8693 exchanged/downscoped user\nidentity. The feature does not blindly relay inbound bearer tokens, follow redirects carrying\nauthorization, accept caller-selected absolute destinations, or expose provider-specific concepts.\n\nProvider adapters generate the relevant token-client and exchange-policy registrations. Application\nfeatures call `IDownstreamApiClient` with a configured API name and a relative URI.\n",
    "lib/net10.0/Orbyss.Foundation.Authentication.DownstreamApi.xml": "<?xml version=\"1.0\"?>\n<doc>\n    <assembly>\n        <name>Orbyss.Foundation.Authentication.DownstreamApi</name>\n    </assembly>\n    <members>\n        <member name=\"T:Orbyss.Foundation.Authentication.DownstreamApi.DownstreamApiClient\">\n            <summary>Routes authenticated calls only to fixed configured downstream destinations.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DownstreamApi.DownstreamApiClient.#ctor(System.Net.Http.IHttpClientFactory,Microsoft.Extensions.Options.IOptions{Orbyss.Foundation.Authentication.DownstreamApi.DownstreamApiOptions},System.IServiceProvider,Orbyss.Foundation.Authentication.DownstreamApi.ICurrentAccessTokenAccessor)\">\n            <summary>Routes authenticated calls only to fixed configured downstream destinations.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Authentication.DownstreamApi.DownstreamApiClient.HttpClientName\">\n            <summary>Names the isolated non-redirecting downstream HTTP client.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DownstreamApi.DownstreamApiClient.SendAsync(System.String,System.Net.Http.HttpRequestMessage,System.Threading.CancellationToken)\">\n            <inheritdoc />\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DownstreamApi.DownstreamApiClient.GetClientCredentialsAsync(Orbyss.Foundation.Authentication.DownstreamApi.DownstreamApiRegistration,System.Threading.CancellationToken)\">\n            <summary>Acquires an application-only access token from the selected machine registration.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DownstreamApi.DownstreamApiClient.GetExchangedTokenAsync(Orbyss.Foundation.Authentication.DownstreamApi.DownstreamApiRegistration,System.Threading.CancellationToken)\">\n            <summary>Exchanges the current validated user token for a downscoped downstream token.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DownstreamApi.DownstreamApiClient.ValidateRelativeRequest(System.Net.Http.HttpRequestMessage)\">\n            <summary>Rejects caller-selected destinations, parent traversal, and caller-owned authorization.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.DownstreamApi.DownstreamApiOptions\">\n            <summary>Defines named provider-neutral authenticated downstream APIs.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Authentication.DownstreamApi.DownstreamApiOptions.SectionName\">\n            <summary>Gets the configuration section containing downstream API registrations.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.DownstreamApi.DownstreamApiOptions.Registrations\">\n            <summary>Gets downstream APIs keyed by an application-owned name.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.DownstreamApi.DownstreamApiOptionsValidator\">\n            <summary>Rejects ambiguous, unsafe, or incomplete downstream API registrations.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DownstreamApi.DownstreamApiOptionsValidator.#ctor(Microsoft.Extensions.Hosting.IHostEnvironment)\">\n            <summary>Rejects ambiguous, unsafe, or incomplete downstream API registrations.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DownstreamApi.DownstreamApiOptionsValidator.Validate(System.String,Orbyss.Foundation.Authentication.DownstreamApi.DownstreamApiOptions)\">\n            <inheritdoc />\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DownstreamApi.DownstreamApiOptionsValidator.ValidateBaseAddress(Orbyss.Foundation.Authentication.DownstreamApi.DownstreamApiRegistration,System.String,System.Collections.Generic.ICollection{System.String})\">\n            <summary>Validates the fixed downstream destination and development transport exception.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.DownstreamApi.DownstreamApiRegistration\">\n            <summary>Configures token acquisition and routing for one downstream API.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.DownstreamApi.DownstreamApiRegistration.BaseAddress\">\n            <summary>Gets or sets the absolute downstream base address.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.DownstreamApi.DownstreamApiRegistration.AccessMode\">\n            <summary>Gets or sets `ClientCredentials` or `TokenExchange`.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.DownstreamApi.DownstreamApiRegistration.TokenRegistration\">\n            <summary>Gets or sets the named token-source or exchange-policy registration.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.DownstreamApi.DownstreamApiRegistration.Audience\">\n            <summary>Gets or sets the exchange target audience.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.DownstreamApi.DownstreamApiRegistration.Resource\">\n            <summary>Gets or sets the exchange target resource URI.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.DownstreamApi.DownstreamApiRegistration.Scopes\">\n            <summary>Gets or sets exact scopes used to downscope a delegated token.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.DownstreamApi.DownstreamApiRegistration.AllowHttpForLocalDevelopment\">\n            <summary>Gets or sets whether loopback HTTP is accepted during local development.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.DownstreamApi.FoundationDownstreamApiFeature\">\n            <summary>Composes governed authenticated downstream HTTP calls into one shell.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DownstreamApi.FoundationDownstreamApiFeature.#ctor(CShells.ShellSettings)\">\n            <summary>Composes governed authenticated downstream HTTP calls into one shell.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DownstreamApi.FoundationDownstreamApiFeature.ConfigureServices(Microsoft.Extensions.DependencyInjection.IServiceCollection)\">\n            <inheritdoc />\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.DownstreamApi.HttpContextAccessTokenAccessor\">\n            <summary>Reads the current access token from ASP.NET Core's authenticated session.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DownstreamApi.HttpContextAccessTokenAccessor.#ctor(Microsoft.AspNetCore.Http.IHttpContextAccessor)\">\n            <summary>Reads the current access token from ASP.NET Core's authenticated session.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DownstreamApi.HttpContextAccessTokenAccessor.GetRequiredTokenAsync(System.Threading.CancellationToken)\">\n            <inheritdoc />\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.DownstreamApi.ICurrentAccessTokenAccessor\">\n            <summary>Reads the already-validated current user access token for delegation.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DownstreamApi.ICurrentAccessTokenAccessor.GetRequiredTokenAsync(System.Threading.CancellationToken)\">\n            <summary>Gets the current validated access token or fails when no authenticated session supplies one.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.DownstreamApi.IDownstreamApiClient\">\n            <summary>Sends bounded authenticated requests to configured downstream APIs.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.DownstreamApi.IDownstreamApiClient.SendAsync(System.String,System.Net.Http.HttpRequestMessage,System.Threading.CancellationToken)\">\n            <summary>Sends one relative request using the named API's governed token mode.</summary>\n            <param name=\"registration\">The exact configured downstream API name.</param>\n            <param name=\"request\">A request with a relative URI and no caller-owned authorization header.</param>\n            <param name=\"cancellationToken\">Cancels token and downstream I/O.</param>\n            <returns>The downstream response, owned by the caller.</returns>\n        </member>\n    </members>\n</doc>\n",
    "orbyss-foundation/feature.json": "{\n  \"schemaVersion\": 2,\n  \"packageId\": \"Orbyss.Foundation.Authentication.DownstreamApi\",\n  \"features\": [\n    {\n      \"identity\": \"Orbyss.Foundation.Authentication.DownstreamApi\",\n      \"featureDependencies\": [],\n      \"runtimeDependencies\": [],\n      \"routes\": [],\n      \"dormant\": true,\n      \"composeForOpenApi\": false,\n      \"requiresContractCoverage\": false\n    }\n  ],\n  \"sourceSha256\": {\n    \"DownstreamApiClient.cs\": \"6eebece3891da35edadfa19dc67fd2c65b0b28726bd307c12bc63f81a131e04e\",\n    \"DownstreamApiOptions.cs\": \"ca1f1c3be86d1a38c4668373d2b122d04b1e4960e1d4ea815291fd63eb15c237\",\n    \"DownstreamApiOptionsValidator.cs\": \"b10ab66b024e9e38f637968cb4dde2178274d8e50713549740acc6efe2917953\",\n    \"DownstreamApiRegistration.cs\": \"da3feaeea41ce553f1da2a6fd9daad694dc27c14cad6b3a9080cf1cd126cd7a9\",\n    \"FoundationDownstreamApiFeature.cs\": \"ee7844310af7977832d443dd9eb90364bdeecb3d368a60e989ea098c2bffb96b\",\n    \"HttpContextAccessTokenAccessor.cs\": \"720b43be403d5025cbcc26d7246c0f34c24f8a501becb56d32e81dc05b07e2c4\",\n    \"ICurrentAccessTokenAccessor.cs\": \"6deed5eee3bb8b2a1b327df887aacf5b2c2a031ef6d38aa421795419032cf2d2\",\n    \"IDownstreamApiClient.cs\": \"5eb6d62fb76ff0b1c835f9c027b3198ddea32dbfd14b7369f52f18df25dfb001\"\n  },\n  \"hostProvidedDependencies\": [\n    {\n      \"packageId\": \"CShells.Abstractions\",\n      \"minimumVersion\": \"0.0.30-preview.159\"\n    },\n    {\n      \"packageId\": \"JetBrains.Annotations\",\n      \"minimumVersion\": \"2025.2.4\"\n    }\n  ]\n}\n",
    "orbyss-foundation/settings.json": "{\n  \"schemaVersion\": 2,\n  \"packageId\": \"Orbyss.Foundation.Authentication.DownstreamApi\",\n  \"packageVersion\": \"0.3.1\",\n  \"sourceSha256\": {\n    \"DownstreamApiClient.cs\": \"6eebece3891da35edadfa19dc67fd2c65b0b28726bd307c12bc63f81a131e04e\",\n    \"DownstreamApiOptions.cs\": \"ca1f1c3be86d1a38c4668373d2b122d04b1e4960e1d4ea815291fd63eb15c237\",\n    \"DownstreamApiOptionsValidator.cs\": \"b10ab66b024e9e38f637968cb4dde2178274d8e50713549740acc6efe2917953\",\n    \"DownstreamApiRegistration.cs\": \"da3feaeea41ce553f1da2a6fd9daad694dc27c14cad6b3a9080cf1cd126cd7a9\",\n    \"FoundationDownstreamApiFeature.cs\": \"ee7844310af7977832d443dd9eb90364bdeecb3d368a60e989ea098c2bffb96b\",\n    \"HttpContextAccessTokenAccessor.cs\": \"720b43be403d5025cbcc26d7246c0f34c24f8a501becb56d32e81dc05b07e2c4\",\n    \"ICurrentAccessTokenAccessor.cs\": \"6deed5eee3bb8b2a1b327df887aacf5b2c2a031ef6d38aa421795419032cf2d2\",\n    \"IDownstreamApiClient.cs\": \"5eb6d62fb76ff0b1c835f9c027b3198ddea32dbfd14b7369f52f18df25dfb001\"\n  },\n  \"contracts\": [\n    {\n      \"schemaVersion\": 2,\n      \"owner\": \"Orbyss.Foundation.Authentication.DownstreamApi\",\n      \"scope\": \"downstream-apis\",\n      \"complete\": true,\n      \"sources\": {\n        \"DownstreamApiClient.cs\": \"6eebece3891da35edadfa19dc67fd2c65b0b28726bd307c12bc63f81a131e04e\",\n        \"DownstreamApiOptions.cs\": \"ca1f1c3be86d1a38c4668373d2b122d04b1e4960e1d4ea815291fd63eb15c237\",\n        \"DownstreamApiOptionsValidator.cs\": \"b10ab66b024e9e38f637968cb4dde2178274d8e50713549740acc6efe2917953\",\n        \"DownstreamApiRegistration.cs\": \"da3feaeea41ce553f1da2a6fd9daad694dc27c14cad6b3a9080cf1cd126cd7a9\",\n        \"FoundationDownstreamApiFeature.cs\": \"ee7844310af7977832d443dd9eb90364bdeecb3d368a60e989ea098c2bffb96b\",\n        \"HttpContextAccessTokenAccessor.cs\": \"720b43be403d5025cbcc26d7246c0f34c24f8a501becb56d32e81dc05b07e2c4\",\n        \"ICurrentAccessTokenAccessor.cs\": \"6deed5eee3bb8b2a1b327df887aacf5b2c2a031ef6d38aa421795419032cf2d2\",\n        \"IDownstreamApiClient.cs\": \"5eb6d62fb76ff0b1c835f9c027b3198ddea32dbfd14b7369f52f18df25dfb001\"\n      },\n      \"settings\": [\n        {\n          \"path\": \"Foundation:Authentication:DownstreamApis:Registrations\",\n          \"required\": true,\n          \"secret\": false,\n          \"constraints\": {\n            \"minProperties\": 1\n          },\n          \"binding\": \"The selected shell feature binds this section from ShellSettings.GetConfigurationRoot using the native .NET configuration binder. Options are consumed within that shell provider generation; recompose/restart the shell to replace cached options.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets downstream APIs keyed by an application-owned name.\",\n          \"type\": \"object\",\n          \"default\": {}\n        }\n      ],\n      \"semanticConstraints\": [\n        \"Endpoints/base addresses must be absolute HTTPS without query/fragment. Loopback HTTP is accepted only in Development with the explicit development override.\",\n        \"Named registration keys must not be blank and are compared ordinally.\",\n        \"Required string settings must not be empty or whitespace.\",\n        \"Configuration is metadata only; token clients and downstream requests are never initialized or executed by export.\",\n        \"TokenExchange mode requires at least one nonblank Audience or Resource to downscope the delegated token.\",\n        \"A nonnull Resource must be an absolute HTTP or HTTPS URI; it is not the downstream base-address transport setting.\",\n        \"Named TokenRegistration must be supplied; resolving the actual selected token source is a separate composition responsibility.\"\n      ],\n      \"appliesTo\": {\n        \"kind\": \"shell\",\n        \"features\": [\n          \"Orbyss.Foundation.Authentication.DownstreamApi\"\n        ],\n        \"configuration\": [\n          \"Foundation:Authentication:DownstreamApis\"\n        ]\n      },\n      \"typeName\": \"Orbyss.Foundation.Authentication.DownstreamApi.DownstreamApiOptions\"\n    },\n    {\n      \"schemaVersion\": 2,\n      \"owner\": \"Orbyss.Foundation.Authentication.DownstreamApi\",\n      \"scope\": \"downstream-apis-registration\",\n      \"complete\": true,\n      \"sources\": {\n        \"DownstreamApiClient.cs\": \"6eebece3891da35edadfa19dc67fd2c65b0b28726bd307c12bc63f81a131e04e\",\n        \"DownstreamApiOptions.cs\": \"ca1f1c3be86d1a38c4668373d2b122d04b1e4960e1d4ea815291fd63eb15c237\",\n        \"DownstreamApiOptionsValidator.cs\": \"b10ab66b024e9e38f637968cb4dde2178274d8e50713549740acc6efe2917953\",\n        \"DownstreamApiRegistration.cs\": \"da3feaeea41ce553f1da2a6fd9daad694dc27c14cad6b3a9080cf1cd126cd7a9\",\n        \"FoundationDownstreamApiFeature.cs\": \"ee7844310af7977832d443dd9eb90364bdeecb3d368a60e989ea098c2bffb96b\",\n        \"HttpContextAccessTokenAccessor.cs\": \"720b43be403d5025cbcc26d7246c0f34c24f8a501becb56d32e81dc05b07e2c4\",\n        \"ICurrentAccessTokenAccessor.cs\": \"6deed5eee3bb8b2a1b327df887aacf5b2c2a031ef6d38aa421795419032cf2d2\",\n        \"IDownstreamApiClient.cs\": \"5eb6d62fb76ff0b1c835f9c027b3198ddea32dbfd14b7369f52f18df25dfb001\"\n      },\n      \"settings\": [\n        {\n          \"path\": \"Foundation:Authentication:DownstreamApis:Registrations:*:BaseAddress\",\n          \"required\": true,\n          \"secret\": false,\n          \"constraints\": {\n            \"format\": \"uri\"\n          },\n          \"binding\": \"The selected shell feature binds this section from ShellSettings.GetConfigurationRoot using the native .NET configuration binder. Options are consumed within that shell provider generation; recompose/restart the shell to replace cached options.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the absolute downstream base address.\",\n          \"type\": \"string\",\n          \"default\": \"\"\n        },\n        {\n          \"path\": \"Foundation:Authentication:DownstreamApis:Registrations:*:AccessMode\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"enum\": [\n              \"ClientCredentials\",\n              \"TokenExchange\"\n            ]\n          },\n          \"binding\": \"The selected shell feature binds this section from ShellSettings.GetConfigurationRoot using the native .NET configuration binder. Options are consumed within that shell provider generation; recompose/restart the shell to replace cached options.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets \\u0060ClientCredentials\\u0060 or \\u0060TokenExchange\\u0060.\",\n          \"type\": \"string\",\n          \"default\": \"ClientCredentials\"\n        },\n        {\n          \"path\": \"Foundation:Authentication:DownstreamApis:Registrations:*:TokenRegistration\",\n          \"required\": true,\n          \"secret\": false,\n          \"constraints\": {\n            \"minLength\": 1\n          },\n          \"binding\": \"The selected shell feature binds this section from ShellSettings.GetConfigurationRoot using the native .NET configuration binder. Options are consumed within that shell provider generation; recompose/restart the shell to replace cached options.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the named token-source or exchange-policy registration.\",\n          \"type\": \"string\",\n          \"default\": \"\"\n        },\n        {\n          \"path\": \"Foundation:Authentication:DownstreamApis:Registrations:*:Audience\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"nullable\": true\n          },\n          \"binding\": \"The selected shell feature binds this section from ShellSettings.GetConfigurationRoot using the native .NET configuration binder. Options are consumed within that shell provider generation; recompose/restart the shell to replace cached options.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the exchange target audience.\",\n          \"type\": \"string\",\n          \"default\": null\n        },\n        {\n          \"path\": \"Foundation:Authentication:DownstreamApis:Registrations:*:Resource\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"nullable\": true\n          },\n          \"binding\": \"The selected shell feature binds this section from ShellSettings.GetConfigurationRoot using the native .NET configuration binder. Options are consumed within that shell provider generation; recompose/restart the shell to replace cached options.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the exchange target resource URI.\",\n          \"type\": \"string\",\n          \"default\": null\n        },\n        {\n          \"path\": \"Foundation:Authentication:DownstreamApis:Registrations:*:Scopes\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"items\": {\n              \"type\": \"string\",\n              \"pattern\": \"^\\\\S\\u002B$\"\n            }\n          },\n          \"binding\": \"The selected shell feature binds this section from ShellSettings.GetConfigurationRoot using the native .NET configuration binder. Options are consumed within that shell provider generation; recompose/restart the shell to replace cached options.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets exact scopes used to downscope a delegated token.\",\n          \"type\": \"array\",\n          \"default\": []\n        },\n        {\n          \"path\": \"Foundation:Authentication:DownstreamApis:Registrations:*:AllowHttpForLocalDevelopment\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {},\n          \"binding\": \"The selected shell feature binds this section from ShellSettings.GetConfigurationRoot using the native .NET configuration binder. Options are consumed within that shell provider generation; recompose/restart the shell to replace cached options.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets whether loopback HTTP is accepted during local development.\",\n          \"type\": \"boolean\",\n          \"default\": false\n        }\n      ],\n      \"semanticConstraints\": [\n        \"Endpoints/base addresses must be absolute HTTPS without query/fragment. Loopback HTTP is accepted only in Development with the explicit development override.\",\n        \"Named registration keys must not be blank and are compared ordinally.\",\n        \"Required string settings must not be empty or whitespace.\",\n        \"Configuration is metadata only; token clients and downstream requests are never initialized or executed by export.\",\n        \"TokenExchange mode requires at least one nonblank Audience or Resource to downscope the delegated token.\",\n        \"A nonnull Resource must be an absolute HTTP or HTTPS URI; it is not the downstream base-address transport setting.\",\n        \"Named TokenRegistration must be supplied; resolving the actual selected token source is a separate composition responsibility.\"\n      ],\n      \"appliesTo\": {\n        \"kind\": \"shell\",\n        \"features\": [\n          \"Orbyss.Foundation.Authentication.DownstreamApi\"\n        ],\n        \"configuration\": [\n          \"Foundation:Authentication:DownstreamApis\"\n        ]\n      },\n      \"typeName\": \"Orbyss.Foundation.Authentication.DownstreamApi.DownstreamApiRegistration\"\n    }\n  ],\n  \"assembly\": {\n    \"name\": \"Orbyss.Foundation.Authentication.DownstreamApi.dll\",\n    \"sha256\": \"a74b8d1b24dceff1580fe1358a62e74437427a2e797a7a9525bfdb3f2fea2b7c\"\n  },\n  \"imports\": []\n}\n"
  }
}
