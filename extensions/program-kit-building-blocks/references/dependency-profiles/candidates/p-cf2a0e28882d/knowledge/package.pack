  },
  "facts": {
    "README.md": "# Orbyss.Foundation.DomainEvents\n\nThis package supplies Orbyss Foundation's default awaited in-process dispatcher. Activate the\n`Orbyss.Foundation.DomainEvents` feature in each shell that publishes or handles domain events.\n\nHandler-owning features reference only `Orbyss.Foundation.DomainEvents.Abstractions` and register their\nhandlers through their normal feature service collection:\n\n```csharp\nservices.AddScoped<IDomainEventHandler<CatalogRevisionPublished>, RefreshCatalogProjection>();\n```\n\nThey do not reference this concrete package; `shells.json` activates it independently.\n\nThe dispatcher resolves scoped typed handlers, invokes them sequentially, propagates cancellation\nand failures, carries separate technical publication metadata, instruments each publication, and\nbounds nested publication depth and count. Handler registration order is not a supported business\nordering contract.\n\nThis implementation is deliberately non-durable. Publishing after a state commit can be lost if\nthe process terminates. Reliable post-commit, background, broker, or cross-process delivery requires\nthe separately governed Integration Events capability and an atomic outbox; do not simulate it with\nfire-and-forget domain-event handlers.\n",
    "lib/net10.0/Orbyss.Foundation.DomainEvents.xml": "<?xml version=\"1.0\"?>\n<doc>\n    <assembly>\n        <name>Orbyss.Foundation.DomainEvents</name>\n    </assembly>\n    <members>\n        <member name=\"T:Orbyss.Foundation.DomainEvents.DefaultDomainEventPublisher\">\n            <summary>Dispatches handlers sequentially and propagates failures to the publishing operation.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.DomainEvents.DefaultDomainEventPublisher.#ctor(System.IServiceProvider,Orbyss.Foundation.DomainEvents.DomainEventDispatchOptions,System.TimeProvider)\">\n            <summary>Dispatches handlers sequentially and propagates failures to the publishing operation.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.DomainEvents.DefaultDomainEventPublisher.ActivitySource\">\n            <summary>Emits one activity for every attempted publication.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.DomainEvents.DefaultDomainEventPublisher._currentDispatch\">\n            <summary>Flows nested publication metadata without introducing an ambient service locator.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.DomainEvents.DefaultDomainEventPublisher.PublishAsync``1(``0,System.Threading.CancellationToken)\">\n            <inheritdoc />\n        </member>\n        <member name=\"M:Orbyss.Foundation.DomainEvents.DefaultDomainEventPublisher.EnforceBounds(Orbyss.Foundation.DomainEvents.DomainEventDispatchState)\">\n            <summary>Rejects cycles or event storms before another handler is invoked.</summary>\n            <param name=\"state\">The active dispatch state.</param>\n        </member>\n        <member name=\"M:Orbyss.Foundation.DomainEvents.DefaultDomainEventPublisher.StartActivity``1(Orbyss.Foundation.DomainEvents.DomainEventContext)\">\n            <summary>Starts one observable activity without changing event delivery semantics.</summary>\n            <typeparam name=\"TEvent\">The published event type.</typeparam>\n            <param name=\"context\">The publication context.</param>\n            <returns>The activity when a listener is present; otherwise, <see langword=\"null\"/>.</returns>\n        </member>\n        <member name=\"T:Orbyss.Foundation.DomainEvents.DomainEventDispatchOptions\">\n            <summary>Bounds nested in-process event publication without defining business ordering.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.DomainEvents.DomainEventDispatchOptions.MaximumDepth\">\n            <summary>Gets or sets the maximum zero-based nested publication depth.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.DomainEvents.DomainEventDispatchOptions.MaximumPublications\">\n            <summary>Gets or sets the maximum number of publications in one top-level dispatch.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.DomainEvents.DomainEventDispatchOptions.Validate\">\n            <summary>Rejects unsafe dispatch bounds during feature activation.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.DomainEvents.DomainEventDispatchState\">\n            <summary>Tracks one awaited top-level dispatch and its nested publications.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.DomainEvents.DomainEventDispatchState.#ctor(System.Guid)\">\n            <summary>Tracks one awaited top-level dispatch and its nested publications.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.DomainEvents.DomainEventDispatchState.DispatchId\">\n            <summary>Gets the top-level dispatch identifier.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.DomainEvents.DomainEventDispatchState.ActivePublicationId\">\n            <summary>Gets or sets the active publication identifier used as nested causation.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.DomainEvents.DomainEventDispatchState.Depth\">\n            <summary>Gets or sets the current nested publication depth.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.DomainEvents.DomainEventDispatchState.PublicationCount\">\n            <summary>Gets or sets the total publications attempted by this dispatch.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.DomainEvents.FoundationDomainEventServiceCollectionExtensions\">\n            <summary>Registers the default awaited in-process domain-event dispatcher.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.DomainEvents.FoundationDomainEventServiceCollectionExtensions.AddFoundationDomainEvents(Microsoft.Extensions.DependencyInjection.IServiceCollection,System.Action{Orbyss.Foundation.DomainEvents.DomainEventDispatchOptions})\">\n            <summary>Registers the dispatcher and validates its bounded-publication options.</summary>\n            <param name=\"services\">The current shell service collection.</param>\n            <param name=\"configure\">Optionally configures dispatch safety bounds.</param>\n            <returns>The supplied service collection.</returns>\n        </member>\n        <member name=\"T:Orbyss.Foundation.DomainEvents.FoundationDomainEventsFeature\">\n            <summary>Composes in-process domain-event publication into one CShells generation.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.DomainEvents.FoundationDomainEventsFeature.ConfigureServices(Microsoft.Extensions.DependencyInjection.IServiceCollection)\">\n            <inheritdoc />\n        </member>\n    </members>\n</doc>\n",
    "orbyss-foundation/feature.json": "{\n  \"schemaVersion\": 2,\n  \"packageId\": \"Orbyss.Foundation.DomainEvents\",\n  \"features\": [\n    {\n      \"identity\": \"Orbyss.Foundation.DomainEvents\",\n      \"featureDependencies\": [],\n      \"runtimeDependencies\": [],\n      \"routes\": [],\n      \"dormant\": true,\n      \"composeForOpenApi\": false,\n      \"requiresContractCoverage\": false\n    }\n  ],\n  \"sourceSha256\": {\n    \"DefaultDomainEventPublisher.cs\": \"7112d46c5322f305cd34779c8e76232c5523f0c3279f62f24186e36220b5a8d1\",\n    \"DomainEventDispatchOptions.cs\": \"7ab008d4ed30e6b46fc58c14f321412e2dd1e995a7c1fb72db8c9ad0b0cfc9bb\",\n    \"DomainEventDispatchState.cs\": \"22aa5cd42584dd806c414b84e0c651d56decbe584a606e07d218c7b15be3473a\",\n    \"FoundationDomainEventServiceCollectionExtensions.cs\": \"a2af30ed07b507c8644e395e410686218d22e84067d8b5906575a0c8d3038d87\",\n    \"FoundationDomainEventsFeature.cs\": \"00439a59482fc18f9cc2c408faf7be5db762b4012a3b74f180df1ad4713e4316\"\n  },\n  \"hostProvidedDependencies\": [\n    {\n      \"packageId\": \"CShells.Abstractions\",\n      \"minimumVersion\": \"0.0.30-preview.159\"\n    },\n    {\n      \"packageId\": \"JetBrains.Annotations\",\n      \"minimumVersion\": \"2025.2.4\"\n    },\n    {\n      \"packageId\": \"Microsoft.Extensions.Configuration.Abstractions\",\n      \"minimumVersion\": \"10.0.0\"\n    },\n    {\n      \"packageId\": \"Microsoft.Extensions.Configuration\",\n      \"minimumVersion\": \"10.0.0\"\n    },\n    {\n      \"packageId\": \"Microsoft.Extensions.DependencyInjection.Abstractions\",\n      \"minimumVersion\": \"10.0.12\"\n    },\n    {\n      \"packageId\": \"Microsoft.Extensions.Options\",\n      \"minimumVersion\": \"10.0.0\"\n    },\n    {\n      \"packageId\": \"Microsoft.Extensions.Primitives\",\n      \"minimumVersion\": \"10.0.0\"\n    }\n  ]\n}\n",
    "orbyss-foundation/settings.json": "{\n  \"schemaVersion\": 2,\n  \"packageId\": \"Orbyss.Foundation.DomainEvents\",\n  \"packageVersion\": \"0.3.1\",\n  \"sourceSha256\": {\n    \"DefaultDomainEventPublisher.cs\": \"7112d46c5322f305cd34779c8e76232c5523f0c3279f62f24186e36220b5a8d1\",\n    \"DomainEventDispatchOptions.cs\": \"7ab008d4ed30e6b46fc58c14f321412e2dd1e995a7c1fb72db8c9ad0b0cfc9bb\",\n    \"DomainEventDispatchState.cs\": \"22aa5cd42584dd806c414b84e0c651d56decbe584a606e07d218c7b15be3473a\",\n    \"FoundationDomainEventServiceCollectionExtensions.cs\": \"a2af30ed07b507c8644e395e410686218d22e84067d8b5906575a0c8d3038d87\",\n    \"FoundationDomainEventsFeature.cs\": \"00439a59482fc18f9cc2c408faf7be5db762b4012a3b74f180df1ad4713e4316\"\n  },\n  \"contracts\": [\n    {\n      \"schemaVersion\": 2,\n      \"owner\": \"Orbyss.Foundation.DomainEvents\",\n      \"scope\": \"domain-event-dispatch\",\n      \"complete\": true,\n      \"sources\": {\n        \"DefaultDomainEventPublisher.cs\": \"7112d46c5322f305cd34779c8e76232c5523f0c3279f62f24186e36220b5a8d1\",\n        \"DomainEventDispatchOptions.cs\": \"7ab008d4ed30e6b46fc58c14f321412e2dd1e995a7c1fb72db8c9ad0b0cfc9bb\",\n        \"DomainEventDispatchState.cs\": \"22aa5cd42584dd806c414b84e0c651d56decbe584a606e07d218c7b15be3473a\",\n        \"FoundationDomainEventServiceCollectionExtensions.cs\": \"a2af30ed07b507c8644e395e410686218d22e84067d8b5906575a0c8d3038d87\",\n        \"FoundationDomainEventsFeature.cs\": \"00439a59482fc18f9cc2c408faf7be5db762b4012a3b74f180df1ad4713e4316\"\n      },\n      \"settings\": [\n        {\n          \"path\": \"DomainEventDispatchOptions:MaximumDepth\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"minimum\": 0\n          },\n          \"binding\": \"Code construction and AddFoundationDomainEvents optional configure delegate; not a configuration-file section.\",\n          \"precedence\": [\n            \"typed source initializer\",\n            \"ordered shell configuration providers\",\n            \"code configuration registered after binding\"\n          ],\n          \"reload\": \"immutable\",\n          \"description\": \"Supported MaximumDepth value owned by DomainEventDispatchOptions.\",\n          \"type\": \"integer\",\n          \"default\": 32\n        },\n        {\n          \"path\": \"DomainEventDispatchOptions:MaximumPublications\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"minimum\": 1\n          },\n          \"binding\": \"Code construction and AddFoundationDomainEvents optional configure delegate; not a configuration-file section.\",\n          \"precedence\": [\n            \"typed source initializer\",\n            \"ordered shell configuration providers\",\n            \"code configuration registered after binding\"\n          ],\n          \"reload\": \"immutable\",\n          \"description\": \"Supported MaximumPublications value owned by DomainEventDispatchOptions.\",\n          \"type\": \"integer\",\n          \"default\": 1024\n        }\n      ],\n      \"semanticConstraints\": [\n        \"AddFoundationDomainEvents constructs the typed value, applies the caller delegate, validates it and registers one shell-owned snapshot; there is no JSON configuration binder.\"\n      ],\n      \"appliesTo\": {\n        \"kind\": \"code\",\n        \"features\": [],\n        \"configuration\": []\n      },\n      \"typeName\": \"Orbyss.Foundation.DomainEvents.DomainEventDispatchOptions\"\n    }\n  ],\n  \"assembly\": {\n    \"name\": \"Orbyss.Foundation.DomainEvents.dll\",\n    \"sha256\": \"844379455eb37549288afa750126466be431eecc014c3f29051090ec70955c48\"\n  },\n  \"imports\": []\n}\n"
