  "facts": {
    "README.md": "# Orbyss.Foundation.Authentication.Assurance\n\nProvider-neutral authentication assurance packaged as a CShell feature. Named policies evaluate\nstandard OIDC `acr`, `amr`, and `auth_time` claims after the selected authentication profile has\nvalidated the token or session. Applications authorize with `assurance:<name>` or use\n`IAssuranceEvaluator` to decide whether an interactive step-up is required.\n\nAccepted ACR values are exact sets rather than a provider-specific numeric hierarchy. Identity\nadapters map those portable requirements to their own authentication flows; the runtime package\ncontains no realm, flow-execution, authenticator, or provider administration concepts.\n",
    "lib/net10.0/Orbyss.Foundation.Authentication.Assurance.xml": "<?xml version=\"1.0\"?>\n<doc>\n    <assembly>\n        <name>Orbyss.Foundation.Authentication.Assurance</name>\n    </assembly>\n    <members>\n        <member name=\"T:Orbyss.Foundation.Authentication.Assurance.AssuranceAuthorizationHandler\">\n            <summary>Applies assurance evaluation to ASP.NET authorization.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.Assurance.AssuranceAuthorizationHandler.#ctor(Orbyss.Foundation.Authentication.Assurance.IAssuranceEvaluator)\">\n            <summary>Applies assurance evaluation to ASP.NET authorization.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.Assurance.AssuranceAuthorizationHandler.HandleRequirementAsync(Microsoft.AspNetCore.Authorization.AuthorizationHandlerContext,Orbyss.Foundation.Authentication.Assurance.AssuranceRequirement)\">\n            <inheritdoc />\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.Assurance.AssuranceEvaluation\">\n            <summary>Reports whether a principal satisfies one named assurance policy.</summary>\n            <param name=\"Satisfied\">Whether all configured evidence requirements passed.</param>\n            <param name=\"FailureCode\">Stable failure code, or null when satisfied.</param>\n            <param name=\"AcceptedAcrValues\">Exact ACR values an interactive client may request for step-up.</param>\n            <param name=\"MaximumAuthenticationAgeSeconds\">Maximum authentication age requested by the policy.</param>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.Assurance.AssuranceEvaluation.#ctor(System.Boolean,System.String,System.Collections.Generic.IReadOnlyList{System.String},System.Nullable{System.Int32})\">\n            <summary>Reports whether a principal satisfies one named assurance policy.</summary>\n            <param name=\"Satisfied\">Whether all configured evidence requirements passed.</param>\n            <param name=\"FailureCode\">Stable failure code, or null when satisfied.</param>\n            <param name=\"AcceptedAcrValues\">Exact ACR values an interactive client may request for step-up.</param>\n            <param name=\"MaximumAuthenticationAgeSeconds\">Maximum authentication age requested by the policy.</param>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.Assurance.AssuranceEvaluation.Satisfied\">\n            <summary>Whether all configured evidence requirements passed.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.Assurance.AssuranceEvaluation.FailureCode\">\n            <summary>Stable failure code, or null when satisfied.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.Assurance.AssuranceEvaluation.AcceptedAcrValues\">\n            <summary>Exact ACR values an interactive client may request for step-up.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.Assurance.AssuranceEvaluation.MaximumAuthenticationAgeSeconds\">\n            <summary>Maximum authentication age requested by the policy.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.Assurance.AssuranceEvaluator\">\n            <summary>Evaluates exact ACR, AMR, and authentication-age requirements.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.Assurance.AssuranceEvaluator.#ctor(Microsoft.Extensions.Options.IOptions{Orbyss.Foundation.Authentication.Assurance.AssuranceOptions},System.TimeProvider)\">\n            <summary>Evaluates exact ACR, AMR, and authentication-age requirements.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.Assurance.AssuranceEvaluator.Evaluate(System.Security.Claims.ClaimsPrincipal,System.String)\">\n            <inheritdoc />\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.Assurance.AssuranceEvaluator.ReadAuthenticationMethods(System.Security.Claims.ClaimsPrincipal)\">\n            <summary>Reads repeated and JSON-array AMR claim representations.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.Assurance.AssuranceEvaluator.Failure(System.String,Orbyss.Foundation.Authentication.Assurance.AssurancePolicy)\">\n            <summary>Creates a stable failed evaluation while preserving step-up request metadata.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.Assurance.AssuranceOptions\">\n            <summary>Defines named provider-neutral authentication-assurance policies.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Authentication.Assurance.AssuranceOptions.SectionName\">\n            <summary>Gets the shell configuration section containing assurance policies.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.Assurance.AssuranceOptions.Policies\">\n            <summary>Gets policies keyed by an application-owned assurance name.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.Assurance.AssuranceOptions.ClockSkewSeconds\">\n            <summary>Gets or sets the tolerated clock skew when validating authentication time.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.Assurance.AssuranceOptionsValidator\">\n            <summary>Rejects ambiguous or ineffective assurance policies.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.Assurance.AssuranceOptionsValidator.Validate(System.String,Orbyss.Foundation.Authentication.Assurance.AssuranceOptions)\">\n            <inheritdoc />\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.Assurance.AssuranceOptionsValidator.ValidateValues(System.String[],System.String,System.Collections.Generic.ICollection{System.String})\">\n            <summary>Rejects empty and duplicate exact claim values.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.Assurance.AssuranceOptionsValidator.PolicyNamePattern\">\n            <remarks>\n            Pattern:<br/>\n            <code>^[a-z][a-z0-9.-]{0,63}$</code><br/>\n            Options:<br/>\n            <code>RegexOptions.CultureInvariant</code><br/>\n            Explanation:<br/>\n            <code>\n            \u25cb Match if at the beginning of the string.<br/>\n            \u25cb Match a character in the set [a-z].<br/>\n            \u25cb Match a character in the set [\\-.0-9a-z] atomically at most 63 times.<br/>\n            \u25cb Match if at the end of the string or if before an ending newline.<br/>\n            </code>\n            </remarks>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.Assurance.AssurancePolicy\">\n            <summary>Describes acceptable standard OIDC authentication-context evidence.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.Assurance.AssurancePolicy.AcceptedAcrValues\">\n            <summary>Gets or sets exact acceptable Authentication Context Class Reference values.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.Assurance.AssurancePolicy.RequiredAmrValues\">\n            <summary>Gets or sets Authentication Methods Reference values that must all be present.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.Assurance.AssurancePolicy.MaximumAuthenticationAgeSeconds\">\n            <summary>Gets or sets the maximum authentication age in seconds, or null for no freshness rule.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.Assurance.AssurancePolicyNames\">\n            <summary>Builds stable ASP.NET authorization policy names for authentication assurance.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Authentication.Assurance.AssurancePolicyNames.Prefix\">\n            <summary>Gets the reserved prefix for assurance authorization policies.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.Assurance.AssurancePolicyNames.For(System.String)\">\n            <summary>Builds the authorization-policy name for one configured assurance policy.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.Assurance.AssuranceRequirement\">\n            <summary>Identifies one named assurance requirement inside ASP.NET authorization.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.Assurance.AssuranceRequirement.#ctor(System.String)\">\n            <summary>Identifies one named assurance requirement inside ASP.NET authorization.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.Assurance.FoundationAssuranceFeature\">\n            <summary>Composes provider-neutral assurance policies into one shell.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.Assurance.FoundationAssuranceFeature.#ctor(CShells.ShellSettings)\">\n            <summary>Composes provider-neutral assurance policies into one shell.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.Assurance.FoundationAssuranceFeature.ConfigureServices(Microsoft.Extensions.DependencyInjection.IServiceCollection)\">\n            <inheritdoc />\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.Assurance.IAssuranceEvaluator\">\n            <summary>Evaluates standard assurance claims without depending on an identity-provider product.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.Assurance.IAssuranceEvaluator.Evaluate(System.Security.Claims.ClaimsPrincipal,System.String)\">\n            <summary>Evaluates one named policy against an already validated principal.</summary>\n        </member>\n        <member name=\"T:System.Text.RegularExpressions.Generated.PolicyNamePattern_0\">\n            <summary>Custom <see cref=\"T:System.Text.RegularExpressions.Regex\"/>-derived type for the PolicyNamePattern method.</summary>\n        </member>\n        <member name=\"F:System.Text.RegularExpressions.Generated.PolicyNamePattern_0.Instance\">\n            <summary>Cached, thread-safe singleton instance.</summary>\n        </member>\n        <member name=\"M:System.Text.RegularExpressions.Generated.PolicyNamePattern_0.#ctor\">\n            <summary>Initializes the instance.</summary>\n        </member>\n        <member name=\"T:System.Text.RegularExpressions.Generated.PolicyNamePattern_0.RunnerFactory\">\n            <summary>Provides a factory for creating <see cref=\"T:System.Text.RegularExpressions.RegexRunner\"/> instances to be used by methods on <see cref=\"T:System.Text.RegularExpressions.Regex\"/>.</summary>\n        </member>\n        <member name=\"M:System.Text.RegularExpressions.Generated.PolicyNamePattern_0.RunnerFactory.CreateInstance\">\n            <summary>Creates an instance of a <see cref=\"T:System.Text.RegularExpressions.RegexRunner\"/> used by methods on <see cref=\"T:System.Text.RegularExpressions.Regex\"/>.</summary>\n        </member>\n        <member name=\"T:System.Text.RegularExpressions.Generated.PolicyNamePattern_0.RunnerFactory.Runner\">\n            <summary>Provides the runner that contains the custom logic implementing the specified regular expression.</summary>\n        </member>\n        <member name=\"M:System.Text.RegularExpressions.Generated.PolicyNamePattern_0.RunnerFactory.Runner.Scan(System.ReadOnlySpan{System.Char})\">\n            <summary>Scan the <paramref name=\"inputSpan\"/> starting from base.runtextstart for the next match.</summary>\n            <param name=\"inputSpan\">The text being scanned by the regular expression.</param>\n        </member>\n        <member name=\"M:System.Text.RegularExpressions.Generated.PolicyNamePattern_0.RunnerFactory.Runner.TryFindNextPossibleStartingPosition(System.ReadOnlySpan{System.Char})\">\n            <summary>Search <paramref name=\"inputSpan\"/> starting from base.runtextpos for the next location a match could possibly start.</summary>\n            <param name=\"inputSpan\">The text being scanned by the regular expression.</param>\n            <returns>true if a possible match was found; false if no more matches are possible.</returns>\n        </member>\n        <member name=\"M:System.Text.RegularExpressions.Generated.PolicyNamePattern_0.RunnerFactory.Runner.TryMatchAtCurrentPosition(System.ReadOnlySpan{System.Char})\">\n            <summary>Determine whether <paramref name=\"inputSpan\"/> at base.runtextpos is a match for the regular expression.</summary>\n            <param name=\"inputSpan\">The text being scanned by the regular expression.</param>\n            <returns>true if the regular expression matches at the current position; otherwise, false.</returns>\n        </member>\n        <member name=\"T:System.Text.RegularExpressions.Generated.Utilities\">\n            <summary>Helper methods used by generated <see cref=\"T:System.Text.RegularExpressions.Regex\"/>-derived implementations.</summary>\n        </member>\n        <member name=\"F:System.Text.RegularExpressions.Generated.Utilities.s_defaultTimeout\">\n            <summary>Default timeout value set in <see cref=\"T:System.AppContext\"/>, or <see cref=\"F:System.Text.RegularExpressions.Regex.InfiniteMatchTimeout\"/> if none was set.</summary>\n        </member>\n        <member name=\"F:System.Text.RegularExpressions.Generated.Utilities.s_hasTimeout\">\n            <summary>Whether <see cref=\"F:System.Text.RegularExpressions.Generated.Utilities.s_defaultTimeout\"/> is non-infinite.</summary>\n        </member>\n    </members>\n</doc>\n",
