  },
  "facts": {
    "README.md": "# Orbyss.Foundation.Identity.Admin.Abstractions\n\nProvider-neutral contracts for identity administration from application workflows. The contracts\ncover portable concepts such as users, applications, scopes, roles, groups, credentials,\nenrollment actions, and sessions. Install an identity-provider adapter to implement only the\nsubdomains a shell needs.\n",
    "lib/net10.0/Orbyss.Foundation.Identity.Admin.Abstractions.xml": "<?xml version=\"1.0\"?>\n<doc>\n    <assembly>\n        <name>Orbyss.Foundation.Identity.Admin.Abstractions</name>\n    </assembly>\n    <members>\n        <member name=\"T:Orbyss.Foundation.Identity.Admin.CreateIdentityApplication\">\n            <summary>Portable fields used to create or replace an OAuth/OIDC application.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.CreateIdentityApplication.#ctor(System.String,System.String,System.Boolean,System.Boolean,System.Collections.Generic.IReadOnlyList{System.String},System.Collections.Generic.IReadOnlyList{System.String},System.Boolean)\">\n            <summary>Portable fields used to create or replace an OAuth/OIDC application.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Identity.Admin.CreateIdentityUser\">\n            <summary>Portable fields used to create a user account.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.CreateIdentityUser.#ctor(System.String,System.String,System.String,System.String,System.Boolean,System.Boolean,System.Collections.Generic.IReadOnlyDictionary{System.String,System.String[]})\">\n            <summary>Portable fields used to create a user account.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Identity.Admin.IdentityApplication\">\n            <summary>A provider-neutral application or OAuth client.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IdentityApplication.#ctor(System.String,System.String,System.String,System.Boolean,System.Boolean,System.Collections.Generic.IReadOnlyList{System.String},System.Collections.Generic.IReadOnlyList{System.String})\">\n            <summary>A provider-neutral application or OAuth client.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Identity.Admin.IdentityClaimMapping\">\n            <summary>A portable token claim mapping backed by a user attribute.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IdentityClaimMapping.#ctor(System.String,System.String,System.String,System.String,System.Boolean,System.Boolean,System.Boolean)\">\n            <summary>A portable token claim mapping backed by a user attribute.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Identity.Admin.IdentityCredential\">\n            <summary>A provider-neutral enrolled credential.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IdentityCredential.#ctor(System.String,System.String,System.String,System.Nullable{System.Int64})\">\n            <summary>A provider-neutral enrolled credential.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Identity.Admin.IdentityEnrollmentAction\">\n            <summary>An interactive enrollment or account-maintenance action.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Identity.Admin.IdentityEnrollmentAction.VerifyEmail\">\n            <summary>Verify ownership of the account email address.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Identity.Admin.IdentityEnrollmentAction.UpdatePassword\">\n            <summary>Choose or replace the password.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Identity.Admin.IdentityEnrollmentAction.ConfigureTotp\">\n            <summary>Configure a time-based one-time-password authenticator.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Identity.Admin.IdentityEnrollmentAction.RegisterPasskey\">\n            <summary>Register a passkey or security key.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Identity.Admin.IdentityEnrollmentAction.UpdateProfile\">\n            <summary>Complete required profile fields.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Identity.Admin.IdentityGroup\">\n            <summary>A provider-neutral group.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IdentityGroup.#ctor(System.String,System.String,System.String)\">\n            <summary>A provider-neutral group.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Identity.Admin.IdentityPage`1\">\n            <summary>A page of identity-provider results and its optional unpaged total.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IdentityPage`1.#ctor(System.Collections.Generic.IReadOnlyList{`0},System.Nullable{System.Int32})\">\n            <summary>A page of identity-provider results and its optional unpaged total.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Identity.Admin.IdentityRole\">\n            <summary>A provider-neutral role.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IdentityRole.#ctor(System.String,System.String,System.String,System.Boolean)\">\n            <summary>A provider-neutral role.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Identity.Admin.IdentityScope\">\n            <summary>A provider-neutral OAuth/OIDC client scope.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IdentityScope.#ctor(System.String,System.String,System.String)\">\n            <summary>A provider-neutral OAuth/OIDC client scope.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Identity.Admin.IdentitySession\">\n            <summary>A provider-neutral login session.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IdentitySession.#ctor(System.String,System.String,System.String,System.Nullable{System.Int64},System.Nullable{System.Int64},System.Collections.Generic.IReadOnlyList{System.String})\">\n            <summary>A provider-neutral login session.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Identity.Admin.IdentityUser\">\n            <summary>A provider-neutral user account.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IdentityUser.#ctor(System.String,System.String,System.String,System.String,System.String,System.Boolean,System.Boolean,System.Collections.Generic.IReadOnlyDictionary{System.String,System.String[]})\">\n            <summary>A provider-neutral user account.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Identity.Admin.IIdentityAccessAdministration\">\n            <summary>Administers portable realm roles, groups, and their user assignments.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IIdentityAccessAdministration.GetRolesAsync(System.Threading.CancellationToken)\">\n            <summary>Gets all realm-wide roles available for portable assignment.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IIdentityAccessAdministration.CreateRoleAsync(System.String,System.String,System.Threading.CancellationToken)\">\n            <summary>Creates a realm-wide role.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IIdentityAccessAdministration.DeleteRoleAsync(System.String,System.Threading.CancellationToken)\">\n            <summary>Deletes a realm-wide role by name.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IIdentityAccessAdministration.AddRolesToUserAsync(System.String,System.Collections.Generic.IReadOnlyCollection{Orbyss.Foundation.Identity.Admin.IdentityRole},System.Threading.CancellationToken)\">\n            <summary>Adds a set of realm-wide roles to a user.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IIdentityAccessAdministration.RemoveRolesFromUserAsync(System.String,System.Collections.Generic.IReadOnlyCollection{Orbyss.Foundation.Identity.Admin.IdentityRole},System.Threading.CancellationToken)\">\n            <summary>Removes a set of realm-wide roles from a user.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IIdentityAccessAdministration.GetGroupsAsync(System.String,System.Threading.CancellationToken)\">\n            <summary>Gets groups matching a provider-supported free-text search.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IIdentityAccessAdministration.CreateGroupAsync(System.String,System.String,System.Threading.CancellationToken)\">\n            <summary>Creates a top-level group or a child beneath the supplied parent.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IIdentityAccessAdministration.DeleteGroupAsync(System.String,System.Threading.CancellationToken)\">\n            <summary>Deletes a group and its provider-defined descendants.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IIdentityAccessAdministration.AddUserToGroupAsync(System.String,System.String,System.Threading.CancellationToken)\">\n            <summary>Adds a user to a group.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IIdentityAccessAdministration.RemoveUserFromGroupAsync(System.String,System.String,System.Threading.CancellationToken)\">\n            <summary>Removes a user from a group.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Identity.Admin.IIdentityApplicationAdministration\">\n            <summary>Administers portable OAuth/OIDC application lifecycle operations.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IIdentityApplicationAdministration.FindAsync(System.String,System.Int32,System.Int32,System.Threading.CancellationToken)\">\n            <summary>Finds a bounded page of registered applications by client identifier.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IIdentityApplicationAdministration.GetAsync(System.String,System.Threading.CancellationToken)\">\n            <summary>Gets one registered application, or returns null when absent.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IIdentityApplicationAdministration.CreateAsync(Orbyss.Foundation.Identity.Admin.CreateIdentityApplication,System.Threading.CancellationToken)\">\n            <summary>Creates an application and returns its stable provider identifier.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IIdentityApplicationAdministration.UpdateAsync(System.String,Orbyss.Foundation.Identity.Admin.CreateIdentityApplication,System.Threading.CancellationToken)\">\n            <summary>Replaces the portable application configuration.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IIdentityApplicationAdministration.DeleteAsync(System.String,System.Threading.CancellationToken)\">\n            <summary>Deletes an application registration.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IIdentityApplicationAdministration.RotateSecretAsync(System.String,System.Threading.CancellationToken)\">\n            <summary>Rotates and returns the confidential application's new client secret.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Identity.Admin.IIdentityEnrollmentAdministration\">\n            <summary>Administers credentials and starts user-facing enrollment actions.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IIdentityEnrollmentAdministration.GetCredentialsAsync(System.String,System.Threading.CancellationToken)\">\n            <summary>Gets the credentials currently enrolled for a user.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IIdentityEnrollmentAdministration.DeleteCredentialAsync(System.String,System.String,System.Threading.CancellationToken)\">\n            <summary>Deletes one enrolled credential from a user.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IIdentityEnrollmentAdministration.SetPasswordAsync(System.String,System.String,System.Boolean,System.Threading.CancellationToken)\">\n            <summary>Sets a user password, temporary by default so the user must replace it.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IIdentityEnrollmentAdministration.SendActionsAsync(System.String,System.Collections.Generic.IReadOnlyCollection{Orbyss.Foundation.Identity.Admin.IdentityEnrollmentAction},System.Uri,System.String,System.Threading.CancellationToken)\">\n            <summary>Sends a user-facing link that starts the selected enrollment actions.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Identity.Admin.IIdentityScopeAdministration\">\n            <summary>Administers reusable scopes and portable user-attribute claim mappings.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IIdentityScopeAdministration.GetAllAsync(System.Threading.CancellationToken)\">\n            <summary>Gets all reusable scopes exposed by the provider.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IIdentityScopeAdministration.CreateAsync(System.String,System.String,System.Threading.CancellationToken)\">\n            <summary>Creates a reusable scope and returns its stable provider identifier.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IIdentityScopeAdministration.DeleteAsync(System.String,System.Threading.CancellationToken)\">\n            <summary>Deletes a reusable scope.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IIdentityScopeAdministration.AddDefaultToApplicationAsync(System.String,System.String,System.Threading.CancellationToken)\">\n            <summary>Adds a scope to the application's default token request.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IIdentityScopeAdministration.AddOptionalToApplicationAsync(System.String,System.String,System.Threading.CancellationToken)\">\n            <summary>Adds a scope that an application can request explicitly.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IIdentityScopeAdministration.RemoveFromApplicationAsync(System.String,System.String,System.Boolean,System.Threading.CancellationToken)\">\n            <summary>Removes a default or optional scope assignment from an application.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IIdentityScopeAdministration.AddClaimMappingAsync(System.String,Orbyss.Foundation.Identity.Admin.IdentityClaimMapping,System.Threading.CancellationToken)\">\n            <summary>Adds a portable user-attribute mapping to a reusable scope.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Identity.Admin.IIdentitySessionAdministration\">\n            <summary>Observes and revokes portable user sessions.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IIdentitySessionAdministration.GetForUserAsync(System.String,System.Threading.CancellationToken)\">\n            <summary>Gets the active login sessions for a user.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IIdentitySessionAdministration.LogoutUserAsync(System.String,System.Threading.CancellationToken)\">\n            <summary>Revokes all active and offline sessions for one user.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IIdentitySessionAdministration.LogoutAllAsync(System.Threading.CancellationToken)\">\n            <summary>Revokes all active sessions for the configured identity domain.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Identity.Admin.IIdentityUserAdministration\">\n            <summary>Administers portable user-account lifecycle operations.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IIdentityUserAdministration.FindAsync(System.String,System.Int32,System.Int32,System.Threading.CancellationToken)\">\n            <summary>Finds a bounded page of users by a provider-supported free-text search.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IIdentityUserAdministration.GetAsync(System.String,System.Threading.CancellationToken)\">\n            <summary>Gets one user by its stable provider identifier, or returns null when absent.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IIdentityUserAdministration.CreateAsync(Orbyss.Foundation.Identity.Admin.CreateIdentityUser,System.Threading.CancellationToken)\">\n            <summary>Creates a user and returns its stable provider identifier.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IIdentityUserAdministration.UpdateAsync(System.String,Orbyss.Foundation.Identity.Admin.UpdateIdentityUser,System.Threading.CancellationToken)\">\n            <summary>Replaces the portable mutable fields of an existing user.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.IIdentityUserAdministration.DeleteAsync(System.String,System.Threading.CancellationToken)\">\n            <summary>Deletes an existing user account.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Identity.Admin.UpdateIdentityUser\">\n            <summary>Portable mutable fields used to replace a user account representation.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Identity.Admin.UpdateIdentityUser.#ctor(System.String,System.String,System.String,System.String,System.Boolean,System.Boolean,System.Collections.Generic.IReadOnlyDictionary{System.String,System.String[]})\">\n            <summary>Portable mutable fields used to replace a user account representation.</summary>\n        </member>\n    </members>\n</doc>\n"
  }
}
