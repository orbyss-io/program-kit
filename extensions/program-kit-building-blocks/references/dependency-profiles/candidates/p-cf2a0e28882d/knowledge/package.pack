    "README.md": "43a27e479d42c66480ab85f9ced67a6ee4fdbab7999dc46265df3a0955b756df",
    "lib/net10.0/Orbyss.Foundation.Web.OpenApi.dll": "5ca1c4f32958b8d18e99d7ed25d51bb26829a2edb32b2add92a47b3e09028b05",
    "lib/net10.0/Orbyss.Foundation.Web.OpenApi.xml": "7b23b03baa14cb7091228f3190bfbf48eedd8f24fb8e90be75273bc5671c6dce",
