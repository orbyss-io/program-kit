    "orbyss-foundation/settings.json": "{\n  \"schemaVersion\": 2,\n  \"packageId\": \"Orbyss.Foundation.Authentication.Assurance\",\n  \"packageVersion\": \"0.3.1\",\n  \"sourceSha256\": {\n    \"AssuranceAuthorizationHandler.cs\": \"6751604c12245c60aee88bc26f6cb2dedeb13b816bbf6a6725dd6593346a8ed8\",\n    \"AssuranceEvaluation.cs\": \"03fbc49068f21bc5c462bd1a41529c1a09ff3285c07c2071b22832b63b3408d0\",\n    \"AssuranceEvaluator.cs\": \"88931a1330e4823e3e249742e884a7fbdd472c26faecf379759b6a22f21c0c24\",\n    \"AssuranceOptions.cs\": \"7af7bc939e1fb22925ed4f2d78b6a40b87cdb1aee8be5d6790288199fa88fb0a\",\n    \"AssuranceOptionsValidator.cs\": \"20da0f953379bde3c81f6047c40ea8a4a386850925f507a4d7b95d33815dfd63\",\n    \"AssurancePolicy.cs\": \"275b4b9f01587a922e5ed2461fc27432b34e7593e33cb7fb67bedd8542ea2071\",\n    \"AssurancePolicyNames.cs\": \"e9081e5a429688d48f75eedf249af25dc43d12d6984c5869a56c0ce90187466f\",\n    \"AssuranceRequirement.cs\": \"ebb567c7c7a0c03b1fe6ccdcbd670a9cfa28ef77f5f325c8582c2ac680643d40\",\n    \"FoundationAssuranceFeature.cs\": \"25a42e51624912e4f4aa968d9ba125addb72e115396ac100ac5b278c36cf69d5\",\n    \"IAssuranceEvaluator.cs\": \"bd6d8f50e90eca2420f0e7cec12b386fbc65fb41ff9b3cc84dffe676548ce59d\"\n  },\n  \"contracts\": [\n    {\n      \"schemaVersion\": 2,\n      \"owner\": \"Orbyss.Foundation.Authentication.Assurance\",\n      \"scope\": \"assurance\",\n      \"complete\": true,\n      \"sources\": {\n        \"AssuranceAuthorizationHandler.cs\": \"6751604c12245c60aee88bc26f6cb2dedeb13b816bbf6a6725dd6593346a8ed8\",\n        \"AssuranceEvaluation.cs\": \"03fbc49068f21bc5c462bd1a41529c1a09ff3285c07c2071b22832b63b3408d0\",\n        \"AssuranceEvaluator.cs\": \"88931a1330e4823e3e249742e884a7fbdd472c26faecf379759b6a22f21c0c24\",\n        \"AssuranceOptions.cs\": \"7af7bc939e1fb22925ed4f2d78b6a40b87cdb1aee8be5d6790288199fa88fb0a\",\n        \"AssuranceOptionsValidator.cs\": \"20da0f953379bde3c81f6047c40ea8a4a386850925f507a4d7b95d33815dfd63\",\n        \"AssurancePolicy.cs\": \"275b4b9f01587a922e5ed2461fc27432b34e7593e33cb7fb67bedd8542ea2071\",\n        \"AssurancePolicyNames.cs\": \"e9081e5a429688d48f75eedf249af25dc43d12d6984c5869a56c0ce90187466f\",\n        \"AssuranceRequirement.cs\": \"ebb567c7c7a0c03b1fe6ccdcbd670a9cfa28ef77f5f325c8582c2ac680643d40\",\n        \"FoundationAssuranceFeature.cs\": \"25a42e51624912e4f4aa968d9ba125addb72e115396ac100ac5b278c36cf69d5\",\n        \"IAssuranceEvaluator.cs\": \"bd6d8f50e90eca2420f0e7cec12b386fbc65fb41ff9b3cc84dffe676548ce59d\"\n      },\n      \"settings\": [\n        {\n          \"path\": \"Foundation:Authentication:Assurance:Policies\",\n          \"required\": true,\n          \"secret\": false,\n          \"constraints\": {\n            \"minProperties\": 1,\n            \"propertyNames\": {\n              \"pattern\": \"^[a-z][a-z0-9.-]{0,63}$\"\n            }\n          },\n          \"binding\": \"The selected shell feature binds this section from ShellSettings.GetConfigurationRoot using the native .NET configuration binder. Options are consumed within that shell provider generation; recompose/restart the shell to replace cached options.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets policies keyed by an application-owned assurance name.\",\n          \"type\": \"object\",\n          \"default\": {}\n        },\n        {\n          \"path\": \"Foundation:Authentication:Assurance:ClockSkewSeconds\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"minimum\": 0,\n            \"maximum\": 120\n          },\n          \"binding\": \"The selected shell feature binds this section from ShellSettings.GetConfigurationRoot using the native .NET configuration binder. Options are consumed within that shell provider generation; recompose/restart the shell to replace cached options.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the tolerated clock skew when validating authentication time.\",\n          \"type\": \"integer\",\n          \"default\": 30\n        }\n      ],\n      \"semanticConstraints\": [\n        \"Every named policy must require ACR, AMR, or authentication freshness; policy names are ordinal lowercase identities.\"\n      ],\n      \"appliesTo\": {\n        \"kind\": \"shell\",\n        \"features\": [\n          \"Orbyss.Foundation.Authentication.Assurance\"\n        ],\n        \"configuration\": [\n          \"Foundation:Authentication:Assurance\"\n        ]\n      },\n      \"typeName\": \"Orbyss.Foundation.Authentication.Assurance.AssuranceOptions\"\n    },\n    {\n      \"schemaVersion\": 2,\n      \"owner\": \"Orbyss.Foundation.Authentication.Assurance\",\n      \"scope\": \"assurance-policy\",\n      \"complete\": true,\n      \"sources\": {\n        \"AssuranceAuthorizationHandler.cs\": \"6751604c12245c60aee88bc26f6cb2dedeb13b816bbf6a6725dd6593346a8ed8\",\n        \"AssuranceEvaluation.cs\": \"03fbc49068f21bc5c462bd1a41529c1a09ff3285c07c2071b22832b63b3408d0\",\n        \"AssuranceEvaluator.cs\": \"88931a1330e4823e3e249742e884a7fbdd472c26faecf379759b6a22f21c0c24\",\n        \"AssuranceOptions.cs\": \"7af7bc939e1fb22925ed4f2d78b6a40b87cdb1aee8be5d6790288199fa88fb0a\",\n        \"AssuranceOptionsValidator.cs\": \"20da0f953379bde3c81f6047c40ea8a4a386850925f507a4d7b95d33815dfd63\",\n        \"AssurancePolicy.cs\": \"275b4b9f01587a922e5ed2461fc27432b34e7593e33cb7fb67bedd8542ea2071\",\n        \"AssurancePolicyNames.cs\": \"e9081e5a429688d48f75eedf249af25dc43d12d6984c5869a56c0ce90187466f\",\n        \"AssuranceRequirement.cs\": \"ebb567c7c7a0c03b1fe6ccdcbd670a9cfa28ef77f5f325c8582c2ac680643d40\",\n        \"FoundationAssuranceFeature.cs\": \"25a42e51624912e4f4aa968d9ba125addb72e115396ac100ac5b278c36cf69d5\",\n        \"IAssuranceEvaluator.cs\": \"bd6d8f50e90eca2420f0e7cec12b386fbc65fb41ff9b3cc84dffe676548ce59d\"\n      },\n      \"settings\": [\n        {\n          \"path\": \"Foundation:Authentication:Assurance:Policies:*:AcceptedAcrValues\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"uniqueItems\": true,\n            \"items\": {\n              \"type\": \"string\",\n              \"minLength\": 1\n            }\n          },\n          \"binding\": \"The selected shell feature binds this section from ShellSettings.GetConfigurationRoot using the native .NET configuration binder. Options are consumed within that shell provider generation; recompose/restart the shell to replace cached options.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets exact acceptable Authentication Context Class Reference values.\",\n          \"type\": \"array\",\n          \"default\": []\n        },\n        {\n          \"path\": \"Foundation:Authentication:Assurance:Policies:*:RequiredAmrValues\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"uniqueItems\": true,\n            \"items\": {\n              \"type\": \"string\",\n              \"minLength\": 1\n            }\n          },\n          \"binding\": \"The selected shell feature binds this section from ShellSettings.GetConfigurationRoot using the native .NET configuration binder. Options are consumed within that shell provider generation; recompose/restart the shell to replace cached options.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets Authentication Methods Reference values that must all be present.\",\n          \"type\": \"array\",\n          \"default\": []\n        },\n        {\n          \"path\": \"Foundation:Authentication:Assurance:Policies:*:MaximumAuthenticationAgeSeconds\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"minimum\": 0,\n            \"maximum\": 86400,\n            \"nullable\": true\n          },\n          \"binding\": \"The selected shell feature binds this section from ShellSettings.GetConfigurationRoot using the native .NET configuration binder. Options are consumed within that shell provider generation; recompose/restart the shell to replace cached options.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the maximum authentication age in seconds, or null for no freshness rule.\",\n          \"type\": \"integer\",\n          \"default\": null\n        }\n      ],\n      \"semanticConstraints\": [\n        \"ACR/AMR items must be nonblank and unique with ordinal comparison.\",\n        \"Null maximum age means no freshness requirement; at least one evidence requirement must still be present.\"\n      ],\n      \"appliesTo\": {\n        \"kind\": \"shell\",\n        \"features\": [\n          \"Orbyss.Foundation.Authentication.Assurance\"\n        ],\n        \"configuration\": [\n          \"Foundation:Authentication:Assurance\"\n        ]\n      },\n      \"typeName\": \"Orbyss.Foundation.Authentication.Assurance.AssurancePolicy\"\n    }\n  ],\n  \"assembly\": {\n    \"name\": \"Orbyss.Foundation.Authentication.Assurance.dll\",\n    \"sha256\": \"502b88f91d7c03c6740b85e437df0e9167552735dde8c9e3e22a1755b2380c87\"\n  },\n  \"imports\": []\n}\n"
