  "facts": {
    "README.md": "# Orbyss Foundation Authentication Core\n\nProvides `ValidatedAccountIdentity` and the stable authentication claim and error-code vocabulary.\nThe issuer and subject retain exact ordinal values; no URI normalization or account authorization is performed.\nThis contract assembly has no ASP.NET, ClaimsPrincipal, provider or feature activation dependency.\nHTTP and principal admission belongs to `Orbyss.Foundation.Authentication`.\n",
    "lib/net10.0/Orbyss.Foundation.Authentication.Core.xml": "<?xml version=\"1.0\"?>\n<doc>\n    <assembly>\n        <name>Orbyss.Foundation.Authentication.Core</name>\n    </assembly>\n    <members>\n        <member name=\"T:Orbyss.Foundation.Authentication.Core.AuthenticationClaimTypes\">\n            <summary>Reserved authentication projection claim types, compatible with existing BFF tickets.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Authentication.Core.AuthenticationClaimTypes.ValidatedIssuer\">\n            <summary>Identifies the token-validated issuer projection.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Authentication.Core.AuthenticationClaimTypes.ValidatedSubject\">\n            <summary>Identifies the token-validated subject projection.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.Core.AuthenticationErrorCodes\">\n            <summary>Stable authentication and antiforgery failure codes.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Authentication.Core.AuthenticationErrorCodes.AuthenticationRequired\">\n            <summary>A session is required.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Authentication.Core.AuthenticationErrorCodes.IdentityInvalid\">\n            <summary>The authenticated ticket has no unambiguous validated account projection.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Authentication.Core.AuthenticationErrorCodes.AuthorizationDenied\">\n            <summary>The authenticated account is forbidden from the operation.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Authentication.Core.AuthenticationErrorCodes.CallbackInvalid\">\n            <summary>The remote authentication callback could not be admitted.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Authentication.Core.AuthenticationErrorCodes.IdentityProviderUnavailable\">\n            <summary>The remote identity provider was unavailable.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Authentication.Core.AuthenticationErrorCodes.InvalidAntiforgeryToken\">\n            <summary>The antiforgery token could not be admitted.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Authentication.Core.ValidatedAccountIdentity\">\n            <summary>An immutable account identity projected from a validated authentication ticket.</summary>\n            <remarks>Resource ownership and authorization remain application policies.</remarks>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Authentication.Core.ValidatedAccountIdentity.#ctor(System.String,System.String)\">\n            <summary>Creates a projection without normalizing its issuer or subject identity.</summary>\n            <param name=\"issuer\">The nonempty token-validated issuer.</param>\n            <param name=\"subject\">The nonempty token-validated subject.</param>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.Core.ValidatedAccountIdentity.Issuer\">\n            <summary>Gets the exact validated issuer.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Authentication.Core.ValidatedAccountIdentity.Subject\">\n            <summary>Gets the exact validated subject.</summary>\n        </member>\n    </members>\n</doc>\n"
  }
}
