t the shell to replace cached options.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the externally reachable Keycloak server base URL.\",\n          \"type\": \"string\",\n          \"default\": \"\"\n        },\n        {\n          \"path\": \"Foundation:Identity:Keycloak:Admin:Realm\",\n          \"required\": true,\n          \"secret\": false,\n          \"constraints\": {\n            \"minLength\": 1\n          },\n          \"binding\": \"The selected shell feature binds this section from ShellSettings.GetConfigurationRoot using the native .NET configuration binder. Options are consumed within that shell provider generation; recompose/restart the shell to replace cached options.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the target realm whose resources are administered.\",\n          \"type\": \"string\",\n          \"default\": \"\"\n        },\n        {\n          \"path\": \"Foundation:Identity:Keycloak:Admin:AdminRealm\",\n          \"required\": true,\n          \"secret\": false,\n          \"constraints\": {\n            \"minLength\": 1\n          },\n          \"binding\": \"The selected shell feature binds this section from ShellSettings.GetConfigurationRoot using the native .NET configuration binder. Options are consumed within that shell provider generation; recompose/restart the shell to replace cached options.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the realm that authenticates the service-account client.\",\n          \"type\": \"string\",\n          \"default\": \"master\"\n        },\n        {\n          \"path\": \"Foundation:Identity:Keycloak:Admin:ClientId\",\n          \"required\": true,\n          \"secret\": false,\n          \"constraints\": {\n            \"minLength\": 1\n          },\n          \"binding\": \"The selected shell feature binds this section from ShellSettings.GetConfigurationRoot using the native .NET configuration binder. Options are consumed within that shell provider generation; recompose/restart the shell to replace cached options.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the confidential service-account client identifier.\",\n          \"type\": \"string\",\n          \"default\": \"\"\n        },\n        {\n          \"path\": \"Foundation:Identity:Keycloak:Admin:ClientSecret\",\n          \"required\": true,\n          \"secret\": true,\n          \"constraints\": {},\n          \"binding\": \"The selected shell feature binds this section from ShellSettings.GetConfigurationRoot using the native .NET configuration binder. Options are consumed within that shell provider generation; recompose/restart the shell to replace cached options.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the confidential service-account client secret.\",\n          \"type\": \"string\"\n        },\n        {\n          \"path\": \"Foundation:Identity:Keycloak:Admin:AllowHttpForLocalDevelopment\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {},\n          \"binding\": \"The selected shell feature binds this section from ShellSettings.GetConfigurationRoot using the native .NET configuration binder. Options are consumed within that shell provider generation; recompose/restart the shell to replace cached options.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets whether loopback HTTP is allowed in the Development environment.\",\n          \"type\": \"boolean\",\n          \"default\": false\n        },\n        {\n          \"path\": \"Foundation:Identity:Keycloak:Admin:TimeoutSeconds\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"minimum\": 1,\n            \"maximum\": 120\n          },\n          \"binding\": \"The selected shell feature binds this section from ShellSettings.GetConfigurationRoot using the native .NET configuration binder. Options are consumed within that shell provider generation; recompose/restart the shell to replace cached options.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets the bounded HTTP operation timeout in seconds.\",\n          \"type\": \"integer\",\n          \"default\": 30\n        },\n        {\n          \"path\": \"Foundation:Identity:Keycloak:Admin:RefreshBeforeExpirySeconds\",\n          \"required\": false,\n          \"secret\": false,\n          \"constraints\": {\n            \"minimum\": 0,\n            \"maximum\": 300\n          },\n          \"binding\": \"The selected shell feature binds this section from ShellSettings.GetConfigurationRoot using the native .NET configuration binder. Options are consumed within that shell provider generation; recompose/restart the shell to replace cached options.\",\n          \"precedence\": [\n            \"typed property initializer\",\n            \"named shell Configuration snapshot\",\n            \"feature settings overlay in native shell composition\",\n            \"explicit registered options configuration in registration order\"\n          ],\n          \"reload\": \"restart\",\n          \"description\": \"Gets or sets how early a cached service-account token is refreshed.\",\n          \"type\": \"integer\",\n          \"default\": 30\n        }\n      ],\n      \"semanticConstraints\": [\n        \"ServerUrl must be absolute HTTPS without query/fragment; loopback HTTP requires Development and the explicit override.\",\n        \"Realm, AdminRealm and client credentials must be nonblank. Secret values and samples are excluded from export.\",\n        \"The Admin API client is not created, authenticated or contacted during settings export.\"\n      ],\n      \"appliesTo\": {\n        \"kind\": \"shell\",\n        \"features\": [\n          \"Orbyss.Foundation.Identity.Keycloak.Admin.Access\",\n          \"Orbyss.Foundation.Identity.Keycloak.Admin.Applications\",\n          \"Orbyss.Foundation.Identity.Keycloak.Admin.AuthenticationFlows\",\n          \"Orbyss.Foundation.Identity.Keycloak.Admin.Enrollment\",\n          \"Orbyss.Foundation.Identity.Keycloak.Admin.IdentityProviders\",\n          \"Orbyss.Foundation.Identity.Keycloak.Admin.Organizations\",\n          \"Orbyss.Foundation.Identity.Keycloak.Admin.RealmOperations\",\n          \"Orbyss.Foundation.Identity.Keycloak.Admin.Scopes\",\n          \"Orbyss.Foundation.Identity.Keycloak.Admin.Sessions\",\n          \"Orbyss.Foundation.Identity.Keycloak.Admin.Users\"\n        ],\n        \"configuration\": [\n          \"Foundation:Identity:Keycloak:Admin\"\n        ]\n      },\n      \"typeName\": \"Orbyss.Foundation.Identity.Keycloak.Admin.KeycloakAdminOptions\"\n    }\n  ],\n  \"assembly\": {\n    \"name\": \"Orbyss.Foundation.Identity.Keycloak.Admin.dll\",\n    \"sha256\": \"85f268094f2a9854da705249d17f5b6e439ea61f88cf83eff022868d51915fea\"\n  },\n  \"imports\": []\n}\n"
