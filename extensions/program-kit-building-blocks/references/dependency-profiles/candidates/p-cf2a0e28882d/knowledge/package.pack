  "facts": {
    "README.md": "# Orbyss.Foundation.Web.ProblemDetails.Core\n\nImmutable bounded problem definitions, field diagnostics, reserved envelope names and application\nfailure mapping contracts. No HTTP, serializer or activation dependency. Definitions contain safe\npublic text only; exception messages, submitted values and provider diagnostics are never mappings.\n",
    "lib/net10.0/Orbyss.Foundation.Web.ProblemDetails.Core.xml": "<?xml version=\"1.0\"?>\n<doc>\n    <assembly>\n        <name>Orbyss.Foundation.Web.ProblemDetails.Core</name>\n    </assembly>\n    <members>\n        <member name=\"T:Orbyss.Foundation.Web.ProblemDetails.Core.IProblemMapper`1\">\n            <summary>Maps an application-owned typed failure to safe bounded public text and diagnostics.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Web.ProblemDetails.Core.IProblemMapper`1.Map(`0)\">\n            <summary>Returns the immutable public definition; no exception or provider details are inferred.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Web.ProblemDetails.Core.ProblemCodes\">\n            <summary>Owns the existing stable generic managed-boundary error codes.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Web.ProblemDetails.Core.ProblemCodes.AuthenticationRequired\">\n            <summary>Caller authentication is required.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Web.ProblemDetails.Core.ProblemCodes.AuthorizationDenied\">\n            <summary>The authenticated caller is denied access.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Web.ProblemDetails.Core.ProblemCodes.InvalidRequest\">\n            <summary>The request was not admitted.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Web.ProblemDetails.Core.ProblemCodes.RequestFailed\">\n            <summary>The request failed without exposing private diagnostic detail.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Web.ProblemDetails.Core.ProblemDefinition\">\n            <summary>Owns an admitted immutable failure representation with finite diagnostics.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Web.ProblemDetails.Core.ProblemDefinition.MaximumFieldErrors\">\n            <summary>The maximum admitted diagnostic count, independent of deployment output budgets.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Web.ProblemDetails.Core.ProblemDefinition.#ctor(System.Int32,System.String,System.String,System.String,System.Collections.Generic.IEnumerable{Orbyss.Foundation.Web.ProblemDetails.Core.ProblemFieldError})\">\n            <summary>Constructs a safe public failure definition; the caller owns text localization.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Web.ProblemDetails.Core.ProblemDefinition.StatusCode\">\n            <summary>The HTTP failure status.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Web.ProblemDetails.Core.ProblemDefinition.Code\">\n            <summary>The stable public failure code.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Web.ProblemDetails.Core.ProblemDefinition.Title\">\n            <summary>An optional localized safe title.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Web.ProblemDetails.Core.ProblemDefinition.Detail\">\n            <summary>An optional bounded safe description, never an exception message.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Web.ProblemDetails.Core.ProblemDefinition.FieldErrors\">\n            <summary>The defensively owned field diagnostics.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Web.ProblemDetails.Core.ProblemDefinition.ValidateCode(System.String)\">\n            <summary>Validates a bounded public code token.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Web.ProblemDetails.Core.ProblemDefinition.ValidateText(System.String,System.String,System.Int32,System.Boolean)\">\n            <summary>Validates finite public text and excludes control characters and invalid UTF-16.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Web.ProblemDetails.Core.ProblemExtensionNames\">\n            <summary>Owns the stable shared problem envelope extension names.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Web.ProblemDetails.Core.ProblemExtensionNames.Code\">\n            <summary>The application or managed-boundary problem code.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Web.ProblemDetails.Core.ProblemExtensionNames.CorrelationId\">\n            <summary>The canonical request correlation identifier.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Web.ProblemDetails.Core.ProblemExtensionNames.TraceId\">\n            <summary>The retained 0.2.4 compatibility alias of correlationId.</summary>\n        </member>\n        <member name=\"F:Orbyss.Foundation.Web.ProblemDetails.Core.ProblemExtensionNames.FieldErrors\">\n            <summary>The bounded public field diagnostics.</summary>\n        </member>\n        <member name=\"T:Orbyss.Foundation.Web.ProblemDetails.Core.ProblemFieldError\">\n            <summary>A bounded field diagnostic containing safe public text and no submitted value.</summary>\n        </member>\n        <member name=\"M:Orbyss.Foundation.Web.ProblemDetails.Core.ProblemFieldError.#ctor(System.String,System.String,System.String)\">\n            <summary>Admits a diagnostic for a named public field.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Web.ProblemDetails.Core.ProblemFieldError.Field\">\n            <summary>The public field path.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Web.ProblemDetails.Core.ProblemFieldError.Code\">\n            <summary>The stable public diagnostic code.</summary>\n        </member>\n        <member name=\"P:Orbyss.Foundation.Web.ProblemDetails.Core.ProblemFieldError.Message\">\n            <summary>The safe public diagnostic text.</summary>\n        </member>\n    </members>\n</doc>\n"
  }
}
