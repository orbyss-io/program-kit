          ],
          "reload": "restart",
          "description": "Gets or sets the token-endpoint request timeout, in seconds."
        },
        {
          "property": "AllowHttpForLocalDevelopment",
          "path": "Foundation:Authentication:ClientCredentials:Registrations:*:AllowHttpForLocalDevelopment",
          "required": false,
          "secret": false,
          "constraints": {},
          "binding": "The selected shell feature binds this section from ShellSettings.GetConfigurationRoot using the native .NET configuration binder. Options are consumed within that shell provider generation; recompose/restart the shell to replace cached options.",
          "precedence": [
            "typed property initializer",
            "named shell Configuration snapshot",
            "feature settings overlay in native shell composition",
            "explicit registered options configuration in registration order"
          ],
          "reload": "restart",
          "description": "Gets or sets whether loopback HTTP is accepted during local development."
        }
      ],
      "semanticConstraints": [
        "Endpoints/base addresses must be absolute HTTPS without query/fragment. Loopback HTTP is accepted only in Development with the explicit development override.",
        "Named registration keys must not be blank and are compared ordinally.",
        "Required string settings must not be empty or whitespace.",
        "Configuration is metadata only; token clients and downstream requests are never initialized or executed by export.",
        "Each scope is a nonblank individual OAuth scope value without whitespace; this validator does not require uniqueness."
      ]
    }
  ]
