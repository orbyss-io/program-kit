{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbyss.io/program-kit/building-blocks-lock.schema.json",
  "title": "Program Kit deterministic building-block lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "producer", "inputs", "instances", "targets", "activations", "registryRequirements", "configurationRequirements", "managedOutputs", "planDigest"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["programKitVersion", "resolverContractVersion"],
      "properties": {
        "programKitVersion": { "$ref": "#/$defs/version" },
        "resolverContractVersion": { "const": "1" }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection", "catalog", "architectureAuthority"],
      "properties": {
        "selection": { "$ref": "#/$defs/input" },
        "catalog": { "$ref": "#/$defs/catalogInput" },
        "architectureAuthority": { "$ref": "#/$defs/authorityInput" }
      }
    },
    "instances": { "type": "array", "items": { "type": "object" } },
    "targets": { "type": "array", "items": { "$ref": "#/$defs/target" } },
    "activations": { "type": "array", "items": { "type": "object" } },
    "registryRequirements": { "type": "array", "items": { "type": "object" } },
    "configurationRequirements": { "type": "array", "items": { "type": "object" } },
    "managedOutputs": { "type": "array", "items": { "type": "object" } },
    "planDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "version": { "type": "string", "minLength": 1 },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "canonicalSha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "canonicalSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "catalogInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "resolutionRevision", "resolutionSha256", "rawSha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "resolutionRevision": { "type": "integer", "minimum": 1 },
        "resolutionSha256": { "$ref": "#/$defs/sha256" },
        "rawSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "authorityInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "authoritySha256", "decisionIds"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "authoritySha256": { "$ref": "#/$defs/sha256" },
        "decisionIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "packages"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "lockRoot": { "type": "string", "minLength": 1 },
        "packages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["packageKey", "packageId", "family", "ecosystem", "version", "source", "materializationKind", "origins"],
            "properties": {
              "packageKey": { "type": "string", "minLength": 1 },
              "packageId": { "type": "string", "minLength": 1 },
              "family": { "type": "string", "minLength": 1 },
              "ecosystem": { "type": "string", "minLength": 1 },
              "version": { "$ref": "#/$defs/version" },
              "source": { "type": "string", "minLength": 1 },
              "materializationKind": { "type": "string", "minLength": 1 },
              "commands": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
              "reference": { "type": "string", "minLength": 1 },
              "origins": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true }
            }
          }
        }
      }
    }
  }
}
