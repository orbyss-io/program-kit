{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbyss.io/program-kit/building-block-restore-request.schema.json",
  "title": "Program Kit building-block restore request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "repository", "lock", "lockSha256", "planDigest", "commands"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "mode": { "enum": ["renew", "locked"] },
    "repository": { "const": "." },
    "lock": { "type": "string", "minLength": 1 },
    "lockSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "planDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ecosystem", "cwd", "args", "subject"],
        "properties": {
          "ecosystem": { "enum": ["nuget", "dotnet-tool", "npm"] },
          "cwd": { "type": "string", "minLength": 1 },
          "args": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "subject": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
