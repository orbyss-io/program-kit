<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Orbyss.Foundation.PostgreSql" Version="$(SelectedFoundationVersion)" />
    <PackageReference Include="CShells.Abstractions" Version="$(SelectedCShellsVersion)" />
    <PackageReference Include="CShells" Version="$(SelectedCShellsVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="$(SelectedEfVersion)" PrivateAssets="all" />
  </ItemGroup>
</Project>
