{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbyss.io/program-kit/retained-inputs.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "records", "protected", "activeDocuments"],
  "properties": {
    "schemaVersion": {"const": 1},
    "records": {"type": "array", "maxItems": 256, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "path", "sha256"],
      "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}, "path": {"$ref": "#/$defs/path"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    }},
    "retiredLocks": {"type": "array", "maxItems": 256, "items": {
      "type": "object", "additionalProperties": false, "required": ["path", "record", "owners"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "record": {"type": "string", "minLength": 1},
        "owners": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}}
    }},
    "archives": {"type": "array", "maxItems": 256, "items": {
      "type": "object", "additionalProperties": false, "required": ["record"],
      "properties": {"record": {"type": "string", "minLength": 1}}
    }},
    "protected": {"type": "array", "maxItems": 256, "items": {
      "type": "object", "additionalProperties": false, "required": ["path", "record"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "record": {"type": "string", "minLength": 1}}
    }},
    "activeDocuments": {"type": "array", "maxItems": 256, "items": {
      "type": "object", "additionalProperties": false, "required": ["path", "supersedes"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "supersedes": {"type": "array", "minItems": 1,
        "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}}
    }}
  },
  "$defs": {"path": {"type": "string", "minLength": 1, "maxLength": 1024}}
}
