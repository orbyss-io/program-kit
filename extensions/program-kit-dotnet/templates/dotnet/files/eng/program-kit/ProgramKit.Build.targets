<Project>
  <PropertyGroup>
    <ProgramKitOpenApiEnabled Condition="'$(ProgramKitOpenApiEnabled)' == ''">false</ProgramKitOpenApiEnabled>
    <ProgramKitOpenApiInitializeBaseline Condition="'$(ProgramKitOpenApiInitializeBaseline)' == ''">false</ProgramKitOpenApiInitializeBaseline>
    <ProgramKitOpenApiUpdateGenerated Condition="'$(ProgramKitOpenApiUpdateGenerated)' == ''">false</ProgramKitOpenApiUpdateGenerated>
    <ProgramKitOasdiffVersion Condition="'$(ProgramKitOasdiffVersion)' == ''">1.29.1</ProgramKitOasdiffVersion>
    <ProgramKitOasdiffCommand Condition="'$(ProgramKitOasdiffCommand)' == ''">oasdiff</ProgramKitOasdiffCommand>
    <ProgramKitPythonCommand Condition="'$(ProgramKitPythonCommand)' == ''">python</ProgramKitPythonCommand>
    <ProgramKitFeatureDormant Condition="'$(ProgramKitFeatureDormant)' == ''">false</ProgramKitFeatureDormant>
    <_ProgramKitFeatureMetadataFile>$(IntermediateOutputPath)program-kit/feature.json</_ProgramKitFeatureMetadataFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(ProgramKitFeatureIdentity)' != ''">
    <None Include="$(_ProgramKitFeatureMetadataFile)" Pack="true" PackagePath="program-kit/feature.json" Visible="false" />
  </ItemGroup>

  <Target Name="ProgramKitValidatePackageVersion" BeforeTargets="Pack" Condition="'$(IsPackable)' == 'true'">
    <Error Condition="'$(Version)' == '0.0.0-local'" Text="A release package requires an explicit application Version." />
  </Target>

  <Target Name="ProgramKitApiContracts"
          AfterTargets="Build"
          Condition="'$(ProgramKitOpenApiEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(ProgramKitOpenApiGeneratedDocument)' == ''"
           Text="PKO100 ProgramKitOpenApiGeneratedDocument must name the build-generated OpenAPI JSON file." />
    <Error Condition="'$(ProgramKitOpenApiArtifact)' == ''"
           Text="PKO101 ProgramKitOpenApiArtifact must name the deterministic consumer-owned generated artifact." />
    <Error Condition="'$(ProgramKitOpenApiBaseline)' == ''"
           Text="PKO102 ProgramKitOpenApiBaseline must name the consumer-owned compatibility baseline." />
    <Exec Command="&quot;$(ProgramKitPythonCommand)&quot; &quot;$(MSBuildThisFileDirectory)openapi_contracts.py&quot; --generated &quot;$(ProgramKitOpenApiGeneratedDocument)&quot; --artifact &quot;$(ProgramKitOpenApiArtifact)&quot; --baseline &quot;$(ProgramKitOpenApiBaseline)&quot; --oasdiff &quot;$(ProgramKitOasdiffCommand)&quot; --oasdiff-version &quot;$(ProgramKitOasdiffVersion)&quot; --approval &quot;$(ProgramKitOpenApiBreakingApproval)&quot; $([MSBuild]::ValueOrDefault('$(_ProgramKitOpenApiInitializeArgument)', '')) $([MSBuild]::ValueOrDefault('$(_ProgramKitOpenApiUpdateArgument)', ''))" />
  </Target>

  <Target Name="ProgramKitFeatureMetadata"
          BeforeTargets="GenerateNuspec"
          Condition="'$(ProgramKitFeatureIdentity)' != ''">
    <Error Condition="'$(IsPackable)' != 'true'" Text="PKF100 a Program Kit feature project must be packable." />
    <Error Condition="'$(AssemblyName)' != '$(PackageId)'"
           Text="PKF101 Program Kit feature AssemblyName must equal PackageId so Nuplane can resolve the package main assembly deterministically." />
    <Error Condition="('%(PackageReference.Identity)' == 'CShells.Abstractions' or '%(PackageReference.Identity)' == 'CShells.AspNetCore.Abstractions' or '%(PackageReference.Identity)' == 'Microsoft.Extensions.DependencyInjection.Abstractions' or '%(PackageReference.Identity)' == 'Microsoft.Extensions.Logging.Abstractions' or '%(PackageReference.Identity)' == 'ProgramKit.Tasks.Abstractions') and '%(PackageReference.PrivateAssets)' != 'all'"
           Text="PKF102 feature host-abstraction PackageReference '%(PackageReference.Identity)' must set PrivateAssets=all; the host supplies the shared contract." />
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_ProgramKitFeatureMetadataFile)'))" />
    <Exec Command="&quot;$(ProgramKitPythonCommand)&quot; &quot;$(MSBuildThisFileDirectory)feature_metadata.py&quot; emit --output &quot;$(_ProgramKitFeatureMetadataFile)&quot; --identity &quot;$(ProgramKitFeatureIdentity)&quot; --package-id &quot;$(PackageId)&quot; --feature-dependencies &quot;$(ProgramKitFeatureDependencies)&quot; --runtime-dependencies &quot;$(ProgramKitRuntimeDependencies)&quot; --routes &quot;$(ProgramKitFeatureRoutes)&quot; --dormant &quot;$(ProgramKitFeatureDormant)&quot;" />
  </Target>

  <PropertyGroup Condition="'$(ProgramKitOpenApiInitializeBaseline)' == 'true'">
    <_ProgramKitOpenApiInitializeArgument>--initialize-baseline</_ProgramKitOpenApiInitializeArgument>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ProgramKitOpenApiUpdateGenerated)' == 'true'">
    <_ProgramKitOpenApiUpdateArgument>--write-generated</_ProgramKitOpenApiUpdateArgument>
  </PropertyGroup>
</Project>
