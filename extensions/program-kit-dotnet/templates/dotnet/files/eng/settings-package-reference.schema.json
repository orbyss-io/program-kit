{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbyss.io/program-kit/settings-package-reference.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "packageId",
    "packageVersion",
    "packageSha256",
    "scope"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "foundation-package"
    },
    "packageId": {
      "type": "string",
      "minLength": 1
    },
    "packageVersion": {
      "type": "string",
      "minLength": 1
    },
    "packageSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
