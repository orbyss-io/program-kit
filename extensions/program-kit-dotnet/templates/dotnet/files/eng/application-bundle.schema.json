{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbyss.io/program-kit/application-bundle.schema.json",
  "title": "Consumer release bundle descriptor for the published Foundation host",
  "type": "object",
  "required": [
    "schemaVersion",
    "application",
    "hostImage",
    "runtimeClosure",
    "configuration",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "application": {
      "type": "object",
      "required": [
        "id",
        "version",
        "sourceCommit",
        "programKitVersion"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sourceCommit": {
          "type": "string",
          "minLength": 1
        },
        "programKitVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "hostImage": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "digest",
        "reference"
      ],
      "properties": {
        "repository": {
          "const": "ghcr.io/orbyss-io/foundation-host"
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "reference": {
          "type": "string",
          "pattern": "@sha256:[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "runtimeClosure": {
      "type": "object",
      "required": [
        "evidence",
        "digest",
        "packageCount",
        "packageHashesAreRunScoped"
      ],
      "properties": {
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "packageCount": {
          "type": "integer"
        },
        "packageHashesAreRunScoped": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "configuration": {
      "type": "object",
      "required": [
        "hostsettings",
        "hostsettingsSha256",
        "shells",
        "shellsSha256",
        "webProfileShells",
        "webProfileShellsSha256",
        "nuplane",
        "nuplaneSha256"
      ],
      "properties": {
        "hostsettings": {
          "type": "object"
        },
        "hostsettingsSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "shells": {
          "type": "object",
          "required": [
            "CShells"
          ]
        },
        "shellsSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "webProfileShells": {
          "type": [
            "object",
            "null"
          ],
          "description": "Managed selected-profile shell contribution, or null when no contribution is staged."
        },
        "webProfileShellsSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$",
          "description": "Digest of webProfileShells, or null when that contribution is absent."
        },
        "nuplane": {
          "type": "object",
          "required": [
            "Nuplane"
          ]
        },
        "nuplaneSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "file",
          "sha256"
        ],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
