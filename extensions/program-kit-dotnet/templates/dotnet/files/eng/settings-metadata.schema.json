{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbyss.io/program-kit/settings-metadata.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "owner",
    "scope",
    "complete",
    "sources",
    "settings",
    "semanticConstraints"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "complete": {
      "type": "boolean"
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "settings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "type",
          "required",
          "secret",
          "constraints",
          "binding",
          "precedence",
          "reload",
          "description"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "string",
              "integer",
              "number",
              "boolean",
              "array",
              "object"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "secret": {
            "type": "boolean"
          },
          "constraints": {
            "type": "object"
          },
          "binding": {
            "type": "string",
            "minLength": 1
          },
          "precedence": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "reload": {
            "enum": [
              "restart",
              "reload",
              "immutable"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "default": {}
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "secret": {
                  "const": true
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "default"
                ]
              }
            }
          }
        ]
      }
    },
    "semanticConstraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
