<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <Import Project="config/program-kit/build/ProgramKit.Packages.props" />
  <Import Project="config/program-kit/build/ProgramKit.Persistence.props"
          Condition="Exists('config/program-kit/build/ProgramKit.Persistence.props')" />
  <Import Project="config/program-kit/build/ProgramKit.BuildingBlocks.props"
          Condition="Exists('config/program-kit/build/ProgramKit.BuildingBlocks.props')" />
  <Import Project="config/program-kit/build/ProgramKit.Foundation.props"
          Condition="Exists('config/program-kit/build/ProgramKit.Foundation.props')" />
  <!-- Consumer-owned central package versions belong here. -->
</Project>
