{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://program-kit.dev/schemas/runtime-closure.schema.json",
  "title": "Program Kit runtime closure evidence",
  "type": "object",
  "required": ["schemaVersion", "stagedRoot", "satisfied"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "programKitVersion": { "type": "string", "minLength": 1 },
    "stagedRoot": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version", "file", "sha256"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "configuration": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["file", "sha256"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "closureDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "packageHashesAreRunScoped": { "type": "boolean" },
    "satisfied": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "satisfied": { "const": true } }, "required": ["satisfied"] },
      "then": {
        "required": [
          "programKitVersion",
          "packages",
          "configuration",
          "closureDigest",
          "packageHashesAreRunScoped"
        ]
      },
      "else": { "required": ["reason"] }
    }
  ],
  "additionalProperties": false
}
