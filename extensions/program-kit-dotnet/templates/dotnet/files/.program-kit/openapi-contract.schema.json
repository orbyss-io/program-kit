{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbyss.io/program-kit/openapi-contract.schema.json",
  "title": "Program Kit OpenAPI contract pipeline",
  "type": "object",
  "required": [
    "schemaVersion",
    "identity",
    "documentName",
    "shell",
    "producer",
    "features",
    "packageClosure",
    "rawDocument",
    "artifact",
    "baseline",
    "compatibility",
    "generator",
    "application"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "identity": { "type": "string", "minLength": 1 },
    "documentName": { "type": "string", "minLength": 1 },
    "shell": { "type": "string", "minLength": 1 },
    "producer": {
      "type": "object",
      "required": ["kind", "version"],
      "properties": {
        "kind": { "const": "ProgramKit.OpenApi.Exporter" },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "packageClosure": { "$ref": "#/$defs/path" },
    "rawDocument": { "$ref": "#/$defs/path" },
    "artifact": { "$ref": "#/$defs/path" },
    "baseline": { "$ref": "#/$defs/path" },
    "compatibility": {
      "type": "object",
      "required": ["oasdiffVersion", "approval"],
      "properties": {
        "oasdiffVersion": { "type": "string", "minLength": 1 },
        "approval": { "$ref": "#/$defs/path" }
      },
      "additionalProperties": false
    },
    "generator": {
      "allOf": [
        { "$ref": "#/$defs/npmStage" },
        { "required": ["generatedTypes"] }
      ]
    },
    "application": {
      "allOf": [
        { "$ref": "#/$defs/npmStage" },
        { "required": ["tsconfig"] }
      ]
    }
  },
  "$defs": {
    "path": { "type": "string", "minLength": 1 },
    "npmStage": {
      "type": "object",
      "required": ["directory", "packageJson", "lockFile", "script"],
      "properties": {
        "directory": { "$ref": "#/$defs/path" },
        "packageJson": { "$ref": "#/$defs/path" },
        "lockFile": { "$ref": "#/$defs/path" },
        "script": { "type": "string", "pattern": "^[A-Za-z0-9:_-]+$" },
        "generatedTypes": { "$ref": "#/$defs/path" },
        "tsconfig": { "$ref": "#/$defs/path" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
