{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbyss.io/program-kit/spa-pkce-v1.schema.json",
  "title": "Program Kit SPA-PKCE v1 configuration",
  "type": "object",
  "required": [
    "$schema", "schemaVersion", "applicationOrigin", "apiOrigin", "identityOrigin",
    "identityAuthority", "clientId", "audience", "redirectUris", "postLogoutRedirectUris",
    "scopes", "silentRenewTimeoutSeconds", "session"
  ],
  "properties": {
    "$schema": { "const": "./spa-pkce.schema.json" },
    "schemaVersion": { "const": 1 },
    "applicationOrigin": { "$ref": "#/$defs/origin" },
    "apiOrigin": { "$ref": "#/$defs/origin" },
    "identityOrigin": { "$ref": "#/$defs/origin" },
    "identityAuthority": { "type": "string", "pattern": "^https?://[^*?#]+$" },
    "clientId": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "redirectUris": { "$ref": "#/$defs/uris" },
    "postLogoutRedirectUris": { "$ref": "#/$defs/uris" },
    "scopes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "contains": { "const": "openid" }, "items": { "type": "string", "minLength": 1 }
    },
    "silentRenewTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 60 },
    "session": {
      "type": "object",
      "required": [
        "idleMinutes", "absoluteMinutes", "absoluteDeadlineClaim", "tokenExpiryClaim",
        "crossTabCoordination", "providerLogoutFailure"
      ],
      "properties": {
        "idleMinutes": { "type": "integer", "minimum": 1 },
        "absoluteMinutes": { "type": "integer", "minimum": 1 },
        "absoluteDeadlineClaim": { "const": "auth_time" },
        "tokenExpiryClaim": { "const": "exp" },
        "crossTabCoordination": { "const": "required-no-token-payload" },
        "providerLogoutFailure": { "const": "local-session-remains-cleared" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "origin": { "type": "string", "pattern": "^https?://[^/*?#]+(?::[0-9]+)?/?$" },
    "uris": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^https?://[^*?#]+/[^*?#]+$" }
    }
  },
  "additionalProperties": false
}
