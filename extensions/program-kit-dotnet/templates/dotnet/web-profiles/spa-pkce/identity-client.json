{
  "clientId": "program-kit-spa",
  "name": "Program Kit explicit direct SPA",
  "enabled": true,
  "publicClient": true,
  "standardFlowEnabled": true,
  "directAccessGrantsEnabled": false,
  "implicitFlowEnabled": false,
  "protocol": "openid-connect",
  "redirectUris": [
    "http://localhost:5173/auth/callback",
    "http://localhost:5173/auth/renew-callback"
  ],
  "postLogoutRedirectUris": [ "http://localhost:5173/signed-out" ],
  "webOrigins": [ "http://localhost:5173" ],
  "attributes": { "pkce.code.challenge.method": "S256" },
  "defaultClientScopes": [ "basic", "profile", "roles", "web-origins", "acr", "program-kit-api" ]
}
