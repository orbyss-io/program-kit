{
  "realm": "program-kit",
  "enabled": true,
  "displayName": "Program Kit Local Identity",
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "clientSessionIdleTimeout": 1800,
  "clientSessionMaxLifespan": 28800,
  "internationalizationEnabled": true,
  "supportedLocales": [ "en", "nl", "fr", "de", "es" ],
  "defaultLocale": "en",
  "roles": {
    "realm": [
      { "name": "user", "description": "Authorized application user" },
      { "name": "admin", "description": "Application administrator" }
    ]
  },
  "clientScopes": [
    {
      "name": "program-kit-api",
      "description": "Program Kit local API audience, scope, and normalized roles",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" },
      "protocolMappers": [
        {
          "name": "program-kit-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "program-kit-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "program-kit-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "program-kit-api",
      "name": "Program Kit protected API",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "program-kit-bff",
      "name": "Program Kit confidential BFF",
      "enabled": true,
      "publicClient": false,
      "secret": "local-program-kit-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "protocol": "openid-connect",
      "redirectUris": [ "http://localhost:5000/signin-oidc" ],
      "postLogoutRedirectUris": [ "http://localhost:5000/bff/signed-out" ],
      "webOrigins": [ "http://localhost:5000" ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [ "basic", "profile", "roles", "web-origins", "acr", "program-kit-api" ],
      "optionalClientScopes": [ "offline_access" ]
    },
    {
      "clientId": "program-kit-spa",
      "name": "Program Kit explicit direct SPA",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:5173/auth/callback",
        "http://localhost:5173/auth/renew-callback"
      ],
      "postLogoutRedirectUris": [ "http://localhost:5173/signed-out" ],
      "webOrigins": [ "http://localhost:5173" ],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "defaultClientScopes": [ "basic", "profile", "roles", "web-origins", "acr", "program-kit-api" ]
    }
  ],
  "users": [
    {
      "username": "local-user",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Local",
      "lastName": "User",
      "email": "local-user@example.test",
      "credentials": [ { "type": "password", "value": "local-user-only", "temporary": false } ],
      "realmRoles": [ "user" ]
    },
    {
      "username": "local-admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Local",
      "lastName": "Administrator",
      "email": "local-admin@example.test",
      "credentials": [ { "type": "password", "value": "local-admin-only", "temporary": false } ],
      "realmRoles": [ "user", "admin" ]
    },
    {
      "username": "local-wrong-role",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Wrong",
      "lastName": "Role",
      "email": "local-wrong-role@example.test",
      "credentials": [ { "type": "password", "value": "local-wrong-role-only", "temporary": false } ],
      "realmRoles": []
    }
  ]
}
