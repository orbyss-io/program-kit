{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbyss.io/program-kit/delivery/azure-reconciliation.schema.json",
  "$defs": {
    "decision": {
      "type": "object",
      "properties": {
        "nativeId": {
          "type": "integer",
          "minimum": 1
        },
        "classification": {
          "enum": [
            "baseline",
            "cosmetic",
            "feedback",
            "business",
            "technical",
            "ownership",
            "retired"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "affectedKeys": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "technicalRevisionRequired": {
          "type": "boolean"
        }
      },
      "required": [
        "nativeId",
        "classification",
        "reason",
        "affectedKeys",
        "technicalRevisionRequired"
      ],
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "available": {
          "type": "boolean"
        },
        "coverage": {
          "type": "object",
          "properties": {
            "item": {
              "type": "boolean"
            },
            "updates": {
              "type": "boolean"
            },
            "comments": {
              "type": "boolean"
            }
          },
          "required": [
            "item",
            "updates",
            "comments"
          ],
          "additionalProperties": false
        },
        "status": {
          "enum": [
            "observed",
            "incomplete",
            "unknown",
            "deleted"
          ]
        },
        "inScope": {
          "type": "boolean"
        },
        "item": {
          "type": "object"
        },
        "updates": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "comments": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "deletion": {
          "type": [
            "object",
            "null"
          ]
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "available",
        "coverage",
        "status"
      ],
      "additionalProperties": false
    },
    "report": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "azure-reconciliation-report"
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
        },
        "space": {
          "type": "string",
          "minLength": 1
        },
        "profileDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observedAt": {
          "type": "string",
          "minLength": 1
        },
        "snapshots": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/snapshot"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "space",
        "profileDigest",
        "observedAt",
        "snapshots",
        "findings"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "azure-reconciliation-review"
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
        },
        "reportId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
        },
        "reportDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "profileDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/decision"
          }
        },
        "requiredRoles": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {
            "enum": [
              "business",
              "technical"
            ]
          }
        },
        "createdAt": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "reportId",
        "reportDigest",
        "profileDigest",
        "decisions",
        "requiredRoles",
        "createdAt"
      ],
      "additionalProperties": false
    }
  }
}
