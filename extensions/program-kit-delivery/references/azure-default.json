    },
    "priority": {
      "providerField": "Microsoft.VSTS.Common.Priority",
      "authority": "platform",
      "requiredAt": "optional",
      "writePolicy": "conditional"
    },
    "assignment": {
      "providerField": "System.AssignedTo",
      "authority": "platform",
      "requiredAt": "optional",
      "writePolicy": "conditional"
    },
    "dependencies": {
      "providerField": "System.LinkTypes.Dependency",
      "authority": "platform",
      "requiredAt": "optional",
      "writePolicy": "conditional"
