          "maxLength": 16000,
          "minLength": 1,
          "type": "string"
        },
        "pointOfUseAction": {
          "maxLength": 16000,
          "minLength": 1,
          "type": "string"
        },
        "proposedDisposition": {
          "enum": [
            "adopt",
            "duplicate",
            "defer",
            "reject",
            "needs-proof"
          ]
        },
        "rationale": {
          "maxLength": 16000,
          "minLength": 1,
          "type": "string"
        },
        "relationships": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "explanation": {
                "maxLength": 16000,
                "minLength": 1,
                "type": "string"
              },
              "groupId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "repairId": {
                "pattern": "^repair-[a-z0-9-]+$",
                "type": "string"
              },
              "requestId": {
                "pattern": "^rf-[0-9a-f]{32}$",
                "type": "string"
