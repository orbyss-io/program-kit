  "budgets": {
    "allowedExtensions": [
      ".cs",
      ".diff",
      ".js",
      ".json",
      ".log",
      ".md",
      ".patch",
      ".pdf",
      ".png",
      ".ps1",
      ".py",
      ".sh",
      ".ts",
      ".txt",
      ".yaml",
      ".yml"
    ],
    "files": 24,
    "perFileBytes": 262144,
    "qualifiedBinaryExtensions": [
      ".pdf",
      ".png"
    ],
    "totalBytes": 1048576
  },
  "compatibility": "Unknown contract versions are preserved and explicitly mapped in separate assessments; never silently upgraded.",
  "contractVersion": "1.0",
  "enums": {
    "assessmentCause": [
      "program-kit-defect",
      "guidance-gap",
      "consumer-choice",
      "domain-adaptation",
      "mixed",
