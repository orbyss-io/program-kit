{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbyss.io/program-kit/capability-adoption.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "instances": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "current-feature",
              "future-feature"
            ]
          },
          "roadmapEntry": {
            "type": "string",
            "minLength": 1
          },
          "duePhase": {
            "enum": [
              "planning",
              "implementation",
              "delivery"
            ]
          },
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "mechanisms": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "publicApi": {
                  "type": "string",
                  "minLength": 1
                },
                "placement": {
                  "type": "string",
                  "minLength": 1
                },
                "checkIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true,
                  "minItems": 1
                },
                "implementationPaths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true,
                  "minItems": 1
                }
              },
              "required": [
                "publicApi",
                "placement",
                "checkIds",
                "implementationPaths"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "owner",
          "rationale",
          "disposition"
        ],
        "additionalProperties": false
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "instances"
  ],
  "additionalProperties": false
}
