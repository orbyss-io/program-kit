{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbyss.io/program-kit/verification-plan.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "suites": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "result": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "enum": [
              "junit",
              "trx"
            ]
          },
          "checks": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 1
            }
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          }
        },
        "required": [
          "command",
          "result",
          "format",
          "checks"
        ],
        "additionalProperties": false
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "suites"
  ],
  "additionalProperties": false
}
