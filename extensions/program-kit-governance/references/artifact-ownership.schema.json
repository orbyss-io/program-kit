{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbyss.io/program-kit/artifact-ownership.schema.json",
  "type": "object",
  "required": ["schemaVersion", "feature", "profiles", "artifacts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "feature": { "type": "string", "minLength": 1 },
    "profiles": { "type": "array", "items": { "enum": ["program-kit", "dotnet", "typescript-vite", "ef-postgresql", "ef-sqlserver", "ef-sqlite"] }, "uniqueItems": true },
    "runtimeComposition": {
      "type": "object",
      "required": ["authorities", "projects", "bindings"],
      "properties": {
        "authorities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "projects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "role", "projectReferences", "packageReferences"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "role": { "enum": ["feature", "application", "domain", "contracts", "runtime-adapter", "test", "other"] },
              "featureIdentity": { "type": "string", "minLength": 1 },
              "projectReferences": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "packageReferences": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            },
            "additionalProperties": false
          }
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["port", "portProject", "adapter", "adapterProject", "ownerFeature", "ownerProject", "registration"],
            "properties": {
              "port": { "type": "string", "minLength": 1 },
              "portProject": { "type": "string", "minLength": 1 },
              "adapter": { "type": "string", "minLength": 1 },
              "adapterProject": { "type": "string", "minLength": 1 },
              "ownerFeature": { "type": "string", "minLength": 1 },
              "ownerProject": { "type": "string", "minLength": 1 },
              "registration": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ownership", "classification", "lifecycle"],
        "oneOf": [{ "required": ["path"] }, { "required": ["pattern"] }],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "pattern": { "type": "string", "minLength": 1 },
          "ownership": { "enum": ["managed", "scaffold-once", "consumer-owned", "generated", "evidence"] },
          "classification": { "enum": ["public", "internal", "confidential", "restricted", "secret"] },
          "lifecycle": { "enum": ["source", "generated", "ephemeral", "retained", "replaced", "deployment"] },
          "owner": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
