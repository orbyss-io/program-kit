{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbyss.io/program-kit/artifact-ownership.schema.json",
  "type": "object",
  "required": ["schemaVersion", "feature", "profiles", "artifacts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "feature": { "type": "string", "minLength": 1 },
    "profiles": { "type": "array", "items": { "enum": ["program-kit", "dotnet", "typescript-vite", "ef-postgresql", "ef-sqlserver", "ef-sqlite"] }, "uniqueItems": true },
    "runtimeComposition": {
      "type": "object",
      "required": ["authorities", "projects", "bindings", "coreReferences"],
      "properties": {
        "authorities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "projects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "role", "projectReferences", "packageReferences"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "role": { "enum": ["core", "helper", "implementation", "provider", "bridge", "composition", "test"] },
              "featureIdentities": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "projectReferences": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "packageReferences": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            },
            "additionalProperties": false
          }
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["capability", "capabilityProject", "implementation", "implementationProject", "featureIdentity", "registration"],
            "properties": {
              "capability": { "type": "string", "minLength": 1 },
              "capabilityProject": { "type": "string", "minLength": 1 },
              "implementation": { "type": "string", "minLength": 1 },
              "implementationProject": { "type": "string", "minLength": 1 },
              "featureIdentity": { "type": "string", "minLength": 1 },
              "registration": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "coreReferences": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["fromProject", "toProject", "relationship", "decision", "verification"],
            "properties": {
              "fromProject": { "type": "string", "minLength": 1 },
              "toProject": { "type": "string", "minLength": 1 },
              "relationship": { "enum": ["subdomain", "published-language", "shared-kernel"] },
              "decision": { "type": "string", "minLength": 1 },
              "verification": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ownership", "classification", "lifecycle"],
        "oneOf": [{ "required": ["path"] }, { "required": ["pattern"] }],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "pattern": { "type": "string", "minLength": 1 },
          "ownership": { "enum": ["managed", "scaffold-once", "consumer-owned", "generated", "evidence"] },
          "classification": { "enum": ["public", "internal", "confidential", "restricted", "secret"] },
          "lifecycle": { "enum": ["source", "generated", "ephemeral", "retained", "replaced", "deployment"] },
          "owner": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
