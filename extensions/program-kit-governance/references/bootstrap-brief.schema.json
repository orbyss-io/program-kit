{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbyss.io/program-kit/bootstrap-brief.schema.json",
  "title": "Program Kit normalized bootstrap brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "project",
    "facts",
    "explicit_boundaries",
    "actors",
    "journeys",
    "quality_requirements",
    "ambiguities",
    "routing"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "source": { "$ref": "#/$defs/source" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "summary"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "facts": { "$ref": "#/$defs/evidence_items" },
    "explicit_boundaries": { "$ref": "#/$defs/evidence_items" },
    "actors": { "$ref": "#/$defs/evidence_items" },
    "journeys": { "$ref": "#/$defs/evidence_items" },
    "quality_requirements": { "$ref": "#/$defs/evidence_items" },
    "ambiguities": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "evidence"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "question": { "type": "string", "minLength": 1, "maxLength": 500 },
          "evidence": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["languages", "frameworks", "interfaces", "included_surfaces", "excluded_surfaces"],
      "properties": {
        "languages": { "$ref": "#/$defs/string_list" },
        "frameworks": { "$ref": "#/$defs/string_list" },
        "interfaces": { "$ref": "#/$defs/string_list" },
        "included_surfaces": { "$ref": "#/$defs/string_list" },
        "excluded_surfaces": { "$ref": "#/$defs/string_list" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "evidence": { "type": "string", "pattern": "^[^:\\r\\n]+:[1-9][0-9]*(?:-[1-9][0-9]*)?$", "maxLength": 260 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidence_items": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "evidence"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "statement": { "type": "string", "minLength": 1, "maxLength": 500 },
          "evidence": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "string_list": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 120 },
      "uniqueItems": true
    }
  }
}
