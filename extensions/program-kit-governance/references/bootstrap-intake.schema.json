{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbyss.io/program-kit/bootstrap-intake.schema.json",
  "title": "Program Kit conversational bootstrap intake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "project", "artifacts", "evidence", "facts", "scope",
    "actors", "journeys", "quality_requirements", "integrations", "choices",
    "capability_assessments", "domain_analysis", "open_items", "candidate_slice_signals", "routing"
  ],
  "properties": {
    "schema_version": { "const": "1.1" },
    "status": { "enum": ["draft", "confirmed"] },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "summary"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_intent", "architecture_map", "c4_projection"],
      "properties": {
        "project_intent": { "$ref": "#/$defs/file" },
        "architecture_map": { "$ref": "#/$defs/file" },
        "c4_projection": { "$ref": "#/$defs/file" }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "locator", "summary"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "source": { "enum": ["project_intent", "architecture_map", "c4_projection"] },
          "locator": { "type": "string", "minLength": 1, "maxLength": 260 },
          "summary": { "$ref": "#/$defs/text" }
        }
      }
    },
    "facts": { "$ref": "#/$defs/evidence_items" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded", "deferred"],
      "properties": {
        "included": { "$ref": "#/$defs/evidence_items" },
        "excluded": { "$ref": "#/$defs/evidence_items" },
        "deferred": { "$ref": "#/$defs/evidence_items" }
      }
    },
    "actors": { "$ref": "#/$defs/evidence_items" },
    "journeys": { "$ref": "#/$defs/evidence_items" },
    "quality_requirements": { "$ref": "#/$defs/evidence_items" },
    "integrations": { "$ref": "#/$defs/evidence_items" },
    "choices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "decision", "source", "rationale", "evidence"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "decision": { "$ref": "#/$defs/text" },
          "source": { "enum": ["explicit-intake", "program-kit-default", "derived-default", "override"] },
          "rationale": { "$ref": "#/$defs/text" },
          "evidence": { "$ref": "#/$defs/id_list" }
        }
      }
    },
    "capability_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "need", "mechanism_coverage", "program_kit_capabilities", "semantic_owner", "semantic_profile", "integration_owner", "provider_selection", "decision_state", "evidence"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "need": { "$ref": "#/$defs/text" },
          "mechanism_coverage": { "enum": ["managed", "guided", "external", "conflict", "not-declared", "insufficient-evidence"] },
          "program_kit_capabilities": { "$ref": "#/$defs/string_list" },
          "semantic_owner": { "type": "string", "minLength": 1, "maxLength": 120 },
          "semantic_profile": { "type": "string", "maxLength": 500 },
          "integration_owner": { "type": "string", "minLength": 1, "maxLength": 120 },
          "provider_selection": { "type": "string", "maxLength": 240 },
          "decision_state": { "enum": ["explicit-user-decision", "program-kit-default", "derived-default", "human-answer-required", "research-required", "project-owned-design", "deferred", "excluded"] },
          "evidence": { "$ref": "#/$defs/id_list" }
        }
      }
    },
    "domain_analysis": { "$ref": "#/$defs/domain_analysis" },
    "open_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "classification", "disposition", "blocks", "trigger", "evidence"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "question": { "$ref": "#/$defs/text" },
          "classification": { "enum": ["human-decision", "research", "project-owned-design", "deferred"] },
          "disposition": { "$ref": "#/$defs/text" },
          "blocks": { "type": "string", "maxLength": 240 },
          "trigger": { "type": "string", "maxLength": 240 },
          "evidence": { "$ref": "#/$defs/id_list" }
        }
      }
    },
    "candidate_slice_signals": { "$ref": "#/$defs/evidence_items" },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["languages", "frameworks", "interfaces", "included_surfaces", "excluded_surfaces", "capabilities"],
      "properties": {
        "languages": { "$ref": "#/$defs/string_list" },
        "frameworks": { "$ref": "#/$defs/string_list" },
        "interfaces": { "$ref": "#/$defs/string_list" },
        "included_surfaces": { "$ref": "#/$defs/string_list" },
        "excluded_surfaces": { "$ref": "#/$defs/string_list" },
        "capabilities": { "$ref": "#/$defs/string_list" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 260, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 500 },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "evidence_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "evidence"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "statement": { "$ref": "#/$defs/text" },
          "evidence": { "$ref": "#/$defs/id_list" }
        }
      }
    },
    "domain_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subdomains", "candidate_contexts", "founding_decision_candidates", "boundary_challenges"],
      "properties": {
        "subdomains": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/subdomain" } },
        "candidate_contexts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/candidate_context" } },
        "founding_decision_candidates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/founding_decision" } },
        "boundary_challenges": { "type": "array", "items": { "$ref": "#/$defs/boundary_challenge" } }
      }
    },
    "subdomain": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "classification", "vision", "ownership", "non_ownership", "language_terms", "data_ownership", "invariants", "lifecycle", "status", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/text" },
        "classification": { "enum": ["core", "supporting", "generic"] },
        "vision": { "$ref": "#/$defs/text" }, "ownership": { "$ref": "#/$defs/text" },
        "non_ownership": { "$ref": "#/$defs/text" }, "language_terms": { "$ref": "#/$defs/text_list" },
        "data_ownership": { "$ref": "#/$defs/text_list" }, "invariants": { "$ref": "#/$defs/text_list" },
        "lifecycle": { "$ref": "#/$defs/text" }, "status": { "$ref": "#/$defs/provisional_status" },
        "evidence": { "$ref": "#/$defs/nonempty_id_list" }
      }
    },
    "candidate_context": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "boundary_kind", "vision", "responsibilities", "non_responsibilities", "language_terms", "subdomains", "data_ownership", "invariants", "lifecycle", "separation_rationale", "split_triggers", "status", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/text" },
        "boundary_kind": { "enum": ["domain-model", "cross-cutting-concern"] },
        "vision": { "$ref": "#/$defs/text" }, "responsibilities": { "$ref": "#/$defs/text_list" },
        "non_responsibilities": { "$ref": "#/$defs/text_list" }, "language_terms": { "$ref": "#/$defs/text_list" },
        "subdomains": { "$ref": "#/$defs/nonempty_id_list" }, "data_ownership": { "$ref": "#/$defs/text_list" },
        "invariants": { "$ref": "#/$defs/text_list" }, "lifecycle": { "$ref": "#/$defs/text" },
        "separation_rationale": { "$ref": "#/$defs/text" }, "split_triggers": { "$ref": "#/$defs/text_list" },
        "status": { "$ref": "#/$defs/provisional_status" }, "evidence": { "$ref": "#/$defs/nonempty_id_list" }
      }
    },
    "founding_decision": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "question", "recommended_option", "alternatives", "rationale", "consequences", "confidence", "affected_elements", "affected_relationships", "status", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/text" },
        "question": { "$ref": "#/$defs/text" }, "recommended_option": { "$ref": "#/$defs/text" },
        "alternatives": { "$ref": "#/$defs/text_list" }, "rationale": { "$ref": "#/$defs/text" },
        "consequences": { "$ref": "#/$defs/text_list" }, "confidence": { "enum": ["high", "medium", "low"] },
        "affected_elements": { "$ref": "#/$defs/id_list" }, "affected_relationships": { "$ref": "#/$defs/id_list" },
        "status": { "enum": ["proposed", "unresolved"] }, "evidence": { "$ref": "#/$defs/nonempty_id_list" }
      }
    },
    "boundary_challenge": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "boundary", "concern", "finding", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "boundary": { "$ref": "#/$defs/id" },
        "concern": { "$ref": "#/$defs/text" }, "finding": { "$ref": "#/$defs/text" },
        "evidence": { "$ref": "#/$defs/nonempty_id_list" }
      }
    },
    "provisional_status": { "enum": ["explicit", "derived", "proposed", "unresolved"] },
    "id_list": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "nonempty_id_list": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "text_list": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/text" }, "uniqueItems": true },
    "string_list": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 120 }, "uniqueItems": true }
  }
}
