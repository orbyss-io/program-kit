# Optional user-reviewed rule for Program Kit's trusted bootstrap workflow only.
# Copy this file manually to an active Codex rules layer, then restart Codex.
# Program Kit never installs or enables it automatically.
prefix_rule(
    pattern = ["specify", "workflow", "run", "program-kit-bootstrap"],
    decision = "allow",
    justification = "Program Kit bootstrap starts a nested Codex CLI that must manage its normal state outside the outer task sandbox.",
    match = [
        "specify workflow run program-kit-bootstrap --input initial_design=./INITIAL_DESIGN.md",
        "specify workflow run program-kit-bootstrap --input initial_design=./INITIAL_DESIGN.md --input integration=codex",
    ],
    not_match = [
        "specify workflow run unrelated-workflow",
        "specify workflow resume abc123 --input assessment_verdict=approve",
        "specify workflow list",
        "powershell -Command specify workflow run program-kit-bootstrap",
    ],
)
