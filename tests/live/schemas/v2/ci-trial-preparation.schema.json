{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbyss.io/program-kit/live/v2/ci-trial-preparation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "version",
    "source",
    "platform",
    "toolchains",
    "steps",
    "artifacts",
    "catalog",
    "startedAt",
    "finishedAt",
    "acceptanceScope",
    "releaseValidationPassed",
    "preparationLogs",
    "host",
    "ci"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "status": {
      "const": "ci-trial-prepared"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree",
        "clean"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "[0-9a-f]{40}"
        },
        "tree": {
          "type": "string",
          "pattern": "[0-9a-f]{40}"
        },
        "clean": {
          "const": true
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "release",
        "machine"
      ],
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1
        },
        "release": {
          "type": "string",
          "minLength": 1
        },
        "machine": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "toolchains": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "dotnet",
        "node",
        "npm",
        "git",
        "specify",
        "codex"
      ],
      "properties": {
        "python": {
          "type": "string",
          "minLength": 1
        },
        "dotnet": {
          "type": "string",
          "minLength": 1
        },
        "node": {
          "type": "string",
          "minLength": 1
        },
        "npm": {
          "type": "string",
          "minLength": 1
        },
        "git": {
          "type": "string",
          "minLength": 1
        },
        "specify": {
          "type": "string",
          "minLength": 1
        },
        "codex": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "startedAt": {
      "type": "string",
      "minLength": 1
    },
    "finishedAt": {
      "type": "string",
      "minLength": 1
    },
    "acceptanceScope": {
      "const": "local-preparation-from-ci"
    },
    "releaseValidationPassed": {
      "const": false
    },
    "preparationLogs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "sourceRoot",
        "pythonExecutable",
        "launchers"
      ],
      "properties": {
        "node": {
          "type": "string",
          "minLength": 1
        },
        "sourceRoot": {
          "type": "string",
          "minLength": 1
        },
        "pythonExecutable": {
          "type": "string",
          "minLength": 1
        },
        "launchers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "git",
            "specify",
            "codex",
            "node",
            "npm",
            "dotnet",
            "uv"
          ],
          "properties": {
            "git": {
              "type": "string",
              "minLength": 1
            },
            "specify": {
              "type": "string",
              "minLength": 1
            },
            "codex": {
              "type": "string",
              "minLength": 1
            },
            "node": {
              "type": "string",
              "minLength": 1
            },
            "npm": {
              "type": "string",
              "minLength": 1
            },
            "dotnet": {
              "type": "string",
              "minLength": 1
            },
            "uv": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "qualificationSha256",
        "qualificationPath",
        "payloadPath"
      ],
      "properties": {
        "runId": {
          "type": "integer",
          "minimum": 1
        },
        "qualificationSha256": {
          "type": "string",
          "pattern": "[a-f0-9]{64}"
        },
        "qualificationPath": {
          "type": "string",
          "minLength": 1
        },
        "payloadPath": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "command",
        "exitCode",
        "startedAt",
        "finishedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "exitCode": {
          "const": 0
        },
        "startedAt": {
          "type": "string",
          "minLength": 1
        },
        "finishedAt": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
