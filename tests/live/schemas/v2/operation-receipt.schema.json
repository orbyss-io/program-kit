{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbyss.io/program-kit/live/v2/operation-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operation", "planDigest", "command", "exitCode", "startedAt", "finishedAt", "artifacts"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "operation": { "enum": ["plan", "apply", "availability", "restore-request-renew", "restore-renew", "restore-request-locked", "restore-locked", "check", "dotnet-build", "npm-verify"] },
    "planDigest": { "type": "string", "pattern": "[0-9a-f]{64}" },
    "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "exitCode": { "type": "integer" },
    "startedAt": { "type": "string", "minLength": 1 },
    "finishedAt": { "type": "string", "minLength": 1 },
    "artifacts": { "type": "array", "items": { "type": "object" } },
    "process": { "type": "object" }
  }
}
