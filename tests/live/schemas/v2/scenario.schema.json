{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbyss.io/program-kit/live/v2/scenario.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "claim", "fixture", "acceptedDecisionIds", "selectionTemplate", "activeExpectation"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "id": { "const": "internal-forms-workspace" },
    "version": { "const": "1" },
    "claim": { "type": "string", "minLength": 1 },
    "fixture": { "type": "string", "minLength": 1 },
    "acceptedDecisionIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "selectionTemplate": { "type": "string", "minLength": 1 },
    "activeExpectation": { "type": "string", "minLength": 1 }
  }
}
