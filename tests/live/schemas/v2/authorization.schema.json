{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbyss.io/program-kit/live/v2/authorization.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "authorizationId", "nonce", "phase", "scenario", "candidate", "checkpoint", "agentProfile", "limits", "issuedAt", "expiresAt"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "authorizationId": { "type": "string", "pattern": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}" },
    "nonce": { "type": "string", "pattern": "[0-9a-f]{64}" },
    "phase": { "enum": ["bootstrap-checkpoint", "building-block-consumer"] },
    "scenario": { "$ref": "#/$defs/namedDigest" },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseReceipt", "releaseReceiptSha256"],
      "properties": {
        "releaseReceipt": { "type": "string", "minLength": 1 },
        "releaseReceiptSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "checkpoint": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["checkpointId", "digest"],
          "properties": {
            "checkpointId": { "type": "string", "minLength": 1 },
            "digest": { "$ref": "#/$defs/sha256" }
          }
        }
      ]
    },
    "agentProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integration", "launcherVersion", "model", "reasoningEffort", "sandbox", "timeoutSeconds"],
      "properties": {
        "integration": { "const": "codex" },
        "launcherVersion": { "type": "string", "minLength": 1, "not": { "const": "unavailable" } },
        "model": { "type": "string", "minLength": 1 },
        "reasoningEffort": { "type": "string", "minLength": 1 },
        "sandbox": { "const": "workspace-write" },
        "timeoutSeconds": { "type": "integer", "minimum": 60 }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumPaidSessions", "workerNetwork", "restoreNetworkOwner"],
      "properties": {
        "maximumPaidSessions": { "type": "integer", "minimum": 1 },
        "workerNetwork": { "const": "model-transport-only" },
        "restoreNetworkOwner": { "const": "supervisor" }
      }
    },
    "issuedAt": { "type": "string", "minLength": 1 },
    "expiresAt": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "[0-9a-f]{64}" },
    "namedDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
