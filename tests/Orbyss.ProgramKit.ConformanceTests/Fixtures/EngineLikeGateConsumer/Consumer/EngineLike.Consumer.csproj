<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>true</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <UseSharedCompilation>false</UseSharedCompilation>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>obj\Generated</CompilerGeneratedFilesOutputPath>
    <ProgramKitGeneratedSourceContract>1.0.0</ProgramKitGeneratedSourceContract>
    <ProgramKitPublicAnalyzerReceiptNonce>0123456789abcdef0123456789abcdef</ProgramKitPublicAnalyzerReceiptNonce>
    <ProgramKitCompilerInvocationNonce>0123456789abcdef0123456789abcdef</ProgramKitCompilerInvocationNonce>
    <ProgramKitCSharpGateVerificationProfile>work-unit</ProgramKitCSharpGateVerificationProfile>
  </PropertyGroup>
  <ItemGroup>
    <Analyzer Include="$(EngineConsumerAnalyzerPath)" />
    <Analyzer Include="$(ProgramKitPublicAnalyzerPath)" />
    <CompilerVisibleProperty Include="ProgramKitGeneratedSourceContract" />
    <CompilerVisibleProperty Include="ProgramKitPublicAnalyzerReceiptNonce" />
    <CompilerVisibleProperty Include="ProgramKitCompilerInvocationNonce" />
    <CompilerVisibleProperty Include="ProgramKitCSharpGateVerificationProfile" />
    <CompilerVisibleProperty Include="MSBuildProjectName" />
  </ItemGroup>
  <Target Name="RequireExactAnalyzerPaths" BeforeTargets="CoreCompile">
    <Error Condition="'$(EngineConsumerAnalyzerPath)' == ''"
           Text="EngineConsumerAnalyzerPath is required." />
    <Error Condition="'$(ProgramKitPublicAnalyzerPath)' == ''"
           Text="ProgramKitPublicAnalyzerPath is required." />
  </Target>
</Project>
