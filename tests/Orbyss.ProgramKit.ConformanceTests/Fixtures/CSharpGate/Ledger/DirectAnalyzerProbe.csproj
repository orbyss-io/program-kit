<Project>
  <PropertyGroup>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ProgramKitGeneratedSourceRoot>ProgramKitGenerated</ProgramKitGeneratedSourceRoot>
    <ProgramKitCompilerInvocationNonce>0123456789abcdef0123456789abcdef</ProgramKitCompilerInvocationNonce>
    <ProgramKitLedgerCase Condition="'$(ProgramKitLedgerCase)' == ''">ApprovedSuppression</ProgramKitLedgerCase>
    <ProgramKitWarningApprovalLedgerPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\Ledgers\$(ProgramKitLedgerCase)\approved-warning-suppressions.tsv'))</ProgramKitWarningApprovalLedgerPath>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RootNamespace>Orbyss.ProgramKit.LedgerProbe</RootNamespace>
    <RunAnalyzers>true</RunAnalyzers>
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(ProgramKitWarningApprovalLedgerPath)" />
    <Compile Include="Configuration\$(ProgramKitLedgerCase)\*.cs" />
    <CompilerVisibleProperty Include="MSBuildProjectDirectory" />
    <CompilerVisibleProperty Include="MSBuildProjectName" />
    <CompilerVisibleProperty Include="ProgramKitCompilerInvocationNonce" />
    <CompilerVisibleProperty Include="ProgramKitGeneratedSourceRoot" />
    <CompilerVisibleProperty Include="ProgramKitWarningApprovalLedgerPath" />
    <CompilerVisibleProperty Include="RootNamespace" />
    <ProjectReference
      Include="$(ProgramKitBuildRoot)\tools\Orbyss.ProgramKit.CSharpGate\Orbyss.ProgramKit.CSharpGate.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      PrivateAssets="all" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
