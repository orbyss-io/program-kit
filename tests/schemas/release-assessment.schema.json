{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "candidate": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recordedAt": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "integer",
      "minimum": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "ready": {
      "type": "boolean"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "actor",
        "reference"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "selectedTrials": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "trials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "phase": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": [
              "passed",
              "failed",
              "inconclusive",
              "harness-failure"
            ]
          },
          "provenance": {
            "enum": [
              "human-attested",
              "verified-internal"
            ]
          },
          "manifest": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "reference",
              "sha256"
            ]
          },
          "disposition": {
            "type": "string"
          }
        },
        "required": [
          "phase",
          "scope",
          "outcome",
          "provenance",
          "manifest",
          "disposition"
        ]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "product-defect",
              "harness",
              "coverage-gap"
            ]
          },
          "status": {
            "enum": [
              "open",
              "resolved",
              "dispositioned"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "resolution": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "status",
          "description",
          "resolution"
        ]
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schemaVersion",
    "candidate",
    "recordedAt",
    "runId",
    "attempt",
    "ready",
    "review",
    "summary",
    "recommendations",
    "selectedTrials",
    "trials",
    "findings",
    "supersedes"
  ]
}
