{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "policySha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "inventorySha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "commit",
        "tree",
        "version",
        "policySha256",
        "inventorySha256"
      ]
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "workflow": {
          "type": "string",
          "minLength": 1
        },
        "workflowRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "runId": {
          "type": "integer",
          "minimum": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "repository",
        "workflow",
        "workflowRevision",
        "runId",
        "attempt"
      ]
    },
    "payloadSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "build": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "linux": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "windows": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "build",
        "linux",
        "windows"
      ]
    },
    "browsers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "id",
            "name",
            "digest"
          ]
        },
        "build": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "id",
            "name",
            "digest"
          ]
        },
        "linux": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "id",
            "name",
            "digest"
          ]
        },
        "windows": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "id",
            "name",
            "digest"
          ]
        },
        "security": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "id",
            "name",
            "digest"
          ]
        }
      },
      "required": [
        "payload",
        "build",
        "linux",
        "windows",
        "security"
      ]
    },
    "security": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "candidate": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "observedAt": {
          "type": "string",
          "minLength": 1
        },
        "runId": {
          "type": "integer",
          "minimum": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "scanner": {
          "type": "string",
          "minLength": 1
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "report": {
          "type": "object"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "tree": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "policySha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "inventorySha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "commit",
            "tree",
            "version",
            "policySha256",
            "inventorySha256"
          ]
        },
        "payloadSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "schemaVersion",
        "candidate",
        "targets",
        "status",
        "observedAt",
        "runId",
        "attempt",
        "identity",
        "scanner",
        "supersedes",
        "report",
        "source",
        "payloadSha256"
      ]
    },
    "finishedAt": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "source",
    "producer",
    "payloadSha256",
    "lanes",
    "coverage",
    "browsers",
    "artifacts",
    "security",
    "finishedAt"
  ]
}
