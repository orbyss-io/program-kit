{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "workflow": {
      "const": ".github/workflows/qualify-candidate.yml"
    },
    "requiredJobs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "publicationEnvironment": {
      "const": "publication"
    },
    "securityMaxAgeHours": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "schemaVersion",
    "repository",
    "workflow",
    "requiredJobs",
    "publicationEnvironment",
    "securityMaxAgeHours"
  ]
}
