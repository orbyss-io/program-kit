<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <PackageReference Include="Orbyss.Forms.Management" Version="0.2.0" />
    <PackageReference Include="Orbyss.Forms.JsonForms" Version="0.2.0" />
    <PackageReference Include="Orbyss.Forms.Storage.InMemory" Version="0.2.0" />
    <PackageReference Include="Orbyss.Foundation.Json" Version="0.2.2" />
    <PackageReference Include="Orbyss.Foundation.Json.AspNetCore" Version="0.2.2" />
    <PackageReference Include="Orbyss.Foundation.WebDefaults" Version="0.2.2" />
    <PackageReference Include="Orbyss.Foundation.Web.HostedPages" Version="0.2.2" />
  </ItemGroup>
</Project>
