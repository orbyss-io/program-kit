<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><LangVersion>latest</LangVersion><Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Version>1.0.0-fixture.1</Version><Deterministic>true</Deterministic>
  </PropertyGroup>
  <Target Name="RequireCandidateVersion" BeforeTargets="CollectPackageReferences">
    <Error Condition="'$(FoundationCandidateVersion)' == ''" Text="Select FoundationCandidateVersion explicitly from qualified private candidate evidence." />
  </Target>
</Project>
