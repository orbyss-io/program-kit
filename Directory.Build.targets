    <ReadLinesFromFile File="$(ProgramKitWarningApprovalLedgerPath)">
      <Output TaskParameter="Lines"
              ItemName="_ProgramKitCs1701CompatibilityLedgerLine" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_ProgramKitCompilerWarningApproval
        Include="@(_ProgramKitCs1701CompatibilityLedgerLine)"
        Condition="$([System.String]::Copy('%(Identity)').Contains('&#x9;CompilerNoWarn&#x9;'))" />
      <_ProgramKitExpectedCs1701CompatibilityApproval
        Include="@(_ProgramKitCompilerWarningApproval)"
        Condition="'%(Identity)' == '$(_ProgramKitCs1701CompatibilityUnitTestApproval)' or
                   '%(Identity)' == '$(_ProgramKitCs1701CompatibilityConformanceTestApproval)'" />
      <_ProgramKitCurrentCs1701CompatibilityApproval
        Include="@(_ProgramKitCompilerWarningApproval)"
        Condition="'$(_ProgramKitCs1701CompatibilityExpectedApproval)' != '' and
                   '%(Identity)' == '$(_ProgramKitCs1701CompatibilityExpectedApproval)'" />
      <_ProgramKitExpectedCs1701CompatibilityApproval
        Include="@(_ProgramKitCompilerWarningApproval)"
        Condition="'%(Identity)' == '$(_ProgramKitCs1701CompatibilityCronosApproval)'" />
      <_ProgramKitExpectedCs1701CompatibilityApproval
        Include="@(_ProgramKitCompilerWarningApproval)"
        Condition="'%(Identity)' == '$(_ProgramKitCs1701CompatibilityTUnitApproval)'" />
    </ItemGroup>
    <Error Condition="'@(_ProgramKitCompilerWarningApproval->Count())' != '4' or
                      '@(_ProgramKitExpectedCs1701CompatibilityApproval->Count())' != '4'"
           Code="PKCS174"
           Text="The canonical compiler-warning approval ledger must contain exactly the four human-approved CS1701 compatibility records." />
    <Error Condition="'$(_ProgramKitCs1701CompatibilityExpectedProjectPath)' != '' and
