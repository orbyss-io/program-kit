           Text="The CS1701 compatibility quarantine requires the canonical lock file and repository global.json." />
    <GetFileHash Files="$(_ProgramKitCs1701CompatibilityLockFile)"
                 Algorithm="SHA256"
                 Condition="'$(_ProgramKitCs1701CompatibilityExpectedProjectPath)' != '' and
