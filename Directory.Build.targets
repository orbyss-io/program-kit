  <Target Name="ValidateProgramKitResolvedReferenceSet"
          DependsOnTargets="ResolveReferences"
          BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_ProgramKitExpectedNetCoreTargetingPackRoot>$([System.IO.Path]::GetFullPath('$(MSBuildToolsPath)\..\..\packs'))</_ProgramKitExpectedNetCoreTargetingPackRoot>
      <_ProgramKitExpectedNetCoreReferenceDirectory>$([System.IO.Path]::GetFullPath('$(_ProgramKitExpectedNetCoreTargetingPackRoot)\Microsoft.NETCore.App.Ref\10.0.10\ref\net10.0'))\</_ProgramKitExpectedNetCoreReferenceDirectory>
    </PropertyGroup>
    <ItemGroup>
      <_ProgramKitExpectedNetCoreReference Remove="@(_ProgramKitExpectedNetCoreReference)" />
      <_ProgramKitResolvedNetCoreReference Remove="@(_ProgramKitResolvedNetCoreReference)" />
      <_ProgramKitInvalidNetCoreReference Remove="@(_ProgramKitInvalidNetCoreReference)" />
      <_ProgramKitMissingNetCoreReference Remove="@(_ProgramKitMissingNetCoreReference)" />
      <_ProgramKitUnexpectedNetCoreReference Remove="@(_ProgramKitUnexpectedNetCoreReference)" />
      <_ProgramKitResolvedReferenceWithAlias Remove="@(_ProgramKitResolvedReferenceWithAlias)" />
      <_ProgramKitResolvedReferenceWithEmbeddedInterop Remove="@(_ProgramKitResolvedReferenceWithEmbeddedInterop)" />
      <_ProgramKitExpectedNetCoreReference
        Include="$(_ProgramKitExpectedNetCoreReferenceDirectory)*.dll">
        <NormalizedPath>%(FullPath)</NormalizedPath>
      </_ProgramKitExpectedNetCoreReference>
      <_ProgramKitResolvedNetCoreReference
        Include="@(ReferencePathWithRefAssemblies)"
        Condition="'%(ReferencePathWithRefAssemblies.NuGetPackageId)' == 'Microsoft.NETCore.App.Ref'">
        <NormalizedPath>%(ReferencePathWithRefAssemblies.FullPath)</NormalizedPath>
      </_ProgramKitResolvedNetCoreReference>
      <_ProgramKitInvalidNetCoreReference
        Include="@(_ProgramKitResolvedNetCoreReference)"
        Condition="'%(NuGetPackageVersion)' != '10.0.10' or
                   !$([System.String]::Copy('%(FullPath)').StartsWith('$(_ProgramKitExpectedNetCoreReferenceDirectory)', System.StringComparison.OrdinalIgnoreCase))" />
      <_ProgramKitMissingNetCoreReference Include="@(_ProgramKitExpectedNetCoreReference)" />
      <_ProgramKitMissingNetCoreReference
        Remove="@(_ProgramKitResolvedNetCoreReference)" />
      <_ProgramKitUnexpectedNetCoreReference Include="@(_ProgramKitResolvedNetCoreReference)" />
      <_ProgramKitUnexpectedNetCoreReference
        Remove="@(_ProgramKitExpectedNetCoreReference)" />
      <_ProgramKitResolvedReferenceWithAlias
        Include="@(ReferencePathWithRefAssemblies)"
        Condition="'%(ReferencePathWithRefAssemblies.Aliases)' != ''" />
      <_ProgramKitResolvedReferenceWithEmbeddedInterop
        Include="@(ReferencePathWithRefAssemblies)"
        Condition="'%(ReferencePathWithRefAssemblies.EmbedInteropTypes)' == 'true'" />
    </ItemGroup>
    <Error Condition="'$(TargetFrameworkIdentifier)' != '.NETCoreApp' or
                      '$(TargetFrameworkVersion)' != 'v10.0' or
                      '$(TargetFrameworkMoniker)' != '.NETCoreApp,Version=v10.0' or
                      '$(NetCoreTargetingPackRoot)' != '$(_ProgramKitExpectedNetCoreTargetingPackRoot)'"
           Code="PKNET009"
           Text="The original target-framework identity and installed targeting-pack root must remain exact .NETCoreApp v10.0 values." />
    <Error Condition="'@(_ProgramKitExpectedNetCoreReference)' == '' or
                      '@(_ProgramKitResolvedNetCoreReference)' == '' or
                      '@(_ProgramKitInvalidNetCoreReference)' != '' or
                      '@(_ProgramKitMissingNetCoreReference)' != '' or
                      '@(_ProgramKitUnexpectedNetCoreReference)' != ''"
           Code="PKNET010"
           Text="The compiler must resolve the complete installed Microsoft.NETCore.App.Ref 10.0.10 net10.0 reference set from $(_ProgramKitExpectedNetCoreReferenceDirectory). Missing @(_ProgramKitMissingNetCoreReference); unexpected @(_ProgramKitUnexpectedNetCoreReference)." />
    <Error Condition="'@(_ProgramKitResolvedReferenceWithAlias)' != '' or
                      '@(_ProgramKitResolvedReferenceWithEmbeddedInterop)' != ''"
           Code="PKCS176"
           Text="Resolved assembly aliases and embedded interop references are forbidden." />
  </Target>

  <Target Name="PrepareProgramKitCompilerInvocation"
          DependsOnTargets="ValidateProgramKitAnalyzerExecutionInputs;
                            ValidateProgramKitCSharpGateConfiguration;
                            ValidateProgramKitResolvedAnalyzerSet;
                             ValidateProgramKitOwnedSourceInventory;
                             ValidateProgramKitCSharpGateBootstrapConfiguration;
                             ValidateProgramKitCSharpGateSelfValidationInvocation;
                             ValidateProgramKitCs1701CompatibilityApproval;
                             ValidateProgramKitResolvedReferenceSet"
          BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_ProgramKitExpectedCompilerInvocationNonce>$(ProgramKitCompilerInvocationNonce)</_ProgramKitExpectedCompilerInvocationNonce>
      <_ProgramKitExpectedCompilerGeneratedFilesOutputPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\obj\ProgramKitCompilerGenerated\$(TargetFramework)\$(_ProgramKitExpectedCompilerInvocationNonce)'))</_ProgramKitExpectedCompilerGeneratedFilesOutputPath>
      <_ProgramKitProducingCompilerInvocation>true</_ProgramKitProducingCompilerInvocation>
      <_ProgramKitRequireCompilerExecutionReceipt></_ProgramKitRequireCompilerExecutionReceipt>
      <_ProgramKitProducingCompilerInvocation
        Condition="'$(DesignTimeBuild)' == 'true' and
                   '$(BuildingProject)' == 'false' and
                   '$(ProvideCommandLineArgs)' == 'true' and
                   '$(SkipCompilerExecution)' == 'true'">false</_ProgramKitProducingCompilerInvocation>
      <_ProgramKitRequireCompilerExecutionReceipt
        Condition="'$(_ProgramKitProducingCompilerInvocation)' == 'true' and
                   ('$(MSBuildProjectName)' != 'Orbyss.ProgramKit.CSharpGate' or
                    '$(ProgramKitSelfValidate)' == 'true')">true</_ProgramKitRequireCompilerExecutionReceipt>
      <_ProgramKitOriginalTargetFrameworkVersion>$(TargetFrameworkVersion)</_ProgramKitOriginalTargetFrameworkVersion>
      <_ProgramKitOriginalTargetFrameworkIdentifier>$(TargetFrameworkIdentifier)</_ProgramKitOriginalTargetFrameworkIdentifier>
      <_ProgramKitOriginalBuildingInsideVisualStudio>$(BuildingInsideVisualStudio)</_ProgramKitOriginalBuildingInsideVisualStudio>
    </PropertyGroup>
    <Error Condition="'$(_ProgramKitOriginalTargetFrameworkIdentifier)' != '.NETCoreApp' or
                      '$(_ProgramKitOriginalTargetFrameworkVersion)' != 'v10.0' or
                      '$(TargetFrameworkMoniker)' != '.NETCoreApp,Version=v10.0'"
           Code="PKNET009"
           Text="The compiler invocation must originate from the exact .NETCoreApp v10.0 target-framework identity." />
    <Error Condition="'$(_ProgramKitProducingCompilerInvocation)' == 'true' and
                      ('$(SkipCompilerExecution)' == 'true' or
                       '$(_SkipAnalyzers)' != '' or
                       '$(CompilerResponseFile)' != '' or
                       '@(CompilerResponseFile)' != '' or
                       '$(CscToolPath)' != '' or
                       '$(CscToolExe)' != '' or
                       '$(ProvideCommandLineArgs)' != 'true' or
                       '$(UseSharedCompilation)' != 'false' or
                       '$(UseHostCompilerIfAvailable)' != 'false' or
                       '$(TargetsTriggeredByCompilation)' != '' or
                       '$(EmitCompilerGeneratedFiles)' != 'true' or
                       '$(ProgramKitCompilerInvocationNonce)' != '$(_ProgramKitExpectedCompilerInvocationNonce)' or
                       '$(ProgramKitCompilerGeneratedFilesOutputPath)' != '$(_ProgramKitExpectedCompilerGeneratedFilesOutputPath)' or
                       '$(CompilerGeneratedFilesOutputPath)' != '$(_ProgramKitExpectedCompilerGeneratedFilesOutputPath)' or
                       '$(TargetFramework)' != 'net10.0')"
           Code="PKCS167"
           Text="The producing compiler execution controls changed after validation; compiler/analyzer skipping, response files, compiler or host substitution, compiler reuse, post-compilation hooks, target-framework mutation, command-line receipt removal, and generated-receipt redirection are forbidden." />
    <MakeDir
      Directories="$(_ProgramKitExpectedCompilerGeneratedFilesOutputPath)"
      Condition="'$(_ProgramKitRequireCompilerExecutionReceipt)' == 'true'" />
    <ItemGroup>
      <_ProgramKitPriorCompilerExecutionReceipt
        Remove="@(_ProgramKitPriorCompilerExecutionReceipt)" />
      <_ProgramKitPriorCompilerExecutionReceipt
        Include="$(_ProgramKitExpectedCompilerGeneratedFilesOutputPath)\**\ProgramKitCompilerInvocationReceipt.cs"
        Condition="'$(_ProgramKitRequireCompilerExecutionReceipt)' == 'true'" />
      <_ProgramKitCompilerInputForHash Remove="@(_ProgramKitCompilerInputForHash)" />
      <_ProgramKitCompilerInputContentSnapshot Remove="@(_ProgramKitCompilerInputContentSnapshot)" />
      <_ProgramKitCompilerInputForHash
        Include="@(_ProgramKitValidatedAnalyzer)">
        <InputKind>Analyzer</InputKind>
      </_ProgramKitCompilerInputForHash>
      <_ProgramKitCompilerInputForHash
        Include="@(_ProgramKitValidatedCompileSource)">
        <InputKind>Source</InputKind>
      </_ProgramKitCompilerInputForHash>
      <_ProgramKitCompilerInputForHash
        Include="@(_ProgramKitValidatedReference)">
        <InputKind>Reference</InputKind>
      </_ProgramKitCompilerInputForHash>
      <_ProgramKitCompilerInputForHash
        Include="@(_ProgramKitValidatedAdditionalFile)">
        <InputKind>AdditionalFile</InputKind>
      </_ProgramKitCompilerInputForHash>
      <_ProgramKitCompilerInputForHash
        Include="@(_ProgramKitValidatedAnalyzerConfig)">
        <InputKind>AnalyzerConfig</InputKind>
        <NormalizedPath>%(FullPath)</NormalizedPath>
      </_ProgramKitCompilerInputForHash>
      <_ProgramKitCompilerInputForHash
        Include="@(AnalyzerConfigFiles)"
        Condition="Exists('%(AnalyzerConfigFiles.FullPath)')">
        <InputKind>AnalyzerConfig</InputKind>
        <NormalizedPath>%(AnalyzerConfigFiles.FullPath)</NormalizedPath>
      </_ProgramKitCompilerInputForHash>
      <_ProgramKitCompilerInputForHash
        Include="@(GlobalAnalyzerConfigFiles)"
        Condition="Exists('%(GlobalAnalyzerConfigFiles.FullPath)')">
        <InputKind>AnalyzerConfig</InputKind>
        <NormalizedPath>%(GlobalAnalyzerConfigFiles.FullPath)</NormalizedPath>
      </_ProgramKitCompilerInputForHash>
    </ItemGroup>
    <Delete Files="@(_ProgramKitPriorCompilerExecutionReceipt)"
            Condition="'$(_ProgramKitRequireCompilerExecutionReceipt)' == 'true'" />
    <GetFileHash Files="@(_ProgramKitCompilerInputForHash)"
                 Algorithm="SHA256"
                 Condition="'$(_ProgramKitProducingCompilerInvocation)' == 'true'">
      <Output TaskParameter="Items"
              ItemName="_ProgramKitCompilerInputContentSnapshot" />
    </GetFileHash>
    <ItemGroup Condition="'$(_ProgramKitProducingCompilerInvocation)' == 'true'">
      <_ProgramKitCompilerInputContentSnapshot
        Update="@(_ProgramKitCompilerInputContentSnapshot)">
        <NormalizedPath>%(FullPath)</NormalizedPath>
        <ContentIdentity>$([System.String]::Concat('%(InputKind)', '|', '%(FullPath)', '|', '%(FileHash)'))</ContentIdentity>
      </_ProgramKitCompilerInputContentSnapshot>
    </ItemGroup>
    <PropertyGroup>
      <!--
        The pinned SDK otherwise injects CS1701, CS1702, CS2008, and CS8002
        suppressions inside CoreCompile. These temporary values affect only
        those legacy suppression branches; the Csc task still receives the
        canonical TargetFramework property (net10.0).
      -->
      <TargetFrameworkVersion>v1.0</TargetFrameworkVersion>
      <TargetFrameworkIdentifier>ProgramKitCompilerInvocation</TargetFrameworkIdentifier>
      <BuildingInsideVisualStudio>false</BuildingInsideVisualStudio>
    </PropertyGroup>
  </Target>

  <Target Name="ValidateProgramKitCompilerInvocationReceipt"
          AfterTargets="CoreCompile">
    <PropertyGroup>
      <_ProgramKitExpectedSdkAnalyzerConfigPath>$([System.IO.Path]::GetFullPath('$(MSBuildToolsPath)\Sdks\Microsoft.NET.Sdk\analyzers\build\config\analysislevel_10_recommended_warnaserror.globalconfig'))</_ProgramKitExpectedSdkAnalyzerConfigPath>
      <_ProgramKitExpectedMSTestAnalyzerConfigPath></_ProgramKitExpectedMSTestAnalyzerConfigPath>
      <_ProgramKitExpectedMSTestAnalyzerConfigPath Condition="'$(NuGetPackageRoot)' != ''">$([System.IO.Path]::GetFullPath('$(NuGetPackageRoot)/mstest.analyzers/4.3.2/globalconfigs/mstest-all.globalconfig'))</_ProgramKitExpectedMSTestAnalyzerConfigPath>
    </PropertyGroup>
    <ItemGroup>
      <_ProgramKitCompilerExecutionReceipt
        Remove="@(_ProgramKitCompilerExecutionReceipt)" />
      <_ProgramKitCompilerExecutionReceiptLine
        Remove="@(_ProgramKitCompilerExecutionReceiptLine)" />
      <_ProgramKitCompilerExecutionReceiptHeader
        Remove="@(_ProgramKitCompilerExecutionReceiptHeader)" />
      <_ProgramKitCompilerExecutionReceiptMarker
        Remove="@(_ProgramKitCompilerExecutionReceiptMarker)" />
      <_ProgramKitPostCompilerInputContent
        Remove="@(_ProgramKitPostCompilerInputContent)" />
      <_ProgramKitCompilerExecutionReceipt
        Include="$(_ProgramKitExpectedCompilerGeneratedFilesOutputPath)\**\ProgramKitCompilerInvocationReceipt.cs"
        Condition="'$(_ProgramKitRequireCompilerExecutionReceipt)' == 'true'" />
    </ItemGroup>
    <ReadLinesFromFile File="@(_ProgramKitCompilerExecutionReceipt)"
                       Condition="'@(_ProgramKitCompilerExecutionReceipt->Count())' == '1'">
      <Output TaskParameter="Lines"
              ItemName="_ProgramKitCompilerExecutionReceiptLine" />
    </ReadLinesFromFile>
    <GetFileHash Files="$(_ProgramKitCs1701CompatibilityLockFile)"
                 Algorithm="SHA256"
                 Condition="'$(_ProgramKitCs1701CompatibilityApproved)' == 'true' and
                            Exists('$(_ProgramKitCs1701CompatibilityLockFile)')">
      <Output TaskParameter="Items"
              ItemName="_ProgramKitCs1701CompatibilityPostCompilerLockFileHash" />
    </GetFileHash>
    <GetFileHash Files="@(_ProgramKitCompilerInputForHash)"
                 Algorithm="SHA256"
                 Condition="'$(_ProgramKitProducingCompilerInvocation)' == 'true'">
      <Output TaskParameter="Items"
              ItemName="_ProgramKitPostCompilerInputContent" />
    </GetFileHash>
    <PropertyGroup Condition="'$(_ProgramKitCs1701CompatibilityApproved)' == 'true'">
      <_ProgramKitCs1701CompatibilityPostCompilerObservedLockHash>@(_ProgramKitCs1701CompatibilityPostCompilerLockFileHash->'%(FileHash)')</_ProgramKitCs1701CompatibilityPostCompilerObservedLockHash>
    </PropertyGroup>
    <ItemGroup>
      <_ProgramKitCompilerAnalyzerArgument Remove="@(_ProgramKitCompilerAnalyzerArgument)" />
      <_ProgramKitCompilerSourceArgument Remove="@(_ProgramKitCompilerSourceArgument)" />
      <_ProgramKitCompilerReferenceArgument Remove="@(_ProgramKitCompilerReferenceArgument)" />
      <_ProgramKitCompilerAdditionalFileArgument Remove="@(_ProgramKitCompilerAdditionalFileArgument)" />
      <_ProgramKitCompilerAnalyzerConfigArgument Remove="@(_ProgramKitCompilerAnalyzerConfigArgument)" />
      <_ProgramKitCompilerSdkAnalyzerConfig Remove="@(_ProgramKitCompilerSdkAnalyzerConfig)" />
      <_ProgramKitCompilerMSTestAnalyzerConfig Remove="@(_ProgramKitCompilerMSTestAnalyzerConfig)" />
      <_ProgramKitMissingCompilerAnalyzer Remove="@(_ProgramKitMissingCompilerAnalyzer)" />
      <_ProgramKitUnexpectedCompilerAnalyzer Remove="@(_ProgramKitUnexpectedCompilerAnalyzer)" />
      <_ProgramKitMissingCompilerSource Remove="@(_ProgramKitMissingCompilerSource)" />
      <_ProgramKitUnexpectedCompilerSource Remove="@(_ProgramKitUnexpectedCompilerSource)" />
      <_ProgramKitMissingCompilerReference Remove="@(_ProgramKitMissingCompilerReference)" />
      <_ProgramKitUnexpectedCompilerReference Remove="@(_ProgramKitUnexpectedCompilerReference)" />
      <_ProgramKitMissingCompilerAdditionalFile Remove="@(_ProgramKitMissingCompilerAdditionalFile)" />
      <_ProgramKitUnexpectedCompilerAdditionalFile Remove="@(_ProgramKitUnexpectedCompilerAdditionalFile)" />
      <_ProgramKitMissingCompilerAnalyzerConfig Remove="@(_ProgramKitMissingCompilerAnalyzerConfig)" />
      <_ProgramKitUnexpectedCompilerAnalyzerConfig Remove="@(_ProgramKitUnexpectedCompilerAnalyzerConfig)" />
      <_ProgramKitCompilerWarningAsErrorArgument Remove="@(_ProgramKitCompilerWarningAsErrorArgument)" />
      <_ProgramKitCompilerWarningLevelArgument Remove="@(_ProgramKitCompilerWarningLevelArgument)" />
      <_ProgramKitCompilerNullableArgument Remove="@(_ProgramKitCompilerNullableArgument)" />
      <_ProgramKitCompilerLanguageVersionArgument Remove="@(_ProgramKitCompilerLanguageVersionArgument)" />
      <_ProgramKitCompilerNoWarnArgument Remove="@(_ProgramKitCompilerNoWarnArgument)" />
      <_ProgramKitCompilerApprovedNoWarnArgument Remove="@(_ProgramKitCompilerApprovedNoWarnArgument)" />
      <_ProgramKitForbiddenCompilerPolicyArgument Remove="@(_ProgramKitForbiddenCompilerPolicyArgument)" />
      <_ProgramKitForbiddenCompilerReferenceArgument Remove="@(_ProgramKitForbiddenCompilerReferenceArgument)" />
      <_ProgramKitMissingCompilerInputContent Remove="@(_ProgramKitMissingCompilerInputContent)" />
      <_ProgramKitUnexpectedCompilerInputContent Remove="@(_ProgramKitUnexpectedCompilerInputContent)" />
      <_ProgramKitPostCompilerInputContent
        Update="@(_ProgramKitPostCompilerInputContent)">
        <NormalizedPath>%(FullPath)</NormalizedPath>
        <ContentIdentity>$([System.String]::Concat('%(InputKind)', '|', '%(FullPath)', '|', '%(FileHash)'))</ContentIdentity>
      </_ProgramKitPostCompilerInputContent>
      <_ProgramKitCompilerExecutionReceiptHeader
        Include="@(_ProgramKitCompilerExecutionReceiptLine)"
        Condition="'%(Identity)' == '// &lt;auto-generated program-kit&gt;'" />
      <_ProgramKitCompilerExecutionReceiptMarker
        Include="@(_ProgramKitCompilerExecutionReceiptLine)"
        Condition="'%(Identity)' == '// compiler-executed:program-kit'" />

      <_ProgramKitCompilerAnalyzerArgument
        Include="@(CscCommandLineArgs)"
        Condition="$([System.String]::Copy('%(Identity)').StartsWith('/analyzer:', System.StringComparison.OrdinalIgnoreCase))">
        <NormalizedPath>$([System.IO.Path]::GetFullPath($([System.String]::Copy('%(Identity)').Substring(10).Replace('&quot;', '')), '$(MSBuildProjectDirectory)'))</NormalizedPath>
      </_ProgramKitCompilerAnalyzerArgument>
      <_ProgramKitCompilerSourceArgument
        Include="@(CscCommandLineArgs)"
        Condition="$([System.String]::Copy('%(Identity)').Replace('&quot;', '').EndsWith('.cs', System.StringComparison.OrdinalIgnoreCase))">
        <NormalizedPath>$([System.IO.Path]::GetFullPath($([System.String]::Copy('%(Identity)').Replace('&quot;', '')), '$(MSBuildProjectDirectory)'))</NormalizedPath>
      </_ProgramKitCompilerSourceArgument>
      <_ProgramKitCompilerReferenceArgument
        Include="@(CscCommandLineArgs)"
        Condition="$([System.String]::Copy('%(Identity)').StartsWith('/reference:', System.StringComparison.OrdinalIgnoreCase)) and
                   !$([System.Text.RegularExpressions.Regex]::IsMatch('%(Identity)', '^/reference:[A-Za-z_][A-Za-z0-9_]*(,[A-Za-z_][A-Za-z0-9_]*)*='))">
        <NormalizedPath>$([System.IO.Path]::GetFullPath($([System.String]::Copy('%(Identity)').Substring(11).Replace('&quot;', '')), '$(MSBuildProjectDirectory)'))</NormalizedPath>
      </_ProgramKitCompilerReferenceArgument>
      <_ProgramKitCompilerAdditionalFileArgument
        Include="@(CscCommandLineArgs)"
        Condition="$([System.String]::Copy('%(Identity)').StartsWith('/additionalfile:', System.StringComparison.OrdinalIgnoreCase))">
        <NormalizedPath>$([System.IO.Path]::GetFullPath($([System.String]::Copy('%(Identity)').Substring(16).Replace('&quot;', '')), '$(MSBuildProjectDirectory)'))</NormalizedPath>
      </_ProgramKitCompilerAdditionalFileArgument>
      <_ProgramKitCompilerAnalyzerConfigArgument
        Include="@(CscCommandLineArgs)"
        Condition="$([System.String]::Copy('%(Identity)').StartsWith('/analyzerconfig:', System.StringComparison.OrdinalIgnoreCase))">
        <NormalizedPath>$([System.IO.Path]::GetFullPath($([System.String]::Copy('%(Identity)').Substring(16).Replace('&quot;', '')), '$(MSBuildProjectDirectory)'))</NormalizedPath>
      </_ProgramKitCompilerAnalyzerConfigArgument>
      <_ProgramKitCompilerSdkAnalyzerConfig
        Include="@(_ProgramKitCompilerAnalyzerConfigArgument)"
        Condition="'%(NormalizedPath)' == '$(_ProgramKitExpectedSdkAnalyzerConfigPath)'" />
      <_ProgramKitCompilerMSTestAnalyzerConfig
        Include="@(_ProgramKitCompilerAnalyzerConfigArgument)"
        Condition="'%(NormalizedPath)' == '$(_ProgramKitExpectedMSTestAnalyzerConfigPath)'" />

      <_ProgramKitMissingCompilerAnalyzer Include="@(_ProgramKitValidatedAnalyzer)" />
      <_ProgramKitMissingCompilerAnalyzer
        Remove="@(_ProgramKitCompilerAnalyzerArgument)"
        MatchOnMetadata="NormalizedPath"
        MatchOnMetadataOptions="PathLike" />
      <_ProgramKitUnexpectedCompilerAnalyzer Include="@(_ProgramKitCompilerAnalyzerArgument)" />
      <_ProgramKitUnexpectedCompilerAnalyzer
        Remove="@(_ProgramKitValidatedAnalyzer)"
        MatchOnMetadata="NormalizedPath"
        MatchOnMetadataOptions="PathLike" />

      <_ProgramKitMissingCompilerSource Include="@(_ProgramKitValidatedCompileSource)" />
      <_ProgramKitMissingCompilerSource
        Remove="@(_ProgramKitCompilerSourceArgument)"
        MatchOnMetadata="NormalizedPath"
        MatchOnMetadataOptions="PathLike" />
      <_ProgramKitUnexpectedCompilerSource Include="@(_ProgramKitCompilerSourceArgument)" />
      <_ProgramKitUnexpectedCompilerSource
        Remove="@(_ProgramKitValidatedCompileSource)"
        MatchOnMetadata="NormalizedPath"
        MatchOnMetadataOptions="PathLike" />

      <_ProgramKitMissingCompilerReference Include="@(_ProgramKitValidatedReference)" />
      <_ProgramKitMissingCompilerReference
        Remove="@(_ProgramKitCompilerReferenceArgument)"
        MatchOnMetadata="NormalizedPath"
        MatchOnMetadataOptions="PathLike" />
      <_ProgramKitUnexpectedCompilerReference Include="@(_ProgramKitCompilerReferenceArgument)" />
      <_ProgramKitUnexpectedCompilerReference
        Remove="@(_ProgramKitValidatedReference)"
        MatchOnMetadata="NormalizedPath"
        MatchOnMetadataOptions="PathLike" />

      <_ProgramKitMissingCompilerAdditionalFile Include="@(_ProgramKitValidatedAdditionalFile)" />
      <_ProgramKitMissingCompilerAdditionalFile
        Remove="@(_ProgramKitCompilerAdditionalFileArgument)"
        MatchOnMetadata="NormalizedPath"
        MatchOnMetadataOptions="PathLike" />
      <_ProgramKitUnexpectedCompilerAdditionalFile Include="@(_ProgramKitCompilerAdditionalFileArgument)" />
      <_ProgramKitUnexpectedCompilerAdditionalFile
        Remove="@(_ProgramKitValidatedAdditionalFile)"
        MatchOnMetadata="NormalizedPath"
        MatchOnMetadataOptions="PathLike" />

      <_ProgramKitMissingCompilerAnalyzerConfig Include="@(_ProgramKitValidatedAnalyzerConfig)" />
      <_ProgramKitMissingCompilerAnalyzerConfig
        Remove="@(_ProgramKitCompilerAnalyzerConfigArgument)"
        MatchOnMetadata="NormalizedPath"
        MatchOnMetadataOptions="PathLike" />
      <_ProgramKitUnexpectedCompilerAnalyzerConfig Include="@(_ProgramKitCompilerAnalyzerConfigArgument)" />
      <_ProgramKitUnexpectedCompilerAnalyzerConfig
        Remove="@(_ProgramKitValidatedAnalyzerConfig)"
        MatchOnMetadata="NormalizedPath"
        MatchOnMetadataOptions="PathLike" />
      <_ProgramKitUnexpectedCompilerAnalyzerConfig
        Remove="@(_ProgramKitCompilerSdkAnalyzerConfig)"
        MatchOnMetadata="NormalizedPath"
        MatchOnMetadataOptions="PathLike" />
      <_ProgramKitUnexpectedCompilerAnalyzerConfig
        Remove="@(_ProgramKitCompilerMSTestAnalyzerConfig)"
        MatchOnMetadata="NormalizedPath"
        MatchOnMetadataOptions="PathLike" />

      <_ProgramKitMissingCompilerInputContent
        Include="@(_ProgramKitCompilerInputContentSnapshot)" />
      <_ProgramKitMissingCompilerInputContent
        Remove="@(_ProgramKitPostCompilerInputContent)"
        MatchOnMetadata="ContentIdentity" />
      <_ProgramKitUnexpectedCompilerInputContent
        Include="@(_ProgramKitPostCompilerInputContent)" />
      <_ProgramKitUnexpectedCompilerInputContent
        Remove="@(_ProgramKitCompilerInputContentSnapshot)"
        MatchOnMetadata="ContentIdentity" />

      <_ProgramKitCompilerWarningAsErrorArgument
        Include="@(CscCommandLineArgs)"
        Condition="'%(Identity)' == '/warnaserror+'" />
      <_ProgramKitCompilerWarningLevelArgument
        Include="@(CscCommandLineArgs)"
        Condition="'%(Identity)' == '/warn:9999'" />
      <_ProgramKitCompilerNullableArgument
        Include="@(CscCommandLineArgs)"
        Condition="'%(Identity)' == '/nullable:enable'" />
      <_ProgramKitCompilerLanguageVersionArgument
        Include="@(CscCommandLineArgs)"
        Condition="'%(Identity)' == '/langversion:14.0'" />
      <_ProgramKitCompilerNoWarnArgument
        Include="@(CscCommandLineArgs)"
        Condition="$([System.String]::Copy('%(Identity)').StartsWith('/nowarn:', System.StringComparison.OrdinalIgnoreCase))" />
      <_ProgramKitCompilerApprovedNoWarnArgument
        Include="@(_ProgramKitCompilerNoWarnArgument)"
        Condition="'$(_ProgramKitCs1701CompatibilityApproved)' == 'true' and
                   '%(Identity)' == '/nowarn:1701'" />
      <_ProgramKitForbiddenCompilerPolicyArgument
        Include="@(CscCommandLineArgs)"
        Condition="$([System.String]::Copy('%(Identity)').StartsWith('/warnaserror-', System.StringComparison.OrdinalIgnoreCase)) or
                   ($([System.String]::Copy('%(Identity)').StartsWith('/nowarn:', System.StringComparison.OrdinalIgnoreCase)) and
                    !('$(_ProgramKitCs1701CompatibilityApproved)' == 'true' and
                      '%(Identity)' == '/nowarn:1701')) or
                   $([System.String]::Copy('%(Identity)').StartsWith('/ruleset:', System.StringComparison.OrdinalIgnoreCase)) or
                   $([System.String]::Copy('%(Identity)').StartsWith('/skipanalyzers', System.StringComparison.OrdinalIgnoreCase)) or
                   $([System.String]::Copy('%(Identity)').ToLowerInvariant().Contains('run-nullable-analysis=never'))" />
      <_ProgramKitForbiddenCompilerReferenceArgument
        Include="@(CscCommandLineArgs)"
        Condition="$([System.String]::Copy('%(Identity)').StartsWith('/link:', System.StringComparison.OrdinalIgnoreCase)) or
                   $([System.String]::Copy('%(Identity)').StartsWith('/addmodule:', System.StringComparison.OrdinalIgnoreCase)) or
                   $([System.Text.RegularExpressions.Regex]::IsMatch('%(Identity)', '^/reference:[A-Za-z_][A-Za-z0-9_]*(,[A-Za-z_][A-Za-z0-9_]*)*='))" />
    </ItemGroup>

    <Error Condition="'$(_ProgramKitProducingCompilerInvocation)' == 'true' and
                      ('$(SkipCompilerExecution)' == 'true' or
                       '$(_SkipAnalyzers)' != '' or
                       '$(CompilerResponseFile)' != '' or
                       '@(CompilerResponseFile)' != '' or
                       '$(CscToolPath)' != '' or
                       '$(CscToolExe)' != '' or
                       '$(ProvideCommandLineArgs)' != 'true' or
                       '$(UseSharedCompilation)' != 'false' or
                       '$(UseHostCompilerIfAvailable)' != 'false' or
                       '$(TargetsTriggeredByCompilation)' != '' or
                       '$(EmitCompilerGeneratedFiles)' != 'true' or
                       '$(RunAnalyzers)' != 'true' or
                       '$(ProgramKitCompilerInvocationNonce)' != '$(_ProgramKitExpectedCompilerInvocationNonce)' or
                       '$(ProgramKitCompilerGeneratedFilesOutputPath)' != '$(_ProgramKitExpectedCompilerGeneratedFilesOutputPath)' or
                       '$(CompilerGeneratedFilesOutputPath)' != '$(_ProgramKitExpectedCompilerGeneratedFilesOutputPath)' or
                       '$(TargetFramework)' != 'net10.0' or
                       '$(TargetFrameworkVersion)' != 'v1.0' or
                       '$(TargetFrameworkIdentifier)' != 'ProgramKitCompilerInvocation' or
                       '$(BuildingInsideVisualStudio)' != 'false')"
           Code="PKCS167"
           Text="The compiler execution controls were changed after their final pre-execution validation." />
    <Error Condition="'$(_ProgramKitProducingCompilerInvocation)' != 'true' and
                      !('$(DesignTimeBuild)' == 'true' and
                        '$(BuildingProject)' == 'false' and
                        '$(ProvideCommandLineArgs)' == 'true' and
                        '$(SkipCompilerExecution)' == 'true')"
           Code="PKCS167"
           Text="A non-producing compiler invocation must retain the exact design-time quartet after CoreCompile." />
    <Error Condition="'$(_ProgramKitProducingCompilerInvocation)' != 'true' and
                      ('$(_SkipAnalyzers)' != '' or
                       '$(CompilerResponseFile)' != '' or
                       '@(CompilerResponseFile)' != '' or
                       '$(CscToolPath)' != '' or
                       '$(CscToolExe)' != '' or
                       '$(UseSharedCompilation)' != 'false' or
                       '$(UseHostCompilerIfAvailable)' != 'false' or
                       '$(TargetsTriggeredByCompilation)' != '' or
                       '$(EmitCompilerGeneratedFiles)' != 'true' or
                       '$(RunAnalyzers)' != 'true' or
                       '$(ProgramKitCompilerInvocationNonce)' != '$(_ProgramKitExpectedCompilerInvocationNonce)' or
                       '$(ProgramKitCompilerGeneratedFilesOutputPath)' != '$(_ProgramKitExpectedCompilerGeneratedFilesOutputPath)' or
                       '$(CompilerGeneratedFilesOutputPath)' != '$(_ProgramKitExpectedCompilerGeneratedFilesOutputPath)' or
                       '$(TargetFramework)' != 'net10.0' or
                       '$(TargetFrameworkVersion)' != 'v1.0' or
                       '$(TargetFrameworkIdentifier)' != 'ProgramKitCompilerInvocation' or
                       '$(BuildingInsideVisualStudio)' != 'false')"
           Code="PKCS167"
           Text="A non-producing compiler invocation changed a validated compiler control after CoreCompile. Observed skip-analyzers=$(_SkipAnalyzers), response=$(CompilerResponseFile), response-items=@(CompilerResponseFile), csc-path=$(CscToolPath), csc-exe=$(CscToolExe), shared=$(UseSharedCompilation), host=$(UseHostCompilerIfAvailable), hooks=$(TargetsTriggeredByCompilation), generated=$(EmitCompilerGeneratedFiles), analyzers=$(RunAnalyzers), nonce=$(ProgramKitCompilerInvocationNonce), expected-nonce=$(_ProgramKitExpectedCompilerInvocationNonce), output=$(ProgramKitCompilerGeneratedFilesOutputPath), compiler-output=$(CompilerGeneratedFilesOutputPath), expected-output=$(_ProgramKitExpectedCompilerGeneratedFilesOutputPath), framework=$(TargetFramework), framework-version=$(TargetFrameworkVersion), framework-identifier=$(TargetFrameworkIdentifier), visual-studio=$(BuildingInsideVisualStudio)." />
    <Error Condition="'$(_ProgramKitCs1701CompatibilityApproved)' == 'true' and
                      '$(_ProgramKitCs1701CompatibilityExpectedProjectPath)' == ''"
           Code="PKCS174"
           Text="The compiler warning suppression did not match an approved canonical test project." />
    <Error Condition="'$(_ProgramKitCs1701CompatibilityApproved)' == 'true' and
                      '$(_ProgramKitCs1701CompatibilityKind)' == 'MSTest' and
                      '$(IsTestProject)' != 'true'"
           Code="PKCS174"
           Text="The compiler warning suppression was used by a non-test project." />
    <Error Condition="'$(_ProgramKitCs1701CompatibilityApproved)' == 'true' and
                      '$(_ProgramKitCs1701CompatibilityKind)' == 'MSTest' and
                      '$(MSTestVersion)' != '4.3.2'"
           Code="PKCS174"
           Text="The compiler warning suppression was used with an unapproved MSTest SDK version." />
    <Error Condition="'$(_ProgramKitCs1701CompatibilityApproved)' == 'true' and
                      '$(_ProgramKitCs1701CompatibilityPostCompilerObservedLockHash)' != '$(_ProgramKitCs1701CompatibilityPreCompilerLockHash)'"
           Code="PKCS174"
           Text="The compiler warning suppression was used after the approved package closure changed." />
    <Error Condition="'$(_ProgramKitCs1701CompatibilityApproved)' == 'true' and
                      '@(_ProgramKitCompilerApprovedNoWarnArgument->Count())' != '1'"
           Code="PKCS174"
           Text="The compiler invocation did not contain exactly one approved /nowarn:1701 argument." />
    <Error Condition="'$(_ProgramKitCs1701CompatibilityApproved)' == 'true' and
                      '@(_ProgramKitCompilerNoWarnArgument->Count())' != '1'"
           Code="PKCS174"
           Text="The compiler invocation contained an additional warning suppression." />
    <Error Condition="'$(_ProgramKitCs1701CompatibilityApproved)' != 'true' and
                      '@(_ProgramKitCompilerNoWarnArgument)' != ''"
           Code="PKCS174"
           Text="A compiler warning suppression was used without an active exact human approval." />
    <Error Condition="'$(_ProgramKitRequireCompilerExecutionReceipt)' == 'true' and
                      ('@(_ProgramKitCompilerExecutionReceipt->Count())' != '1' or
                       '@(_ProgramKitCompilerExecutionReceiptLine->Count())' != '2' or
                       '@(_ProgramKitCompilerExecutionReceiptHeader->Count())' != '1' or
                       '@(_ProgramKitCompilerExecutionReceiptMarker->Count())' != '1')"
           Code="PKCS168"
           Text="The Program Kit compiler and its configured gate generator did not produce exactly one current execution receipt." />
    <Error Condition="'$(_ProgramKitProducingCompilerInvocation)' == 'true' and
                      ('@(_ProgramKitMissingCompilerInputContent)' != '' or
                       '@(_ProgramKitUnexpectedCompilerInputContent)' != '')"
           Code="PKCS175"
           Text="A compiler input changed content at the same path after validation. Missing @(_ProgramKitMissingCompilerInputContent->'%(NormalizedPath)'); changed @(_ProgramKitUnexpectedCompilerInputContent->'%(NormalizedPath)')." />
    <Error Condition="'$(ProvideCommandLineArgs)' != 'true' or
                      '@(CscCommandLineArgs->Count())' == '0'"
           Code="PKCS161"
           Text="The C# compiler must produce a non-empty invocation receipt." />
    <Error Condition="'@(_ProgramKitMissingCompilerAnalyzer)' != '' or
                      '@(_ProgramKitUnexpectedCompilerAnalyzer)' != ''"
           Code="PKCS162"
           Text="The analyzers passed to C# must exactly match the validated set. Missing @(_ProgramKitMissingCompilerAnalyzer->'%(NormalizedPath)'); unexpected @(_ProgramKitUnexpectedCompilerAnalyzer->'%(NormalizedPath)')." />
    <Error Condition="'@(_ProgramKitMissingCompilerSource)' != '' or
                      '@(_ProgramKitUnexpectedCompilerSource)' != ''"
           Code="PKCS163"
           Text="The sources passed to C# must exactly match the validated set. Missing @(_ProgramKitMissingCompilerSource->'%(NormalizedPath)'); unexpected @(_ProgramKitUnexpectedCompilerSource->'%(NormalizedPath)')." />
    <Error Condition="'@(_ProgramKitMissingCompilerReference)' != '' or
                      '@(_ProgramKitUnexpectedCompilerReference)' != ''"
           Code="PKCS173"
           Text="The references passed to C# must exactly match the validated target-framework and dependency set. Missing @(_ProgramKitMissingCompilerReference->'%(NormalizedPath)'); unexpected @(_ProgramKitUnexpectedCompilerReference->'%(NormalizedPath)')." />
    <Error Condition="'@(_ProgramKitForbiddenCompilerReferenceArgument)' != ''"
           Code="PKCS176"
           Text="Compiler reference aliases, linked interop assemblies, and added modules are forbidden." />
    <Error Condition="'@(_ProgramKitMissingCompilerAdditionalFile)' != '' or
                      '@(_ProgramKitUnexpectedCompilerAdditionalFile)' != '' or
                      '@(_ProgramKitMissingCompilerAnalyzerConfig)' != '' or
                      '@(_ProgramKitUnexpectedCompilerAnalyzerConfig)' != '' or
                      '@(_ProgramKitCompilerSdkAnalyzerConfig->Count())' != '1' or
                      ('$(_ProgramKitLegacyMSTestProject)' == 'true' and
                       '@(_ProgramKitCompilerMSTestAnalyzerConfig->Count())' != '1') or
                      ('$(_ProgramKitLegacyMSTestProject)' != 'true' and
                       '@(_ProgramKitCompilerMSTestAnalyzerConfig)' != '')"
           Code="PKCS164"
           Text="The additional files and analyzer configurations passed to C# must exactly match the validated sets. Missing additional @(_ProgramKitMissingCompilerAdditionalFile->'%(NormalizedPath)'); unexpected additional @(_ProgramKitUnexpectedCompilerAdditionalFile->'%(NormalizedPath)'); missing configuration @(_ProgramKitMissingCompilerAnalyzerConfig->'%(NormalizedPath)'); unexpected configuration @(_ProgramKitUnexpectedCompilerAnalyzerConfig->'%(NormalizedPath)')." />
    <Error Condition="'@(_ProgramKitCompilerWarningAsErrorArgument->Count())' != '1' or
                      '@(_ProgramKitCompilerWarningLevelArgument->Count())' != '1' or
                      '@(_ProgramKitCompilerNullableArgument->Count())' != '1' or
                      '@(_ProgramKitCompilerLanguageVersionArgument->Count())' != '1' or
                      '@(_ProgramKitForbiddenCompilerPolicyArgument)' != ''"
           Code="PKCS165"
           Text="The executed compiler invocation must preserve warnings-as-errors, warning level 9999, nullable analysis, C# 14.0, and the no-bypass policy." />
    <ItemGroup Condition="'$(_ProgramKitRequireCompilerExecutionReceipt)' == 'true'">
      <_ProgramKitCurrentBuildAcceptance
        Include="$(_ProgramKitExpectedCompilerInvocationNonce)">
        <ProjectFullPath>$(MSBuildProjectFullPath)</ProjectFullPath>
      </_ProgramKitCurrentBuildAcceptance>
    </ItemGroup>
    <PropertyGroup>
      <TargetFrameworkVersion>$(_ProgramKitOriginalTargetFrameworkVersion)</TargetFrameworkVersion>
      <TargetFrameworkIdentifier>$(_ProgramKitOriginalTargetFrameworkIdentifier)</TargetFrameworkIdentifier>
      <BuildingInsideVisualStudio>$(_ProgramKitOriginalBuildingInsideVisualStudio)</BuildingInsideVisualStudio>
      <NoWarn></NoWarn>
    </PropertyGroup>
  </Target>

  <Target Name="WriteProgramKitAggregatePackBuildReceipt"
          AfterTargets="Build"
          Condition="'$(ProgramKitAggregatePackReceiptRoot)' != '' and
                     '$(_ProgramKitRequireCompilerExecutionReceipt)' == 'true'">
    <PropertyGroup>
      <_ProgramKitAggregatePackReceiptRoot>$([System.IO.Path]::GetFullPath('$(ProgramKitAggregatePackReceiptRoot)'))</_ProgramKitAggregatePackReceiptRoot>
      <_ProgramKitAggregatePackReceiptPath>$(_ProgramKitAggregatePackReceiptRoot)\$(MSBuildProjectName).receipt</_ProgramKitAggregatePackReceiptPath>
    </PropertyGroup>
    <Error Condition="!$([System.IO.Path]::IsPathRooted('$(_ProgramKitAggregatePackReceiptRoot)'))"
           Code="PKCS179"
           Text="The aggregate-pack receipt root must be an absolute path." />
    <Error Condition="'@(_ProgramKitCurrentBuildAcceptance->Count())' != '1'"
           Code="PKCS180"
           Text="An aggregate-pack receipt can be written only after one exact current compiler acceptance." />
    <GetFileHash Files="$(TargetPath)"
                 Algorithm="SHA256">
      <Output TaskParameter="Items"
              ItemName="_ProgramKitAggregatePackBuiltTargetHash" />
    </GetFileHash>
    <ItemGroup>
      <_ProgramKitAggregatePackBuildReceiptLine
        Include="format=0.1.0-alpha.1" />
      <_ProgramKitAggregatePackBuildReceiptLine
        Include="project=$(MSBuildProjectFullPath)" />
      <_ProgramKitAggregatePackBuildReceiptLine
        Include="package-version=$(PackageVersion)" />
      <_ProgramKitAggregatePackBuildReceiptLine
        Include="target=$(TargetPath)" />
      <_ProgramKitAggregatePackBuildReceiptLine
        Include="target-sha256=%(_ProgramKitAggregatePackBuiltTargetHash.FileHash)" />
    </ItemGroup>
    <MakeDir Directories="$(_ProgramKitAggregatePackReceiptRoot)" />
    <WriteLinesToFile
      File="$(_ProgramKitAggregatePackReceiptPath)"
      Lines="@(_ProgramKitAggregatePackBuildReceiptLine)"
      Overwrite="true"
      Encoding="UTF-8" />
  </Target>

  <Target Name="ValidateProgramKitCSharpGateBootstrapConfiguration"
          BeforeTargets="ResolveProjectReferences;CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'Orbyss.ProgramKit.CSharpGate'">
    <Error Condition="'$(TreatWarningsAsErrors)' != 'true'"
           Code="PKCS102"
           Text="TreatWarningsAsErrors must remain true for the C# gate." />
    <Error Condition="'$(CodeAnalysisTreatWarningsAsErrors)' != 'true'"
           Code="PKCS108"
           Text="CodeAnalysisTreatWarningsAsErrors must remain true for the C# gate." />
    <Error Condition="'$(MSBuildTreatWarningsAsErrors)' != 'true'"
           Code="PKCS109"
           Text="MSBuildTreatWarningsAsErrors must remain true for the C# gate." />
    <Error Condition="'$(NoWarn)' != '__ProgramKitNoWarningSuppression__'"
           Code="PKCS103"
           Text="NoWarn is forbidden for the C# gate; observed $(NoWarn)." />
    <Error Condition="'$(MSBuildWarningsAsMessages)' != '__ProgramKitNoMSBuildWarningDemotion__;__ProgramKitNoWarningSuppression__'"
           Code="PKCS111"
           Text="MSBuildWarningsAsMessages is forbidden for the C# gate; observed $(MSBuildWarningsAsMessages)." />
    <Error Condition="'$(Nullable)' != 'enable'"
           Code="PKCS105"
           Text="Nullable analysis must remain enabled for the C# gate." />
    <Error Condition="'$(AnalysisLevel)' != 'latest-recommended'"
           Code="PKCS106"
           Text="AnalysisLevel must remain latest-recommended for the C# gate." />
    <Error Condition="'$(EnableNETAnalyzers)' != 'true'"
           Code="PKCS112"
           Text="EnableNETAnalyzers must remain true for the C# gate." />
    <Error Condition="'$(RunAnalyzers)' != 'true'"
           Code="PKCS114"
           Text="RunAnalyzers must remain true for the C# gate." />
    <Error Condition="'$(RunAnalyzersDuringBuild)' != 'true'"
           Code="PKCS113"
           Text="RunAnalyzersDuringBuild must remain true for the C# gate." />
    <Error Condition="'$(ProvideCommandLineArgs)' != 'true'"
           Code="PKCS161"
           Text="ProvideCommandLineArgs must remain true so the C# gate compiler invocation can be verified." />
    <Error Condition="'$(UseSharedCompilation)' != 'false'"
           Code="PKCS169"
           Text="UseSharedCompilation must remain false for the C# gate so self-validation and consumers cannot reuse stale analyzer code." />
    <Error Condition="'$(UseHostCompilerIfAvailable)' != 'false'"
           Code="PKCS170"
           Text="UseHostCompilerIfAvailable must remain false for the C# gate." />
    <Error Condition="'$(TargetsTriggeredByCompilation)' != ''"
           Code="PKCS171"
           Text="TargetsTriggeredByCompilation must remain empty for the C# gate." />
    <Error Condition="'$(EnforceCodeStyleInBuild)' != 'true'"
           Code="PKCS107"
           Text="EnforceCodeStyleInBuild must remain true for the C# gate." />
    <Error Condition="'$(WarningLevel)' != '9999'"
           Code="PKCS115"
           Text="WarningLevel must remain 9999 for the C# gate; observed $(WarningLevel)." />
    <Error Condition="'$(CodeAnalysisRuleSet)' != ''"
           Code="PKCS116"
           Text="CodeAnalysisRuleSet is forbidden for the C# gate." />
    <Error Condition="'$(AnalysisMode)' != '' or
                      '$(AnalysisModeAll)' != '' or
                      '$(AnalysisModeGlobal)' != '' or
                      '$(AnalysisModeStyle)' != '' or
                      '$(AnalysisModeDesign)' != '' or
                      '$(AnalysisModeDocumentation)' != '' or
                      '$(AnalysisModeGlobalization)' != '' or
                      '$(AnalysisModeInteroperability)' != '' or
                      '$(AnalysisModeMaintainability)' != '' or
                      '$(AnalysisModeNaming)' != '' or
                      '$(AnalysisModePerformance)' != '' or
                      '$(AnalysisModeReliability)' != '' or
                      '$(AnalysisModeSecurity)' != '' or
                      '$(AnalysisModeUsage)' != '' or
                      ('$(AnalysisLevelStyle)' != '' and '$(AnalysisLevelStyle)' != 'latest-recommended') or
                      ('$(AnalysisLevelDesign)' != '' and '$(AnalysisLevelDesign)' != 'latest-recommended') or
                      ('$(AnalysisLevelDocumentation)' != '' and '$(AnalysisLevelDocumentation)' != 'latest-recommended') or
                      ('$(AnalysisLevelGlobalization)' != '' and '$(AnalysisLevelGlobalization)' != 'latest-recommended') or
                      ('$(AnalysisLevelInteroperability)' != '' and '$(AnalysisLevelInteroperability)' != 'latest-recommended') or
                      ('$(AnalysisLevelMaintainability)' != '' and '$(AnalysisLevelMaintainability)' != 'latest-recommended') or
                      ('$(AnalysisLevelNaming)' != '' and '$(AnalysisLevelNaming)' != 'latest-recommended') or
                      ('$(AnalysisLevelPerformance)' != '' and '$(AnalysisLevelPerformance)' != 'latest-recommended') or
                      ('$(AnalysisLevelReliability)' != '' and '$(AnalysisLevelReliability)' != 'latest-recommended') or
                      ('$(AnalysisLevelSecurity)' != '' and '$(AnalysisLevelSecurity)' != 'latest-recommended') or
                      ('$(AnalysisLevelUsage)' != '' and '$(AnalysisLevelUsage)' != 'latest-recommended') or
                      '$(AnalysisLevelPrefix)' != 'latest' or
                      '$(AnalysisLevelSuffix)' != 'recommended' or
                      '$(EffectiveAnalysisLevel)' != '10.0' or
                      '$(SkipGlobalAnalyzerConfigForPackage)' != '' or
                      '$(EffectiveCodeAnalysisTreatWarningsAsErrors)' != 'true' or
                      ('$(MicrosoftCodeAnalysisNetAnalyzersRulesVersion)' != '' and
                       '$(MicrosoftCodeAnalysisNetAnalyzersRulesVersion)' != '10')"
           Code="PKCS117"
           Text="Analyzer mode, level, effective severity, and global-configuration overrides are forbidden for the C# gate. Observed prefix=$(AnalysisLevelPrefix), suffix=$(AnalysisLevelSuffix), effective=$(EffectiveAnalysisLevel), skip-global=$(SkipGlobalAnalyzerConfigForPackage), effective-errors=$(EffectiveCodeAnalysisTreatWarningsAsErrors), rules=$(MicrosoftCodeAnalysisNetAnalyzersRulesVersion), style=$(AnalysisLevelStyle), design=$(AnalysisLevelDesign), documentation=$(AnalysisLevelDocumentation), globalization=$(AnalysisLevelGlobalization), interoperability=$(AnalysisLevelInteroperability), maintainability=$(AnalysisLevelMaintainability), naming=$(AnalysisLevelNaming), performance=$(AnalysisLevelPerformance), reliability=$(AnalysisLevelReliability), security=$(AnalysisLevelSecurity), usage=$(AnalysisLevelUsage)." />
    <Error Condition="'$(WarningsNotAsErrors)' != '__ProgramKitNoWarningDemotion__'"
           Code="PKCS104"
           Text="WarningsNotAsErrors is forbidden for the C# gate; observed $(WarningsNotAsErrors)." />
    <Error Condition="'$(DisabledWarnings)' != ''"
           Code="PKCS123"
           Text="DisabledWarnings is forbidden for the C# gate." />
    <Error Condition="'$(ProgramKitGeneratedSourceRoot)' != 'ProgramKitGenerated'"
           Code="PKCS126"
           Text="ProgramKitGeneratedSourceRoot must remain exactly ProgramKitGenerated for the C# gate." />
    <Error Condition="'$(SkipCompilerExecution)' == 'true' and
                      !('$(DesignTimeBuild)' == 'true' and
                        '$(BuildingProject)' == 'false' and
                        '$(ProvideCommandLineArgs)' == 'true')"
           Code="PKCS130"
           Text="SkipCompilerExecution is allowed only for a non-producing design-time C# gate workspace build." />
    <Error Condition="'$(OptimizeImplicitlyTriggeredBuild)' != 'false'"
           Code="PKCS134"
           Text="OptimizeImplicitlyTriggeredBuild must remain false for the C# gate." />
    <Error Condition="$([System.String]::Copy('$(Features)').ToLowerInvariant().Contains('run-nullable-analysis=never'))"
           Code="PKCS135"
           Text="The run-nullable-analysis=never compiler feature is forbidden for the C# gate." />
    <Error Condition="'$(CompilerResponseFile)' != '' or
                      '@(CompilerResponseFile)' != ''"
           Code="PKCS145"
           Text="CompilerResponseFile properties and items are forbidden for the C# gate." />
    <Error Condition="'$(CscToolPath)' != ''"
           Code="PKCS146"
           Text="CscToolPath compiler substitution is forbidden for the C# gate." />
    <Error Condition="'$(CscToolExe)' != ''"
           Code="PKCS147"
           Text="CscToolExe compiler substitution is forbidden for the C# gate." />
    <Error Condition="'$(BuildProjectReferences)' != 'true' and
                      !('$(DesignTimeBuild)' == 'true' and
                        '$(BuildingProject)' == 'false' and
                        '$(ProvideCommandLineArgs)' == 'true')"
           Code="PKCS151"
           Text="BuildProjectReferences must remain true for producing C# gate builds." />
    <PropertyGroup>
      <NoWarn></NoWarn>
      <WarningsNotAsErrors></WarningsNotAsErrors>
      <MSBuildWarningsAsMessages></MSBuildWarningsAsMessages>
    </PropertyGroup>
  </Target>

  <Target Name="ValidateProgramKitCSharpGateSelfValidationInvocation"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'Orbyss.ProgramKit.CSharpGate' and
                     '$(ProgramKitSelfValidate)' == 'true'">
    <PropertyGroup>
      <_ProgramKitSelfValidationInvocationDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\obj\self-validation-invocations'))</_ProgramKitSelfValidationInvocationDirectory>
      <_ProgramKitExpectedSelfValidationInvocationFile></_ProgramKitExpectedSelfValidationInvocationFile>
      <_ProgramKitExpectedSelfValidationInvocationFile Condition="'$(ProgramKitSelfValidationInvocationToken)' != ''">$([System.IO.Path]::GetFullPath('$(_ProgramKitSelfValidationInvocationDirectory)\$(ProgramKitSelfValidationInvocationToken).token'))</_ProgramKitExpectedSelfValidationInvocationFile>
    </PropertyGroup>
    <ItemGroup>
      <_ProgramKitSelfValidationInvocationLine Remove="@(_ProgramKitSelfValidationInvocationLine)" />
    </ItemGroup>
    <Error Condition="'$(ProgramKitSelfValidationInvocationToken)' == '' or
                      '$(ProgramKitSelfValidationInvocationFile)' == '' or
                      '$(ProgramKitSelfValidationInvocationFile)' != '$(_ProgramKitExpectedSelfValidationInvocationFile)' or
                      !Exists('$(ProgramKitSelfValidationInvocationFile)')"
           Code="PKCS149"
           Text="ProgramKitSelfValidate is an internal one-time invocation and cannot be supplied by a caller." />
    <Error Condition="'$(ProgramKitSelfValidationAnalyzerPath)' != '$(ProgramKitCSharpGateAssemblyPath)' or
                      !Exists('$(ProgramKitCSharpGateAssemblyPath)')"
           Code="PKCS150"
           Text="Gate self-validation must use the canonical analyzer emitted by the immediately preceding outer build." />
    <ReadLinesFromFile File="$(ProgramKitSelfValidationInvocationFile)"
                       Condition="Exists('$(ProgramKitSelfValidationInvocationFile)')">
      <Output TaskParameter="Lines"
              ItemName="_ProgramKitSelfValidationInvocationLine" />
    </ReadLinesFromFile>
    <Error Condition="'@(_ProgramKitSelfValidationInvocationLine->Count())' != '1' or
                      '@(_ProgramKitSelfValidationInvocationLine)' != '$(ProgramKitSelfValidationInvocationToken)'"
           Code="PKCS149"
           Text="The gate self-validation invocation token is invalid or has already been consumed." />
    <Delete Files="$(ProgramKitSelfValidationInvocationFile)"
            Condition="'@(_ProgramKitSelfValidationInvocationLine->Count())' == '1' and
                       '@(_ProgramKitSelfValidationInvocationLine)' == '$(ProgramKitSelfValidationInvocationToken)'" />
  </Target>

  <Target Name="ValidateProgramKitRestoreWarningConfiguration"
          DependsOnTargets="ValidateProgramKitCSharpGateCanonicalPaths"
          BeforeTargets="_GenerateRestoreGraphProjectEntry">
    <ItemGroup>
      <_ProgramKitPackageReferenceWithNoWarn Remove="@(_ProgramKitPackageReferenceWithNoWarn)" />
      <_ProgramKitProjectReferenceWithNoWarn Remove="@(_ProgramKitProjectReferenceWithNoWarn)" />
      <_ProgramKitPackageReferenceWithNoWarn
        Include="@(PackageReference)"
        Condition="'%(PackageReference.NoWarn)' != ''" />
      <_ProgramKitProjectReferenceWithNoWarn
        Include="@(ProjectReference)"
        Condition="'%(ProjectReference.NoWarn)' != ''" />
    </ItemGroup>
    <Error Condition="'$(TreatWarningsAsErrors)' != 'true'"
           Code="PKCS102"
           Text="TreatWarningsAsErrors must remain true during restore." />
    <Error Condition="'$(CodeAnalysisTreatWarningsAsErrors)' != 'true'"
           Code="PKCS108"
           Text="CodeAnalysisTreatWarningsAsErrors must remain true during restore." />
    <Error Condition="'$(RestoreTreatWarningsAsErrors)' != 'true'"
           Code="PKCS110"
           Text="RestoreTreatWarningsAsErrors must remain true." />
    <Error Condition="'$(AnalysisLevel)' != 'latest-recommended'"
           Code="PKCS106"
           Text="AnalysisLevel must remain latest-recommended during restore." />
    <Error Condition="'$(AnalysisMode)' != '' or
                      '$(AnalysisModeAll)' != '' or
                      '$(AnalysisModeGlobal)' != '' or
                      '$(AnalysisModeStyle)' != '' or
                      '$(AnalysisModeDesign)' != '' or
                      '$(AnalysisModeDocumentation)' != '' or
                      '$(AnalysisModeGlobalization)' != '' or
                      '$(AnalysisModeInteroperability)' != '' or
                      '$(AnalysisModeMaintainability)' != '' or
                      '$(AnalysisModeNaming)' != '' or
                      '$(AnalysisModePerformance)' != '' or
                      '$(AnalysisModeReliability)' != '' or
                      '$(AnalysisModeSecurity)' != '' or
                      '$(AnalysisModeUsage)' != '' or
                      ('$(AnalysisLevelStyle)' != '' and '$(AnalysisLevelStyle)' != 'latest-recommended') or
                      ('$(AnalysisLevelDesign)' != '' and '$(AnalysisLevelDesign)' != 'latest-recommended') or
                      ('$(AnalysisLevelDocumentation)' != '' and '$(AnalysisLevelDocumentation)' != 'latest-recommended') or
                      ('$(AnalysisLevelGlobalization)' != '' and '$(AnalysisLevelGlobalization)' != 'latest-recommended') or
                      ('$(AnalysisLevelInteroperability)' != '' and '$(AnalysisLevelInteroperability)' != 'latest-recommended') or
                      ('$(AnalysisLevelMaintainability)' != '' and '$(AnalysisLevelMaintainability)' != 'latest-recommended') or
                      ('$(AnalysisLevelNaming)' != '' and '$(AnalysisLevelNaming)' != 'latest-recommended') or
                      ('$(AnalysisLevelPerformance)' != '' and '$(AnalysisLevelPerformance)' != 'latest-recommended') or
                      ('$(AnalysisLevelReliability)' != '' and '$(AnalysisLevelReliability)' != 'latest-recommended') or
                      ('$(AnalysisLevelSecurity)' != '' and '$(AnalysisLevelSecurity)' != 'latest-recommended') or
                      ('$(AnalysisLevelUsage)' != '' and '$(AnalysisLevelUsage)' != 'latest-recommended') or
                      '$(AnalysisLevelPrefix)' != 'latest' or
                      '$(AnalysisLevelSuffix)' != 'recommended' or
                      '$(EffectiveAnalysisLevel)' != '10.0' or
                      '$(SkipGlobalAnalyzerConfigForPackage)' != '' or
                      '$(EffectiveCodeAnalysisTreatWarningsAsErrors)' != 'true' or
                      ('$(MicrosoftCodeAnalysisNetAnalyzersRulesVersion)' != '' and
                       '$(MicrosoftCodeAnalysisNetAnalyzersRulesVersion)' != '10')"
           Code="PKCS117"
           Text="Analyzer mode, level, effective severity, and global-configuration overrides are forbidden during restore." />
    <Error Condition="'$(NoWarn)' != '__ProgramKitNoWarningSuppression__'"
           Code="PKCS103"
           Text="NoWarn is forbidden during restore; observed $(NoWarn)." />
    <Error Condition="'$(WarningsNotAsErrors)' != '__ProgramKitNoWarningDemotion__'"
           Code="PKCS104"
           Text="WarningsNotAsErrors is forbidden during restore; observed $(WarningsNotAsErrors)." />
    <Error Condition="'$(MSBuildWarningsAsMessages)' != '__ProgramKitNoMSBuildWarningDemotion__;__ProgramKitNoWarningSuppression__'"
           Code="PKCS111"
           Text="MSBuildWarningsAsMessages is forbidden during restore; observed $(MSBuildWarningsAsMessages)." />
    <Error Condition="'$(RestoreNoWarn)' != ''"
           Code="PKCS124"
           Text="RestoreNoWarn is forbidden; observed $(RestoreNoWarn)." />
    <Error Condition="'$(NuGetAudit)' != 'true'"
           Code="PKCS136"
           Text="NuGetAudit must remain true." />
    <Error Condition="'$(NuGetAuditMode)' != 'all'"
           Code="PKCS137"
           Text="NuGetAuditMode must remain all." />
    <Error Condition="'$(NuGetAuditLevel)' != 'low'"
           Code="PKCS138"
           Text="NuGetAuditLevel must remain low." />
    <Error Condition="'$(RestoreIgnoreFailedSources)' != 'false'"
           Code="PKCS139"
           Text="RestoreIgnoreFailedSources must remain false." />
    <Error Condition="'@(NuGetAuditSuppress)' != ''"
           Code="PKCS140"
           Text="NuGetAuditSuppress entries are forbidden; observed @(NuGetAuditSuppress)." />
    <Error Condition="'@(_ProgramKitPackageReferenceWithNoWarn)' != ''"
           Code="PKCS143"
           Text="PackageReference NoWarn metadata is forbidden; observed @(_ProgramKitPackageReferenceWithNoWarn)." />
    <Error Condition="'@(_ProgramKitProjectReferenceWithNoWarn)' != ''"
           Code="PKCS144"
           Text="ProjectReference NoWarn metadata is forbidden; observed @(_ProgramKitProjectReferenceWithNoWarn)." />
    <PropertyGroup>
      <NoWarn></NoWarn>
      <WarningsNotAsErrors></WarningsNotAsErrors>
      <MSBuildWarningsAsMessages></MSBuildWarningsAsMessages>
    </PropertyGroup>
  </Target>

  <Target Name="RunProgramKitCSharpGateSelfValidation"
          AfterTargets="Build"
          Condition="'$(MSBuildProjectName)' == 'Orbyss.ProgramKit.CSharpGate' and
                     '$(ProgramKitSelfValidate)' != 'true'">
    <PropertyGroup>
      <_ProgramKitDotNetHostPath Condition="'$(OS)' == 'Windows_NT'">$([System.IO.Path]::GetFullPath('$(MSBuildToolsPath)\..\..\dotnet.exe'))</_ProgramKitDotNetHostPath>
      <_ProgramKitDotNetHostPath Condition="'$(OS)' != 'Windows_NT'">$([System.IO.Path]::GetFullPath('$(MSBuildToolsPath)/../../dotnet'))</_ProgramKitDotNetHostPath>
      <_ProgramKitSelfValidationAnalyzerPath>$(TargetPath)</_ProgramKitSelfValidationAnalyzerPath>
      <_ProgramKitSelfValidationInvocationToken>$([System.Guid]::NewGuid().ToString('N'))</_ProgramKitSelfValidationInvocationToken>
      <_ProgramKitSelfValidationBaseOutputPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\bin\self-validation\$(_ProgramKitSelfValidationInvocationToken)'))/</_ProgramKitSelfValidationBaseOutputPath>
      <_ProgramKitSelfValidationIntermediateOutputPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\obj\self-validation\$(Configuration)\$(TargetFramework)\$(_ProgramKitSelfValidationInvocationToken)'))/</_ProgramKitSelfValidationIntermediateOutputPath>
      <_ProgramKitSelfValidationInvocationDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\obj\self-validation-invocations'))</_ProgramKitSelfValidationInvocationDirectory>
      <_ProgramKitSelfValidationInvocationFile>$(_ProgramKitSelfValidationInvocationDirectory)\$(_ProgramKitSelfValidationInvocationToken).token</_ProgramKitSelfValidationInvocationFile>
    </PropertyGroup>
    <MakeDir Directories="$(_ProgramKitSelfValidationInvocationDirectory)" />
    <WriteLinesToFile File="$(_ProgramKitSelfValidationInvocationFile)"
                      Lines="$(_ProgramKitSelfValidationInvocationToken)"
                      Overwrite="true" />
    <Message Text="Running mandatory Program Kit C# gate self-validation."
             Importance="high" />
    <Exec Command="&quot;$(_ProgramKitDotNetHostPath)&quot; build &quot;$(MSBuildProjectFullPath)&quot; --configuration &quot;$(Configuration)&quot; --no-restore --no-incremental --property:ProgramKitSelfValidate=true --property:ProgramKitSelfValidationAnalyzerPath=&quot;$(_ProgramKitSelfValidationAnalyzerPath)&quot; --property:ProgramKitSelfValidationInvocationToken=&quot;$(_ProgramKitSelfValidationInvocationToken)&quot; --property:ProgramKitSelfValidationInvocationFile=&quot;$(_ProgramKitSelfValidationInvocationFile)&quot; --property:RootNamespace=&quot;$(RootNamespace)&quot; --property:BaseOutputPath=&quot;$(_ProgramKitSelfValidationBaseOutputPath)&quot; --property:IntermediateOutputPath=&quot;$(_ProgramKitSelfValidationIntermediateOutputPath)&quot; --property:UseSharedCompilation=false"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
    <RemoveDir Directories="$(_ProgramKitSelfValidationBaseOutputPath);
                            $(_ProgramKitSelfValidationIntermediateOutputPath)" />
  </Target>

  <Target Name="ValidateProgramKitPackageVersion"
          BeforeTargets="_IntermediatePack;GenerateNuspec"
          Condition="'$(IsPackable)' == 'true'">
    <Error Condition="'$(NoBuild)' == 'true' and
                      '$(ProgramKitAggregatePackReceiptRoot)' == ''"
           Code="PKCS152"
           Text="Pack can use NoBuild only with exact transaction-local receipts from the immediately preceding aggregate C# gate build." />
    <Error Condition="'$(DesignTimeBuild)' == 'true' or
                      '$(SkipCompilerExecution)' == 'true'"
           Code="PKCS172"
           Text="Pack requires a producing compiler invocation; design-time and compiler-skipping modes are forbidden." />
    <Error Condition="'$(ProgramKitPackageRole)' == 'program-kit' and
                      '$(PackageVersion)' != '0.1.0-alpha.3'"
           Code="PKPUB001"
           Text="Program Kit packages must use exact version 0.1.0-alpha.3." />
    <Error Condition="'$(ProgramKitPackageRole)' == 'fixture' and
                      '$(PackageVersion)' != '0.1.0-fixture.1'"
           Code="PKPUB002"
           Text="Selected fixture packages must use exact version 0.1.0-fixture.1." />
    <Error Condition="'$(ProgramKitPackageRole)' != 'program-kit' and
                      '$(ProgramKitPackageRole)' != 'fixture'"
           Code="PKPUB003"
           Text="ProgramKitPackageRole must be exactly program-kit or fixture." />
  </Target>

  <Target Name="ValidateProgramKitAggregatePackReceipt"
          DependsOnTargets="ValidateProgramKitPackageVersion"
          BeforeTargets="PrepareForPublish;GenerateNuspec"
          Condition="'$(IsPackable)' == 'true' and
                     '$(_IsPacking)' == 'true' and
                     '$(NoBuild)' == 'true'">
    <PropertyGroup>
      <_ProgramKitAggregatePackReceiptRoot>$([System.IO.Path]::GetFullPath('$(ProgramKitAggregatePackReceiptRoot)'))</_ProgramKitAggregatePackReceiptRoot>
      <_ProgramKitAggregatePackReceiptPath>$(_ProgramKitAggregatePackReceiptRoot)\$(MSBuildProjectName).receipt</_ProgramKitAggregatePackReceiptPath>
    </PropertyGroup>
    <Error Condition="!Exists('$(_ProgramKitAggregatePackReceiptPath)')"
           Code="PKCS181"
           Text="The exact aggregate-pack build receipt is absent for $(MSBuildProjectFullPath)." />
    <GetFileHash Files="$(TargetPath)"
                 Algorithm="SHA256"
                 Condition="Exists('$(_ProgramKitAggregatePackReceiptPath)')">
      <Output TaskParameter="Items"
              ItemName="_ProgramKitAggregatePackCurrentTargetHash" />
    </GetFileHash>
    <ReadLinesFromFile
      File="$(_ProgramKitAggregatePackReceiptPath)"
      Condition="Exists('$(_ProgramKitAggregatePackReceiptPath)')">
      <Output TaskParameter="Lines"
              ItemName="_ProgramKitAggregatePackActualReceiptLine" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_ProgramKitAggregatePackExpectedReceiptLine
        Include="format=0.1.0-alpha.1" />
      <_ProgramKitAggregatePackExpectedReceiptLine
        Include="project=$(MSBuildProjectFullPath)" />
      <_ProgramKitAggregatePackExpectedReceiptLine
        Include="package-version=$(PackageVersion)" />
      <_ProgramKitAggregatePackExpectedReceiptLine
        Include="target=$(TargetPath)" />
      <_ProgramKitAggregatePackExpectedReceiptLine
        Include="target-sha256=%(_ProgramKitAggregatePackCurrentTargetHash.FileHash)" />
      <_ProgramKitAggregatePackMissingReceiptLine
        Include="@(_ProgramKitAggregatePackExpectedReceiptLine)" />
      <_ProgramKitAggregatePackMissingReceiptLine
        Remove="@(_ProgramKitAggregatePackActualReceiptLine)" />
      <_ProgramKitAggregatePackUnexpectedReceiptLine
        Include="@(_ProgramKitAggregatePackActualReceiptLine)" />
      <_ProgramKitAggregatePackUnexpectedReceiptLine
        Remove="@(_ProgramKitAggregatePackExpectedReceiptLine)" />
    </ItemGroup>
    <Error Condition="'@(_ProgramKitAggregatePackMissingReceiptLine)' != '' or
                       '@(_ProgramKitAggregatePackUnexpectedReceiptLine)' != '' or
                       '@(_ProgramKitAggregatePackActualReceiptLine->Count())' != '5'"
           Code="PKCS182"
           Text="The aggregate-pack build receipt does not exactly match this project's current built target, package version, and path. Missing @(_ProgramKitAggregatePackMissingReceiptLine); unexpected @(_ProgramKitAggregatePackUnexpectedReceiptLine); actual @(_ProgramKitAggregatePackActualReceiptLine); expected @(_ProgramKitAggregatePackExpectedReceiptLine)." />
    <ItemGroup>
      <_ProgramKitValidatedAggregatePackReceipt
        Include="$(MSBuildProjectFullPath)"
        Condition="'@(_ProgramKitAggregatePackMissingReceiptLine)' == '' and
                   '@(_ProgramKitAggregatePackUnexpectedReceiptLine)' == '' and
                   '@(_ProgramKitAggregatePackActualReceiptLine->Count())' == '5'" />
    </ItemGroup>
  </Target>

  <Target Name="RequireProgramKitCurrentBuildForPackage"
          DependsOnTargets="ValidateProgramKitPackageVersion;
                            ValidateProgramKitAggregatePackReceipt"
          BeforeTargets="GenerateNuspec"
          Condition="'$(IsPackable)' == 'true'">
    <ItemGroup>
      <_ProgramKitMatchingPackageBuildAcceptance
        Remove="@(_ProgramKitMatchingPackageBuildAcceptance)" />
      <_ProgramKitMatchingPackageBuildAcceptance
        Include="@(_ProgramKitCurrentBuildAcceptance)"
        Condition="'%(Identity)' == '$(ProgramKitCompilerInvocationNonce)' and
                   '%(ProjectFullPath)' == '$(MSBuildProjectFullPath)'" />
    </ItemGroup>
    <Error Condition="'$(NoBuild)' != 'true' and
                      '@(_ProgramKitMatchingPackageBuildAcceptance->Count())' != '1'"
           Code="PKCS177"
           Text="Package generation requires the private acceptance receipt from this project instance's current verified compiler invocation." />
    <Error Condition="'$(NoBuild)' == 'true' and
                      '@(_ProgramKitValidatedAggregatePackReceipt->Count())' != '1'"
           Code="PKCS182"
           Text="Package generation with NoBuild requires one exact validated aggregate-pack receipt." />
  </Target>

  <Target Name="ValidateProgramKitPublishBuildOptions"
          BeforeTargets="BuildOnlySettings;Publish"
          Condition="'$(_IsPublishing)' == 'true'">
    <Error Condition="'$(NoBuild)' == 'true' and
                      ('$(_IsPacking)' != 'true' or
                       '$(ProgramKitAggregatePackReceiptRoot)' == '')"
           Code="PKCS153"
           Text="Publish cannot use NoBuild because publication requires a current C# gate build." />
    <Error Condition="'$(DesignTimeBuild)' == 'true' or
                      ('$(SkipCompilerExecution)' == 'true' and
                       ('$(_IsPacking)' != 'true' or
                        '$(NoBuild)' != 'true' or
                        '$(ProgramKitAggregatePackReceiptRoot)' == ''))"
           Code="PKCS172"
           Text="Publish requires a producing compiler invocation; design-time and compiler-skipping modes are forbidden." />
  </Target>

  <Target Name="RequireProgramKitCurrentBuildForPublish"
          DependsOnTargets="ValidateProgramKitAggregatePackReceipt"
          BeforeTargets="PrepareForPublish;ComputeAndCopyFilesToPublishDirectory">
    <ItemGroup>
      <_ProgramKitMatchingPublishBuildAcceptance
        Remove="@(_ProgramKitMatchingPublishBuildAcceptance)" />
      <_ProgramKitMatchingPublishBuildAcceptance
        Include="@(_ProgramKitCurrentBuildAcceptance)"
        Condition="'%(Identity)' == '$(ProgramKitCompilerInvocationNonce)' and
                   '%(ProjectFullPath)' == '$(MSBuildProjectFullPath)'" />
    </ItemGroup>
    <Error Condition="'@(_ProgramKitMatchingPublishBuildAcceptance->Count())' != '1' and
                      '@(_ProgramKitValidatedAggregatePackReceipt->Count())' != '1'"
           Code="PKCS178"
           Text="Publish preparation and copying require the private acceptance receipt from this project instance's current verified compiler invocation." />
  </Target>

  <Target Name="PinProgramKitProjectReferenceVersionsExactly"
          AfterTargets="_GetProjectReferenceVersions"
          BeforeTargets="GenerateNuspec"
          Condition="'$(IsPackable)' == 'true'">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)"
                                      Condition="'%(_ProjectReferencesWithVersions.ProjectVersion)' != ''">
        <ProjectVersion>[%(_ProjectReferencesWithVersions.ProjectVersion)]</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>
</Project>
