<Project TreatAsLocalProperty="_ProgramKitApprovedMSTestAnalyzerConfigPath;
                               _ProgramKitApprovedMSTestAnalyzerTargetsPath;
                               _ProgramKitCodeStyleAnalyzerPath;
                               _ProgramKitCodeStyleFixAnalyzerPath;
                               _ProgramKitCSharpCodeStyleAnalyzerPath;
                               _ProgramKitCSharpCodeStyleFixAnalyzerPath;
                               _ProgramKitCSharpNetAnalyzerPath;
                               _ProgramKitDotNetHostPath;
                               _ProgramKitExpectedCSharpGateAssemblyPath;
                               _ProgramKitExpectedCSharpGateProjectPath;
                               _ProgramKitExpectedCompilerInvocationNonce;
                               _ProgramKitExpectedCompilerGeneratedFilesOutputPath;
                               _ProgramKitExpectedGeneratedSourceProbeProjectPath;
                               _ProgramKitExpectedSelfValidationInvocationFile;
                               _ProgramKitExpectedWarningApprovalLedgerPath;
                               _ProgramKitFrameworkAnalyzerRoot;
                               _ProgramKitGeneratedSourceProbeAnalyzerPath;
                               _ProgramKitIntermediateRoot;
                               _ProgramKitManagedCoreTargetsPath;
                               _ProgramKitMSTestAnalyzerPath;
                               _ProgramKitMSTestCodeFixAnalyzerPath;
                               _ProgramKitNetAnalyzerPath;
                               _ProgramKitNetAnalyzersTargetsPath;
                               _ProgramKitResolvedGeneratedSourceProbeProjectPath;
                               _ProgramKitSdkRoot;
                               _ProgramKitSelfValidationAnalyzerPath;
                               _ProgramKitSystemClientModelGeneratorPath;
                               _ProgramKitSelfValidationBaseOutputPath;
                               _ProgramKitSelfValidationIntermediateOutputPath;
                               _ProgramKitSelfValidationInvocationDirectory;
                               _ProgramKitSelfValidationInvocationFile;
                               _ProgramKitSelfValidationInvocationToken;
                               _ProgramKitCs1701CompatibilityApproved;
                               _ProgramKitCs1701CompatibilityExpectedApproval;
                               _ProgramKitCs1701CompatibilityExpectedProjectPath;
                               _ProgramKitCs1701CompatibilityPreCompilerLockHash;
                               _ProgramKitOriginalBuildingInsideVisualStudio;
                               _ProgramKitOriginalTargetFrameworkIdentifier;
                               _ProgramKitOriginalTargetFrameworkVersion;
                               _ProgramKitProducingCompilerInvocation;
                               _ProgramKitRequireCompilerExecutionReceipt;
                               BuildingInsideVisualStudio;
                               TargetFrameworkIdentifier;
                               TargetFrameworkVersion">
  <PropertyGroup>
    <ProgramKitCSharpGateAssemblyPath Condition="'$(ProgramKitCSharpGateAssemblyPath)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)tools\Orbyss.ProgramKit.CSharpGate\bin\$(Configuration)\$(TargetFramework)\Orbyss.ProgramKit.CSharpGate.dll'))</ProgramKitCSharpGateAssemblyPath>
  </PropertyGroup>

  <Target Name="ValidateProgramKitCSharpGateCanonicalPaths"
          BeforeTargets="_GenerateRestoreGraphProjectEntry;PrepareForBuild">
    <PropertyGroup>
      <_ProgramKitExpectedCSharpGateProjectPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)tools\Orbyss.ProgramKit.CSharpGate\Orbyss.ProgramKit.CSharpGate.csproj'))</_ProgramKitExpectedCSharpGateProjectPath>
      <_ProgramKitExpectedCSharpGateAssemblyPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)tools\Orbyss.ProgramKit.CSharpGate\bin\$(Configuration)\$(TargetFramework)\Orbyss.ProgramKit.CSharpGate.dll'))</_ProgramKitExpectedCSharpGateAssemblyPath>
      <_ProgramKitExpectedWarningApprovalLedgerPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)governance\approved-warning-suppressions.tsv'))</_ProgramKitExpectedWarningApprovalLedgerPath>
      <_ProgramKitExpectedConformanceGateProbePath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)tests\Orbyss.ProgramKit.ConformanceTests\Fixtures\CSharpGate\CSharpGateProbe.csproj'))</_ProgramKitExpectedConformanceGateProbePath>
    </PropertyGroup>
    <Error Condition="'$(ProgramKitCSharpGateProjectPath)' != '$(_ProgramKitExpectedCSharpGateProjectPath)'"
           Code="PKCS127"
           Text="ProgramKitCSharpGateProjectPath must remain the repository-owned gate project at $(_ProgramKitExpectedCSharpGateProjectPath)." />
    <Error Condition="'$(ProgramKitCSharpGateAssemblyPath)' != '$(_ProgramKitExpectedCSharpGateAssemblyPath)'"
           Code="PKCS128"
           Text="ProgramKitCSharpGateAssemblyPath must remain the repository-owned gate analyzer at $(_ProgramKitExpectedCSharpGateAssemblyPath)." />
    <Error Condition="'$(ProgramKitWarningApprovalLedgerPath)' != '$(_ProgramKitExpectedWarningApprovalLedgerPath)'"
           Code="PKCS129"
           Text="ProgramKitWarningApprovalLedgerPath must remain the repository-owned canonical ledger at $(_ProgramKitExpectedWarningApprovalLedgerPath)." />
    <Error Condition="'$(ProgramKitConformanceValidatedGateDigest)' != '' and
                      ('$(MSBuildProjectFullPath)' != '$(_ProgramKitExpectedConformanceGateProbePath)' or
                       '$(IsPackable)' != 'false' or
                       !Exists('$(_ProgramKitExpectedCSharpGateAssemblyPath)') or
                       !$([System.Text.RegularExpressions.Regex]::IsMatch('$(ProgramKitConformanceValidatedGateDigest)', '^[0-9A-F]{64}$')))"
           Code="PKCS118"
           Text="Validated gate reuse is restricted to the exact non-packable CSharpGateProbe project, an existing current-configuration analyzer, and an uppercase SHA-256 digest." />
    <GetFileHash Files="$(_ProgramKitExpectedCSharpGateAssemblyPath)"
                 Algorithm="SHA256"
                 Condition="'$(ProgramKitConformanceValidatedGateDigest)' != '' and
                            Exists('$(_ProgramKitExpectedCSharpGateAssemblyPath)')">
      <Output TaskParameter="Items"
              ItemName="_ProgramKitConformanceValidatedGateAssemblyHash" />
    </GetFileHash>
    <Error Condition="'$(ProgramKitConformanceValidatedGateDigest)' != '' and
                      '@(_ProgramKitConformanceValidatedGateAssemblyHash->'%(FileHash)')' != '$(ProgramKitConformanceValidatedGateDigest)'"
           Code="PKCS118"
           Text="The CSharpGateProbe validated-gate digest does not match the current-configuration analyzer assembly." />
  </Target>

  <Target Name="ValidateProgramKitBuildCompilerDependencyChain"
          BeforeTargets="Build">
    <ItemGroup>
      <_ProgramKitBuildDependency Remove="@(_ProgramKitBuildDependency)" />
      <_ProgramKitCoreBuildDependency Remove="@(_ProgramKitCoreBuildDependency)" />
      <_ProgramKitCompileDependency Remove="@(_ProgramKitCompileDependency)" />
      <_ProgramKitRequiredCoreBuild Remove="@(_ProgramKitRequiredCoreBuild)" />
      <_ProgramKitRequiredCompile Remove="@(_ProgramKitRequiredCompile)" />
      <_ProgramKitRequiredCoreCompile Remove="@(_ProgramKitRequiredCoreCompile)" />
      <_ProgramKitBuildDependency Include="$(BuildDependsOn)" />
      <_ProgramKitCoreBuildDependency Include="$(CoreBuildDependsOn)" />
      <_ProgramKitCompileDependency Include="$(CompileDependsOn)" />
      <_ProgramKitRequiredCoreBuild
        Include="@(_ProgramKitBuildDependency)"
        Condition="'%(Identity)' == 'CoreBuild'" />
      <_ProgramKitRequiredCompile
        Include="@(_ProgramKitCoreBuildDependency)"
        Condition="'%(Identity)' == 'Compile'" />
      <_ProgramKitRequiredCoreCompile
        Include="@(_ProgramKitCompileDependency)"
        Condition="'%(Identity)' == 'CoreCompile'" />
    </ItemGroup>
    <Error Condition="'@(_ProgramKitRequiredCoreBuild)' == ''"
           Code="PKCS131"
           Text="BuildDependsOn must execute CoreBuild so the C# gate cannot be bypassed." />
    <Error Condition="'@(_ProgramKitRequiredCompile)' == ''"
           Code="PKCS132"
           Text="CoreBuildDependsOn must execute Compile so the C# gate cannot be bypassed." />
    <Error Condition="'@(_ProgramKitRequiredCoreCompile)' == ''"
           Code="PKCS133"
           Text="CompileDependsOn must execute CoreCompile so the C# gate cannot be bypassed." />
  </Target>

  <Target Name="ValidateProgramKitAnalyzerExecutionInputs"
          BeforeTargets="_ComputeSkipAnalyzers;CoreCompile">
    <Error Condition="'$(_SkipAnalyzers)' != ''"
           Code="PKCS159"
           Text="_SkipAnalyzers is an SDK-internal compiler input and cannot be supplied by a caller." />
    <Error Condition="'$(ResolvedCodeAnalysisRuleSet)' != '' and
                      '$(CodeAnalysisRuleSet)' == ''"
           Code="PKCS160"
           Text="ResolvedCodeAnalysisRuleSet is an SDK-internal compiler input and cannot be supplied by a caller." />
    <Error Condition="'$(NonExistentFile)' == '' or
                      Exists('$(NonExistentFile)')"
           Code="PKCS166"
           Text="The compiler invocation sentinel must identify a non-existent output so every producing build yields a current compiler receipt." />
  </Target>

  <Target Name="ValidateProgramKitTargetProfile"
          BeforeTargets="PrepareForBuild">
    <Error Condition="'$(TargetFrameworks)' != ''"
           Code="PKNET001"
           Text="Program Kit projects must not use TargetFrameworks or multitargeting." />
    <Error Condition="'$(TargetFramework)' != 'net10.0'"
           Code="PKNET002"
           Text="Program Kit projects must target exactly net10.0; observed $(TargetFramework)." />
    <Error Condition="'$(LangVersion)' != '14.0'"
           Code="PKNET003"
           Text="Program Kit projects must use C# 14.0; observed $(LangVersion)." />
    <Error Condition="'$(NETCoreSdkVersion)' != '10.0.302'"
           Code="PKNET004"
           Text="Program Kit projects must use SDK 10.0.302; observed $(NETCoreSdkVersion)." />
    <Error Condition="'$(ProgramKitTargetProfileId)' != 'pkid:profile:program-kit:dotnet-10'"
           Code="PKNET005"
           Text="The Program Kit target-profile identity is invalid." />
    <Error Condition="'$(ProgramKitTargetProfileVersion)' != '0.1.0-alpha.1'"
           Code="PKNET006"
           Text="The Program Kit target-profile version is invalid." />
    <Error Condition="'$(ProgramKitSdkRollForward)' != 'disable'"
           Code="PKNET007"
           Text="SDK roll-forward must remain disabled." />
    <Error Condition="'$(ProgramKitAllowPrereleaseSdk)' != 'false'"
           Code="PKNET008"
           Text="Prerelease SDK selection must remain disabled." />
  </Target>

  <Target Name="ValidateProgramKitCSharpGateConfiguration"
          DependsOnTargets="ValidateProgramKitCSharpGateCanonicalPaths;ResolveProjectReferences"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' != 'Orbyss.ProgramKit.CSharpGate'">
    <PropertyGroup>
      <_ProgramKitIntermediateRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)'))</_ProgramKitIntermediateRoot>
      <_ProgramKitSdkRoot>$([System.IO.Path]::GetFullPath('$(MSBuildToolsPath)\Sdks'))</_ProgramKitSdkRoot>
      <_ProgramKitManagedCoreTargetsPath>$([System.IO.Path]::GetFullPath('$(MSBuildToolsPath)\Roslyn\Microsoft.Managed.Core.targets'))</_ProgramKitManagedCoreTargetsPath>
      <_ProgramKitNetAnalyzersTargetsPath>$([System.IO.Path]::GetFullPath('$(MSBuildToolsPath)\Sdks\Microsoft.NET.Sdk\analyzers\build\Microsoft.CodeAnalysis.NetAnalyzers.targets'))</_ProgramKitNetAnalyzersTargetsPath>
      <_ProgramKitExpectedGeneratedEditorConfigPath>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)$(MSBuildProjectName).GeneratedMSBuildEditorConfig.editorconfig'))</_ProgramKitExpectedGeneratedEditorConfigPath>
      <_ProgramKitApprovedMSTestAnalyzerConfigPath></_ProgramKitApprovedMSTestAnalyzerConfigPath>
      <_ProgramKitApprovedMSTestAnalyzerTargetsPath></_ProgramKitApprovedMSTestAnalyzerTargetsPath>
      <_ProgramKitApprovedMSTestAnalyzerConfigPath Condition="'$(NuGetPackageRoot)' != ''">$([System.IO.Path]::GetFullPath('$(NuGetPackageRoot)/mstest.analyzers/4.3.2/globalconfigs/mstest-all.globalconfig'))</_ProgramKitApprovedMSTestAnalyzerConfigPath>
      <_ProgramKitApprovedMSTestAnalyzerTargetsPath Condition="'$(NuGetPackageRoot)' != ''">$([System.IO.Path]::GetFullPath('$(NuGetPackageRoot)/mstest.analyzers/4.3.2/buildTransitive/MSTest.Analyzers.targets'))</_ProgramKitApprovedMSTestAnalyzerTargetsPath>
    </PropertyGroup>
    <ItemGroup>
      <_ProgramKitCSharpGateProjectReference Remove="@(_ProgramKitCSharpGateProjectReference)" />
      <_ProgramKitAllCSharpGateProjectReference Remove="@(_ProgramKitAllCSharpGateProjectReference)" />
      <_ProgramKitCSharpGateAnalyzer Remove="@(_ProgramKitCSharpGateAnalyzer)" />
      <_ProgramKitProjectDirectoryCompilerProperty Remove="@(_ProgramKitProjectDirectoryCompilerProperty)" />
      <_ProgramKitProjectNameCompilerProperty Remove="@(_ProgramKitProjectNameCompilerProperty)" />
      <_ProgramKitGeneratedSourceRootCompilerProperty Remove="@(_ProgramKitGeneratedSourceRootCompilerProperty)" />
      <_ProgramKitCompilerInvocationNonceCompilerProperty Remove="@(_ProgramKitCompilerInvocationNonceCompilerProperty)" />
      <_ProgramKitWarningApprovalLedgerPathCompilerProperty Remove="@(_ProgramKitWarningApprovalLedgerPathCompilerProperty)" />
      <_ProgramKitRootNamespaceCompilerProperty Remove="@(_ProgramKitRootNamespaceCompilerProperty)" />
      <_ProgramKitNamedWarningApprovalLedger Remove="@(_ProgramKitNamedWarningApprovalLedger)" />
      <_ProgramKitWarningApprovalLedger Remove="@(_ProgramKitWarningApprovalLedger)" />
      <_ProgramKitUnapprovedEditorConfig Remove="@(_ProgramKitUnapprovedEditorConfig)" />
      <_ProgramKitUnapprovedAnalyzerConfig Remove="@(_ProgramKitUnapprovedAnalyzerConfig)" />
      <_ProgramKitUnapprovedGlobalAnalyzerConfig Remove="@(_ProgramKitUnapprovedGlobalAnalyzerConfig)" />
      <_ProgramKitCSharpGateProjectReference
        Include="@(ProjectReference)"
        Condition="'%(ProjectReference.Identity)' == '$(_ProgramKitExpectedCSharpGateProjectPath)' and
                   '%(ProjectReference.FullPath)' == '$(_ProgramKitExpectedCSharpGateProjectPath)' and
                   '%(ProjectReference.DefiningProjectFullPath)' == '$(MSBuildThisFileDirectory)Directory.Build.props' and
                   '%(ProjectReference.OutputItemType)' == 'Analyzer' and
                   '%(ProjectReference.ReferenceOutputAssembly)' == 'false' and
                   '%(ProjectReference.PrivateAssets)' == 'all' and
                   ('%(ProjectReference.BuildReference)' == '' or
                    '%(ProjectReference.BuildReference)' == 'true') and
                   (('%(ProjectReference.Targets)' == '' and
                     '$(ProgramKitConformanceValidatedGateDigest)' == '') or
                    ('%(ProjectReference.Targets)' == 'GetTargetPath' and
                     '$(ProgramKitConformanceValidatedGateDigest)' != '')) and
                   ('%(ProjectReference.SkipGetTargetFrameworkProperties)' == '' or
                    '%(ProjectReference.SkipGetTargetFrameworkProperties)' == 'false') and
                   '%(ProjectReference.AdditionalProperties)' == '' and
                   ('%(ProjectReference.GlobalPropertiesToRemove)' == '' or
                    '%(ProjectReference.GlobalPropertiesToRemove)' == ';WebPublishProfileFile')" />
      <_ProgramKitAllCSharpGateProjectReference
        Include="@(ProjectReference)"
        Condition="'%(ProjectReference.FullPath)' == '$(_ProgramKitExpectedCSharpGateProjectPath)'" />
      <_ProgramKitCSharpGateAnalyzer
        Include="@(Analyzer)"
        Condition="'%(Analyzer.FullPath)' == '$(_ProgramKitExpectedCSharpGateAssemblyPath)' and
                   '%(Analyzer.Filename)%(Analyzer.Extension)' == 'Orbyss.ProgramKit.CSharpGate.dll'" />
      <_ProgramKitProjectDirectoryCompilerProperty
        Include="@(CompilerVisibleProperty)"
        Condition="'%(CompilerVisibleProperty.Identity)' == 'MSBuildProjectDirectory'" />
      <_ProgramKitProjectNameCompilerProperty
        Include="@(CompilerVisibleProperty)"
        Condition="'%(CompilerVisibleProperty.Identity)' == 'MSBuildProjectName'" />
      <_ProgramKitGeneratedSourceRootCompilerProperty
        Include="@(CompilerVisibleProperty)"
        Condition="'%(CompilerVisibleProperty.Identity)' == 'ProgramKitGeneratedSourceRoot'" />
      <_ProgramKitCompilerInvocationNonceCompilerProperty
        Include="@(CompilerVisibleProperty)"
        Condition="'%(CompilerVisibleProperty.Identity)' == 'ProgramKitCompilerInvocationNonce'" />
      <_ProgramKitWarningApprovalLedgerPathCompilerProperty
        Include="@(CompilerVisibleProperty)"
        Condition="'%(CompilerVisibleProperty.Identity)' == 'ProgramKitWarningApprovalLedgerPath'" />
      <_ProgramKitRootNamespaceCompilerProperty
        Include="@(CompilerVisibleProperty)"
        Condition="'%(CompilerVisibleProperty.Identity)' == 'RootNamespace'" />
      <_ProgramKitNamedWarningApprovalLedger
        Include="@(AdditionalFiles)"
        Condition="'%(AdditionalFiles.Filename)%(AdditionalFiles.Extension)' == 'approved-warning-suppressions.tsv'" />
      <_ProgramKitWarningApprovalLedger
        Include="@(AdditionalFiles)"
        Condition="'%(AdditionalFiles.FullPath)' == '$(_ProgramKitExpectedWarningApprovalLedgerPath)'" />
      <_ProgramKitUnapprovedEditorConfig
        Include="@(EditorConfigFiles)"
        Condition="Exists('%(EditorConfigFiles.FullPath)') and
                   !(('%(EditorConfigFiles.FullPath)' == '$(_ProgramKitExpectedGeneratedEditorConfigPath)') or
                     ($([System.String]::Copy('%(EditorConfigFiles.FullPath)').StartsWith('$(_ProgramKitIntermediateRoot)', System.StringComparison.OrdinalIgnoreCase)) and
                      '%(EditorConfigFiles.DefiningProjectFullPath)' == '$(_ProgramKitManagedCoreTargetsPath)') or
                     ($([System.String]::Copy('%(EditorConfigFiles.FullPath)').StartsWith('$(_ProgramKitSdkRoot)', System.StringComparison.OrdinalIgnoreCase)) and
                      '%(EditorConfigFiles.DefiningProjectFullPath)' == '$(_ProgramKitNetAnalyzersTargetsPath)') or
                     ('%(EditorConfigFiles.FullPath)' == '$(_ProgramKitApprovedMSTestAnalyzerConfigPath)' and
                      '%(EditorConfigFiles.DefiningProjectFullPath)' == '$(_ProgramKitApprovedMSTestAnalyzerTargetsPath)'))" />
      <_ProgramKitUnapprovedAnalyzerConfig
        Include="@(AnalyzerConfigFiles)"
        Condition="Exists('%(AnalyzerConfigFiles.FullPath)') and
                   !(($([System.String]::Copy('%(AnalyzerConfigFiles.FullPath)').StartsWith('$(_ProgramKitIntermediateRoot)', System.StringComparison.OrdinalIgnoreCase)) and
                      '%(AnalyzerConfigFiles.DefiningProjectFullPath)' == '$(_ProgramKitManagedCoreTargetsPath)') or
                     ($([System.String]::Copy('%(AnalyzerConfigFiles.FullPath)').StartsWith('$(_ProgramKitSdkRoot)', System.StringComparison.OrdinalIgnoreCase)) and
                      '%(AnalyzerConfigFiles.DefiningProjectFullPath)' == '$(_ProgramKitNetAnalyzersTargetsPath)') or
                     ('%(AnalyzerConfigFiles.FullPath)' == '$(_ProgramKitApprovedMSTestAnalyzerConfigPath)' and
                      '%(AnalyzerConfigFiles.DefiningProjectFullPath)' == '$(_ProgramKitApprovedMSTestAnalyzerTargetsPath)'))" />
      <_ProgramKitUnapprovedGlobalAnalyzerConfig
        Include="@(GlobalAnalyzerConfigFiles)"
        Condition="Exists('%(GlobalAnalyzerConfigFiles.FullPath)') and
                   !(($([System.String]::Copy('%(GlobalAnalyzerConfigFiles.FullPath)').StartsWith('$(_ProgramKitIntermediateRoot)', System.StringComparison.OrdinalIgnoreCase)) and
                      '%(GlobalAnalyzerConfigFiles.DefiningProjectFullPath)' == '$(_ProgramKitManagedCoreTargetsPath)') or
                     ($([System.String]::Copy('%(GlobalAnalyzerConfigFiles.FullPath)').StartsWith('$(_ProgramKitSdkRoot)', System.StringComparison.OrdinalIgnoreCase)) and
                      '%(GlobalAnalyzerConfigFiles.DefiningProjectFullPath)' == '$(_ProgramKitNetAnalyzersTargetsPath)') or
                     ('%(GlobalAnalyzerConfigFiles.FullPath)' == '$(_ProgramKitApprovedMSTestAnalyzerConfigPath)' and
                      '%(GlobalAnalyzerConfigFiles.DefiningProjectFullPath)' == '$(_ProgramKitApprovedMSTestAnalyzerTargetsPath)'))" />
    </ItemGroup>
    <Error Condition="'$(ProgramKitCSharpGateEnabled)' != 'true'"
           Code="PKCS101"
           Text="The Program Kit C# source gate must remain enabled." />
    <Error Condition="'$(TreatWarningsAsErrors)' != 'true'"
           Code="PKCS102"
           Text="TreatWarningsAsErrors must remain true." />
    <Error Condition="'$(CodeAnalysisTreatWarningsAsErrors)' != 'true'"
           Code="PKCS108"
           Text="CodeAnalysisTreatWarningsAsErrors must remain true." />
    <Error Condition="'$(MSBuildTreatWarningsAsErrors)' != 'true'"
           Code="PKCS109"
           Text="MSBuildTreatWarningsAsErrors must remain true." />
    <Error Condition="'$(RestoreTreatWarningsAsErrors)' != 'true'"
           Code="PKCS110"
           Text="RestoreTreatWarningsAsErrors must remain true." />
    <Error Condition="'$(NoWarn)' != '__ProgramKitNoWarningSuppression__'"
           Code="PKCS103"
           Text="Project-level NoWarn is forbidden; observed $(NoWarn)." />
    <Error Condition="'$(MSBuildWarningsAsMessages)' != '__ProgramKitNoMSBuildWarningDemotion__;__ProgramKitNoWarningSuppression__'"
           Code="PKCS111"
           Text="MSBuildWarningsAsMessages is forbidden; observed $(MSBuildWarningsAsMessages)." />
    <Error Condition="'$(Nullable)' != 'enable'"
           Code="PKCS105"
           Text="Nullable analysis must remain enabled." />
    <Error Condition="'$(AnalysisLevel)' != 'latest-recommended'"
           Code="PKCS106"
           Text="AnalysisLevel must remain latest-recommended." />
    <Error Condition="'$(EnableNETAnalyzers)' != 'true'"
           Code="PKCS112"
           Text="EnableNETAnalyzers must remain true." />
    <Error Condition="'$(RunAnalyzers)' != 'true'"
           Code="PKCS114"
           Text="RunAnalyzers must remain true." />
    <Error Condition="'$(RunAnalyzersDuringBuild)' != 'true'"
           Code="PKCS113"
           Text="RunAnalyzersDuringBuild must remain true." />
    <Error Condition="'$(ProvideCommandLineArgs)' != 'true'"
           Code="PKCS161"
           Text="ProvideCommandLineArgs must remain true so the compiler invocation can be verified." />
    <Error Condition="'$(UseSharedCompilation)' != 'false'"
           Code="PKCS169"
           Text="UseSharedCompilation must remain false so a producing build cannot reuse a stale compiler or analyzer process." />
    <Error Condition="'$(UseHostCompilerIfAvailable)' != 'false'"
           Code="PKCS170"
           Text="UseHostCompilerIfAvailable must remain false so a producing build cannot reuse an unverified host compiler." />
    <Error Condition="'$(TargetsTriggeredByCompilation)' != ''"
           Code="PKCS171"
           Text="TargetsTriggeredByCompilation must remain empty so compiler arguments cannot be changed between Csc execution and receipt validation." />
    <Error Condition="'$(EnforceCodeStyleInBuild)' != 'true'"
           Code="PKCS107"
           Text="EnforceCodeStyleInBuild must remain true." />
    <Error Condition="'$(WarningLevel)' != '9999'"
           Code="PKCS115"
           Text="WarningLevel must remain 9999; observed $(WarningLevel)." />
    <Error Condition="'$(CodeAnalysisRuleSet)' != ''"
           Code="PKCS116"
           Text="CodeAnalysisRuleSet is forbidden; observed $(CodeAnalysisRuleSet)." />
    <Error Condition="'$(AnalysisMode)' != '' or
                      '$(AnalysisModeAll)' != '' or
                      '$(AnalysisModeGlobal)' != '' or
                      '$(AnalysisModeStyle)' != '' or
                      '$(AnalysisModeDesign)' != '' or
                      '$(AnalysisModeDocumentation)' != '' or
                      '$(AnalysisModeGlobalization)' != '' or
                      '$(AnalysisModeInteroperability)' != '' or
                      '$(AnalysisModeMaintainability)' != '' or
                      '$(AnalysisModeNaming)' != '' or
                      '$(AnalysisModePerformance)' != '' or
                      '$(AnalysisModeReliability)' != '' or
                      '$(AnalysisModeSecurity)' != '' or
                      '$(AnalysisModeUsage)' != '' or
                      ('$(AnalysisLevelStyle)' != '' and '$(AnalysisLevelStyle)' != 'latest-recommended') or
                      ('$(AnalysisLevelDesign)' != '' and '$(AnalysisLevelDesign)' != 'latest-recommended') or
                      ('$(AnalysisLevelDocumentation)' != '' and '$(AnalysisLevelDocumentation)' != 'latest-recommended') or
                      ('$(AnalysisLevelGlobalization)' != '' and '$(AnalysisLevelGlobalization)' != 'latest-recommended') or
                      ('$(AnalysisLevelInteroperability)' != '' and '$(AnalysisLevelInteroperability)' != 'latest-recommended') or
                      ('$(AnalysisLevelMaintainability)' != '' and '$(AnalysisLevelMaintainability)' != 'latest-recommended') or
                      ('$(AnalysisLevelNaming)' != '' and '$(AnalysisLevelNaming)' != 'latest-recommended') or
                      ('$(AnalysisLevelPerformance)' != '' and '$(AnalysisLevelPerformance)' != 'latest-recommended') or
                      ('$(AnalysisLevelReliability)' != '' and '$(AnalysisLevelReliability)' != 'latest-recommended') or
                      ('$(AnalysisLevelSecurity)' != '' and '$(AnalysisLevelSecurity)' != 'latest-recommended') or
                      ('$(AnalysisLevelUsage)' != '' and '$(AnalysisLevelUsage)' != 'latest-recommended') or
                      '$(AnalysisLevelPrefix)' != 'latest' or
                      '$(AnalysisLevelSuffix)' != 'recommended' or
                      '$(EffectiveAnalysisLevel)' != '10.0' or
                      '$(SkipGlobalAnalyzerConfigForPackage)' != '' or
                      '$(EffectiveCodeAnalysisTreatWarningsAsErrors)' != 'true' or
                      ('$(MicrosoftCodeAnalysisNetAnalyzersRulesVersion)' != '' and
                       '$(MicrosoftCodeAnalysisNetAnalyzersRulesVersion)' != '10')"
           Code="PKCS117"
           Text="Analyzer mode, level, effective severity, and global-configuration overrides are forbidden." />
    <Error Condition="'$(WarningsNotAsErrors)' != '__ProgramKitNoWarningDemotion__'"
           Code="PKCS104"
           Text="WarningsNotAsErrors is forbidden; observed $(WarningsNotAsErrors)." />
    <Error Condition="'@(_ProgramKitCSharpGateProjectReference->Count())' != '1' or
                      '@(_ProgramKitAllCSharpGateProjectReference->Count())' != '1'"
           Code="PKCS118"
           Text="Exactly one repository-defined Program Kit C# gate analyzer ProjectReference with unmodified build metadata is required." />
    <Error Condition="'@(_ProgramKitProjectDirectoryCompilerProperty)' == '' or
                      '@(_ProgramKitProjectNameCompilerProperty)' == '' or
                      '@(_ProgramKitGeneratedSourceRootCompilerProperty)' == '' or
                      '@(_ProgramKitCompilerInvocationNonceCompilerProperty)' == '' or
                      '@(_ProgramKitWarningApprovalLedgerPathCompilerProperty)' == '' or
                      '@(_ProgramKitRootNamespaceCompilerProperty)' == ''"
           Code="PKCS119"
           Text="The C# gate compiler-visible project identity and generated-source properties are required." />
    <Error Condition="'@(_ProgramKitUnapprovedEditorConfig)' != '' or
                      '@(_ProgramKitUnapprovedAnalyzerConfig)' != '' or
                      '@(_ProgramKitUnapprovedGlobalAnalyzerConfig)' != ''"
           Code="PKCS120"
           Text="Analyzer configuration outside the SDK-generated build inputs is forbidden: @(_ProgramKitUnapprovedEditorConfig);@(_ProgramKitUnapprovedAnalyzerConfig);@(_ProgramKitUnapprovedGlobalAnalyzerConfig)." />
    <Error Condition="'@(_ProgramKitCSharpGateAnalyzer->Count())' != '1'"
           Code="PKCS121"
           Text="Exactly one resolved Program Kit C# gate analyzer is required at $(_ProgramKitExpectedCSharpGateAssemblyPath)." />
    <Error Condition="'@(_ProgramKitWarningApprovalLedger->Count())' != '1' or
                      '@(_ProgramKitNamedWarningApprovalLedger->Count())' != '1'"
           Code="PKCS122"
           Text="Exactly one approved-warning-suppressions.tsv AdditionalFile is required, and it must be the canonical ledger at $(_ProgramKitExpectedWarningApprovalLedgerPath)." />
    <Error Condition="'$(DisabledWarnings)' != ''"
           Code="PKCS123"
           Text="DisabledWarnings is forbidden; observed $(DisabledWarnings)." />
    <Error Condition="'$(ProgramKitGeneratedSourceRoot)' != 'ProgramKitGenerated'"
           Code="PKCS126"
           Text="ProgramKitGeneratedSourceRoot must remain exactly ProgramKitGenerated; observed $(ProgramKitGeneratedSourceRoot)." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(ProgramKitCompilerInvocationNonce)', '^[0-9a-f]{32}$'))"
           Code="PKCS168"
           Text="The compiler invocation nonce must be a repository-minted lowercase 32-character hexadecimal value." />
    <Error Condition="'$(SkipCompilerExecution)' == 'true' and
                      !('$(DesignTimeBuild)' == 'true' and
                        '$(BuildingProject)' == 'false' and
                        '$(ProvideCommandLineArgs)' == 'true')"
           Code="PKCS130"
           Text="SkipCompilerExecution is allowed only for a non-producing design-time workspace build." />
    <Error Condition="'$(OptimizeImplicitlyTriggeredBuild)' != 'false'"
           Code="PKCS134"
           Text="OptimizeImplicitlyTriggeredBuild must remain false so implicit builds cannot skip analyzers." />
    <Error Condition="$([System.String]::Copy('$(Features)').ToLowerInvariant().Contains('run-nullable-analysis=never'))"
           Code="PKCS135"
           Text="The run-nullable-analysis=never compiler feature is forbidden." />
    <Error Condition="('$(MSBuildProjectName)' == 'Orbyss.ProgramKit.UnitTests' or
                      '$(MSBuildProjectName)' == 'Orbyss.ProgramKit.ConformanceTests') and
                      '$(MSTestAnalysisMode)' != 'All'"
           Code="PKCS125"
           Text="MSTestAnalysisMode must remain All for the two legacy MSTest projects; observed $(MSTestAnalysisMode)." />
    <Error Condition="'$(CompilerResponseFile)' != '' or
                      '@(CompilerResponseFile)' != ''"
           Code="PKCS145"
           Text="CompilerResponseFile properties and items are forbidden." />
    <Error Condition="'$(CscToolPath)' != ''"
           Code="PKCS146"
           Text="CscToolPath compiler substitution is forbidden." />
    <Error Condition="'$(CscToolExe)' != ''"
           Code="PKCS147"
           Text="CscToolExe compiler substitution is forbidden." />
    <Error Condition="'$(BuildProjectReferences)' != 'true' and
                      !('$(DesignTimeBuild)' == 'true' and
                        '$(BuildingProject)' == 'false' and
                        '$(ProvideCommandLineArgs)' == 'true')"
           Code="PKCS151"
           Text="BuildProjectReferences must remain true for producing C# gate builds." />
    <PropertyGroup>
      <NoWarn></NoWarn>
      <WarningsNotAsErrors></WarningsNotAsErrors>
      <MSBuildWarningsAsMessages></MSBuildWarningsAsMessages>
    </PropertyGroup>
  </Target>

  <Target Name="RemoveProgramKitUnselectedHumanizerAnalyzer"
          DependsOnTargets="ResolveProjectReferences"
          BeforeTargets="ValidateProgramKitResolvedAnalyzerSet">
    <PropertyGroup>
      <_ProgramKitExpectedHumanizerAnalyzerPath>$([System.IO.Path]::GetFullPath('$(NuGetPackageRoot)/humanizer.core/3.0.10/analyzers/dotnet/roslyn4.14/cs/Humanizer.Analyzers.dll'))</_ProgramKitExpectedHumanizerAnalyzerPath>
    </PropertyGroup>
    <ItemGroup>
      <_ProgramKitAllHumanizerAnalyzer Remove="@(_ProgramKitAllHumanizerAnalyzer)" />
      <_ProgramKitUnselectedHumanizerAnalyzer Remove="@(_ProgramKitUnselectedHumanizerAnalyzer)" />
      <_ProgramKitAllHumanizerAnalyzer
        Include="@(Analyzer)"
        Condition="'%(Analyzer.Filename)%(Analyzer.Extension)' == 'Humanizer.Analyzers.dll'" />
      <_ProgramKitUnselectedHumanizerAnalyzer
        Include="@(_ProgramKitAllHumanizerAnalyzer)"
        Condition="'%(_ProgramKitAllHumanizerAnalyzer.FullPath)' == '$(_ProgramKitExpectedHumanizerAnalyzerPath)' and
                   '%(_ProgramKitAllHumanizerAnalyzer.NuGetPackageId)' == 'Humanizer.Core' and
                   '%(_ProgramKitAllHumanizerAnalyzer.NuGetPackageVersion)' == '3.0.10'" />
    </ItemGroup>
    <Error Condition="'@(_ProgramKitAllHumanizerAnalyzer->Count())' != '@(_ProgramKitUnselectedHumanizerAnalyzer->Count())' or
                      '@(_ProgramKitUnselectedHumanizerAnalyzer->Count())' &gt; '1'"
           Code="PKCS178"
           Text="Only the exact unselected Humanizer.Core 3.0.10 analyzer transitively contributed by JsonSchema.Net 9.3.0 may be removed; observed @(_ProgramKitAllHumanizerAnalyzer->'%(FullPath)|%(NuGetPackageId)|%(NuGetPackageVersion)')." />
    <ItemGroup>
      <Analyzer Remove="@(_ProgramKitUnselectedHumanizerAnalyzer)" />
    </ItemGroup>
  </Target>

  <Target Name="RemoveProgramKitRuntimeRoslynPackageAnalyzers"
          DependsOnTargets="ResolveProjectReferences"
          BeforeTargets="ValidateProgramKitResolvedAnalyzerSet">
    <PropertyGroup>
      <_ProgramKitExpectedCodeAnalysisAnalyzerPath>$([System.IO.Path]::GetFullPath('$(NuGetPackageRoot)/microsoft.codeanalysis.analyzers/5.3.0/analyzers/dotnet/cs/Microsoft.CodeAnalysis.Analyzers.dll'))</_ProgramKitExpectedCodeAnalysisAnalyzerPath>
      <_ProgramKitExpectedCSharpAnalysisAnalyzerPath>$([System.IO.Path]::GetFullPath('$(NuGetPackageRoot)/microsoft.codeanalysis.analyzers/5.3.0/analyzers/dotnet/cs/Microsoft.CodeAnalysis.CSharp.Analyzers.dll'))</_ProgramKitExpectedCSharpAnalysisAnalyzerPath>
    </PropertyGroup>
    <ItemGroup>
      <_ProgramKitAllRuntimeRoslynPackageAnalyzer Remove="@(_ProgramKitAllRuntimeRoslynPackageAnalyzer)" />
      <_ProgramKitRuntimeRoslynPackageAnalyzer Remove="@(_ProgramKitRuntimeRoslynPackageAnalyzer)" />
      <_ProgramKitAllRuntimeRoslynPackageAnalyzer
        Include="@(Analyzer)"
        Condition="'%(Analyzer.Filename)%(Analyzer.Extension)' == 'Microsoft.CodeAnalysis.Analyzers.dll' or
                   '%(Analyzer.Filename)%(Analyzer.Extension)' == 'Microsoft.CodeAnalysis.CSharp.Analyzers.dll'" />
      <_ProgramKitRuntimeRoslynPackageAnalyzer
        Include="@(_ProgramKitAllRuntimeRoslynPackageAnalyzer)"
        Condition="('%(_ProgramKitAllRuntimeRoslynPackageAnalyzer.FullPath)' == '$(_ProgramKitExpectedCodeAnalysisAnalyzerPath)' or
                    '%(_ProgramKitAllRuntimeRoslynPackageAnalyzer.FullPath)' == '$(_ProgramKitExpectedCSharpAnalysisAnalyzerPath)') and
                   '%(_ProgramKitAllRuntimeRoslynPackageAnalyzer.NuGetPackageId)' == 'Microsoft.CodeAnalysis.Analyzers' and
                   '%(_ProgramKitAllRuntimeRoslynPackageAnalyzer.NuGetPackageVersion)' == '5.3.0'" />
    </ItemGroup>
    <Error Condition="'@(_ProgramKitAllRuntimeRoslynPackageAnalyzer->Count())' != '@(_ProgramKitRuntimeRoslynPackageAnalyzer->Count())' or
                      '@(_ProgramKitRuntimeRoslynPackageAnalyzer->Count())' == '1' or
                      '@(_ProgramKitRuntimeRoslynPackageAnalyzer->Count())' &gt; '2'"
           Code="PKCS179"
           Text="Only the exact Microsoft.CodeAnalysis.Analyzers 5.3.0 analyzer pair contributed by the runtime Roslyn compiler may be removed; observed @(_ProgramKitAllRuntimeRoslynPackageAnalyzer->'%(FullPath)|%(NuGetPackageId)|%(NuGetPackageVersion)')." />
    <ItemGroup>
      <Analyzer Remove="@(_ProgramKitRuntimeRoslynPackageAnalyzer)" />
    </ItemGroup>
  </Target>

  <Target Name="ValidateProgramKitResolvedAnalyzerSet"
          DependsOnTargets="ResolveProjectReferences;RemoveProgramKitUnselectedHumanizerAnalyzer;RemoveProgramKitRuntimeRoslynPackageAnalyzers"
          BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_ProgramKitNetAnalyzerPath>$([System.IO.Path]::GetFullPath('$(MSBuildToolsPath)/Sdks/Microsoft.NET.Sdk/analyzers/Microsoft.CodeAnalysis.NetAnalyzers.dll'))</_ProgramKitNetAnalyzerPath>
      <_ProgramKitCSharpNetAnalyzerPath>$([System.IO.Path]::GetFullPath('$(MSBuildToolsPath)/Sdks/Microsoft.NET.Sdk/analyzers/Microsoft.CodeAnalysis.CSharp.NetAnalyzers.dll'))</_ProgramKitCSharpNetAnalyzerPath>
      <_ProgramKitCodeStyleAnalyzerPath>$([System.IO.Path]::GetFullPath('$(MSBuildToolsPath)/Sdks/Microsoft.NET.Sdk/codestyle/cs/Microsoft.CodeAnalysis.CodeStyle.dll'))</_ProgramKitCodeStyleAnalyzerPath>
      <_ProgramKitCodeStyleFixAnalyzerPath>$([System.IO.Path]::GetFullPath('$(MSBuildToolsPath)/Sdks/Microsoft.NET.Sdk/codestyle/cs/Microsoft.CodeAnalysis.CodeStyle.Fixes.dll'))</_ProgramKitCodeStyleFixAnalyzerPath>
      <_ProgramKitCSharpCodeStyleAnalyzerPath>$([System.IO.Path]::GetFullPath('$(MSBuildToolsPath)/Sdks/Microsoft.NET.Sdk/codestyle/cs/Microsoft.CodeAnalysis.CSharp.CodeStyle.dll'))</_ProgramKitCSharpCodeStyleAnalyzerPath>
      <_ProgramKitCSharpCodeStyleFixAnalyzerPath>$([System.IO.Path]::GetFullPath('$(MSBuildToolsPath)/Sdks/Microsoft.NET.Sdk/codestyle/cs/Microsoft.CodeAnalysis.CSharp.CodeStyle.Fixes.dll'))</_ProgramKitCSharpCodeStyleFixAnalyzerPath>
      <_ProgramKitMSTestAnalyzerPath></_ProgramKitMSTestAnalyzerPath>
      <_ProgramKitMSTestCodeFixAnalyzerPath></_ProgramKitMSTestCodeFixAnalyzerPath>
      <_ProgramKitMSTestAnalyzerPath Condition="'$(NuGetPackageRoot)' != ''">$([System.IO.Path]::GetFullPath('$(NuGetPackageRoot)/mstest.analyzers/4.3.2/analyzers/dotnet/cs/MSTest.Analyzers.dll'))</_ProgramKitMSTestAnalyzerPath>
      <_ProgramKitMSTestCodeFixAnalyzerPath Condition="'$(NuGetPackageRoot)' != ''">$([System.IO.Path]::GetFullPath('$(NuGetPackageRoot)/mstest.analyzers/4.3.2/analyzers/dotnet/cs/MSTest.Analyzers.CodeFixes.dll'))</_ProgramKitMSTestCodeFixAnalyzerPath>
      <_ProgramKitTUnitAssertionsAnalyzerRoot Condition="'$(NuGetPackageRoot)' != ''">$([System.IO.Path]::GetFullPath('$(NuGetPackageRoot)/tunit.assertions/1.60.0/analyzers/dotnet/cs'))$([System.IO.Path]::DirectorySeparatorChar)</_ProgramKitTUnitAssertionsAnalyzerRoot>
      <_ProgramKitTUnitCoreAnalyzerRoot Condition="'$(NuGetPackageRoot)' != ''">$([System.IO.Path]::GetFullPath('$(NuGetPackageRoot)/tunit.core/1.60.0/analyzers/dotnet'))$([System.IO.Path]::DirectorySeparatorChar)</_ProgramKitTUnitCoreAnalyzerRoot>
      <_ProgramKitLegacyMSTestProject
        Condition="'$(MSBuildProjectName)' == 'Orbyss.ProgramKit.UnitTests' or
                   '$(MSBuildProjectName)' == 'Orbyss.ProgramKit.ConformanceTests'">true</_ProgramKitLegacyMSTestProject>
      <_ProgramKitLoggingGeneratorPath></_ProgramKitLoggingGeneratorPath>
      <_ProgramKitOptionsGeneratorPath></_ProgramKitOptionsGeneratorPath>
      <_ProgramKitConfigurationBinderGeneratorPath></_ProgramKitConfigurationBinderGeneratorPath>
      <_ProgramKitLoggingGeneratorPath Condition="'$(NuGetPackageRoot)' != ''">$([System.IO.Path]::GetFullPath('$(NuGetPackageRoot)/microsoft.extensions.logging.abstractions/10.0.10/analyzers/dotnet/roslyn4.4/cs/Microsoft.Extensions.Logging.Generators.dll'))</_ProgramKitLoggingGeneratorPath>
      <_ProgramKitOptionsGeneratorPath Condition="'$(NuGetPackageRoot)' != ''">$([System.IO.Path]::GetFullPath('$(NuGetPackageRoot)/microsoft.extensions.options/10.0.10/analyzers/dotnet/roslyn4.4/cs/Microsoft.Extensions.Options.SourceGeneration.dll'))</_ProgramKitOptionsGeneratorPath>
      <_ProgramKitConfigurationBinderGeneratorPath Condition="'$(NuGetPackageRoot)' != ''">$([System.IO.Path]::GetFullPath('$(NuGetPackageRoot)/microsoft.extensions.configuration.binder/10.0.10/analyzers/dotnet/cs/Microsoft.Extensions.Configuration.Binder.SourceGeneration.dll'))</_ProgramKitConfigurationBinderGeneratorPath>
      <_ProgramKitFrameworkAnalyzerRoot>$([System.IO.Path]::GetFullPath('$(MSBuildToolsPath)/../../packs/Microsoft.NETCore.App.Ref'))$([System.IO.Path]::DirectorySeparatorChar)</_ProgramKitFrameworkAnalyzerRoot>
      <_ProgramKitAspNetFrameworkAnalyzerRoot>$([System.IO.Path]::GetFullPath('$(MSBuildToolsPath)/../../packs/Microsoft.AspNetCore.App.Ref/10.0.10/analyzers/dotnet/cs'))$([System.IO.Path]::DirectorySeparatorChar)</_ProgramKitAspNetFrameworkAnalyzerRoot>
      <_ProgramKitWebSdkAnalyzerRoot>$([System.IO.Path]::GetFullPath('$(MSBuildToolsPath)/Sdks/Microsoft.NET.Sdk.Web/analyzers/cs'))$([System.IO.Path]::DirectorySeparatorChar)</_ProgramKitWebSdkAnalyzerRoot>
      <_ProgramKitSystemClientModelGeneratorPath Condition="'$(NuGetPackageRoot)' != ''">$([System.IO.Path]::GetFullPath('$(NuGetPackageRoot)/system.clientmodel/1.10.0/analyzers/dotnet/cs/System.ClientModel.SourceGeneration.dll'))</_ProgramKitSystemClientModelGeneratorPath>
      <_ProgramKitRazorGeneratorRoot>$([System.IO.Path]::GetFullPath('$(MSBuildToolsPath)/Sdks/Microsoft.NET.Sdk.Razor/source-generators'))$([System.IO.Path]::DirectorySeparatorChar)</_ProgramKitRazorGeneratorRoot>
      <_ProgramKitExpectedGeneratedSourceProbeProjectPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)tests/Orbyss.ProgramKit.ConformanceTests/Fixtures/CSharpGate/GeneratedSource/Generator/GeneratedSourceProbe.csproj'))</_ProgramKitExpectedGeneratedSourceProbeProjectPath>
      <_ProgramKitResolvedGeneratedSourceProbeProjectPath></_ProgramKitResolvedGeneratedSourceProbeProjectPath>
      <_ProgramKitGeneratedSourceProbeAnalyzerPath></_ProgramKitGeneratedSourceProbeAnalyzerPath>
      <_ProgramKitResolvedGeneratedSourceProbeProjectPath Condition="'$(ProgramKitGeneratedSourceProbeProject)' != ''">$([System.IO.Path]::GetFullPath('$(ProgramKitGeneratedSourceProbeProject)'))</_ProgramKitResolvedGeneratedSourceProbeProjectPath>
      <_ProgramKitGeneratedSourceProbeAnalyzerPath Condition="'$(ProgramKitGeneratedSourceProbeProject)' != ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)tests/Orbyss.ProgramKit.ConformanceTests/Fixtures/CSharpGate/GeneratedSource/Generator/bin/$(Configuration)/$(TargetFramework)/GeneratedSourceProbe.dll'))</_ProgramKitGeneratedSourceProbeAnalyzerPath>
    </PropertyGroup>
    <Error Condition="'$(ProgramKitGeneratedSourceProbeProject)' != '' and
                      '$(_ProgramKitResolvedGeneratedSourceProbeProjectPath)' != '$(_ProgramKitExpectedGeneratedSourceProbeProjectPath)'"
           Code="PKCS155"
           Text="ProgramKitGeneratedSourceProbeProject, when present, must be the exact repository-owned conformance generator project." />
    <ItemGroup>
      <_ProgramKitResolvedNetAnalyzer Remove="@(_ProgramKitResolvedNetAnalyzer)" />
      <_ProgramKitResolvedCSharpNetAnalyzer Remove="@(_ProgramKitResolvedCSharpNetAnalyzer)" />
      <_ProgramKitResolvedCodeStyleAnalyzer Remove="@(_ProgramKitResolvedCodeStyleAnalyzer)" />
      <_ProgramKitResolvedCSharpCodeStyleAnalyzer Remove="@(_ProgramKitResolvedCSharpCodeStyleAnalyzer)" />
      <_ProgramKitResolvedMSTestAnalyzer Remove="@(_ProgramKitResolvedMSTestAnalyzer)" />
      <_ProgramKitResolvedTUnitAnalyzer Remove="@(_ProgramKitResolvedTUnitAnalyzer)" />
      <_ProgramKitResolvedTUnitAssertionsAnalyzer Remove="@(_ProgramKitResolvedTUnitAssertionsAnalyzer)" />
      <_ProgramKitResolvedTUnitCoreAnalyzer Remove="@(_ProgramKitResolvedTUnitCoreAnalyzer)" />
      <_ProgramKitApprovedResolvedAnalyzer Remove="@(_ProgramKitApprovedResolvedAnalyzer)" />
      <_ProgramKitResolvedNetAnalyzer
        Include="@(Analyzer)"
        Condition="'%(FullPath)' == '$(_ProgramKitNetAnalyzerPath)'" />
      <_ProgramKitResolvedCSharpNetAnalyzer
        Include="@(Analyzer)"
        Condition="'%(FullPath)' == '$(_ProgramKitCSharpNetAnalyzerPath)'" />
      <_ProgramKitResolvedCodeStyleAnalyzer
        Include="@(Analyzer)"
        Condition="'%(FullPath)' == '$(_ProgramKitCodeStyleAnalyzerPath)'" />
      <_ProgramKitResolvedCSharpCodeStyleAnalyzer
        Include="@(Analyzer)"
        Condition="'%(FullPath)' == '$(_ProgramKitCSharpCodeStyleAnalyzerPath)'" />
      <_ProgramKitResolvedMSTestAnalyzer
        Include="@(Analyzer)"
        Condition="'%(FullPath)' == '$(_ProgramKitMSTestAnalyzerPath)' and
                   '%(Analyzer.NuGetPackageId)' == 'MSTest.Analyzers' and
                   '%(Analyzer.NuGetPackageVersion)' == '4.3.2'" />
      <_ProgramKitResolvedTUnitAssertionsAnalyzer
        Include="@(Analyzer)"
        Condition="(('%(FullPath)' == '$(_ProgramKitTUnitAssertionsAnalyzerRoot)TUnit.Assertions.Analyzers.CodeFixers.dll') or
                    ('%(FullPath)' == '$(_ProgramKitTUnitAssertionsAnalyzerRoot)TUnit.Assertions.Analyzers.dll') or
                    ('%(FullPath)' == '$(_ProgramKitTUnitAssertionsAnalyzerRoot)TUnit.Assertions.SourceGenerator.dll')) and
                   '%(Analyzer.NuGetPackageId)' == 'TUnit.Assertions' and
                   '%(Analyzer.NuGetPackageVersion)' == '1.60.0'" />
      <_ProgramKitResolvedTUnitCoreAnalyzer
        Include="@(Analyzer)"
        Condition="(('%(FullPath)' == '$(_ProgramKitTUnitCoreAnalyzerRoot)cs\TUnit.Analyzers.CodeFixers.dll') or
                    ('%(FullPath)' == '$(_ProgramKitTUnitCoreAnalyzerRoot)roslyn4.14\cs\TUnit.Analyzers.dll') or
                    ('%(FullPath)' == '$(_ProgramKitTUnitCoreAnalyzerRoot)roslyn4.14\cs\TUnit.Core.SourceGenerator.dll')) and
                   '%(Analyzer.NuGetPackageId)' == 'TUnit.Core' and
                   '%(Analyzer.NuGetPackageVersion)' == '1.60.0'" />
      <_ProgramKitResolvedTUnitAnalyzer
        Include="@(_ProgramKitResolvedTUnitAssertionsAnalyzer);
                 @(_ProgramKitResolvedTUnitCoreAnalyzer)" />
      <_ProgramKitApprovedResolvedAnalyzer
        Include="@(Analyzer)"
        Condition="'%(FullPath)' == '$(_ProgramKitNetAnalyzerPath)' or
                   '%(FullPath)' == '$(_ProgramKitCSharpNetAnalyzerPath)' or
                   '%(FullPath)' == '$(_ProgramKitCodeStyleAnalyzerPath)' or
                   '%(FullPath)' == '$(_ProgramKitCodeStyleFixAnalyzerPath)' or
                   '%(FullPath)' == '$(_ProgramKitCSharpCodeStyleAnalyzerPath)' or
                   '%(FullPath)' == '$(_ProgramKitCSharpCodeStyleFixAnalyzerPath)' or
                   '%(FullPath)' == '$(ProgramKitCSharpGateAssemblyPath)' or
                   '%(FullPath)' == '$(_ProgramKitMSTestAnalyzerPath)' or
                   '%(FullPath)' == '$(_ProgramKitMSTestCodeFixAnalyzerPath)' or
                   ('%(FullPath)' == '$(_ProgramKitLoggingGeneratorPath)' and
                    '%(Analyzer.NuGetPackageId)' == 'Microsoft.Extensions.Logging.Abstractions' and
                    '%(Analyzer.NuGetPackageVersion)' == '10.0.10') or
                   '%(FullPath)' == '$(_ProgramKitOptionsGeneratorPath)' or
                   '%(FullPath)' == '$(_ProgramKitConfigurationBinderGeneratorPath)' or
                   ('%(FullPath)' == '$(_ProgramKitSystemClientModelGeneratorPath)' and
                    '%(Analyzer.NuGetPackageId)' == 'System.ClientModel' and
                    '%(Analyzer.NuGetPackageVersion)' == '1.10.0') or
                   ('$(_ProgramKitGeneratedSourceProbeAnalyzerPath)' != '' and
                    '%(FullPath)' == '$(_ProgramKitGeneratedSourceProbeAnalyzerPath)') or
                    ($([System.String]::Copy('%(FullPath)').StartsWith('$(_ProgramKitFrameworkAnalyzerRoot)', System.StringComparison.OrdinalIgnoreCase)) and
                     ('%(Filename)%(Extension)' == 'Microsoft.Interop.ComInterfaceGenerator.dll' or
                      '%(Filename)%(Extension)' == 'Microsoft.Interop.JavaScript.JSImportGenerator.dll' or
                      '%(Filename)%(Extension)' == 'Microsoft.Interop.LibraryImportGenerator.dll' or
                      '%(Filename)%(Extension)' == 'Microsoft.Interop.SourceGeneration.dll' or
                      '%(Filename)%(Extension)' == 'System.Text.Json.SourceGeneration.dll' or
                      '%(Filename)%(Extension)' == 'System.Text.RegularExpressions.Generator.dll')) or
                    ($([System.String]::Copy('%(FullPath)').StartsWith('$(_ProgramKitAspNetFrameworkAnalyzerRoot)', System.StringComparison.OrdinalIgnoreCase)) and
                     ('%(Filename)%(Extension)' == 'Microsoft.AspNetCore.App.Analyzers.dll' or
                      '%(Filename)%(Extension)' == 'Microsoft.AspNetCore.App.CodeFixes.dll' or
                      '%(Filename)%(Extension)' == 'Microsoft.AspNetCore.App.SourceGenerators.dll' or
                      '%(Filename)%(Extension)' == 'Microsoft.AspNetCore.Components.Analyzers.dll' or
                      '%(Filename)%(Extension)' == 'Microsoft.Extensions.Validation.ValidationsGenerator.dll' or
                      '%(Filename)%(Extension)' == 'Microsoft.Extensions.Logging.Generators.dll' or
                      '%(Filename)%(Extension)' == 'Microsoft.Extensions.Options.SourceGeneration.dll')) or
                    ($([System.String]::Copy('%(FullPath)').StartsWith('$(_ProgramKitWebSdkAnalyzerRoot)', System.StringComparison.OrdinalIgnoreCase)) and
                     ('%(Filename)%(Extension)' == 'Microsoft.AspNetCore.Analyzers.dll' or
                      '%(Filename)%(Extension)' == 'Microsoft.AspNetCore.Mvc.Analyzers.dll')) or
                    ($([System.String]::Copy('%(FullPath)').StartsWith('$(_ProgramKitRazorGeneratorRoot)', System.StringComparison.OrdinalIgnoreCase)) and
                     ('%(Filename)%(Extension)' == 'Microsoft.AspNetCore.Razor.Utilities.Shared.dll' or
                      '%(Filename)%(Extension)' == 'Microsoft.CodeAnalysis.Razor.Compiler.dll' or
                      '%(Filename)%(Extension)' == 'Microsoft.Extensions.ObjectPool.dll'))" />
      <_ProgramKitApprovedResolvedAnalyzer
        Include="@(_ProgramKitResolvedTUnitAnalyzer)" />
    </ItemGroup>
    <Error Condition="'@(_ProgramKitResolvedNetAnalyzer->Count())' != '1' or
                      '@(_ProgramKitResolvedCSharpNetAnalyzer->Count())' != '1' or
                      '@(_ProgramKitResolvedCodeStyleAnalyzer->Count())' != '1' or
                      '@(_ProgramKitResolvedCSharpCodeStyleAnalyzer->Count())' != '1'"
           Code="PKCS141"
           Text="The exact SDK .NET, C# .NET, CodeStyle, and C# CodeStyle analyzers must all remain attached once; observed counts @(_ProgramKitResolvedNetAnalyzer->Count()), @(_ProgramKitResolvedCSharpNetAnalyzer->Count()), @(_ProgramKitResolvedCodeStyleAnalyzer->Count()), @(_ProgramKitResolvedCSharpCodeStyleAnalyzer->Count())." />
    <Error Condition="'$(_ProgramKitLegacyMSTestProject)' == 'true' and
                      '@(_ProgramKitResolvedMSTestAnalyzer->Count())' != '1'"
           Code="PKCS142"
           Text="The two legacy MSTest projects must attach exactly MSTest.Analyzers.dll 4.3.2." />
    <Error Condition="'$(IsTestProject)' == 'true' and
                      '$(_ProgramKitLegacyMSTestProject)' != 'true' and
                      ('@(_ProgramKitResolvedTUnitAnalyzer->Count())' != '6' or
                       '@(_ProgramKitResolvedMSTestAnalyzer)' != '')"
           Code="PKCS142"
           Text="New test projects must attach exactly the six source-verified TUnit 1.60.0 analyzer/generator inputs and no MSTest analyzer." />
    <Error Condition="'@(Analyzer->Count())' != '@(_ProgramKitApprovedResolvedAnalyzer->Count())'"
           Code="PKCS148"
           Text="Every resolved analyzer or generator must be on the central exact-path allowlist; observed @(Analyzer->'%(FullPath)')." />
    <ItemGroup>
      <_ProgramKitValidatedAnalyzer Remove="@(_ProgramKitValidatedAnalyzer)" />
      <_ProgramKitValidatedCompileSource Remove="@(_ProgramKitValidatedCompileSource)" />
      <_ProgramKitValidatedReference Remove="@(_ProgramKitValidatedReference)" />
      <_ProgramKitValidatedAdditionalFile Remove="@(_ProgramKitValidatedAdditionalFile)" />
      <_ProgramKitValidatedAnalyzerConfig Remove="@(_ProgramKitValidatedAnalyzerConfig)" />
      <_ProgramKitValidatedAnalyzer Include="@(Analyzer)">
        <NormalizedPath>%(Analyzer.FullPath)</NormalizedPath>
      </_ProgramKitValidatedAnalyzer>
      <_ProgramKitValidatedCompileSource Include="@(Compile)">
        <NormalizedPath>%(Compile.FullPath)</NormalizedPath>
      </_ProgramKitValidatedCompileSource>
      <_ProgramKitValidatedReference Include="@(ReferencePathWithRefAssemblies)">
        <NormalizedPath>%(ReferencePathWithRefAssemblies.FullPath)</NormalizedPath>
      </_ProgramKitValidatedReference>
      <_ProgramKitValidatedAdditionalFile Include="@(AdditionalFiles)">
        <NormalizedPath>%(AdditionalFiles.FullPath)</NormalizedPath>
      </_ProgramKitValidatedAdditionalFile>
      <_ProgramKitValidatedAnalyzerConfig Include="@(EditorConfigFiles)">
        <NormalizedPath>%(EditorConfigFiles.FullPath)</NormalizedPath>
      </_ProgramKitValidatedAnalyzerConfig>
    </ItemGroup>
  </Target>

  <Target Name="ValidateProgramKitOwnedSourceInventory"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectFullPath)' != '$(MSBuildThisFileDirectory)tests\Orbyss.ProgramKit.ConformanceTests\Fixtures\CSharpGate\CSharpGateProbe.csproj' and
                     '$(MSBuildProjectFullPath)' != '$(MSBuildThisFileDirectory)tests\Orbyss.ProgramKit.ConformanceTests\Fixtures\CSharpGate\TestMirroring\Orbyss.ProgramKit.UnitTests.csproj' and
                     '$(MSBuildProjectFullPath)' != '$(MSBuildThisFileDirectory)tests\Orbyss.ProgramKit.ConformanceTests\Fixtures\CSharpGate\FutureTestMirroring\Orbyss.ProgramKit.Artifacts.UnitTests.csproj'">
    <Error Condition="'$(EnableDefaultItems)' == 'false'"
           Code="PKCS156"
           Text="Owned Program Kit projects cannot disable default SDK items." />
    <Error Condition="'$(EnableDefaultCompileItems)' == 'false'"
           Code="PKCS157"
           Text="Owned Program Kit projects cannot disable default SDK Compile items." />
    <ItemGroup>
      <_ProgramKitPhysicalOwnedSource Remove="@(_ProgramKitPhysicalOwnedSource)" />
      <_ProgramKitMissingOwnedSource Remove="@(_ProgramKitMissingOwnedSource)" />
      <_ProgramKitPhysicalOwnedSource
        Include="$(MSBuildProjectDirectory)\**\*.cs"
        Exclude="$(MSBuildProjectDirectory)\bin\**\*.cs;
                 $(MSBuildProjectDirectory)\obj\**\*.cs" />
      <_ProgramKitPhysicalOwnedSource
        Remove="$(MSBuildProjectDirectory)\Fixtures\**\*.cs"
        Condition="'$(MSBuildProjectFullPath)' == '$(MSBuildThisFileDirectory)tests\Orbyss.ProgramKit.ConformanceTests\Orbyss.ProgramKit.ConformanceTests.csproj'" />
      <_ProgramKitMissingOwnedSource Include="@(_ProgramKitPhysicalOwnedSource)" />
      <_ProgramKitMissingOwnedSource
        Remove="@(Compile)"
        MatchOnMetadata="FullPath"
        MatchOnMetadataOptions="PathLike" />
    </ItemGroup>
    <Error Condition="'@(_ProgramKitMissingOwnedSource)' != ''"
           Code="PKCS158"
           Text="Every physical owned C# source must remain in Compile; missing @(_ProgramKitMissingOwnedSource)." />
  </Target>

  <Target Name="ValidateProgramKitCs1701CompatibilityRawReferences"
          BeforeTargets="ResolvePackageAssets">
    <PropertyGroup>
      <_ProgramKitCs1701CompatibilityRawReferenceUnitTestProjectPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)tests\Orbyss.ProgramKit.UnitTests\Orbyss.ProgramKit.UnitTests.csproj'))</_ProgramKitCs1701CompatibilityRawReferenceUnitTestProjectPath>
      <_ProgramKitCs1701CompatibilityRawReferenceConformanceTestProjectPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)tests\Orbyss.ProgramKit.ConformanceTests\Orbyss.ProgramKit.ConformanceTests.csproj'))</_ProgramKitCs1701CompatibilityRawReferenceConformanceTestProjectPath>
      <_ProgramKitCs1701CompatibilityMSTestFrameworkTargetsPath>$([System.IO.Path]::Combine('$(NuGetPackageRoot)', 'mstest.testframework', '4.3.2', 'buildTransitive', 'net9.0', 'MSTest.TestFramework.targets'))</_ProgramKitCs1701CompatibilityMSTestFrameworkTargetsPath>
      <_ProgramKitCs1701CompatibilityMSTestAdapterTargetsPath>$([System.IO.Path]::Combine('$(NuGetPackageRoot)', 'mstest.testadapter', '4.3.2', 'buildTransitive', 'net9.0', 'MSTest.TestAdapter.targets'))</_ProgramKitCs1701CompatibilityMSTestAdapterTargetsPath>
      <_ProgramKitCs1701CompatibilityMSTestFrameworkExtensionsPath>$([System.IO.Path]::Combine('$(NuGetPackageRoot)', 'mstest.testframework', '4.3.2', 'buildTransitive', 'net9.0', 'MSTest.TestFramework.Extensions.dll'))</_ProgramKitCs1701CompatibilityMSTestFrameworkExtensionsPath>
      <_ProgramKitCs1701CompatibilityMSTestAdapterPath>$([System.IO.Path]::Combine('$(NuGetPackageRoot)', 'mstest.testadapter', '4.3.2', 'buildTransitive', 'net9.0', 'MSTest.TestAdapter.dll'))</_ProgramKitCs1701CompatibilityMSTestAdapterPath>
      <_ProgramKitCs1701CompatibilityMSTestPlatformServicesPath>$([System.IO.Path]::Combine('$(NuGetPackageRoot)', 'mstest.testadapter', '4.3.2', 'buildTransitive', 'net9.0', 'MSTestAdapter.PlatformServices.dll'))</_ProgramKitCs1701CompatibilityMSTestPlatformServicesPath>
      <_ProgramKitCs1701CompatibilityCanonicalProject
        Condition="'$(MSBuildProjectFullPath)' == '$(_ProgramKitCs1701CompatibilityRawReferenceUnitTestProjectPath)' or
                   '$(MSBuildProjectFullPath)' == '$(_ProgramKitCs1701CompatibilityRawReferenceConformanceTestProjectPath)'">true</_ProgramKitCs1701CompatibilityCanonicalProject>
    </PropertyGroup>
    <ItemGroup Condition="'$(_ProgramKitCs1701CompatibilityCanonicalProject)' == 'true'">
      <_ProgramKitCs1701CompatibilityApprovedRawReference
        Include="@(Reference)"
        Condition="('%(Reference.Identity)' == 'MSTest.TestFramework.Extensions' and
                    '%(Reference.HintPath)' == '$(_ProgramKitCs1701CompatibilityMSTestFrameworkExtensionsPath)' and
                    '%(Reference.DefiningProjectFullPath)' == '$(_ProgramKitCs1701CompatibilityMSTestFrameworkTargetsPath)') or
                   ('%(Reference.Identity)' == 'MSTest.TestAdapter' and
                    '%(Reference.HintPath)' == '$(_ProgramKitCs1701CompatibilityMSTestAdapterPath)' and
                    '%(Reference.DefiningProjectFullPath)' == '$(_ProgramKitCs1701CompatibilityMSTestAdapterTargetsPath)') or
                   ('%(Reference.Identity)' == 'MSTestAdapter.PlatformServices' and
                    '%(Reference.HintPath)' == '$(_ProgramKitCs1701CompatibilityMSTestPlatformServicesPath)' and
                    '%(Reference.DefiningProjectFullPath)' == '$(_ProgramKitCs1701CompatibilityMSTestAdapterTargetsPath)')" />
    </ItemGroup>
    <Error Condition="'$(_ProgramKitCs1701CompatibilityCanonicalProject)' == 'true' and
                      '@(Reference->Count())' != '3'"
           Code="PKCS174"
           Text="The CS1701 compatibility quarantine forbids every raw assembly reference except the exact three imported by MSTest SDK 4.3.2; observed @(Reference->'%(Identity)')." />
    <Error Condition="'$(_ProgramKitCs1701CompatibilityCanonicalProject)' == 'true' and
                      '@(_ProgramKitCs1701CompatibilityApprovedRawReference->Count())' != '3'"
           Code="PKCS174"
           Text="The exact raw MSTest SDK 4.3.2 reference identities or their import provenance changed." />
  </Target>

  <Target Name="ValidateProgramKitDeclaredReferenceInputs"
          DependsOnTargets="ValidateProgramKitCs1701CompatibilityRawReferences"
          BeforeTargets="ResolvePackageAssets">
    <PropertyGroup>
      <_ProgramKitCSharpGateRawReferenceProjectPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)tools\Orbyss.ProgramKit.CSharpGate\Orbyss.ProgramKit.CSharpGate.csproj'))</_ProgramKitCSharpGateRawReferenceProjectPath>
      <_ProgramKitCSharpBuildGatesAuthoringRawReferenceProjectPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)src\Orbyss.ProgramKit.CSharpBuildGates.Authoring\Orbyss.ProgramKit.CSharpBuildGates.Authoring.csproj'))</_ProgramKitCSharpBuildGatesAuthoringRawReferenceProjectPath>
      <_ProgramKitCSharpBuildGatesBuildRawReferenceProjectPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)src\Orbyss.ProgramKit.CSharpBuildGates.Build\Orbyss.ProgramKit.CSharpBuildGates.Build.csproj'))</_ProgramKitCSharpBuildGatesBuildRawReferenceProjectPath>
      <_ProgramKitGeneratedOutputIntegrityBuildRawReferenceProjectPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)src\Orbyss.ProgramKit.GeneratedOutputIntegrity.Build\Orbyss.ProgramKit.GeneratedOutputIntegrity.Build.csproj'))</_ProgramKitGeneratedOutputIntegrityBuildRawReferenceProjectPath>
      <_ProgramKitGeneratedSourceContractAnalyzerRawReferenceProjectPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)src\Orbyss.ProgramKit.GeneratedSourceContract.Analyzers\Orbyss.ProgramKit.GeneratedSourceContract.Analyzers.csproj'))</_ProgramKitGeneratedSourceContractAnalyzerRawReferenceProjectPath>
      <_ProgramKitGeneratedProbeRawReferenceProjectPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)tests\Orbyss.ProgramKit.ConformanceTests\Fixtures\CSharpGate\GeneratedSource\Generator\GeneratedSourceProbe.csproj'))</_ProgramKitGeneratedProbeRawReferenceProjectPath>
      <_ProgramKitRoslynBinariesPath>$([System.IO.Path]::GetFullPath('$(MSBuildToolsPath)\Roslyn\bincore'))\</_ProgramKitRoslynBinariesPath>
      <_ProgramKitMSBuildBinariesPath>$([System.IO.Path]::GetFullPath('$(MSBuildToolsPath)'))\</_ProgramKitMSBuildBinariesPath>
    </PropertyGroup>
    <ItemGroup>
      <_ProgramKitApprovedRawReference Remove="@(_ProgramKitApprovedRawReference)" />
      <_ProgramKitApprovedRawReference
        Include="@(Reference)"
        Condition="('%(Reference.Identity)' == 'Microsoft.CodeAnalysis' and
                    '%(Reference.HintPath)' == '$(_ProgramKitRoslynBinariesPath)Microsoft.CodeAnalysis.dll' and
                    ('%(Reference.DefiningProjectFullPath)' == '$(_ProgramKitCSharpGateRawReferenceProjectPath)' or
                     '%(Reference.DefiningProjectFullPath)' == '$(_ProgramKitCSharpBuildGatesAuthoringRawReferenceProjectPath)' or
                     '%(Reference.DefiningProjectFullPath)' == '$(_ProgramKitGeneratedSourceContractAnalyzerRawReferenceProjectPath)' or
                     '%(Reference.DefiningProjectFullPath)' == '$(_ProgramKitGeneratedProbeRawReferenceProjectPath)') and
                    '%(Reference.Private)' == 'false' and
                    '%(Reference.Aliases)' == '' and
                    '%(Reference.EmbedInteropTypes)' != 'true') or
                   ('%(Reference.Identity)' == 'Microsoft.CodeAnalysis.CSharp' and
                    '%(Reference.HintPath)' == '$(_ProgramKitRoslynBinariesPath)Microsoft.CodeAnalysis.CSharp.dll' and
                    ('%(Reference.DefiningProjectFullPath)' == '$(_ProgramKitCSharpGateRawReferenceProjectPath)' or
                     '%(Reference.DefiningProjectFullPath)' == '$(_ProgramKitCSharpBuildGatesAuthoringRawReferenceProjectPath)' or
                     '%(Reference.DefiningProjectFullPath)' == '$(_ProgramKitGeneratedSourceContractAnalyzerRawReferenceProjectPath)' or
                     '%(Reference.DefiningProjectFullPath)' == '$(_ProgramKitGeneratedProbeRawReferenceProjectPath)') and
                    '%(Reference.Private)' == 'false' and
                    '%(Reference.Aliases)' == '' and
                    '%(Reference.EmbedInteropTypes)' != 'true') or
                   ('%(Reference.Identity)' == 'Microsoft.Build.Framework' and
                    '%(Reference.HintPath)' == '$(_ProgramKitMSBuildBinariesPath)Microsoft.Build.Framework.dll' and
                    ('%(Reference.DefiningProjectFullPath)' == '$(_ProgramKitCSharpBuildGatesBuildRawReferenceProjectPath)' or
                     '%(Reference.DefiningProjectFullPath)' == '$(_ProgramKitGeneratedOutputIntegrityBuildRawReferenceProjectPath)') and
                    '%(Reference.Private)' == 'false' and
                    '%(Reference.Aliases)' == '' and
                    '%(Reference.EmbedInteropTypes)' != 'true') or
                   ('%(Reference.Identity)' == 'Microsoft.Build.Utilities.Core' and
                    '%(Reference.HintPath)' == '$(_ProgramKitMSBuildBinariesPath)Microsoft.Build.Utilities.Core.dll' and
                    ('%(Reference.DefiningProjectFullPath)' == '$(_ProgramKitCSharpBuildGatesBuildRawReferenceProjectPath)' or
                     '%(Reference.DefiningProjectFullPath)' == '$(_ProgramKitGeneratedOutputIntegrityBuildRawReferenceProjectPath)') and
                    '%(Reference.Private)' == 'false' and
                    '%(Reference.Aliases)' == '' and
                    '%(Reference.EmbedInteropTypes)' != 'true')" />
      <_ProgramKitApprovedRawReference
        Include="@(_ProgramKitCs1701CompatibilityApprovedRawReference)"
        Condition="'%(_ProgramKitCs1701CompatibilityApprovedRawReference.Aliases)' == '' and
                   '%(_ProgramKitCs1701CompatibilityApprovedRawReference.EmbedInteropTypes)' != 'true'" />
      <_ProgramKitReferenceWithAlias
        Include="@(Reference)"
        Condition="'%(Reference.Aliases)' != ''" />
      <_ProgramKitReferenceWithEmbeddedInterop
        Include="@(Reference)"
        Condition="'%(Reference.EmbedInteropTypes)' == 'true'" />
    </ItemGroup>
    <Error Condition="'@(Reference->Count())' != '@(_ProgramKitApprovedRawReference->Count())' or
                      '@(_ProgramKitReferenceWithAlias)' != '' or
                      '@(_ProgramKitReferenceWithEmbeddedInterop)' != ''"
           Code="PKCS176"
           Text="Raw assembly references are forbidden except the exact repository-approved Roslyn tool references and quarantined MSTest imports; aliases and embedded interop are forbidden. Observed @(Reference->'%(Identity)')." />
    <Error Condition="'@(COMReference)' != '' or
                      '@(COMFileReference)' != '' or
                      '@(AddModules)' != ''"
           Code="PKCS176"
           Text="COM references, COM file references, and added compiler modules are forbidden." />
  </Target>

