{
  "schemaVersion": 1,
  "profileRegistry": "extensions/program-kit-building-blocks/references/dependency-profiles",
  "optionalTools": [
    {
      "name": "Dedicated evidence guardian App token action",
      "command": "actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1",
      "usedBy": "evidence-repository/.github/workflows/guardian.yml",
      "scope": "Optional separately provisioned evidence repository only; token restricted to that repository, checks write and contents/pull requests read.",
      "updatePolicy": "SHA pin v3.2.0; tracked by the workflow input scan. No automatic provisioning or secret setup. Review upgrades with dependency maintenance.",
      "source": "https://github.com/actions/create-github-app-token"
    },
    {
      "name": "GitHub CLI repair feedback",
      "command": "gh api",
      "usedBy": "extensions/program-kit-governance/scripts/repair_feedback.py and scripts/verify_evidence_repository.py",
      "scope": "Optional fresh read-only correlation/history/status and exact-content-approved issue, consumer-fork and evidence PR delivery to explicit Program Kit repositories.",
      "updatePolicy": "Use the installed device CLI; no automatic installation or login. Public delivery fails closed on lookup, security, provisioning or authentication failure. Local queuing remains independent.",
      "source": "https://cli.github.com/manual/gh_api"
    },
    {
      "name": "GitHub CLI qualification and attestation verification",
      "command": "gh api / gh attestation verify",
      "usedBy": "scripts/release_candidate.py",
      "scope": "Required CI artifact metadata, hard-failing archive downloads and exact producer attestations; local candidate inspection and explicitly authorized workflow dispatch.",
      "updatePolicy": "Use the runner/device GitHub CLI; fail closed if required attestation flags or APIs are unavailable. No automatic device installation or unrelated pin update.",
      "source": "https://cli.github.com/manual/gh_attestation_verify"
    },
    {
      "name": "GitHub CLI",
      "command": "gh api",
      "usedBy": "extensions/program-kit-governance/scripts/task_draft.py",
      "scope": "Optional authenticated read-only account verification and explicitly supplied story decision references.",
      "updatePolicy": "Use the device-supported GitHub CLI API command; no toolkit version pin or automatic installation. Missing/unavailable access leaves new identity/decisions pending.",
      "source": "https://cli.github.com/manual/gh_api"
    }
  ],
  "inputs": [
    "evidence-repository/.github/workflows/*.yml",
    "maintenance-policy.json",
    "scripts/dependency_maintenance.py",
    "tests/ci-tool-requirements.txt",
    ".github/workflows/*.yml",
    "extensions/program-kit-dotnet/templates/dotnet/files/.github/workflows/*.yml",
    "extensions/program-kit-dotnet/templates/dotnet/files/global.json",
    "extensions/program-kit-dotnet/templates/dotnet/files/.python-version",
    "extensions/program-kit-dotnet/templates/dotnet/files/.nvmrc",
    "extensions/program-kit-dotnet/templates/dotnet/files/.npm-version",
    "extensions/program-kit-dotnet/templates/dotnet/files/.oasdiff-version",
    "extensions/program-kit-dotnet/templates/dotnet/files/eng/ProgramKit.Packages.props",
    "extensions/program-kit-dotnet/templates/dotnet/files/eng/profiles/persistence/*.props",
    "extensions/program-kit-dotnet/templates/dotnet/files/eng/foundation-test-support/packages.json",
    "extensions/program-kit-dotnet/templates/dotnet/files/eng/.config/dotnet-tools.json",
    "extensions/program-kit-dotnet/templates/dotnet/web-profiles/common/eng/web/package.json",
    "extensions/program-kit-dotnet/templates/dotnet/hosted-pages/web/package.json",
    "extensions/program-kit-dotnet/templates/dotnet/web-profiles/common/deploy/compose.identity.yml",
    "extensions/program-kit-governance/templates/ui-experience/acceptance/package.json",
    "extensions/program-kit-governance/scripts/json-schema-requirements.txt",
    "extensions/program-kit-governance/references/c4-viewer-tool.json",
    "extensions/program-kit-building-blocks/references/dependency-profiles/index.json",
    "extensions/program-kit-building-blocks/references/foundation-baseline-evidence.json",
    "extensions/program-kit-dotnet/references/persistence-runtimes.json",
    "extensions/program-kit-dotnet/references/examples/pdf-decoding/PdfDecodingExample.csproj",
    "extensions/program-kit-dotnet/references/examples/ocr-operation/OcrOperation.csproj",
    ".python-version"
  ],
  "families": {
    "foundation": "Orbyss.Foundation.WebDefaults",
    "foundation-build": "Orbyss.Foundation.Build",
    "forms": "Orbyss.Forms.Abstractions",
    "localization": "Orbyss.Localization.Abstractions"
  },
  "additionalPins": [
    {
      "kind": "nuget",
      "name": "xunit.v3.mtp-v2",
      "path": "extensions/program-kit-dotnet/templates/dotnet/files/eng/foundation-test-support/packages.json",
      "pointer": "/xunit.v3.mtp-v2"
    },
    {
      "kind": "github",
      "name": "structurizr/structurizr",
      "path": "extensions/program-kit-governance/references/c4-viewer-tool.json",
      "pointer": "/selected/version"
    }
  ],
  "metadataOverrides": {
    "anonymousGithubMetadata": [
      "aquasecurity/setup-trivy",
      "aquasecurity/trivy"
    ],
    "CShells.Abstractions": "https://f.feedz.io/valence-works/cshells/nuget/v3/packages/cshells.abstractions/index.json",
    "CShells.AspNetCore.Abstractions": "https://f.feedz.io/valence-works/cshells/nuget/v3/packages/cshells.aspnetcore.abstractions/index.json",
    "image:postgres": {
      "tag": "latest",
      "omitTag": true,
      "versionEnvironment": "PG_VERSION"
    },
    "image:quay.io/keycloak/keycloak": {
      "github": "keycloak/keycloak"
    }
  },
  "immutableInputs": [
    "extensions/program-kit-building-blocks/references/foundation-baseline-evidence.json"
  ]
}
