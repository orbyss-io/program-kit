{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/dotnet/keycloak-local-fixture-profile/1.0.0/schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:dotnet-keycloak-local-fixture-profile",
  "x-program-kit-version": "1.0.0",
  "title": "Program Kit Keycloak local fixture profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profileKind",
    "profileVersion",
    "authority",
    "metadataAddress",
    "audience",
    "scope",
    "profiles",
    "tls",
    "providerConclusions",
    "domainAuthorizationMeaning",
    "runtimeTransport",
    "executionGate",
    "evidence"
  ],
  "properties": {
    "profileKind": {
      "const": "keycloak-local-test"
    },
    "profileVersion": {
      "const": "1.0.0"
    },
    "authority": {
      "type": "string",
      "pattern": "^https://localhost:[1-9][0-9]{0,4}/realms/[a-z][a-z0-9._-]{0,127}$"
    },
    "metadataAddress": {
      "type": "string",
      "pattern": "^https://localhost:[1-9][0-9]{0,4}/realms/[a-z][a-z0-9._-]{0,127}/\\.well-known/openid-configuration$"
    },
    "audience": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,127}$"
    },
    "scope": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,127}$"
    },
    "profiles": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {
          "const": "oidc-public-browser-code-pkce"
        },
        {
          "const": "oidc-confidential-code-pkce"
        },
        {
          "const": "rfc9068-jwt-resource-server"
        },
        {
          "const": "oauth-client-credentials"
        },
        {
          "const": "rfc8693-token-exchange"
        }
      ],
      "items": false
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileIdentity",
        "profileVersion",
        "serverHostName",
        "providerHttpsTargetPort",
        "runtimeRootEnvironmentVariable",
        "dotNetTrustMode",
        "chromiumTrustMode",
        "providerHttpEnabled",
        "materialLifetime",
        "trustScope"
      ],
      "properties": {
        "profileIdentity": {
          "const": "pkid:profile:program-kit:keycloak-fixture-tls"
        },
        "profileVersion": {
          "const": "1.0.0"
        },
        "serverHostName": {
          "const": "localhost"
        },
        "providerHttpsTargetPort": {
          "const": 8443
        },
        "runtimeRootEnvironmentVariable": {
          "const": "PROGRAM_KIT_KEYCLOAK_RUNTIME_ROOT"
        },
        "dotNetTrustMode": {
          "const": "dotnet-custom-root-trust"
        },
        "chromiumTrustMode": {
          "const": "chromium-server-spki-list"
        },
        "providerHttpEnabled": {
          "const": false
        },
        "materialLifetime": {
          "const": "authorized-execution-only"
        },
        "trustScope": {
          "const": "exact-fixture-processes-only"
        }
      }
    },
    "providerConclusions": {
      "const": false
    },
    "domainAuthorizationMeaning": {
      "const": false
    },
    "runtimeTransport": {
      "const": "https-only-fixture-owned-ephemeral-authority"
    },
    "executionGate": {
      "const": "PROGRAM_KIT_RUN_KEYCLOAK_FIXTURE=1"
    },
    "evidence": {
      "const": "redacted-non-authoritative-outcomes-only"
    }
  }
}
