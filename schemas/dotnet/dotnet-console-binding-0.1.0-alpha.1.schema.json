{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/dotnet/console-binding/0.1.0-alpha.1/schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:dotnet-console-binding",
  "x-program-kit-version": "0.1.0-alpha.1",
  "title": "Program Kit .NET Console Binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "openConsoleDocumentRevision",
    "consumerProject",
    "featureType",
    "validationResultType",
    "operations"
  ],
  "properties": {
    "$schema": {
      "const": "pkid:schema:program-kit:dotnet-console-binding@1.0.0"
    },
    "version": {
      "const": "0.1.0-alpha.1"
    },
    "openConsoleDocumentRevision": {
      "$ref": "#/$defs/reference"
    },
    "consumerProject": {
      "$ref": "#/$defs/consumerProject"
    },
    "featureType": {
      "$ref": "#/$defs/clrType"
    },
    "validationResultType": {
      "$ref": "#/$defs/clrType"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/operationBinding"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^pkid:[a-z0-9-]+:[a-z0-9-]+:[a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "version",
        "digest"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "clrType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadataName",
        "genericArguments",
        "referenceNullability"
      ],
      "properties": {
        "metadataName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "genericArguments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clrType"
          }
        },
        "referenceNullability": {
          "enum": [
            "not-applicable",
            "not-null",
            "nullable"
          ]
        }
      }
    },
    "consumerProject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "name",
        "relativeProjectPath",
        "targetFramework",
        "referenceAssemblyName",
        "relativeReferenceAssemblyPath",
        "referenceAssemblyDigest"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "relativeProjectPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "targetFramework": {
          "const": "net10.0"
        },
        "referenceAssemblyName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "relativeReferenceAssemblyPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "referenceAssemblyDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "parameterSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "enum": [
            "argument",
            "option"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "defaultDisposition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "canonicalValue"
          ],
          "properties": {
            "kind": {
              "const": "none"
            },
            "canonicalValue": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "canonicalValue"
          ],
          "properties": {
            "kind": {
              "const": "canonical"
            },
            "canonicalValue": {
              "type": "string"
            }
          }
        }
      ]
    },
    "constructorParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "name",
        "clrType",
        "source",
        "defaultDisposition"
      ],
      "properties": {
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "clrType": {
          "$ref": "#/$defs/clrType"
        },
        "source": {
          "$ref": "#/$defs/parameterSource"
        },
        "defaultDisposition": {
          "$ref": "#/$defs/defaultDisposition"
        }
      }
    },
    "operationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationRevision",
        "generatedSymbol",
        "requestType",
        "handlerType",
        "validatorType",
        "constructorParameters"
      ],
      "properties": {
        "operationRevision": {
          "$ref": "#/$defs/reference"
        },
        "generatedSymbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "requestType": {
          "$ref": "#/$defs/clrType"
        },
        "handlerType": {
          "$ref": "#/$defs/clrType"
        },
        "validatorType": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/clrType"
            }
          ]
        },
        "constructorParameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constructorParameter"
          }
        }
      }
    }
  }
}
