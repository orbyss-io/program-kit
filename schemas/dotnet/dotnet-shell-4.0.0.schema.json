{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/dotnet/4.0.0/dotnet-shell.schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:dotnet-shell",
  "x-program-kit-version": "4.0.0",
  "title": "Program Kit .NET Shell with exact configuration providers",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "inputVersionMapRevision",
    "inputVersionSelectionRevision",
    "composition",
    "features",
    "jsonSerialization",
    "hosts",
    "compatibility"
  ],
  "properties": {
    "$schema": {"const": "pkid:schema:program-kit:dotnet-shell@4.0.0"},
    "version": {"const": "4.0.0"},
    "inputVersionMapRevision": {"$ref": "#/$defs/reference"},
    "inputVersionSelectionRevision": {"$ref": "#/$defs/reference"},
    "composition": {
      "$ref": "https://schemas.orbyss.io/program-kit/dotnet/3.0.0/dotnet-shell.schema.json#/properties/composition"
    },
    "features": {
      "$ref": "https://schemas.orbyss.io/program-kit/dotnet/3.0.0/dotnet-shell.schema.json#/properties/features"
    },
    "jsonSerialization": {
      "$ref": "https://schemas.orbyss.io/program-kit/dotnet/3.0.0/dotnet-shell.schema.json#/properties/jsonSerialization"
    },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/host"}
    },
    "compatibility": {"$ref": "#/$defs/compatibility"}
  },
  "$defs": {
    "identifier": {
      "$ref": "https://schemas.orbyss.io/program-kit/dotnet/3.0.0/dotnet-shell.schema.json#/$defs/identifier"
    },
    "reference": {
      "$ref": "https://schemas.orbyss.io/program-kit/dotnet/3.0.0/dotnet-shell.schema.json#/$defs/reference"
    },
    "package": {
      "$ref": "https://schemas.orbyss.io/program-kit/dotnet/3.0.0/dotnet-shell.schema.json#/$defs/package"
    },
    "compatibility": {
      "$ref": "https://schemas.orbyss.io/program-kit/dotnet/3.0.0/dotnet-shell.schema.json#/$defs/compatibility"
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "version",
        "kind",
        "dotNetTargetProfileRevision",
        "generatorProfileRevision",
        "shellIdentities",
        "featureActivationIdentities",
        "hostPackages",
        "operationBindings",
        "configurationSources",
        "configurationBindings",
        "taskRuntimeRequirements",
        "health",
        "compatibility"
      ],
      "properties": {
        "identity": {"$ref": "#/$defs/identifier"},
        "version": {
          "$ref": "https://schemas.orbyss.io/program-kit/dotnet/3.0.0/dotnet-shell.schema.json#/$defs/version"
        },
        "kind": {
          "$ref": "https://schemas.orbyss.io/program-kit/dotnet/3.0.0/dotnet-shell.schema.json#/$defs/host/properties/kind"
        },
        "dotNetTargetProfileRevision": {"$ref": "#/$defs/reference"},
        "generatorProfileRevision": {"$ref": "#/$defs/reference"},
        "shellIdentities": {
          "$ref": "https://schemas.orbyss.io/program-kit/dotnet/3.0.0/dotnet-shell.schema.json#/$defs/host/properties/shellIdentities"
        },
        "featureActivationIdentities": {
          "$ref": "https://schemas.orbyss.io/program-kit/dotnet/3.0.0/dotnet-shell.schema.json#/$defs/host/properties/featureActivationIdentities"
        },
        "hostPackages": {
          "type": "array",
          "items": {"$ref": "#/$defs/package"}
        },
        "operationBindings": {
          "$ref": "https://schemas.orbyss.io/program-kit/dotnet/3.0.0/dotnet-shell.schema.json#/$defs/host/properties/operationBindings"
        },
        "configurationSources": {
          "type": "array",
          "items": {"$ref": "#/$defs/configurationSource"}
        },
        "configurationBindings": {
          "$ref": "https://schemas.orbyss.io/program-kit/dotnet/3.0.0/dotnet-shell.schema.json#/$defs/host/properties/configurationBindings"
        },
        "taskRuntimeRequirements": {
          "$ref": "https://schemas.orbyss.io/program-kit/dotnet/3.0.0/dotnet-shell.schema.json#/$defs/host/properties/taskRuntimeRequirements"
        },
        "health": {
          "$ref": "https://schemas.orbyss.io/program-kit/dotnet/3.0.0/dotnet-shell.schema.json#/$defs/host/properties/health"
        },
        "compatibility": {"$ref": "#/$defs/compatibility"}
      }
    },
    "configurationSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "order",
        "providerKind",
        "providerRevision",
        "package",
        "path",
        "prefix",
        "initialValues",
        "userSecretsId",
        "optional",
        "startupDisposition",
        "reload",
        "secretClassification",
        "failureDisposition"
      ],
      "properties": {
        "identity": {"$ref": "#/$defs/identifier"},
        "order": {"type": "integer", "minimum": 0},
        "providerKind": {
          "enum": [
            "json-file",
            "environment-variables",
            "command-line",
            "in-memory",
            "user-secrets",
            "key-per-file",
            "chained-configuration",
            "registered-adapter"
          ]
        },
        "providerRevision": {"$ref": "#/$defs/reference"},
        "package": {"$ref": "#/$defs/package"},
        "path": {
          "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]
        },
        "prefix": {
          "oneOf": [{"type": "null"}, {"type": "string"}]
        },
        "initialValues": {
          "type": "array",
          "items": {"$ref": "#/$defs/initialValue"}
        },
        "userSecretsId": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}
          ]
        },
        "optional": {"type": "boolean"},
        "startupDisposition": {"enum": ["required", "optional"]},
        "reload": {
          "$ref": "https://schemas.orbyss.io/program-kit/dotnet/3.0.0/dotnet-shell.schema.json#/$defs/configurationReload"
        },
        "secretClassification": {
          "enum": ["public-only", "references-only", "provider-owned"]
        },
        "failureDisposition": {"enum": ["fail", "continue-without-source"]}
      }
    },
    "initialValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value", "classification"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "value": {"type": "string"},
        "classification": {"const": "public"}
      }
    }
  }
}
