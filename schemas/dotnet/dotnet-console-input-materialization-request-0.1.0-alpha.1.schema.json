{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/dotnet/console-input-materialization-request/0.1.0-alpha.1/schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:dotnet-console-input-materialization-request",
  "x-program-kit-version": "0.1.0-alpha.1",
  "title": "Program Kit .NET Console Input Materialization Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "identity",
    "ownerIdentity",
    "outputSetIdentity",
    "hostIdentity",
    "consumerProjectPath",
    "consumerProjectIdentity",
    "consumerProjectName",
    "targetFramework",
    "configuration",
    "platform",
    "shell",
    "openConsole",
    "binding",
    "suppliedArtifacts"
  ],
  "properties": {
    "$schema": {
      "const": "pkid:schema:program-kit:dotnet-console-input-materialization-request@0.1.0-alpha.1"
    },
    "version": {
      "const": "0.1.0-alpha.1"
    },
    "identity": {
      "$ref": "#/$defs/identifier"
    },
    "ownerIdentity": {
      "$ref": "#/$defs/identifier"
    },
    "outputSetIdentity": {
      "$ref": "#/$defs/identifier"
    },
    "hostIdentity": {
      "$ref": "#/$defs/identifier"
    },
    "consumerProjectPath": {
      "$ref": "#/$defs/projectPath"
    },
    "consumerProjectIdentity": {
      "$ref": "#/$defs/identifier"
    },
    "consumerProjectName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "targetFramework": {
      "const": "net10.0"
    },
    "configuration": {
      "enum": [
        "Debug",
        "Release"
      ]
    },
    "platform": {
      "const": "AnyCPU"
    },
    "shell": {
      "$ref": "https://schemas.orbyss.io/program-kit/dotnet/11.0.0/dotnet-shell.schema.json"
    },
    "openConsole": {
      "$ref": "#/$defs/openConsoleIntent"
    },
    "binding": {
      "$ref": "#/$defs/bindingIntent"
    },
    "suppliedArtifacts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/suppliedArtifact"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^pkid:[a-z0-9-]+:[a-z0-9-]+:[a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[^:]+$"
    },
    "projectPath": {
      "allOf": [
        {
          "$ref": "#/$defs/relativePath"
        },
        {
          "pattern": "\\.csproj$"
        }
      ]
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "version",
        "digest"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "openConsoleIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "documentVersion",
        "info",
        "hostRevision",
        "parsing",
        "hostExitCodeRoles",
        "globalOptions",
        "commands",
        "help",
        "completion",
        "compatibility",
        "generatorRevision",
        "operationRevisions"
      ],
      "properties": {
        "$schema": {
          "const": "pkid:schema:program-kit:open-console@1.0.0"
        },
        "documentVersion": {
          "const": "1.0.0"
        },
        "info": {
          "type": "object"
        },
        "hostRevision": {
          "$ref": "#/$defs/reference"
        },
        "parsing": {
          "type": "object"
        },
        "hostExitCodeRoles": {
          "type": "object"
        },
        "globalOptions": {
          "type": "array"
        },
        "commands": {
          "type": "array",
          "minItems": 1
        },
        "help": {
          "type": "object"
        },
        "completion": {
          "type": "object"
        },
        "compatibility": {
          "type": "object"
        },
        "generatorRevision": {
          "$ref": "#/$defs/reference"
        },
        "operationRevisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      }
    },
    "bindingIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "version",
        "featureType",
        "validationResultType",
        "operations"
      ],
      "properties": {
        "$schema": {
          "const": "pkid:schema:program-kit:dotnet-console-binding@1.0.0"
        },
        "version": {
          "const": "1.0.0"
        },
        "featureType": {
          "type": "object"
        },
        "validationResultType": {
          "type": "object"
        },
        "operations": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "suppliedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "workspaceRelativePath",
        "outputRelativePath"
      ],
      "properties": {
        "revision": {
          "$ref": "#/$defs/reference"
        },
        "workspaceRelativePath": {
          "$ref": "#/$defs/relativePath"
        },
        "outputRelativePath": {
          "$ref": "#/$defs/relativePath"
        }
      }
    }
  }
}
