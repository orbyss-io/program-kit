{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/dotnet/security-composition/2.0.0/schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:dotnet-security-composition",
  "x-program-kit-version": "2.0.0",
  "title": "Program Kit .NET transport security with public-browser OIDC",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profileRevision",
    "defaults",
    "oidcConfidentialInteractive",
    "oidcPublicBrowser",
    "jwtResourceServer",
    "policies",
    "operationBindings"
  ],
  "properties": {
    "profileRevision": {"$ref": "#/$defs/reference"},
    "defaults": {
      "$ref": "https://schemas.orbyss.io/program-kit/dotnet/security-composition/1.0.0/schema.json#/properties/defaults"
    },
    "oidcConfidentialInteractive": {
      "$ref": "https://schemas.orbyss.io/program-kit/dotnet/security-composition/1.0.0/schema.json#/properties/oidcConfidentialInteractive"
    },
    "oidcPublicBrowser": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/oidcPublicBrowser"}
      ]
    },
    "jwtResourceServer": {
      "$ref": "https://schemas.orbyss.io/program-kit/dotnet/security-composition/1.0.0/schema.json#/properties/jwtResourceServer"
    },
    "policies": {
      "$ref": "https://schemas.orbyss.io/program-kit/dotnet/security-composition/1.0.0/schema.json#/properties/policies"
    },
    "operationBindings": {
      "$ref": "https://schemas.orbyss.io/program-kit/dotnet/security-composition/1.0.0/schema.json#/properties/operationBindings"
    }
  },
  "$defs": {
    "identifier": {
      "$ref": "https://schemas.orbyss.io/program-kit/operations/1.0.0/definitions.schema.json#/$defs/identifier"
    },
    "reference": {
      "$ref": "https://schemas.orbyss.io/program-kit/operations/1.0.0/definitions.schema.json#/$defs/reference"
    },
    "httpsUri": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageId", "version", "sha256"],
      "properties": {
        "packageId": {"type": "string", "minLength": 1},
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "targetAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapterRevision",
        "targetKind",
        "generatorRevision",
        "packages"
      ],
      "properties": {
        "adapterRevision": {"$ref": "#/$defs/reference"},
        "targetKind": {"const": "blazor-web-assembly-oidc"},
        "generatorRevision": {"$ref": "#/$defs/reference"},
        "packages": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/package"}
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileRevision",
        "playwrightRevision",
        "engines",
        "automatedLocalExecutionHumanStarted",
        "operatorAssistedRealProviderOptIn",
        "captureCredentials",
        "persistAuthenticationState",
        "persistTrace",
        "redactedNonAuthoritativeEvidence"
      ],
      "properties": {
        "profileRevision": {"$ref": "#/$defs/reference"},
        "playwrightRevision": {"$ref": "#/$defs/reference"},
        "engines": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["chromium", "firefox", "web-kit"]}
        },
        "automatedLocalExecutionHumanStarted": {"const": true},
        "operatorAssistedRealProviderOptIn": {"const": true},
        "captureCredentials": {"const": false},
        "persistAuthenticationState": {"const": false},
        "persistTrace": {"const": false},
        "redactedNonAuthoritativeEvidence": {"const": true}
      }
    },
    "oidcPublicBrowser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileRevision",
        "targetAdapter",
        "authority",
        "metadataAddress",
        "clientId",
        "redirectUri",
        "postLogoutRedirectUri",
        "browserOrigin",
        "apiResource",
        "corsPolicyName",
        "corsAllowedOrigins",
        "corsAllowedMethods",
        "scopes",
        "tokenStorage",
        "refreshDisposition",
        "threatModelAcceptanceRevision",
        "humanAcceptedBrowserHeldTokens",
        "confidentialBffPreferredForSensitiveApplications",
        "requireHttps",
        "usePkce",
        "requireState",
        "requireNonce",
        "clientSecretAbsent",
        "logoutEnabled",
        "verification"
      ],
      "properties": {
        "profileRevision": {"$ref": "#/$defs/reference"},
        "targetAdapter": {"$ref": "#/$defs/targetAdapter"},
        "authority": {"$ref": "#/$defs/httpsUri"},
        "metadataAddress": {"$ref": "#/$defs/httpsUri"},
        "clientId": {"type": "string", "minLength": 1},
        "redirectUri": {
          "allOf": [
            {"$ref": "#/$defs/httpsUri"},
            {"pattern": "/authentication/login-callback$"}
          ]
        },
        "postLogoutRedirectUri": {
          "allOf": [
            {"$ref": "#/$defs/httpsUri"},
            {"pattern": "/authentication/logout-callback$"}
          ]
        },
        "browserOrigin": {"$ref": "#/$defs/httpsUri"},
        "apiResource": {"$ref": "#/$defs/httpsUri"},
        "corsPolicyName": {"$ref": "#/$defs/name"},
        "corsAllowedOrigins": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/httpsUri"}
        },
        "corsAllowedMethods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD"]}
        },
        "scopes": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "contains": {"const": "openid"},
          "not": {"contains": {"const": "offline_access"}},
          "items": {"type": "string", "minLength": 1}
        },
        "tokenStorage": {"const": "browser-session"},
        "refreshDisposition": {"const": "absent"},
        "threatModelAcceptanceRevision": {"$ref": "#/$defs/reference"},
        "humanAcceptedBrowserHeldTokens": {"const": true},
        "confidentialBffPreferredForSensitiveApplications": {"const": true},
        "requireHttps": {"const": true},
        "usePkce": {"const": true},
        "requireState": {"const": true},
        "requireNonce": {"const": true},
        "clientSecretAbsent": {"const": true},
        "logoutEnabled": {"const": true},
        "verification": {"$ref": "#/$defs/verification"}
      }
    }
  }
}
