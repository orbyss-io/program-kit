{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/dotnet/10.0.0/dotnet-shell.schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:dotnet-shell",
  "x-program-kit-version": "10.0.0",
  "title": "Program Kit .NET Shell with optional Azure Key Vault configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "inputVersionMapRevision",
    "inputVersionSelectionRevision",
    "composition",
    "features",
    "jsonSerialization",
    "hosts",
    "compatibility"
  ],
  "properties": {
    "$schema": {"const": "pkid:schema:program-kit:dotnet-shell@10.0.0"},
    "version": {"const": "10.0.0"},
    "inputVersionMapRevision": {"$ref": "#/$defs/reference"},
    "inputVersionSelectionRevision": {"$ref": "#/$defs/reference"},
    "composition": {
      "$ref": "https://schemas.orbyss.io/program-kit/dotnet/9.0.0/dotnet-shell.schema.json#/properties/composition"
    },
    "features": {
      "$ref": "https://schemas.orbyss.io/program-kit/dotnet/9.0.0/dotnet-shell.schema.json#/properties/features"
    },
    "jsonSerialization": {
      "$ref": "https://schemas.orbyss.io/program-kit/dotnet/9.0.0/dotnet-shell.schema.json#/properties/jsonSerialization"
    },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/host"}
    },
    "compatibility": {"$ref": "#/$defs/compatibility"}
  },
  "$defs": {
    "identifier": {
      "$ref": "https://schemas.orbyss.io/program-kit/dotnet/9.0.0/dotnet-shell.schema.json#/$defs/identifier"
    },
    "reference": {
      "$ref": "https://schemas.orbyss.io/program-kit/dotnet/9.0.0/dotnet-shell.schema.json#/$defs/reference"
    },
    "compatibility": {
      "$ref": "https://schemas.orbyss.io/program-kit/dotnet/9.0.0/dotnet-shell.schema.json#/$defs/compatibility"
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "version",
        "kind",
        "dotNetTargetProfileRevision",
        "generatorProfileRevision",
        "shellIdentities",
        "featureActivationIdentities",
        "hostPackages",
        "operationBindings",
        "configurationSources",
        "configurationBindings",
        "taskRuntimeRequirements",
        "health",
        "compatibility",
        "telemetry",
        "transportFailures",
        "security",
        "azureConfiguration"
      ],
      "properties": {
        "identity": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "https://schemas.orbyss.io/program-kit/dotnet/9.0.0/dotnet-shell.schema.json#/$defs/host/properties/version"},
        "kind": {"$ref": "https://schemas.orbyss.io/program-kit/dotnet/9.0.0/dotnet-shell.schema.json#/$defs/host/properties/kind"},
        "dotNetTargetProfileRevision": {"$ref": "#/$defs/reference"},
        "generatorProfileRevision": {"$ref": "#/$defs/reference"},
        "shellIdentities": {"$ref": "https://schemas.orbyss.io/program-kit/dotnet/9.0.0/dotnet-shell.schema.json#/$defs/host/properties/shellIdentities"},
        "featureActivationIdentities": {"$ref": "https://schemas.orbyss.io/program-kit/dotnet/9.0.0/dotnet-shell.schema.json#/$defs/host/properties/featureActivationIdentities"},
        "hostPackages": {"$ref": "https://schemas.orbyss.io/program-kit/dotnet/9.0.0/dotnet-shell.schema.json#/$defs/host/properties/hostPackages"},
        "operationBindings": {"$ref": "https://schemas.orbyss.io/program-kit/dotnet/9.0.0/dotnet-shell.schema.json#/$defs/host/properties/operationBindings"},
        "configurationSources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/configurationSource"}
        },
        "configurationBindings": {"$ref": "https://schemas.orbyss.io/program-kit/dotnet/9.0.0/dotnet-shell.schema.json#/$defs/host/properties/configurationBindings"},
        "taskRuntimeRequirements": {"$ref": "https://schemas.orbyss.io/program-kit/dotnet/9.0.0/dotnet-shell.schema.json#/$defs/host/properties/taskRuntimeRequirements"},
        "health": {"$ref": "https://schemas.orbyss.io/program-kit/dotnet/9.0.0/dotnet-shell.schema.json#/$defs/host/properties/health"},
        "compatibility": {"$ref": "#/$defs/compatibility"},
        "telemetry": {"$ref": "https://schemas.orbyss.io/program-kit/dotnet/9.0.0/dotnet-shell.schema.json#/$defs/host/properties/telemetry"},
        "transportFailures": {"$ref": "https://schemas.orbyss.io/program-kit/dotnet/9.0.0/dotnet-shell.schema.json#/$defs/host/properties/transportFailures"},
        "security": {"$ref": "https://schemas.orbyss.io/program-kit/dotnet/9.0.0/dotnet-shell.schema.json#/$defs/host/properties/security"},
        "azureConfiguration": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "https://schemas.orbyss.io/program-kit/dotnet/azure-key-vault-composition/1.0.0/schema.json"}
          ]
        }
      }
    },
    "package": {
      "$ref": "https://schemas.orbyss.io/program-kit/dotnet/4.0.0/dotnet-shell.schema.json#/$defs/package"
    },
    "initialValue": {
      "$ref": "https://schemas.orbyss.io/program-kit/dotnet/4.0.0/dotnet-shell.schema.json#/$defs/initialValue"
    },
    "configurationReload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "capability",
        "pollIntervalSeconds",
        "refreshRevision"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "capability": {
          "enum": [
            "none",
            "change-token",
            "provider-polling",
            "explicit-refresh"
          ]
        },
        "pollIntervalSeconds": {
          "oneOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 1}
          ]
        },
        "refreshRevision": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/reference"}
          ]
        }
      }
    },
    "configurationSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "order",
        "providerKind",
        "providerRevision",
        "package",
        "path",
        "prefix",
        "initialValues",
        "userSecretsId",
        "optional",
        "startupDisposition",
        "reload",
        "secretClassification",
        "failureDisposition"
      ],
      "properties": {
        "identity": {"$ref": "#/$defs/identifier"},
        "order": {"type": "integer", "minimum": 0},
        "providerKind": {
          "enum": [
            "json-file",
            "environment-variables",
            "command-line",
            "in-memory",
            "user-secrets",
            "key-per-file",
            "chained-configuration",
            "registered-adapter"
          ]
        },
        "providerRevision": {"$ref": "#/$defs/reference"},
        "package": {"$ref": "#/$defs/package"},
        "path": {
          "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]
        },
        "prefix": {
          "oneOf": [{"type": "null"}, {"type": "string"}]
        },
        "initialValues": {
          "type": "array",
          "items": {"$ref": "#/$defs/initialValue"}
        },
        "userSecretsId": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}
          ]
        },
        "optional": {"type": "boolean"},
        "startupDisposition": {"enum": ["required", "optional"]},
        "reload": {"$ref": "#/$defs/configurationReload"},
        "secretClassification": {
          "enum": ["public-only", "references-only", "provider-owned"]
        },
        "failureDisposition": {"enum": ["fail", "continue-without-source"]}
      }
    }
  }
}
