{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/dotnet/0.1.0-alpha.1/dotnet-shell-lock.schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:dotnet-shell-lock",
  "x-program-kit-version": "0.1.0-alpha.1",
  "title": "Program Kit .NET Shell Lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "shellRevision",
    "inputVersionMapRevision",
    "inputVersionSelectionRevision",
    "hostLocks"
  ],
  "properties": {
    "$schema": {
      "const": "pkid:schema:program-kit:dotnet-shell-lock@1.0.0"
    },
    "version": {
      "const": "0.1.0-alpha.1"
    },
    "shellRevision": {
      "$ref": "#/$defs/reference"
    },
    "inputVersionMapRevision": {
      "$ref": "#/$defs/reference"
    },
    "inputVersionSelectionRevision": {
      "$ref": "#/$defs/reference"
    },
    "hostLocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hostIdentity",
          "hostVersion",
          "kind",
          "target",
          "cShellsAbiVersion",
          "featureActivationIdentities",
          "contractRevisions",
          "schemaRevisions",
          "generatorRevisions",
          "serializationRevisions",
          "inputVersionMapRevision",
          "inputVersionSelectionRevision",
          "packages",
          "packageLockDigest"
        ],
        "properties": {
          "hostIdentity": {
            "$ref": "#/$defs/identifier"
          },
          "hostVersion": {
            "$ref": "#/$defs/version"
          },
          "kind": {
            "enum": [
              "api",
              "console",
              "worker"
            ]
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "profileRevision",
              "sdkVersion",
              "targetFramework",
              "languageVersion",
              "rollForward",
              "allowPrerelease"
            ],
            "properties": {
              "profileRevision": {
                "$ref": "#/$defs/reference"
              },
              "sdkVersion": {
                "const": "10.0.302"
              },
              "targetFramework": {
                "const": "net10.0"
              },
              "languageVersion": {
                "const": "14.0"
              },
              "rollForward": {
                "const": "disable"
              },
              "allowPrerelease": {
                "const": false
              }
            }
          },
          "cShellsAbiVersion": {
            "const": "0.0.28"
          },
          "featureActivationIdentities": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/identifier"
            }
          },
          "contractRevisions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/reference"
            }
          },
          "schemaRevisions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/reference"
            }
          },
          "generatorRevisions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/reference"
            }
          },
          "serializationRevisions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/reference"
            }
          },
          "inputVersionMapRevision": {
            "$ref": "#/$defs/reference"
          },
          "inputVersionSelectionRevision": {
            "$ref": "#/$defs/reference"
          },
          "packages": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "packageId",
                "version",
                "packageDigest"
              ],
              "properties": {
                "packageId": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "$ref": "#/$defs/version"
                },
                "packageDigest": {
                  "$ref": "#/$defs/digest"
                }
              }
            }
          },
          "packageLockDigest": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^pkid:[a-z0-9-]+:[a-z0-9-]+:[a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "version",
        "digest"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
