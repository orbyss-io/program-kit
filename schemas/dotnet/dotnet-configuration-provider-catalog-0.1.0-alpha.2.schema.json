{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/dotnet/configuration-provider-catalog/0.1.0-alpha.2/schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:dotnet-configuration-provider-catalog",
  "x-program-kit-version": "0.1.0-alpha.2",
  "title": "Program Kit .NET configuration provider catalog with provider polling",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "identity",
    "version",
    "providers"
  ],
  "properties": {
    "$schema": {
      "const": "pkid:schema:program-kit:dotnet-configuration-provider-catalog@2.0.0"
    },
    "identity": {
      "$ref": "#/$defs/identifier"
    },
    "version": {
      "const": "0.1.0-alpha.2"
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/provider"
      }
    }
  },
  "$defs": {
    "identifier": {
      "$ref": "https://schemas.orbyss.io/program-kit/dotnet/10.0.0/dotnet-shell.schema.json#/$defs/identifier"
    },
    "reference": {
      "$ref": "https://schemas.orbyss.io/program-kit/dotnet/10.0.0/dotnet-shell.schema.json#/$defs/reference"
    },
    "package": {
      "$ref": "https://schemas.orbyss.io/program-kit/dotnet/10.0.0/dotnet-shell.schema.json#/$defs/package"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerRevision",
        "kind",
        "package",
        "generatorRevision",
        "supportedReloadCapabilities",
        "reloadMechanism",
        "developmentOnly",
        "allowedSecretClassifications",
        "limitations"
      ],
      "properties": {
        "providerRevision": {
          "$ref": "#/$defs/reference"
        },
        "kind": {
          "enum": [
            "json-file",
            "environment-variables",
            "command-line",
            "in-memory",
            "user-secrets",
            "key-per-file",
            "chained-configuration",
            "registered-adapter"
          ]
        },
        "package": {
          "$ref": "#/$defs/package"
        },
        "generatorRevision": {
          "$ref": "#/$defs/reference"
        },
        "supportedReloadCapabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "none",
              "change-token",
              "provider-polling",
              "explicit-refresh"
            ]
          }
        },
        "reloadMechanism": {
          "enum": [
            "none",
            "file-provider-change-token",
            "provider-polling-change-token"
          ]
        },
        "developmentOnly": {
          "type": "boolean"
        },
        "allowedSecretClassifications": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "public-only",
              "references-only",
              "provider-owned"
            ]
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
