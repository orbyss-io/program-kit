{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/dotnet/keycloak-local-realm-import/1.0.0/schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:dotnet-keycloak-local-realm-import",
  "x-program-kit-version": "1.0.0",
  "title": "Program Kit bounded Keycloak local realm import",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "realm",
    "enabled",
    "sslRequired",
    "registrationAllowed",
    "resetPasswordAllowed",
    "rememberMe",
    "verifyEmail",
    "loginWithEmailAllowed",
    "duplicateEmailsAllowed",
    "accessTokenLifespan",
    "ssoSessionIdleTimeout",
    "ssoSessionMaxLifespan",
    "clientScopes",
    "clients",
    "users"
  ],
  "properties": {
    "realm": {
      "$ref": "#/$defs/stableName"
    },
    "enabled": {
      "const": true
    },
    "sslRequired": {
      "const": "external"
    },
    "registrationAllowed": {
      "const": false
    },
    "resetPasswordAllowed": {
      "const": false
    },
    "rememberMe": {
      "const": false
    },
    "verifyEmail": {
      "const": false
    },
    "loginWithEmailAllowed": {
      "const": false
    },
    "duplicateEmailsAllowed": {
      "const": false
    },
    "accessTokenLifespan": {
      "const": 300
    },
    "ssoSessionIdleTimeout": {
      "const": 600
    },
    "ssoSessionMaxLifespan": {
      "const": 1800
    },
    "clientScopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/apiScope"
      }
    },
    "clients": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/client"
      }
    },
    "users": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/testPrincipal"
      }
    }
  },
  "$defs": {
    "stableName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "apiScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "protocol",
        "attributes",
        "protocolMappers"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/stableName"
        },
        "protocol": {
          "const": "openid-connect"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "include.in.token.scope",
            "display.on.consent.screen"
          ],
          "properties": {
            "include.in.token.scope": {
              "const": "true"
            },
            "display.on.consent.screen": {
              "const": "false"
            }
          }
        },
        "protocolMappers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/audienceMapper"
          }
        }
      }
    },
    "audienceMapper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "protocol",
        "protocolMapper",
        "consentRequired",
        "config"
      ],
      "properties": {
        "name": {
          "const": "program-kit-api-audience"
        },
        "protocol": {
          "const": "openid-connect"
        },
        "protocolMapper": {
          "const": "oidc-audience-mapper"
        },
        "consentRequired": {
          "const": false
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "included.client.audience",
            "id.token.claim",
            "access.token.claim",
            "userinfo.token.claim"
          ],
          "properties": {
            "included.client.audience": {
              "$ref": "#/$defs/stableName"
            },
            "id.token.claim": {
              "const": "false"
            },
            "access.token.claim": {
              "const": "true"
            },
            "userinfo.token.claim": {
              "const": "false"
            }
          }
        }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clientId",
        "protocol",
        "publicClient",
        "standardFlowEnabled",
        "implicitFlowEnabled",
        "directAccessGrantsEnabled",
        "serviceAccountsEnabled"
      ],
      "oneOf": [
        {
          "required": [
            "bearerOnly"
          ],
          "properties": {
            "publicClient": {
              "const": false
            },
            "bearerOnly": {
              "const": true
            },
            "standardFlowEnabled": {
              "const": false
            },
            "serviceAccountsEnabled": {
              "const": false
            }
          }
        },
        {
          "required": [
            "defaultClientScopes",
            "attributes"
          ],
          "not": {
            "required": [
              "bearerOnly"
            ]
          }
        }
      ],
      "properties": {
        "clientId": {
          "$ref": "#/$defs/stableName"
        },
        "protocol": {
          "const": "openid-connect"
        },
        "publicClient": {
          "type": "boolean"
        },
        "bearerOnly": {
          "type": "boolean"
        },
        "clientAuthenticatorType": {
          "const": "client-secret"
        },
        "secret": {
          "type": "string",
          "pattern": "^\\$\\{PROGRAM_KIT_(CONFIDENTIAL|SERVICE|TOKEN_EXCHANGE)_CLIENT_SECRET\\}$"
        },
        "standardFlowEnabled": {
          "type": "boolean"
        },
        "implicitFlowEnabled": {
          "const": false
        },
        "directAccessGrantsEnabled": {
          "const": false
        },
        "serviceAccountsEnabled": {
          "type": "boolean"
        },
        "redirectUris": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        },
        "webOrigins": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        },
        "defaultClientScopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/stableName"
          }
        },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "access.token.header.type.rfc9068"
          ],
          "properties": {
            "pkce.code.challenge.method": {
              "const": "S256"
            },
            "access.token.header.type.rfc9068": {
              "const": "true"
            },
            "post.logout.redirect.uris": {
              "type": "string",
              "pattern": "^https://.*##$"
            },
            "standard.token.exchange.enabled": {
              "enum": [
                "true",
                "false"
              ]
            }
          }
        }
      }
    },
    "testPrincipal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "username",
        "firstName",
        "lastName",
        "email",
        "enabled",
        "emailVerified",
        "credentials"
      ],
      "properties": {
        "username": {
          "$ref": "#/$defs/stableName"
        },
        "firstName": {
          "const": "Fixture"
        },
        "lastName": {
          "const": "Principal"
        },
        "email": {
          "const": "fixture-principal@example.invalid"
        },
        "enabled": {
          "const": true
        },
        "emailVerified": {
          "const": false
        },
        "credentials": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "value",
              "temporary"
            ],
            "properties": {
              "type": {
                "const": "password"
              },
              "value": {
                "const": "${PROGRAM_KIT_TEST_PRINCIPAL_PASSWORD}"
              },
              "temporary": {
                "const": false
              }
            }
          }
        }
      }
    }
  }
}
