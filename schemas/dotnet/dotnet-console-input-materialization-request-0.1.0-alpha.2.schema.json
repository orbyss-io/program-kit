{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/dotnet/console-input-materialization-request/0.1.0-alpha.2/schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:dotnet-console-input-materialization-request",
  "x-program-kit-version": "0.1.0-alpha.2",
  "title": "Program Kit .NET Console Input Materialization Request 0.1.0-alpha.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "identity",
    "ownerIdentity",
    "outputSetIdentity",
    "hostIdentity",
    "consumerProjectPath",
    "consumerProjectIdentity",
    "consumerProjectName",
    "targetFramework",
    "configuration",
    "platform",
    "shell",
    "openConsole",
    "binding",
    "suppliedArtifacts"
  ],
  "properties": {
    "$schema": {
      "const": "pkid:schema:program-kit:dotnet-console-input-materialization-request@0.1.0-alpha.2"
    },
    "version": {
      "const": "0.1.0-alpha.2"
    },
    "identity": {
      "$ref": "#/$defs/identifier"
    },
    "ownerIdentity": {
      "$ref": "#/$defs/identifier"
    },
    "outputSetIdentity": {
      "$ref": "#/$defs/identifier"
    },
    "hostIdentity": {
      "$ref": "#/$defs/identifier"
    },
    "consumerProjectPath": {
      "$ref": "#/$defs/projectPath"
    },
    "consumerProjectIdentity": {
      "$ref": "#/$defs/identifier"
    },
    "consumerProjectName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "targetFramework": {
      "const": "net10.0"
    },
    "configuration": {
      "enum": [
        "Debug",
        "Release"
      ]
    },
    "platform": {
      "const": "AnyCPU"
    },
    "shell": {
      "$ref": "https://schemas.orbyss.io/program-kit/dotnet/11.0.0/dotnet-shell.schema.json"
    },
    "openConsole": {
      "$ref": "#/$defs/openConsoleIntent"
    },
    "binding": {
      "$ref": "#/$defs/bindingIntent"
    },
    "suppliedArtifacts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/suppliedArtifact"
      }
    }
  },
  "$defs": {
    "identifier": {
      "$ref": "https://schemas.orbyss.io/program-kit/artifacts/0.1.0-alpha.2/definitions.schema.json#/$defs/programKitIdentifier"
    },
    "reference": {
      "$ref": "https://schemas.orbyss.io/program-kit/artifacts/0.1.0-alpha.2/definitions.schema.json#/$defs/artifactReference"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[^:]+$"
    },
    "projectPath": {
      "allOf": [
        {
          "$ref": "#/$defs/relativePath"
        },
        {
          "pattern": "\\.csproj$"
        }
      ]
    },
    "openConsoleIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "documentVersion",
        "info",
        "hostRevision",
        "parsing",
        "hostExitCodeRoles",
        "globalOptions",
        "commands",
        "help",
        "completion",
        "compatibility",
        "generatorRevision",
        "operationRevisions"
      ],
      "properties": {
        "$schema": {
          "const": "pkid:schema:program-kit:open-console@0.1.0-alpha.2"
        },
        "documentVersion": {
          "const": "0.1.0-alpha.2"
        },
        "info": {
          "$ref": "https://schemas.orbyss.io/program-kit/open-console/0.1.0-alpha.2/schema.json#/$defs/info"
        },
        "hostRevision": {
          "$ref": "#/$defs/reference"
        },
        "parsing": {
          "$ref": "https://schemas.orbyss.io/program-kit/open-console/0.1.0-alpha.2/schema.json#/$defs/parsing"
        },
        "hostExitCodeRoles": {
          "$ref": "https://schemas.orbyss.io/program-kit/open-console/0.1.0-alpha.2/schema.json#/$defs/hostExitCodeRoles"
        },
        "globalOptions": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.orbyss.io/program-kit/open-console/0.1.0-alpha.2/schema.json#/$defs/option"
          }
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://schemas.orbyss.io/program-kit/open-console/0.1.0-alpha.2/schema.json#/$defs/command"
          }
        },
        "help": {
          "$ref": "https://schemas.orbyss.io/program-kit/open-console/0.1.0-alpha.2/schema.json#/$defs/help"
        },
        "completion": {
          "$ref": "https://schemas.orbyss.io/program-kit/open-console/0.1.0-alpha.2/schema.json#/$defs/completion"
        },
        "compatibility": {
          "$ref": "https://schemas.orbyss.io/program-kit/open-console/0.1.0-alpha.2/schema.json#/$defs/compatibility"
        },
        "generatorRevision": {
          "$ref": "#/$defs/reference"
        },
        "operationRevisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      }
    },
    "bindingIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "version",
        "featureType",
        "validationResultType",
        "operations"
      ],
      "properties": {
        "$schema": {
          "const": "pkid:schema:program-kit:dotnet-console-binding@1.0.0"
        },
        "version": {
          "const": "1.0.0"
        },
        "featureType": {
          "$ref": "https://schemas.orbyss.io/program-kit/dotnet/console-binding/1.0.0/schema.json#/$defs/clrType"
        },
        "validationResultType": {
          "$ref": "https://schemas.orbyss.io/program-kit/dotnet/console-binding/1.0.0/schema.json#/$defs/clrType"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/operationBinding"
          }
        }
      }
    },
    "operationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationRevision",
        "generatedSymbol",
        "requestType",
        "handlerType",
        "validatorType",
        "constructorParameters"
      ],
      "properties": {
        "operationRevision": {
          "$ref": "#/$defs/reference"
        },
        "generatedSymbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "requestType": {
          "$ref": "https://schemas.orbyss.io/program-kit/dotnet/console-binding/1.0.0/schema.json#/$defs/clrType"
        },
        "handlerType": {
          "$ref": "https://schemas.orbyss.io/program-kit/dotnet/console-binding/1.0.0/schema.json#/$defs/clrType"
        },
        "validatorType": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://schemas.orbyss.io/program-kit/dotnet/console-binding/1.0.0/schema.json#/$defs/clrType"
            }
          ]
        },
        "constructorParameters": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.orbyss.io/program-kit/dotnet/console-binding/1.0.0/schema.json#/$defs/constructorParameter"
          }
        }
      }
    },
    "suppliedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "workspaceRelativePath",
        "outputRelativePath"
      ],
      "properties": {
        "revision": {
          "$ref": "#/$defs/reference"
        },
        "workspaceRelativePath": {
          "$ref": "#/$defs/relativePath"
        },
        "outputRelativePath": {
          "$ref": "#/$defs/relativePath"
        }
      }
    }
  }
}
