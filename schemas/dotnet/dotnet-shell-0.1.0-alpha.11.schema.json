{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/dotnet/0.1.0-alpha.11/dotnet-shell.schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:dotnet-shell",
  "x-program-kit-version": "0.1.0-alpha.11",
  "title": "Program Kit .NET Shell with optional FastEndpoints projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "inputVersionMapRevision",
    "inputVersionSelectionRevision",
    "composition",
    "features",
    "jsonSerialization",
    "hosts",
    "compatibility"
  ],
  "properties": {
    "$schema": {
      "const": "pkid:schema:program-kit:dotnet-shell@11.0.0"
    },
    "version": {
      "const": "0.1.0-alpha.11"
    },
    "inputVersionMapRevision": {
      "$ref": "#/$defs/reference"
    },
    "inputVersionSelectionRevision": {
      "$ref": "#/$defs/reference"
    },
    "composition": {
      "$ref": "https://schemas.orbyss.io/program-kit/dotnet/10.0.0/dotnet-shell.schema.json#/properties/composition"
    },
    "features": {
      "$ref": "https://schemas.orbyss.io/program-kit/dotnet/10.0.0/dotnet-shell.schema.json#/properties/features"
    },
    "jsonSerialization": {
      "$ref": "https://schemas.orbyss.io/program-kit/dotnet/10.0.0/dotnet-shell.schema.json#/properties/jsonSerialization"
    },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/host"
      }
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    }
  },
  "$defs": {
    "identifier": {
      "$ref": "https://schemas.orbyss.io/program-kit/dotnet/10.0.0/dotnet-shell.schema.json#/$defs/identifier"
    },
    "reference": {
      "$ref": "https://schemas.orbyss.io/program-kit/dotnet/10.0.0/dotnet-shell.schema.json#/$defs/reference"
    },
    "package": {
      "$ref": "https://schemas.orbyss.io/program-kit/dotnet/10.0.0/dotnet-shell.schema.json#/$defs/package"
    },
    "compatibility": {
      "$ref": "https://schemas.orbyss.io/program-kit/dotnet/10.0.0/dotnet-shell.schema.json#/$defs/compatibility"
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "version",
        "kind",
        "dotNetTargetProfileRevision",
        "generatorProfileRevision",
        "shellIdentities",
        "featureActivationIdentities",
        "hostPackages",
        "operationBindings",
        "configurationSources",
        "configurationBindings",
        "taskRuntimeRequirements",
        "health",
        "compatibility",
        "telemetry",
        "transportFailures",
        "security",
        "azureConfiguration",
        "fastEndpoints"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "https://schemas.orbyss.io/program-kit/dotnet/10.0.0/dotnet-shell.schema.json#/$defs/host/properties/version"
        },
        "kind": {
          "$ref": "https://schemas.orbyss.io/program-kit/dotnet/10.0.0/dotnet-shell.schema.json#/$defs/host/properties/kind"
        },
        "dotNetTargetProfileRevision": {
          "$ref": "#/$defs/reference"
        },
        "generatorProfileRevision": {
          "$ref": "#/$defs/reference"
        },
        "shellIdentities": {
          "$ref": "https://schemas.orbyss.io/program-kit/dotnet/10.0.0/dotnet-shell.schema.json#/$defs/host/properties/shellIdentities"
        },
        "featureActivationIdentities": {
          "$ref": "https://schemas.orbyss.io/program-kit/dotnet/10.0.0/dotnet-shell.schema.json#/$defs/host/properties/featureActivationIdentities"
        },
        "hostPackages": {
          "$ref": "https://schemas.orbyss.io/program-kit/dotnet/10.0.0/dotnet-shell.schema.json#/$defs/host/properties/hostPackages"
        },
        "operationBindings": {
          "$ref": "https://schemas.orbyss.io/program-kit/dotnet/10.0.0/dotnet-shell.schema.json#/$defs/host/properties/operationBindings"
        },
        "configurationSources": {
          "$ref": "https://schemas.orbyss.io/program-kit/dotnet/10.0.0/dotnet-shell.schema.json#/$defs/host/properties/configurationSources"
        },
        "configurationBindings": {
          "$ref": "https://schemas.orbyss.io/program-kit/dotnet/10.0.0/dotnet-shell.schema.json#/$defs/host/properties/configurationBindings"
        },
        "taskRuntimeRequirements": {
          "$ref": "https://schemas.orbyss.io/program-kit/dotnet/10.0.0/dotnet-shell.schema.json#/$defs/host/properties/taskRuntimeRequirements"
        },
        "health": {
          "$ref": "https://schemas.orbyss.io/program-kit/dotnet/10.0.0/dotnet-shell.schema.json#/$defs/host/properties/health"
        },
        "compatibility": {
          "$ref": "#/$defs/compatibility"
        },
        "telemetry": {
          "$ref": "https://schemas.orbyss.io/program-kit/dotnet/10.0.0/dotnet-shell.schema.json#/$defs/host/properties/telemetry"
        },
        "transportFailures": {
          "$ref": "https://schemas.orbyss.io/program-kit/dotnet/10.0.0/dotnet-shell.schema.json#/$defs/host/properties/transportFailures"
        },
        "security": {
          "$ref": "https://schemas.orbyss.io/program-kit/dotnet/10.0.0/dotnet-shell.schema.json#/$defs/host/properties/security"
        },
        "azureConfiguration": {
          "$ref": "https://schemas.orbyss.io/program-kit/dotnet/10.0.0/dotnet-shell.schema.json#/$defs/host/properties/azureConfiguration"
        },
        "fastEndpoints": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/fastEndpointsConfiguration"
            }
          ]
        }
      }
    },
    "fastEndpointsConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileRevision",
        "shellAdapterPackage",
        "fastEndpointsPackage"
      ],
      "properties": {
        "profileRevision": {
          "$ref": "#/$defs/reference"
        },
        "shellAdapterPackage": {
          "$ref": "#/$defs/package"
        },
        "fastEndpointsPackage": {
          "$ref": "#/$defs/package"
        }
      }
    }
  }
}
