{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/dotnet/configuration-provider-catalog/1.0.0/schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:dotnet-configuration-provider-catalog",
  "x-program-kit-version": "1.0.0",
  "title": "Program Kit .NET configuration provider catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "identity", "version", "providers"],
  "properties": {
    "$schema": {
      "const": "pkid:schema:program-kit:dotnet-configuration-provider-catalog@1.0.0"
    },
    "identity": {"$ref": "#/$defs/identifier"},
    "version": {"const": "1.0.0"},
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/provider"}
    }
  },
  "$defs": {
    "identifier": {
      "$ref": "https://schemas.orbyss.io/program-kit/dotnet/3.0.0/dotnet-shell.schema.json#/$defs/identifier"
    },
    "reference": {
      "$ref": "https://schemas.orbyss.io/program-kit/dotnet/3.0.0/dotnet-shell.schema.json#/$defs/reference"
    },
    "package": {
      "$ref": "https://schemas.orbyss.io/program-kit/dotnet/3.0.0/dotnet-shell.schema.json#/$defs/package"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerRevision",
        "kind",
        "package",
        "generatorRevision",
        "supportedReloadCapabilities",
        "reloadMechanism",
        "developmentOnly",
        "allowedSecretClassifications",
        "limitations"
      ],
      "properties": {
        "providerRevision": {"$ref": "#/$defs/reference"},
        "kind": {
          "enum": [
            "json-file",
            "environment-variables",
            "command-line",
            "in-memory",
            "user-secrets",
            "key-per-file",
            "chained-configuration",
            "registered-adapter"
          ]
        },
        "package": {"$ref": "#/$defs/package"},
        "generatorRevision": {"$ref": "#/$defs/reference"},
        "supportedReloadCapabilities": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["none", "change-token", "explicit-refresh"]}
        },
        "reloadMechanism": {
          "enum": ["none", "file-provider-change-token"]
        },
        "developmentOnly": {"type": "boolean"},
        "allowedSecretClassifications": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["public-only", "references-only", "provider-owned"]
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
