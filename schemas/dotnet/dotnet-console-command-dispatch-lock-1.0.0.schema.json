{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/dotnet/console-command-dispatch-lock/1.0.0/schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:dotnet-console-command-dispatch-lock",
  "x-program-kit-version": "1.0.0",
  "title": "Program Kit .NET Console Command Dispatch Lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "hostRevision",
    "shellRevision",
    "openConsoleDocumentRevision",
    "hostGeneratorRevision",
    "dispatcherContractRevision"
  ],
  "properties": {
    "$schema": {
      "const": "pkid:schema:program-kit:dotnet-console-command-dispatch-lock@1.0.0"
    },
    "version": {"const": "1.0.0"},
    "hostRevision": {"$ref": "#/$defs/reference"},
    "shellRevision": {"$ref": "#/$defs/reference"},
    "openConsoleDocumentRevision": {"$ref": "#/$defs/reference"},
    "hostGeneratorRevision": {"$ref": "#/$defs/reference"},
    "dispatcherContractRevision": {"$ref": "#/$defs/reference"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^pkid:[a-z0-9-]+:[a-z0-9-]+:[a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "version", "digest"],
      "properties": {
        "identity": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/version"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
