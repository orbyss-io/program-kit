{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/quality/0.1.0-alpha.1/definitions.schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:quality-definitions",
  "x-program-kit-version": "0.1.0-alpha.1",
  "$defs": {
    "pkid": {
      "$ref": "https://schemas.orbyss.io/program-kit/artifacts/0.1.0-alpha.1/definitions.schema.json#/$defs/programKitIdentifier"
    },
    "semver": {
      "$ref": "https://schemas.orbyss.io/program-kit/artifacts/0.1.0-alpha.1/definitions.schema.json#/$defs/semanticVersion"
    },
    "sha256": {
      "$ref": "https://schemas.orbyss.io/program-kit/artifacts/0.1.0-alpha.1/definitions.schema.json#/$defs/sha256Digest"
    },
    "duration": {
      "type": "string",
      "pattern": "^P(?!$)(?:[0-9]+D)?(?:T(?=[0-9])(?:[0-9]+H)?(?:[0-9]+M)?(?:[0-9]+(?:\\.[0-9]+)?S)?)?$"
    },
    "artifactReference": {
      "$ref": "https://schemas.orbyss.io/program-kit/artifacts/0.1.0-alpha.1/definitions.schema.json#/$defs/artifactReference"
    },
    "profileReference": {
      "$ref": "https://schemas.orbyss.io/program-kit/artifacts/0.1.0-alpha.1/definitions.schema.json#/$defs/profileReference"
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "referenceSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifactReference"
      }
    },
    "testExecutionAccessPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "allowedNetworkDestinations",
        "writes",
        "allowedWriteRoots",
        "restore",
        "secrets",
        "allowedSecretReferences"
      ],
      "properties": {
        "network": {
          "enum": [
            "denied",
            "loopback-only",
            "explicit-allow-list"
          ]
        },
        "allowedNetworkDestinations": {
          "$ref": "#/$defs/stringSet"
        },
        "writes": {
          "enum": [
            "denied",
            "temporary-output-only",
            "explicit-roots"
          ]
        },
        "allowedWriteRoots": {
          "$ref": "#/$defs/stringSet"
        },
        "restore": {
          "enum": [
            "denied",
            "locked-only"
          ]
        },
        "secrets": {
          "enum": [
            "denied",
            "explicit-references-only"
          ]
        },
        "allowedSecretReferences": {
          "$ref": "#/$defs/stringSet"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "network": {
                "const": "explicit-allow-list"
              }
            },
            "required": [
              "network"
            ]
          },
          "then": {
            "properties": {
              "allowedNetworkDestinations": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "allowedNetworkDestinations": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "writes": {
                "const": "explicit-roots"
              }
            },
            "required": [
              "writes"
            ]
          },
          "then": {
            "properties": {
              "allowedWriteRoots": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "allowedWriteRoots": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "secrets": {
                "const": "explicit-references-only"
              }
            },
            "required": [
              "secrets"
            ]
          },
          "then": {
            "properties": {
              "allowedSecretReferences": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "allowedSecretReferences": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "testRetryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumAttempts",
        "delay"
      ],
      "properties": {
        "maximumAttempts": {
          "type": "integer",
          "minimum": 1
        },
        "delay": {
          "$ref": "#/$defs/duration"
        }
      }
    },
    "testExecutionRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runnerClasses",
        "platforms",
        "environmentAssumptions",
        "requiredDependencyClosure",
        "access",
        "timeout",
        "retry"
      ],
      "properties": {
        "runnerClasses": {
          "allOf": [
            {
              "$ref": "#/$defs/stringSet"
            },
            {
              "minItems": 1
            }
          ]
        },
        "platforms": {
          "allOf": [
            {
              "$ref": "#/$defs/stringSet"
            },
            {
              "minItems": 1
            }
          ]
        },
        "environmentAssumptions": {
          "$ref": "#/$defs/stringSet"
        },
        "requiredDependencyClosure": {
          "$ref": "#/$defs/referenceSet"
        },
        "access": {
          "$ref": "#/$defs/testExecutionAccessPolicy"
        },
        "timeout": {
          "$ref": "#/$defs/duration"
        },
        "retry": {
          "$ref": "#/$defs/testRetryPolicy"
        }
      }
    },
    "testScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioId",
        "kind",
        "purpose",
        "inputs",
        "fixtures",
        "expectedResult"
      ],
      "properties": {
        "scenarioId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "positive",
            "negative",
            "failure",
            "recovery",
            "cancellation",
            "concurrency",
            "migration"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "$ref": "#/$defs/referenceSet"
        },
        "fixtures": {
          "$ref": "#/$defs/referenceSet"
        },
        "expectedResult": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "testSpecification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownerId",
        "purpose",
        "requirementIds",
        "categories",
        "scenarios",
        "executionRequirements",
        "expectedResult",
        "evidenceShape"
      ],
      "properties": {
        "ownerId": {
          "$ref": "#/$defs/pkid"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "requirementIds": {
          "allOf": [
            {
              "$ref": "#/$defs/stringSet"
            },
            {
              "minItems": 1
            }
          ]
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "unit",
              "component",
              "contract-conformance",
              "registration-composition",
              "integration",
              "end-to-end",
              "regression",
              "architecture",
              "security",
              "performance",
              "reproducibility",
              "compatibility",
              "human-validation"
            ]
          }
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/testScenario"
          }
        },
        "executionRequirements": {
          "$ref": "#/$defs/testExecutionRequirements"
        },
        "expectedResult": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcomeCode",
            "description"
          ],
          "properties": {
            "outcomeCode": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "evidenceShape": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "requiredObservations",
            "allowsAttachments"
          ],
          "properties": {
            "schema": {
              "$ref": "#/$defs/artifactReference"
            },
            "requiredObservations": {
              "allOf": [
                {
                  "$ref": "#/$defs/stringSet"
                },
                {
                  "minItems": 1
                }
              ]
            },
            "allowsAttachments": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "executionProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runnerClass",
        "platform",
        "environmentAssumptions",
        "dependencyClosure",
        "access",
        "timeout",
        "retry"
      ],
      "properties": {
        "runnerClass": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "environmentAssumptions": {
          "$ref": "#/$defs/stringSet"
        },
        "dependencyClosure": {
          "$ref": "#/$defs/referenceSet"
        },
        "access": {
          "$ref": "#/$defs/testExecutionAccessPolicy"
        },
        "timeout": {
          "$ref": "#/$defs/duration"
        },
        "retry": {
          "$ref": "#/$defs/testRetryPolicy"
        }
      }
    },
    "testSpecificationSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specification",
        "profile"
      ],
      "properties": {
        "specification": {
          "$ref": "#/$defs/artifactReference"
        },
        "profile": {
          "$ref": "#/$defs/profileReference"
        }
      }
    },
    "testEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specification",
        "profile",
        "subject",
        "outcome",
        "observations",
        "producerId",
        "observedAt",
        "correlationId"
      ],
      "properties": {
        "specification": {
          "$ref": "#/$defs/artifactReference"
        },
        "profile": {
          "$ref": "#/$defs/profileReference"
        },
        "subject": {
          "$ref": "#/$defs/artifactReference"
        },
        "outcome": {
          "enum": [
            "passed",
            "failed",
            "inconclusive"
          ]
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value",
              "attachment"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "attachment": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/artifactReference"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "producerId": {
          "$ref": "#/$defs/pkid"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "correlationId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "independentReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "producerId",
        "reviewerId",
        "disposition",
        "evidence",
        "summary",
        "reviewedAt"
      ],
      "properties": {
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "artifact",
            "baseArtifact"
          ],
          "properties": {
            "kind": {
              "enum": [
                "artifact",
                "delta"
              ]
            },
            "artifact": {
              "$ref": "#/$defs/artifactReference"
            },
            "baseArtifact": {
              "oneOf": [
                {
                  "$ref": "#/$defs/artifactReference"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "delta"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "properties": {
                  "baseArtifact": {
                    "$ref": "#/$defs/artifactReference"
                  }
                }
              },
              "else": {
                "properties": {
                  "baseArtifact": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        "producerId": {
          "$ref": "#/$defs/pkid"
        },
        "reviewerId": {
          "allOf": [
            {
              "$ref": "#/$defs/pkid"
            }
          ]
        },
        "disposition": {
          "enum": [
            "confirmed",
            "concern-raised",
            "unable-to-conclude"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/referenceSet"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
