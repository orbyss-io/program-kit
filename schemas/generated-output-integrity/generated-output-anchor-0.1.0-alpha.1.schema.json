{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/generated-output-integrity/anchor/0.1.0-alpha.1/schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:generated-output-anchor",
  "x-program-kit-version": "0.1.0-alpha.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "formatVersion",
    "manifestPath",
    "manifestSha256"
  ],
  "properties": {
    "$schema": {
      "const": "pkid:schema:program-kit:generated-output-anchor@1.0.0"
    },
    "formatVersion": {
      "const": "1.0.0"
    },
    "manifestPath": {
      "const": ".program-kit/generated-output.manifest.json"
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
