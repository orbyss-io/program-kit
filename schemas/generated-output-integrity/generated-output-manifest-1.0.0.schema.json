{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/generated-output-integrity/manifest/1.0.0/schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:generated-output-manifest",
  "x-program-kit-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "formatVersion",
    "ownership",
    "files"
  ],
  "properties": {
    "$schema": {
      "const": "pkid:schema:program-kit:generated-output-manifest@1.0.0"
    },
    "formatVersion": {
      "const": "1.0.0"
    },
    "ownership": {
      "const": "program-kit-generated-host"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "length"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "length": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
