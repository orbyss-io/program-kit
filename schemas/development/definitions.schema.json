{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/development/1.0.0/definitions.schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:development-definitions",
  "x-program-kit-version": "1.0.0",
  "$defs": {
    "pkid": {
      "$ref": "https://schemas.orbyss.io/program-kit/artifacts/1.0.0/definitions.schema.json#/$defs/programKitIdentifier"
    },
    "sha256": {
      "$ref": "https://schemas.orbyss.io/program-kit/artifacts/1.0.0/definitions.schema.json#/$defs/sha256Digest"
    },
    "artifactReference": {
      "$ref": "https://schemas.orbyss.io/program-kit/artifacts/1.0.0/definitions.schema.json#/$defs/artifactReference"
    },
    "referenceSet": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifactReference" }
    },
    "capabilityAvailability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilityId", "status"],
      "properties": {
        "capabilityId": { "$ref": "#/$defs/pkid" },
        "status": {
          "enum": ["available", "unavailable"]
        }
      }
    },
    "capabilityAvailabilitySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourcePath",
        "sourceDigest",
        "capabilities",
        "supplierId",
        "suppliedAt"
      ],
      "properties": {
        "sourcePath": {
          "const": ".agent-capabilities/capabilities/INDEX.md"
        },
        "sourceDigest": { "$ref": "#/$defs/sha256" },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/capabilityAvailability" }
        },
        "supplierId": { "$ref": "#/$defs/pkid" },
        "suppliedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "routingOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "nextCapabilities", "reason"],
      "properties": {
        "kind": {
          "enum": ["routed", "human-decision-required", "flow-unavailable"]
        },
        "nextCapabilities": {
          "allOf": [
            { "$ref": "#/$defs/referenceSet" },
            { "maxItems": 1 }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["human-decision-required", "flow-unavailable"]
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "nextCapabilities": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "routingResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestOrIntent", "availabilitySnapshot", "outcome"],
      "properties": {
        "requestOrIntent": { "$ref": "#/$defs/artifactReference" },
        "availabilitySnapshot": { "$ref": "#/$defs/artifactReference" },
        "outcome": { "$ref": "#/$defs/routingOutcome" }
      }
    },
    "developmentResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "summary", "producedArtifacts", "routing"],
      "properties": {
        "kind": {
          "enum": ["completed", "refused", "failed"]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "producedArtifacts": { "$ref": "#/$defs/referenceSet" },
        "routing": {
          "oneOf": [
            { "$ref": "#/$defs/routingOutcome" },
            { "type": "null" }
          ]
        }
      }
    },
    "developmentReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "requestOrIntent",
        "consumedArtifacts",
        "result",
        "producerId",
        "principal",
        "correlationId",
        "suppliedAt"
      ],
      "properties": {
        "capability": { "$ref": "#/$defs/artifactReference" },
        "requestOrIntent": { "$ref": "#/$defs/artifactReference" },
        "consumedArtifacts": { "$ref": "#/$defs/referenceSet" },
        "result": { "$ref": "#/$defs/developmentResult" },
        "producerId": { "$ref": "#/$defs/pkid" },
        "principal": {
          "$ref": "https://schemas.orbyss.io/program-kit/planning/1.0.0/definitions.schema.json#/$defs/principalReference"
        },
        "correlationId": {
          "type": "string",
          "minLength": 1
        },
        "suppliedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
