{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/planning/0.1.0-alpha.4/definitions.schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:planning-definitions",
  "x-program-kit-version": "0.1.0-alpha.4",
  "$defs": {
    "pkid": {
      "$ref": "https://schemas.orbyss.io/program-kit/artifacts/0.1.0-alpha.2/definitions.schema.json#/$defs/programKitIdentifier"
    },
    "semverRange": {
      "$ref": "https://schemas.orbyss.io/program-kit/artifacts/0.1.0-alpha.2/definitions.schema.json#/$defs/semanticVersionRange"
    },
    "sha256": {
      "$ref": "https://schemas.orbyss.io/program-kit/artifacts/0.1.0-alpha.2/definitions.schema.json#/$defs/sha256Digest"
    },
    "artifactReference": {
      "$ref": "https://schemas.orbyss.io/program-kit/artifacts/0.1.0-alpha.2/definitions.schema.json#/$defs/artifactReference"
    },
    "profileReference": {
      "$ref": "https://schemas.orbyss.io/program-kit/artifacts/0.1.0-alpha.2/definitions.schema.json#/$defs/profileReference"
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "referenceSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifactReference"
      }
    },
    "testSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specification",
        "profile"
      ],
      "properties": {
        "specification": {
          "$ref": "#/$defs/artifactReference"
        },
        "profile": {
          "$ref": "#/$defs/profileReference"
        }
      }
    },
    "planDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "purpose"
      ],
      "properties": {
        "artifact": {
          "$ref": "#/$defs/artifactReference"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "compatibilityRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjectId",
        "acceptedVersions",
        "expectedDisposition"
      ],
      "properties": {
        "subjectId": {
          "$ref": "#/$defs/pkid"
        },
        "acceptedVersions": {
          "$ref": "#/$defs/semverRange"
        },
        "expectedDisposition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verificationCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "arguments",
        "workingDirectory",
        "expectedObservation"
      ],
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "workingDirectory": {
          "type": "string",
          "minLength": 1
        },
        "expectedObservation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "planWorkUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workUnitId",
        "requiredOutcome",
        "sequence",
        "parallelGroupId",
        "dependsOn",
        "inputs",
        "outputs",
        "allowedEdits",
        "sourceDependencies",
        "externalDependencies",
        "migrations",
        "compatibility",
        "stopConditions",
        "verification",
        "selectedTests",
        "workUnitKind",
        "activationMatrix",
        "verificationProfile"
      ],
      "properties": {
        "workUnitId": {
          "type": "string",
          "minLength": 1
        },
        "requiredOutcome": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "parallelGroupId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "dependsOn": {
          "$ref": "#/$defs/stringSet"
        },
        "inputs": {
          "$ref": "#/$defs/referenceSet"
        },
        "outputs": {
          "$ref": "#/$defs/plannedArtifactSet"
        },
        "allowedEdits": {
          "allOf": [
            {
              "$ref": "#/$defs/stringSet"
            },
            {
              "minItems": 1
            }
          ]
        },
        "sourceDependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/planDependency"
          }
        },
        "externalDependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/planDependency"
          }
        },
        "migrations": {
          "$ref": "#/$defs/referenceSet"
        },
        "compatibility": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/compatibilityRequirement"
          }
        },
        "stopConditions": {
          "allOf": [
            {
              "$ref": "#/$defs/stringSet"
            },
            {
              "minItems": 1
            }
          ]
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/verificationCommand"
          }
        },
        "selectedTests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/testSelection"
          }
        },
        "workUnitKind": {
          "enum": [
            "gate-establishment",
            "product",
            "closure"
          ]
        },
        "activationMatrix": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifactReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "verificationProfile": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifactReference"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "parallelGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parallelGroupId",
        "workUnitIds"
      ],
      "properties": {
        "parallelGroupId": {
          "type": "string",
          "minLength": 1
        },
        "workUnitIds": {
          "allOf": [
            {
              "$ref": "#/$defs/stringSet"
            },
            {
              "minItems": 1
            }
          ]
        }
      }
    },
    "unresolvedDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionId",
        "question",
        "blocksImplementation"
      ],
      "properties": {
        "decisionId": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "blocksImplementation": {
          "type": "boolean"
        }
      }
    },
    "requirementTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirementId",
        "ownerId",
        "contractOrArtifact",
        "workUnitIds",
        "implementationOutcome",
        "dependencyOrExtensionImpact",
        "tests",
        "evidence",
        "observableAcceptanceOutcome"
      ],
      "properties": {
        "requirementId": {
          "type": "string",
          "minLength": 1
        },
        "ownerId": {
          "$ref": "#/$defs/pkid"
        },
        "contractOrArtifact": {
          "$ref": "#/$defs/artifactReference"
        },
        "workUnitIds": {
          "allOf": [
            {
              "$ref": "#/$defs/stringSet"
            },
            {
              "minItems": 1
            }
          ]
        },
        "implementationOutcome": {
          "type": "string",
          "minLength": 1
        },
        "dependencyOrExtensionImpact": {
          "$ref": "#/$defs/referenceSet"
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/testSelection"
          }
        },
        "evidence": {
          "$ref": "#/$defs/referenceSet"
        },
        "observableAcceptanceOutcome": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "implementationPlanDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "design",
        "ownerId",
        "state",
        "requirementIds",
        "workUnits",
        "parallelGroups",
        "trace",
        "unresolvedDecisions",
        "staticConformanceDisposition",
        "staticConformanceState",
        "gateDesign",
        "gateDefinition",
        "selectionLock",
        "activationEvidence"
      ],
      "properties": {
        "$schema": {
          "const": "https://schemas.orbyss.io/program-kit/planning/implementation-plan/0.1.0-alpha.4/schema.json"
        },
        "design": {
          "$ref": "#/$defs/artifactReference"
        },
        "ownerId": {
          "$ref": "#/$defs/pkid"
        },
        "state": {
          "enum": [
            "draft",
            "ready-for-human-decision",
            "superseded"
          ]
        },
        "requirementIds": {
          "allOf": [
            {
              "$ref": "#/$defs/stringSet"
            },
            {
              "minItems": 1
            }
          ]
        },
        "workUnits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/planWorkUnit"
          }
        },
        "parallelGroups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parallelGroup"
          }
        },
        "trace": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/requirementTrace"
          }
        },
        "unresolvedDecisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unresolvedDecision"
          }
        },
        "staticConformanceDisposition": {
          "$ref": "#/$defs/artifactReference"
        },
        "staticConformanceState": {
          "enum": [
            "reuse-existing",
            "extend-existing",
            "create-new",
            "accepted-empty",
            "blocked-unavailable"
          ]
        },
        "gateDesign": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifactReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "gateDefinition": {
          "oneOf": [
            {
              "$ref": "#/$defs/plannedArtifactReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "selectionLock": {
          "oneOf": [
            {
              "$ref": "#/$defs/plannedArtifactReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "activationEvidence": {
          "oneOf": [
            {
              "$ref": "#/$defs/plannedArtifactReference"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "principalReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "provider",
        "identifier",
        "role"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "authorityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source",
        "jsonPointer",
        "ownerId"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/artifactReference"
        },
        "jsonPointer": {
          "type": "string",
          "pattern": "^/"
        },
        "ownerId": {
          "$ref": "#/$defs/pkid"
        }
      }
    },
    "decisionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "provider",
        "referenceId",
        "digest"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "referenceId": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "approvalCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conditionId",
        "description",
        "state",
        "resolutionEvidence"
      ],
      "properties": {
        "conditionId": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "open",
            "satisfied",
            "waived"
          ]
        },
        "resolutionEvidence": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifactReference"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "open"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "resolutionEvidence": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "resolutionEvidence": {
                "$ref": "#/$defs/artifactReference"
              }
            }
          }
        }
      ]
    },
    "approvalSupersession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "supersededBy"
      ],
      "properties": {
        "state": {
          "enum": [
            "active",
            "superseded"
          ]
        },
        "supersededBy": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifactReference"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "active"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "supersededBy": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "supersededBy": {
                "$ref": "#/$defs/artifactReference"
              }
            }
          }
        }
      ]
    },
    "designPlanApprovalRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design",
        "plan",
        "acceptedScope",
        "approvingPrincipal",
        "authority",
        "decisionEvidence",
        "correlationId",
        "decisionTime",
        "decision",
        "conditions",
        "supersession"
      ],
      "properties": {
        "design": {
          "$ref": "#/$defs/artifactReference"
        },
        "plan": {
          "$ref": "#/$defs/artifactReference"
        },
        "acceptedScope": {
          "type": "string",
          "minLength": 1
        },
        "approvingPrincipal": {
          "$ref": "#/$defs/principalReference"
        },
        "authority": {
          "$ref": "#/$defs/authorityReference"
        },
        "decisionEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/decisionEvidence"
          }
        },
        "correlationId": {
          "type": "string",
          "minLength": 1
        },
        "decisionTime": {
          "type": "string",
          "format": "date-time"
        },
        "decision": {
          "enum": [
            "approved",
            "rejected",
            "changes-required"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/approvalCondition"
          }
        },
        "supersession": {
          "$ref": "#/$defs/approvalSupersession"
        }
      }
    },
    "plannedArtifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "version",
        "state",
        "integrityDigest"
      ],
      "properties": {
        "identity": {
          "$ref": "https://schemas.orbyss.io/program-kit/artifacts/0.1.0-alpha.2/definitions.schema.json#/$defs/programKitIdentifier"
        },
        "version": {
          "$ref": "https://schemas.orbyss.io/program-kit/artifacts/0.1.0-alpha.2/definitions.schema.json#/$defs/semanticVersion"
        },
        "state": {
          "enum": [
            "prospective",
            "materialized"
          ]
        },
        "integrityDigest": {
          "oneOf": [
            {
              "$ref": "https://schemas.orbyss.io/program-kit/artifacts/0.1.0-alpha.2/definitions.schema.json#/$defs/sha256Digest"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "prospective"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "integrityDigest": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "integrityDigest": {
                "$ref": "https://schemas.orbyss.io/program-kit/artifacts/0.1.0-alpha.2/definitions.schema.json#/$defs/sha256Digest"
              }
            }
          }
        }
      ]
    },
    "plannedArtifactSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/plannedArtifactReference"
      }
    }
  }
}
