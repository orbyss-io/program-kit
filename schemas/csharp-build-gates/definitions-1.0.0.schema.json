{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/csharp-build-gates/1.0.0/definitions.schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:csharp-build-gate-definitions",
  "x-program-kit-version": "1.0.0",
  "$defs": {
    "pkid": {
      "$ref": "https://schemas.orbyss.io/program-kit/artifacts/1.0.0/definitions.schema.json#/$defs/programKitIdentifier"
    },
    "version": {
      "$ref": "https://schemas.orbyss.io/program-kit/artifacts/1.0.0/definitions.schema.json#/$defs/semanticVersion"
    },
    "versionRange": {
      "$ref": "https://schemas.orbyss.io/program-kit/artifacts/1.0.0/definitions.schema.json#/$defs/semanticVersionRange"
    },
    "digest": {
      "$ref": "https://schemas.orbyss.io/program-kit/artifacts/1.0.0/definitions.schema.json#/$defs/sha256Digest"
    },
    "reference": {
      "$ref": "https://schemas.orbyss.io/program-kit/artifacts/1.0.0/definitions.schema.json#/$defs/artifactReference"
    },
    "referenceArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "pkidArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/pkid"
      }
    },
    "contentItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryRelativePath", "digest"],
      "properties": {
        "repositoryRelativePath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*[\\\\*?\\[\\]]).+$"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "semanticOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "kind", "governingContract", "diagnosticPrefix"],
      "properties": {
        "identity": {
          "$ref": "#/$defs/pkid"
        },
        "kind": {
          "enum": ["compiler-baseline", "program-kit-public-contract", "consumer-owned"]
        },
        "governingContract": {
          "$ref": "#/$defs/reference"
        },
        "diagnosticPrefix": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+$"
        }
      }
    },
    "artifactSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "repositoryRelativeProjectPath",
        "package",
        "assemblyFileName",
        "assemblyDigest",
        "isPackable",
        "hasRuntimeAssets",
        "hasBuildTransitiveAssets"
      ],
      "properties": {
        "kind": {
          "enum": ["local-non-packable-project", "analyzer-package"]
        },
        "repositoryRelativeProjectPath": {
          "type": ["string", "null"]
        },
        "package": {
          "oneOf": [
            {
              "$ref": "#/$defs/reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "assemblyFileName": {
          "type": "string",
          "pattern": "^[^/\\\\]+\\.dll$"
        },
        "assemblyDigest": {
          "$ref": "#/$defs/digest"
        },
        "isPackable": {
          "type": "boolean"
        },
        "hasRuntimeAssets": {
          "const": false
        },
        "hasBuildTransitiveAssets": {
          "const": false
        }
      }
    },
    "analyzerComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "kind",
        "semanticOwnerId",
        "artifact",
        "ruleIds",
        "receiptGeneratorRevisions",
        "sdkRange",
        "compilerRoslynRange",
        "languageRange",
        "targetFrameworkRange",
        "programKitMechanicsRange"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/pkid"
        },
        "kind": {
          "enum": ["compiler-baseline", "program-kit-public-contract", "consumer-owned"]
        },
        "semanticOwnerId": {
          "$ref": "#/$defs/pkid"
        },
        "artifact": {
          "$ref": "#/$defs/artifactSelection"
        },
        "ruleIds": {
          "$ref": "#/$defs/pkidArray"
        },
        "receiptGeneratorRevisions": {
          "$ref": "#/$defs/referenceArray"
        },
        "sdkRange": {
          "$ref": "#/$defs/versionRange"
        },
        "compilerRoslynRange": {
          "$ref": "#/$defs/versionRange"
        },
        "languageRange": {
          "$ref": "#/$defs/versionRange"
        },
        "targetFrameworkRange": {
          "$ref": "#/$defs/versionRange"
        },
        "programKitMechanicsRange": {
          "$ref": "#/$defs/versionRange"
        }
      }
    },
    "ruleCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "version", "rules", "diagnostics"],
      "properties": {
        "identity": {
          "$ref": "#/$defs/pkid"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object"
          }
        },
        "diagnostics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object"
          }
        }
      }
    },
    "profileCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projects", "inputs", "generatedSources"],
      "properties": {
        "projects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object"
          }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object"
          }
        },
        "generatedSources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object"
          }
        }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectProfileId",
        "sourceProfileId",
        "command",
        "boundary",
        "verificationProfile",
        "analyzerComponentIds"
      ],
      "properties": {
        "projectProfileId": {
          "$ref": "#/$defs/pkid"
        },
        "sourceProfileId": {
          "$ref": "#/$defs/pkid"
        },
        "command": {
          "enum": ["build", "test", "pack", "publish", "generated-project-verify"]
        },
        "boundary": {
          "enum": ["gate-establishment", "preflight", "work-unit", "generated-output", "final-closure"]
        },
        "verificationProfile": {
          "enum": ["bootstrap", "focused", "work-unit", "generated-output", "tamper", "performance", "final-closure"]
        },
        "analyzerComponentIds": {
          "allOf": [
            {
              "$ref": "#/$defs/pkidArray"
            },
            {
              "minItems": 1
            }
          ]
        }
      }
    },
    "activationMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "version", "activations"],
      "properties": {
        "identity": {
          "$ref": "#/$defs/pkid"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "activations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/activation"
          }
        }
      }
    },
    "temporaryException": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "gate",
        "ruleId",
        "projectProfileId",
        "sourceProfileId",
        "command",
        "boundary",
        "verificationProfile",
        "conditionKind",
        "conditionParameters",
        "consumerOwnerId",
        "humanAuthority",
        "rationale",
        "residualRisk",
        "compensatingVerification",
        "evidenceRequirements",
        "activatedAt",
        "expiresAt",
        "removalTrigger",
        "maximumUses",
        "removalOwnerId"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/pkid"
        },
        "gate": {
          "$ref": "#/$defs/reference"
        },
        "ruleId": {
          "$ref": "#/$defs/pkid"
        },
        "projectProfileId": {
          "$ref": "#/$defs/pkid"
        },
        "sourceProfileId": {
          "$ref": "#/$defs/pkid"
        },
        "command": {
          "enum": ["build", "test", "pack", "publish", "generated-project-verify"]
        },
        "boundary": {
          "enum": ["gate-establishment", "preflight", "work-unit", "generated-output", "final-closure"]
        },
        "verificationProfile": {
          "enum": ["bootstrap", "focused", "work-unit", "generated-output", "tamper", "performance", "final-closure"]
        },
        "conditionKind": {
          "enum": [
            "exact-toolchain-incompatibility",
            "exact-target-framework-incompatibility",
            "unavailable-generated-input",
            "gate-establishment-boundary"
          ]
        },
        "conditionParameters": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object"
          }
        },
        "consumerOwnerId": {
          "$ref": "#/$defs/pkid"
        },
        "humanAuthority": {
          "$ref": "#/$defs/reference"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "residualRisk": {
          "type": "string",
          "minLength": 1
        },
        "compensatingVerification": {
          "allOf": [
            {
              "$ref": "#/$defs/referenceArray"
            },
            {
              "minItems": 1
            }
          ]
        },
        "evidenceRequirements": {
          "allOf": [
            {
              "$ref": "#/$defs/referenceArray"
            },
            {
              "minItems": 1
            }
          ]
        },
        "activatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "removalTrigger": {
          "type": ["string", "null"]
        },
        "maximumUses": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "removalOwnerId": {
          "$ref": "#/$defs/pkid"
        }
      }
    },
    "suppressionLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "version", "entries"],
      "properties": {
        "identity": {
          "$ref": "#/$defs/pkid"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "entries": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object"
          }
        }
      }
    },
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compatibility", "migrations", "threats", "fixtures", "performance"],
      "properties": {
        "compatibility": {
          "type": "object"
        },
        "migrations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object"
          }
        },
        "threats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object"
          }
        },
        "fixtures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object"
          }
        },
        "performance": {
          "type": "object"
        }
      }
    },
    "gateDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "version",
        "revisionDigest",
        "ownerId",
        "consumerPolicyId",
        "disposition",
        "compatibilityPolicy",
        "semanticOwners",
        "analyzerComponents",
        "ruleCatalog",
        "profiles",
        "activationMatrix",
        "temporaryExceptions",
        "suppressionLedger",
        "assurance"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/pkid"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "revisionDigest": {
          "$ref": "#/$defs/digest"
        },
        "ownerId": {
          "$ref": "#/$defs/pkid"
        },
        "consumerPolicyId": {
          "$ref": "#/$defs/pkid"
        },
        "disposition": {
          "$ref": "#/$defs/reference"
        },
        "compatibilityPolicy": {
          "$ref": "#/$defs/reference"
        },
        "semanticOwners": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/semanticOwner"
          }
        },
        "analyzerComponents": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/analyzerComponent"
          }
        },
        "ruleCatalog": {
          "$ref": "#/$defs/ruleCatalog"
        },
        "profiles": {
          "$ref": "#/$defs/profileCatalog"
        },
        "activationMatrix": {
          "$ref": "#/$defs/activationMatrix"
        },
        "temporaryExceptions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/temporaryException"
          }
        },
        "suppressionLedger": {
          "$ref": "#/$defs/suppressionLedger"
        },
        "assurance": {
          "$ref": "#/$defs/assurance"
        }
      }
    },
    "lockedContent": {
      "$ref": "#/$defs/contentItem"
    },
    "expectedReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectProfileId", "analyzerComponentId", "verificationProfile", "receiptIdentity"],
      "properties": {
        "projectProfileId": {
          "$ref": "#/$defs/pkid"
        },
        "analyzerComponentId": {
          "$ref": "#/$defs/pkid"
        },
        "verificationProfile": {
          "enum": ["bootstrap", "focused", "work-unit", "generated-output", "tamper", "performance", "final-closure"]
        },
        "receiptIdentity": {
          "$ref": "#/$defs/pkid"
        }
      }
    },
    "selectionLock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "version",
        "disposition",
        "gateDefinition",
        "analyzerComponents",
        "ruleCatalog",
        "recipes",
        "activationMatrix",
        "suppressionLedger",
        "operationRevisions",
        "projectInventory",
        "physicalSourceInventory",
        "generatedSourceInventory",
        "referenceInventory",
        "additionalFileInventory",
        "analyzerConfigurationInventory",
        "sdkVersion",
        "compilerRoslynVersion",
        "languageVersion",
        "targetFramework",
        "expectedReceipts",
        "inputDigest",
        "outputDigest"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/pkid"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "disposition": {
          "$ref": "#/$defs/reference"
        },
        "gateDefinition": {
          "$ref": "#/$defs/reference"
        },
        "analyzerComponents": {
          "$ref": "#/$defs/referenceArray"
        },
        "ruleCatalog": {
          "$ref": "#/$defs/reference"
        },
        "recipes": {
          "$ref": "#/$defs/referenceArray"
        },
        "activationMatrix": {
          "$ref": "#/$defs/reference"
        },
        "suppressionLedger": {
          "$ref": "#/$defs/reference"
        },
        "operationRevisions": {
          "$ref": "#/$defs/referenceArray"
        },
        "projectInventory": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lockedContent"
          }
        },
        "physicalSourceInventory": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lockedContent"
          }
        },
        "generatedSourceInventory": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lockedContent"
          }
        },
        "referenceInventory": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lockedContent"
          }
        },
        "additionalFileInventory": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lockedContent"
          }
        },
        "analyzerConfigurationInventory": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lockedContent"
          }
        },
        "sdkVersion": {
          "$ref": "#/$defs/version"
        },
        "compilerRoslynVersion": {
          "$ref": "#/$defs/version"
        },
        "languageVersion": {
          "$ref": "#/$defs/version"
        },
        "targetFramework": {
          "type": "string",
          "minLength": 1
        },
        "expectedReceipts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/expectedReceipt"
          }
        },
        "inputDigest": {
          "$ref": "#/$defs/digest"
        },
        "outputDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "participationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "version",
        "selectionLock",
        "projectProfileId",
        "analyzerComponentId",
        "verificationProfile",
        "compilationNonce",
        "analyzerAssemblyDigest",
        "validatedCompilerInputDigest",
        "executedCompilerInputDigest",
        "compilationOutputDigest"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/pkid"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "selectionLock": {
          "$ref": "#/$defs/reference"
        },
        "projectProfileId": {
          "$ref": "#/$defs/pkid"
        },
        "analyzerComponentId": {
          "$ref": "#/$defs/pkid"
        },
        "verificationProfile": {
          "enum": ["bootstrap", "focused", "work-unit", "generated-output", "tamper", "performance", "final-closure"]
        },
        "compilationNonce": {
          "type": "string",
          "minLength": 1
        },
        "analyzerAssemblyDigest": {
          "$ref": "#/$defs/digest"
        },
        "validatedCompilerInputDigest": {
          "$ref": "#/$defs/digest"
        },
        "executedCompilerInputDigest": {
          "$ref": "#/$defs/digest"
        },
        "compilationOutputDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "verificationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "version",
        "selectionLock",
        "verificationProfile",
        "succeeded",
        "failureLayer",
        "participationReceipts",
        "exceptionUseReceipts",
        "consumedSuppressionIds",
        "diagnosticsDigest",
        "evidenceDigest"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/pkid"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "selectionLock": {
          "$ref": "#/$defs/reference"
        },
        "verificationProfile": {
          "enum": ["bootstrap", "focused", "work-unit", "generated-output", "tamper", "performance", "final-closure"]
        },
        "succeeded": {
          "type": "boolean"
        },
        "failureLayer": {
          "type": ["string", "null"],
          "enum": [
            "definition",
            "mechanics",
            "analyzer-build",
            "attachment",
            "inventory",
            "source-policy",
            "suppression",
            "configuration-tamper",
            "evidence",
            "performance",
            "package-runtime",
            "toolchain",
            "internal-regression",
            null
          ]
        },
        "participationReceipts": {
          "$ref": "#/$defs/referenceArray"
        },
        "exceptionUseReceipts": {
          "$ref": "#/$defs/referenceArray"
        },
        "consumedSuppressionIds": {
          "$ref": "#/$defs/pkidArray"
        },
        "diagnosticsDigest": {
          "$ref": "#/$defs/digest"
        },
        "evidenceDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
