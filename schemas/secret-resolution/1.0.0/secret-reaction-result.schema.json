{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/secret-resolution/secret-reaction-result/1.0.0/schema.json",
  "title": "Program Kit Secret Reaction Result",
  "x-program-kit-identity": "pkid:schema:program-kit:secret-reaction-result",
  "x-program-kit-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "referenceIdentity",
    "generation",
    "reaction",
    "status",
    "safeDiagnosticCode"
  ],
  "properties": {
    "referenceIdentity": {
      "type": "string",
      "pattern": "^pkid:[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "reaction": {
      "type": "string",
      "enum": [
        "hot-replacement",
        "client-recreation",
        "reconnect",
        "resource-recycle",
        "host-restart-request",
        "manual",
        "unsupported"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "succeeded",
        "failed",
        "rejected"
      ]
    },
    "safeDiagnosticCode": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^pkid:[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
