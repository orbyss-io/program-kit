{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/secret-resolution/secret-change-signal/1.0.0/schema.json",
  "title": "Program Kit Secret Change Signal",
  "x-program-kit-identity": "pkid:schema:program-kit:secret-change-signal",
  "x-program-kit-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "referenceIdentity",
    "kind",
    "previousGeneration",
    "lifecycle"
  ],
  "properties": {
    "referenceIdentity": {
      "type": "string",
      "pattern": "^pkid:[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "generation-changed",
        "expiring",
        "expired",
        "revoked",
        "denied",
        "provider-unavailable",
        "failed"
      ]
    },
    "previousGeneration": {
      "type": "integer",
      "minimum": 0
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "status",
        "observedAt",
        "expiresAt"
      ],
      "properties": {
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "available",
            "denied",
            "provider-unavailable",
            "expired",
            "revoked",
            "failed"
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}
