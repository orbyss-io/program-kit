{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/secret-resolution/secret-resolution-contract/0.1.0-alpha.1/schema.json",
  "title": "Program Kit Secret Resolution Contract",
  "x-program-kit-identity": "pkid:schema:program-kit:secret-resolution-contract",
  "x-program-kit-version": "0.1.0-alpha.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reference",
    "resolver",
    "consumption"
  ],
  "properties": {
    "reference": {
      "$ref": "#/$defs/secretReference"
    },
    "resolver": {
      "$ref": "#/$defs/resolverCapability"
    },
    "consumption": {
      "$ref": "#/$defs/consumption"
    }
  },
  "$defs": {
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "version",
        "digest"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "pattern": "^pkid:[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "classification": {
      "type": "string",
      "enum": [
        "restricted-metadata",
        "sensitive-metadata"
      ]
    },
    "resultKind": {
      "type": "string",
      "enum": [
        "configuration-text",
        "configuration-bytes",
        "certificate",
        "mounted-file-handle",
        "credential-handle",
        "assertion-service",
        "workload-identity-capability"
      ]
    },
    "lifetime": {
      "type": "string",
      "enum": [
        "resolution-lease",
        "consumer",
        "host",
        "provider-managed"
      ]
    },
    "secretReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "classification",
        "expectedResultKind",
        "resolverCapabilityRevision",
        "locatorRevision",
        "locatorClassification"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "pattern": "^pkid:[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "classification": {
          "$ref": "#/$defs/classification"
        },
        "expectedResultKind": {
          "$ref": "#/$defs/resultKind"
        },
        "resolverCapabilityRevision": {
          "$ref": "#/$defs/artifactReference"
        },
        "locatorRevision": {
          "$ref": "#/$defs/artifactReference"
        },
        "locatorClassification": {
          "$ref": "#/$defs/classification"
        }
      }
    },
    "resolverCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilityRevision",
        "supportedResultKinds",
        "supportedLifetimes",
        "supportedReferenceClassifications",
        "supportedLocatorClassifications",
        "rotationCapability"
      ],
      "properties": {
        "capabilityRevision": {
          "$ref": "#/$defs/artifactReference"
        },
        "supportedResultKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/resultKind"
          }
        },
        "supportedLifetimes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/lifetime"
          }
        },
        "supportedReferenceClassifications": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/classification"
          }
        },
        "supportedLocatorClassifications": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/classification"
          }
        },
        "rotationCapability": {
          "type": "string",
          "enum": [
            "unsupported",
            "lease-expiry",
            "change-signal",
            "lease-expiry-and-change-signal"
          ]
        }
      }
    },
    "consumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestedLifetime",
        "consumptionShape",
        "rotationRequired",
        "reaction"
      ],
      "properties": {
        "requestedLifetime": {
          "$ref": "#/$defs/lifetime"
        },
        "consumptionShape": {
          "type": "string",
          "enum": [
            "native-capability",
            "configuration"
          ]
        },
        "rotationRequired": {
          "type": "boolean"
        },
        "reaction": {
          "type": "string",
          "enum": [
            "hot-replacement",
            "client-recreation",
            "reconnect",
            "resource-recycle",
            "host-restart-request",
            "manual",
            "unsupported"
          ]
        }
      }
    }
  }
}
