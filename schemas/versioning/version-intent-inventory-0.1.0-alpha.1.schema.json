{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/versioning/0.1.0-alpha.1/version-intent-inventory.schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:version-intent-inventory",
  "x-program-kit-version": "0.1.0-alpha.1",
  "title": "Program Kit version-intent inventory",
  "description": "A closed explicit classification of version-bearing repository sources.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repositoryRoot",
    "sourceRoots",
    "entries",
    "completenessEvidence"
  ],
  "properties": {
    "repositoryRoot": {
      "$ref": "#/$defs/normalizedRelativeRoot"
    },
    "sourceRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/normalizedRelativeRoot"
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/inventoryEntry"
      }
    },
    "completenessEvidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.orbyss.io/program-kit/artifacts/1.0.0/definitions.schema.json#/$defs/artifactReference"
      }
    }
  },
  "$defs": {
    "normalizedRelativeRoot": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:\\.|(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*:)(?!.*//)(?!.*?/$).+)$"
    },
    "normalizedRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*:)(?!.*//)(?!.*?/$).+$"
    },
    "versionIntent": {
      "enum": [
        "product-release",
        "owned-artifact-revision",
        "external-selection",
        "historical-evidence-revision",
        "fixture-revision"
      ]
    },
    "transitionDisposition": {
      "enum": [
        "coordinate-product-release",
        "migrate-owned-revision",
        "preserve-external-selection",
        "preserve-historical-evidence",
        "preserve-fixture"
      ]
    },
    "inventoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "ownerId",
        "sourcePath",
        "currentValue",
        "sourceDigest",
        "intent",
        "isActive",
        "ownedRevisionOrdinal",
        "transitionDisposition"
      ],
      "properties": {
        "identity": {
          "$ref": "https://schemas.orbyss.io/program-kit/artifacts/1.0.0/definitions.schema.json#/$defs/programKitIdentifier"
        },
        "ownerId": {
          "$ref": "https://schemas.orbyss.io/program-kit/artifacts/1.0.0/definitions.schema.json#/$defs/programKitIdentifier"
        },
        "sourcePath": {
          "$ref": "#/$defs/normalizedRelativePath"
        },
        "currentValue": {
          "type": "string",
          "minLength": 1
        },
        "sourceDigest": {
          "$ref": "https://schemas.orbyss.io/program-kit/artifacts/1.0.0/definitions.schema.json#/$defs/sha256Digest"
        },
        "intent": {
          "$ref": "#/$defs/versionIntent"
        },
        "isActive": {
          "type": "boolean"
        },
        "ownedRevisionOrdinal": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "transitionDisposition": {
          "$ref": "#/$defs/transitionDisposition"
        }
      }
    }
  }
}
