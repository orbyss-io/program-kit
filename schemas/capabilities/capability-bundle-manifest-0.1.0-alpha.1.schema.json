{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/capabilities/capability-bundle-manifest/0.1.0-alpha.1/schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:capability-bundle-manifest",
  "x-program-kit-version": "0.1.0-alpha.1",
  "title": "Program Kit capability-bundle manifest",
  "description": "The exact content allow-list and release identity for one Program Kit capability bundle.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "bundleVersion",
    "capabilities",
    "kitVersion",
    "optionalProviderAdapters",
    "supportingResources"
  ],
  "properties": {
    "manifestVersion": {
      "const": "0.1.0-alpha.1"
    },
    "bundleVersion": {
      "$ref": "#/$defs/semanticVersion"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "kitVersion": {
      "$ref": "#/$defs/semanticVersion"
    },
    "optionalProviderAdapters": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/providerAdapter"
      }
    },
    "supportingResources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/supportingResource"
      }
    }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "provider": {
      "enum": [
        "claude",
        "codex"
      ]
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*:)(?!.*//)(?!.*?/$).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilityId",
        "packagePath",
        "sha256",
        "sourcePath"
      ],
      "properties": {
        "capabilityId": {
          "$ref": "#/$defs/identifier"
        },
        "packagePath": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourcePath": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "providerAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilityId",
        "packagePath",
        "provider",
        "sha256",
        "sourcePath"
      ],
      "properties": {
        "capabilityId": {
          "$ref": "#/$defs/identifier"
        },
        "packagePath": {
          "$ref": "#/$defs/relativePath"
        },
        "provider": {
          "$ref": "#/$defs/provider"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourcePath": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "supportingResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packagePath",
        "resourceId",
        "sha256",
        "sourcePath"
      ],
      "properties": {
        "packagePath": {
          "$ref": "#/$defs/relativePath"
        },
        "resourceId": {
          "$ref": "#/$defs/identifier"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourcePath": {
          "$ref": "#/$defs/relativePath"
        }
      }
    }
  }
}
