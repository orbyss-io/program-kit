{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/artifacts/1.0.0/artifact-envelope.schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:artifact-envelope",
  "x-program-kit-version": "1.0.0",
  "title": "ArtifactEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "artifact",
    "compatibility",
    "provenance",
    "representation",
    "integrity",
    "document"
  ],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaId",
        "schemaVersion"
      ],
      "properties": {
        "schemaId": {
          "allOf": [
            {
              "$ref": "definitions.schema.json#/$defs/programKitIdentifier"
            },
            {
              "pattern": "^pkid:schema:"
            }
          ]
        },
        "schemaVersion": {
          "$ref": "definitions.schema.json#/$defs/semanticVersion"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "version",
        "ownerId",
        "status",
        "consumers"
      ],
      "properties": {
        "id": {
          "$ref": "definitions.schema.json#/$defs/programKitIdentifier"
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "version": {
          "$ref": "definitions.schema.json#/$defs/semanticVersion"
        },
        "ownerId": {
          "$ref": "definitions.schema.json#/$defs/programKitIdentifier"
        },
        "status": {
          "$ref": "definitions.schema.json#/$defs/artifactStatus"
        },
        "consumers": {
          "type": "array",
          "items": {
            "$ref": "definitions.schema.json#/$defs/programKitIdentifier"
          },
          "uniqueItems": true
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "dimensions",
        "readerRange",
        "writerRange",
        "migrationReferences"
      ],
      "properties": {
        "policy": {
          "$ref": "definitions.schema.json#/$defs/programKitIdentifier"
        },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "definitions.schema.json#/$defs/compatibilityClaim"
          }
        },
        "readerRange": {
          "$ref": "definitions.schema.json#/$defs/semanticVersionRange"
        },
        "writerRange": {
          "$ref": "definitions.schema.json#/$defs/semanticVersionRange"
        },
        "migrationReferences": {
          "type": "array",
          "items": {
            "$ref": "definitions.schema.json#/$defs/artifactReference"
          },
          "uniqueItems": true
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceInputs",
        "producer",
        "correlationId"
      ],
      "properties": {
        "sourceInputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "definitions.schema.json#/$defs/artifactReference"
          },
          "uniqueItems": true
        },
        "producer": {
          "$ref": "definitions.schema.json#/$defs/programKitIdentifier"
        },
        "correlationId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serializationProfileRef",
        "canonicalizationProfileRef",
        "canonicalMediaType"
      ],
      "properties": {
        "serializationProfileRef": {
          "$ref": "definitions.schema.json#/$defs/profileReference"
        },
        "canonicalizationProfileRef": {
          "$ref": "definitions.schema.json#/$defs/profileReference"
        },
        "canonicalMediaType": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s]+$"
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "$ref": "definitions.schema.json#/$defs/sha256Digest"
        }
      }
    },
    "document": true
  }
}
