{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/artifacts/1.0.0/versioned-component-manifest.schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:versioned-component-manifest",
  "x-program-kit-version": "1.0.0",
  "title": "VersionedComponentManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity",
    "kind",
    "ownerId",
    "version",
    "digest",
    "providedContracts",
    "requiredContracts",
    "compatibilityClaims",
    "migrationReferences"
  ],
  "properties": {
    "identity": {
      "$ref": "definitions.schema.json#/$defs/programKitIdentifier"
    },
    "kind": {
      "$ref": "#/$defs/versionBoundaryKind"
    },
    "ownerId": {
      "$ref": "definitions.schema.json#/$defs/programKitIdentifier"
    },
    "version": {
      "$ref": "definitions.schema.json#/$defs/semanticVersion"
    },
    "digest": {
      "$ref": "definitions.schema.json#/$defs/sha256Digest"
    },
    "providedContracts": {
      "type": "array",
      "items": {
        "$ref": "definitions.schema.json#/$defs/artifactReference"
      },
      "uniqueItems": true
    },
    "requiredContracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/versionRequirement"
      }
    },
    "compatibilityClaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "definitions.schema.json#/$defs/compatibilityClaim"
      }
    },
    "migrationReferences": {
      "type": "array",
      "items": {
        "$ref": "definitions.schema.json#/$defs/artifactReference"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "versionBoundaryKind": {
      "type": "string",
      "enum": [
        "contract",
        "schema",
        "package",
        "implementation",
        "generator",
        "generated-artifact",
        "host-composition",
        "serialization-profile",
        "converter-contribution",
        "canonicalization-profile",
        "configuration",
        "artifact",
        "persisted-data",
        "command-line",
        "task-definition",
        "task-schedule",
        "external-consumer"
      ]
    },
    "dependencyExposure": {
      "type": "string",
      "enum": [
        "private",
        "public"
      ]
    },
    "versionRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "acceptedRange",
        "resolution",
        "exposure",
        "dimensions",
        "evidenceReferences"
      ],
      "properties": {
        "identity": {
          "$ref": "definitions.schema.json#/$defs/programKitIdentifier"
        },
        "acceptedRange": {
          "$ref": "definitions.schema.json#/$defs/semanticVersionRange"
        },
        "resolution": {
          "$ref": "definitions.schema.json#/$defs/artifactReference"
        },
        "exposure": {
          "$ref": "#/$defs/dependencyExposure"
        },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "definitions.schema.json#/$defs/compatibilityDimension"
          },
          "uniqueItems": true
        },
        "evidenceReferences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "definitions.schema.json#/$defs/artifactReference"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
