{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/artifacts/0.1.0-alpha.1/migration-definition.schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:migration-definition",
  "x-program-kit-version": "0.1.0-alpha.1",
  "title": "MigrationDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceIdentity",
    "sourceRange",
    "target",
    "mode",
    "preconditions",
    "lossPolicy",
    "isDeterministic",
    "isIdempotent",
    "failurePolicy",
    "implementationReference",
    "fixtureReferences"
  ],
  "properties": {
    "sourceIdentity": {
      "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/programKitIdentifier"
    },
    "sourceRange": {
      "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/semanticVersionRange"
    },
    "target": {
      "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/artifactReference"
    },
    "mode": {
      "type": "string",
      "enum": [
        "artifact-transform",
        "configuration-transform",
        "source-guidance",
        "regenerate",
        "package-upgrade",
        "runtime-adapter"
      ]
    },
    "preconditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/precondition"
      }
    },
    "lossPolicy": {
      "type": "string",
      "enum": [
        "lossless",
        "explicitly-lossy",
        "reject-loss"
      ]
    },
    "isDeterministic": {
      "type": "boolean"
    },
    "isIdempotent": {
      "type": "boolean"
    },
    "failurePolicy": {
      "type": "string",
      "enum": [
        "fail-before-write",
        "atomic-rollback",
        "preserve-source-and-report"
      ]
    },
    "implementationReference": {
      "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/artifactReference"
    },
    "fixtureReferences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/artifactReference"
          },
          {
            "properties": {
              "identity": {
                "pattern": "^pkid:fixture:"
              }
            }
          }
        ]
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "precondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "description",
        "evidenceReferences"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidenceReferences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/artifactReference"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
