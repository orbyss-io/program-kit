{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/artifacts/1.0.0/definitions.schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:artifact-definitions",
  "x-program-kit-version": "1.0.0",
  "title": "Orbyss Program Kit artifact definitions",
  "$defs": {
    "programKitIdentifier": {
      "type": "string",
      "pattern": "^pkid:[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "semanticVersionRange": {
      "type": "string",
      "minLength": 1,
      "description": "A full SemVer version or deterministic NuGet-style SemVer interval; semantic validation owns bound ordering and exact grammar."
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "version",
        "digest"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/programKitIdentifier"
        },
        "version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "digest": {
          "$ref": "#/$defs/sha256Digest"
        }
      }
    },
    "profileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "version",
        "digest"
      ],
      "properties": {
        "identity": {
          "allOf": [
            {
              "$ref": "#/$defs/programKitIdentifier"
            },
            {
              "pattern": "^pkid:profile:"
            }
          ]
        },
        "version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "digest": {
          "$ref": "#/$defs/sha256Digest"
        }
      }
    },
    "artifactStatus": {
      "type": "string",
      "enum": [
        "implemented",
        "scaffolded",
        "deferred",
        "aspirational"
      ]
    },
    "compatibilityDimension": {
      "type": "string",
      "enum": [
        "semantic-behavior",
        "wire-read",
        "wire-write",
        "source-api",
        "binary-abi",
        "configuration",
        "persisted-artifacts",
        "generated-artifacts",
        "command-line",
        "host-composition"
      ]
    },
    "compatibilityClassification": {
      "type": "string",
      "enum": [
        "editorial",
        "compatible-additive",
        "conditionally-compatible",
        "breaking",
        "unknown"
      ]
    },
    "compatibilityClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "classification",
        "conditions"
      ],
      "properties": {
        "dimension": {
          "$ref": "#/$defs/compatibilityDimension"
        },
        "classification": {
          "$ref": "#/$defs/compatibilityClassification"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
