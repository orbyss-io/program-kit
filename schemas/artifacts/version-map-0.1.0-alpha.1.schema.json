{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/artifacts/0.1.0-alpha.1/version-map.schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:version-map",
  "x-program-kit-version": "0.1.0-alpha.1",
  "title": "VersionMapDocument",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nodes",
    "edges"
  ],
  "properties": {
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "kind",
        "ownerId",
        "evidenceReferences"
      ],
      "properties": {
        "revision": {
          "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/artifactReference"
        },
        "kind": {
          "$ref": "versioned-component-manifest-0.1.0-alpha.1.schema.json#/$defs/versionBoundaryKind"
        },
        "ownerId": {
          "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/programKitIdentifier"
        },
        "evidenceReferences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/artifactReference"
          },
          "uniqueItems": true
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "targetIdentity",
        "kind",
        "acceptedRange",
        "resolution",
        "exposure",
        "compatibilityDimensions",
        "evidenceReferences"
      ],
      "properties": {
        "id": {
          "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/programKitIdentifier"
        },
        "source": {
          "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/artifactReference"
        },
        "targetIdentity": {
          "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/programKitIdentifier"
        },
        "kind": {
          "$ref": "#/$defs/dependencyKind"
        },
        "acceptedRange": {
          "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/semanticVersionRange"
        },
        "resolution": {
          "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/artifactReference"
        },
        "exposure": {
          "$ref": "versioned-component-manifest-0.1.0-alpha.1.schema.json#/$defs/dependencyExposure"
        },
        "compatibilityDimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/compatibilityDimension"
          },
          "uniqueItems": true
        },
        "evidenceReferences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/artifactReference"
          },
          "uniqueItems": true
        }
      }
    },
    "dependencyKind": {
      "type": "string",
      "enum": [
        "implements",
        "reads",
        "writes",
        "validates",
        "uses-contract",
        "wire-schema-of",
        "serializes-with",
        "contributes-converter",
        "canonicalizes-with",
        "publicly-exposes",
        "package-depends-on",
        "configured-by",
        "generated-by",
        "projects",
        "composes",
        "handles-task",
        "schedules",
        "migrates",
        "verifies"
      ]
    }
  }
}
