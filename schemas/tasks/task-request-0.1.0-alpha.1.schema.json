{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/tasks/0.1.0-alpha.1/task-request.schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:task-request",
  "x-program-kit-version": "0.1.0-alpha.1",
  "title": "TaskRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision",
    "definitionRevision",
    "requestContract",
    "responseContract",
    "failureContract",
    "requestedBy",
    "requestedAt",
    "payload",
    "idempotencyKey",
    "causalReferences",
    "occurrenceRevision"
  ],
  "properties": {
    "revision": {
      "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/artifactReference"
    },
    "definitionRevision": {
      "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/artifactReference"
    },
    "requestContract": {
      "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/artifactReference"
    },
    "responseContract": {
      "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/artifactReference"
    },
    "failureContract": {
      "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/artifactReference"
    },
    "requestedBy": {
      "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/programKitIdentifier"
    },
    "requestedAt": {
      "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/timestamp"
    },
    "payload": true,
    "idempotencyKey": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "causalReferences": {
      "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/artifactReferenceArray"
    },
    "occurrenceRevision": {
      "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/optionalArtifactReference"
    }
  }
}
