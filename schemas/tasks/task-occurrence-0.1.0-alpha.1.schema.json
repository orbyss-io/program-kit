      "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/artifactReference"
    },
    "scheduleRevision": {
      "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/artifactReference"
    },
    "definitionRevision": {
      "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/artifactReference"
    },
    "descriptorRevision": {
      "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/artifactReference"
    },
    "occurrenceCalculatorProfile": {
      "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/artifactReference"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "scheduledFor": {
      "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/timestamp"
    },
    "evaluatedAt": {
      "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/timestamp"
    }
  }
}
