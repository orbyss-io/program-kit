{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/tasks/0.1.0-alpha.1/task-occurrence.schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:task-occurrence",
  "x-program-kit-version": "0.1.0-alpha.1",
  "title": "TaskOccurrence",
  "type": "object",
  "additionalProperties": false,
