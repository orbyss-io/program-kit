{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/open-console/0.1.0-alpha.2/schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:open-console",
  "x-program-kit-version": "0.1.0-alpha.2",
  "title": "Open Console 0.1.0-alpha.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "documentVersion",
    "info",
    "hostRevision",
    "parsing",
    "hostExitCodeRoles",
    "globalOptions",
    "commands",
    "help",
    "completion",
    "compatibility",
    "provenance"
  ],
  "properties": {
    "$schema": {
      "const": "pkid:schema:program-kit:open-console@0.1.0-alpha.2"
    },
    "documentVersion": {
      "const": "0.1.0-alpha.2"
    },
    "info": {
      "$ref": "#/$defs/info"
    },
    "hostRevision": {
      "$ref": "https://schemas.orbyss.io/program-kit/artifacts/0.1.0-alpha.2/definitions.schema.json#/$defs/artifactReference"
    },
    "parsing": {
      "$ref": "#/$defs/parsing"
    },
    "hostExitCodeRoles": {
      "$ref": "#/$defs/hostExitCodeRoles"
    },
    "globalOptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/option"
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "help": {
      "$ref": "#/$defs/help"
    },
    "completion": {
      "$ref": "#/$defs/completion"
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "reference": {
      "$ref": "https://schemas.orbyss.io/program-kit/artifacts/0.1.0-alpha.2/definitions.schema.json#/$defs/artifactReference"
    },
    "version": {
      "$ref": "https://schemas.orbyss.io/program-kit/artifacts/0.1.0-alpha.2/definitions.schema.json#/$defs/semanticVersion"
    },
    "identifier": {
      "$ref": "https://schemas.orbyss.io/program-kit/artifacts/0.1.0-alpha.2/definitions.schema.json#/$defs/programKitIdentifier"
    },
    "info": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "summary",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "parsing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumesOperatingSystemTokenArray",
        "optionTerminator",
        "supportsLongEqualsSyntax",
        "caseSensitive",
        "conversionCulture",
        "singleValueDuplicatePolicy",
        "multiValueDuplicatePolicy",
        "flagDuplicatePolicy"
      ],
      "properties": {
        "consumesOperatingSystemTokenArray": {
          "const": true
        },
        "optionTerminator": {
          "const": null
        },
        "supportsLongEqualsSyntax": {
          "const": true
        },
        "caseSensitive": {
          "const": true
        },
        "conversionCulture": {
          "const": "invariant"
        },
        "singleValueDuplicatePolicy": {
          "const": "last-value-wins"
        },
        "multiValueDuplicatePolicy": {
          "const": "accumulate"
        },
        "flagDuplicatePolicy": {
          "const": "idempotent"
        }
      }
    },
    "hostExitCodeRoles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invalidInvocation",
        "cancellation",
        "internalFailure"
      ],
      "properties": {
        "invalidInvocation": {
          "type": "integer",
          "minimum": 1
        },
        "cancellation": {
          "type": "integer",
          "minimum": 1
        },
        "internalFailure": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "arity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "maximum"
      ],
      "properties": {
        "minimum": {
          "type": "integer",
          "minimum": 0
        },
        "maximum": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "argument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "position",
        "summary",
        "valueType",
        "valueSchemaRevision",
        "valueArity",
        "occurrence",
        "required",
        "defaultValue"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "valueType": {
          "enum": [
            "string",
            "boolean",
            "int32",
            "int64",
            "decimal",
            "guid",
            "date-time"
          ]
        },
        "valueSchemaRevision": {
          "$ref": "#/$defs/reference"
        },
        "valueArity": {
          "$ref": "#/$defs/arity"
        },
        "occurrence": {
          "$ref": "#/$defs/arity"
        },
        "required": {
          "type": "boolean"
        },
        "defaultValue": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "longName",
        "shortName",
        "aliases",
        "summary",
        "kind",
        "valueType",
        "valueSchemaRevision",
        "valueArity",
        "occurrence",
        "required",
        "defaultValue",
        "conflicts",
        "prerequisites",
        "configurationBinding"
      ],
      "properties": {
        "longName": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "shortName": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9]$"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^-{1,2}[A-Za-z0-9][A-Za-z0-9-]*$"
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "flag",
            "value"
          ]
        },
        "valueType": {
          "enum": [
            "string",
            "boolean",
            "int32",
            "int64",
            "decimal",
            "guid",
            "date-time"
          ]
        },
        "valueSchemaRevision": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/reference"
            }
          ]
        },
        "valueArity": {
          "$ref": "#/$defs/arity"
        },
        "occurrence": {
          "$ref": "#/$defs/arity"
        },
        "required": {
          "type": "boolean"
        },
        "defaultValue": {
          "type": [
            "string",
            "null"
          ]
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "configurationBinding": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "mediaType",
        "schemaRevision",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "schemaRevision": {
          "$ref": "#/$defs/reference"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "exitCode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "meaning",
        "diagnosticSchemaRevisions"
      ],
      "properties": {
        "code": {
          "type": "integer",
          "minimum": 0
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "diagnosticSchemaRevisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "tokens"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "tokens": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "commandSketch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationRevision",
        "path",
        "aliases",
        "summary",
        "arguments",
        "options",
        "standardInput",
        "standardOutput",
        "standardError",
        "exitCodes",
        "authorityRevision",
        "examples",
        "deprecation"
      ],
      "properties": {
        "operationRevision": {
          "$ref": "#/$defs/reference"
        },
        "path": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/argument"
          }
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "standardInput": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/stream"
            }
          ]
        },
        "standardOutput": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/stream"
            }
          ]
        },
        "standardError": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/stream"
            }
          ]
        },
        "exitCodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/exitCode"
          }
        },
        "authorityRevision": {
          "$ref": "#/$defs/reference"
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/example"
          }
        },
        "deprecation": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationRevision",
        "path",
        "aliases",
        "summary",
        "arguments",
        "options",
        "standardInput",
        "standardOutput",
        "standardError",
        "requestSchemaRevisions",
        "resultSchemaRevisions",
        "diagnosticSchemaRevisions",
        "exitCodes",
        "authorityRevision",
        "examples",
        "deprecation"
      ],
      "properties": {
        "operationRevision": {
          "$ref": "#/$defs/reference"
        },
        "path": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/argument"
          }
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "standardInput": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/stream"
            }
          ]
        },
        "standardOutput": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/stream"
            }
          ]
        },
        "standardError": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/stream"
            }
          ]
        },
        "requestSchemaRevisions": {
          "$ref": "#/$defs/referenceSet"
        },
        "resultSchemaRevisions": {
          "$ref": "#/$defs/referenceSet"
        },
        "diagnosticSchemaRevisions": {
          "$ref": "#/$defs/referenceSet"
        },
        "exitCodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/exitCode"
          }
        },
        "authorityRevision": {
          "$ref": "#/$defs/reference"
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/example"
          }
        },
        "deprecation": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "referenceSet": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "help": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "longOption",
        "shortOption",
        "exitCode"
      ],
      "properties": {
        "longOption": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "shortOption": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]$"
        },
        "exitCode": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "longOption",
        "includesAliases",
        "includesValueHints"
      ],
      "properties": {
        "longOption": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "includesAliases": {
          "type": "boolean"
        },
        "includesValueHints": {
          "type": "boolean"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "dimensions",
        "readerRange",
        "writerRange",
        "migrationReferences"
      ],
      "properties": {
        "policy": {
          "$ref": "#/$defs/identifier"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dimension",
              "classification",
              "conditions"
            ],
            "properties": {
              "dimension": {
                "type": "string"
              },
              "classification": {
                "type": "string"
              },
              "conditions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "readerRange": {
          "type": "string",
          "minLength": 1
        },
        "writerRange": {
          "type": "string",
          "minLength": 1
        },
        "migrationReferences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shellRevision",
        "generatorRevision",
        "operationRevisions"
      ],
      "properties": {
        "shellRevision": {
          "$ref": "#/$defs/reference"
        },
        "generatorRevision": {
          "$ref": "#/$defs/reference"
        },
        "operationRevisions": {
          "$ref": "#/$defs/referenceSet"
        }
      }
    }
  }
}
