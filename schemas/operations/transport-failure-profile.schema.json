{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/operations/transport-failure-profile/1.0.0/schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:transport-failure-profile",
  "x-program-kit-version": "1.0.0",
  "title": "Program Kit explicit transport-failure profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["profileRevision", "genericFallbackIdentity", "failures"],
  "properties": {
    "profileRevision": {
      "$ref": "https://schemas.orbyss.io/program-kit/operations/1.0.0/definitions.schema.json#/$defs/reference"
    },
    "genericFallbackIdentity": {
      "$ref": "https://schemas.orbyss.io/program-kit/operations/1.0.0/definitions.schema.json#/$defs/identifier"
    },
    "failures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/failure"}
    }
  },
  "$defs": {
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "statusCode",
        "type",
        "title",
        "productionDetail",
        "developmentDetail",
        "problemSchemaRevision",
        "disclosure"
      ],
      "properties": {
        "identity": {
          "$ref": "https://schemas.orbyss.io/program-kit/operations/1.0.0/definitions.schema.json#/$defs/identifier"
        },
        "statusCode": {"type": "integer", "minimum": 400, "maximum": 599},
        "type": {"type": "string", "format": "uri", "pattern": "^https://"},
        "title": {"type": "string", "minLength": 1, "maxLength": 128},
        "productionDetail": {"type": "string", "minLength": 1, "maxLength": 512},
        "developmentDetail": {"type": "string", "minLength": 1, "maxLength": 512},
        "problemSchemaRevision": {
          "$ref": "https://schemas.orbyss.io/program-kit/operations/1.0.0/definitions.schema.json#/$defs/reference"
        },
        "disclosure": {"const": "public"}
      }
    }
  }
}
