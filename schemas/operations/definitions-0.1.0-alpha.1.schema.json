{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/operations/0.1.0-alpha.1/definitions.schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:operations-definitions",
  "x-program-kit-version": "0.1.0-alpha.1",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^pkid:[a-z0-9-]+:[a-z0-9-]+:[a-z0-9-]+$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "version",
        "digest"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "pattern": "^pkid:[a-z0-9-]+:[a-z0-9-]+:[a-z0-9-]+$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "referenceSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "resultDisposition": {
      "enum": [
        "terminal",
        "additional-input-required"
      ]
    },
    "resultContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractRevision",
        "disposition"
      ],
      "properties": {
        "contractRevision": {
          "$ref": "#/$defs/reference"
        },
        "disposition": {
          "$ref": "#/$defs/resultDisposition"
        }
      }
    },
    "relatedOperationContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationId",
        "operationRevision",
        "requestContractRevision"
      ],
      "properties": {
        "relationId": {
          "$ref": "#/$defs/identifier"
        },
        "operationRevision": {
          "$ref": "#/$defs/reference"
        },
        "requestContractRevision": {
          "$ref": "#/$defs/reference"
        }
      }
    },
    "deprecation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isDeprecated",
        "replacedBy"
      ],
      "properties": {
        "isDeprecated": {
          "type": "boolean"
        },
        "replacedBy": {
          "oneOf": [
            {
              "$ref": "#/$defs/reference"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "isDeprecated": {
                "const": false
              }
            },
            "required": [
              "isDeprecated"
            ]
          },
          "then": {
            "properties": {
              "replacedBy": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "operationContractDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationRevision",
        "requestContractRevisions",
        "resultContracts",
        "diagnosticContractRevisions",
        "progressContractRevisions",
        "relatedOperations",
        "effectContractRevision",
        "authorityContractRevision",
        "expectedRevisionPolicy",
        "idempotencyPolicy",
        "cancellationPolicy",
        "progressPolicy",
        "compatibility",
        "deprecation"
      ],
      "properties": {
        "operationRevision": {
          "$ref": "#/$defs/reference"
        },
        "requestContractRevisions": {
          "$ref": "#/$defs/referenceSet"
        },
        "resultContracts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/resultContract"
          }
        },
        "diagnosticContractRevisions": {
          "$ref": "#/$defs/referenceSet"
        },
        "progressContractRevisions": {
          "$ref": "#/$defs/referenceSet"
        },
        "relatedOperations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relatedOperationContract"
          },
          "uniqueItems": true
        },
        "effectContractRevision": {
          "oneOf": [
            {
              "$ref": "#/$defs/reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "authorityContractRevision": {
          "oneOf": [
            {
              "$ref": "#/$defs/reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "expectedRevisionPolicy": {
          "enum": [
            "unsupported",
            "optional",
            "required"
          ]
        },
        "idempotencyPolicy": {
          "enum": [
            "unsupported",
            "optional",
            "required"
          ]
        },
        "cancellationPolicy": {
          "enum": [
            "unsupported",
            "cooperative"
          ]
        },
        "progressPolicy": {
          "enum": [
            "unsupported",
            "bounded-non-authoritative"
          ]
        },
        "compatibility": {
          "$ref": "#/$defs/compatibility"
        },
        "deprecation": {
          "$ref": "#/$defs/deprecation"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "progressPolicy": {
                "const": "unsupported"
              }
            },
            "required": [
              "progressPolicy"
            ]
          },
          "then": {
            "properties": {
              "progressContractRevisions": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "progressContractRevisions": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "dimensions",
        "readerRange",
        "writerRange",
        "migrationReferences"
      ],
      "properties": {
        "policy": {
          "$ref": "#/$defs/identifier"
        },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dimension",
              "classification",
              "conditions"
            ],
            "properties": {
              "dimension": {
                "enum": [
                  "semantic-behavior",
                  "wire-read",
                  "wire-write",
                  "source-api",
                  "binary-abi",
                  "configuration",
                  "persisted-artifacts",
                  "generated-artifacts",
                  "command-line",
                  "host-composition"
                ]
              },
              "classification": {
                "enum": [
                  "editorial",
                  "compatible-additive",
                  "conditionally-compatible",
                  "breaking",
                  "unknown"
                ]
              },
              "conditions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "readerRange": {
          "type": "string",
          "minLength": 1
        },
        "writerRange": {
          "type": "string",
          "minLength": 1
        },
        "migrationReferences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "uniqueItems": true
        }
      }
    },
    "operationContractCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operations"
      ],
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/operationContractDescriptor"
          }
        }
      }
    },
    "operationInvocationDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocationId",
        "operationRevision",
        "requestContractRevision",
        "requestDocumentRevision",
        "correlationId",
        "causationId",
        "cancellationSignalId",
        "expectedRevision",
        "idempotencyKey"
      ],
      "properties": {
        "invocationId": {
          "type": "string",
          "minLength": 1
        },
        "operationRevision": {
          "$ref": "#/$defs/reference"
        },
        "requestContractRevision": {
          "$ref": "#/$defs/reference"
        },
        "requestDocumentRevision": {
          "$ref": "#/$defs/reference"
        },
        "correlationId": {
          "type": "string",
          "minLength": 1
        },
        "causationId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "cancellationSignalId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "expectedRevision": {
          "oneOf": [
            {
              "$ref": "#/$defs/reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "idempotencyKey": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "operationProgressDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocationId",
        "operationRevision",
        "sequence",
        "progressContractRevision",
        "progressDocumentRevision"
      ],
      "properties": {
        "invocationId": {
          "type": "string",
          "minLength": 1
        },
        "operationRevision": {
          "$ref": "#/$defs/reference"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "progressContractRevision": {
          "$ref": "#/$defs/reference"
        },
        "progressDocumentRevision": {
          "$ref": "#/$defs/reference"
        }
      }
    },
    "operationDiagnosticDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractRevision",
        "documentRevision"
      ],
      "properties": {
        "contractRevision": {
          "$ref": "#/$defs/reference"
        },
        "documentRevision": {
          "$ref": "#/$defs/reference"
        }
      }
    },
    "operationResultDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocationId",
        "operationRevision",
        "resultContractRevision",
        "resultDocumentRevision",
        "disposition",
        "diagnostics",
        "relatedOperationRevision"
      ],
      "properties": {
        "invocationId": {
          "type": "string",
          "minLength": 1
        },
        "operationRevision": {
          "$ref": "#/$defs/reference"
        },
        "resultContractRevision": {
          "$ref": "#/$defs/reference"
        },
        "resultDocumentRevision": {
          "$ref": "#/$defs/reference"
        },
        "disposition": {
          "$ref": "#/$defs/resultDisposition"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operationDiagnosticDocument"
          }
        },
        "relatedOperationRevision": {
          "oneOf": [
            {
              "$ref": "#/$defs/reference"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "terminal"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "relatedOperationRevision": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "relatedOperationRevision": {
                "$ref": "#/$defs/reference"
              }
            }
          }
        }
      ]
    }
  }
}
