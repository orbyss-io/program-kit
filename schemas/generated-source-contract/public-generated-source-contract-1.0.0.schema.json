{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/csharp-build-gates/public-generated-source-contract/1.0.0/schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:public-generated-source-contract",
  "x-program-kit-version": "1.0.0",
  "title": "PublicGeneratedSourceContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity",
    "version",
    "semanticOwnerId",
    "diagnosticId",
    "activationProperty",
    "activationValue",
    "ownershipHeader",
    "logicalPathPattern",
    "compilationObservableClaim",
    "claimsOutsideRule",
    "suppressionDisposition",
    "compatibility",
    "fixtures",
    "performance"
  ],
  "properties": {
    "identity": {
      "const": "pkid:contract:program-kit:generated-source-convention"
    },
    "version": {
      "const": "1.0.0"
    },
    "semanticOwnerId": {
      "const": "pkid:domain:program-kit:generated-source-contract"
    },
    "diagnosticId": {
      "const": "PKCC001"
    },
    "activationProperty": {
      "const": "ProgramKitGeneratedSourceContract"
    },
    "activationValue": {
      "const": "1.0.0"
    },
    "ownershipHeader": {
      "const": "// <auto-generated program-kit>"
    },
    "logicalPathPattern": {
      "const": "ProgramKitGenerated/<intent>/<file>.cs"
    },
    "compilationObservableClaim": {
      "type": "string",
      "minLength": 1
    },
    "claimsOutsideRule": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "suppressionDisposition": {
      "const": "source-local-ledger"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sdkRange",
        "compilerRoslynRange",
        "languageRange",
        "targetFrameworkRange"
      ],
      "properties": {
        "sdkRange": {
          "const": "[10.0.302]"
        },
        "compilerRoslynRange": {
          "const": "[5.0.0]"
        },
        "languageRange": {
          "const": "[14.0.0]"
        },
        "targetFrameworkRange": {
          "const": "[10.0.0]"
        }
      }
    },
    "fixtures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positive",
        "negative",
        "suppression",
        "unrelatedProfile",
        "receipt"
      ],
      "properties": {
        "positive": {
          "const": "pkid:fixture:program-kit:pkcc001-positive"
        },
        "negative": {
          "const": "pkid:fixture:program-kit:pkcc001-negative"
        },
        "suppression": {
          "const": "pkid:fixture:program-kit:pkcc001-suppression"
        },
        "unrelatedProfile": {
          "const": "pkid:fixture:program-kit:pkcc001-unrelated-profile"
        },
        "receipt": {
          "const": "pkid:fixture:program-kit:pkcc001-receipt"
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "focusedBuildMilliseconds"
      ],
      "properties": {
        "focusedBuildMilliseconds": {
          "const": 30000
        }
      }
    }
  }
}
