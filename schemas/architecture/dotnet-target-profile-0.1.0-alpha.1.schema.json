{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/architecture/0.1.0-alpha.1/dotnet-target-profile.schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:dotnet-target-profile",
  "x-program-kit-version": "0.1.0-alpha.1",
  "title": "Program Kit .NET target profile",
  "description": "The exact immutable .NET 10 compilation target approved by W010.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity",
    "version",
    "sdkVersion",
    "rollForward",
    "allowPrerelease",
    "targetFramework",
    "languageVersion"
  ],
  "properties": {
    "identity": {
      "const": "pkid:profile:program-kit:dotnet-10"
    },
    "version": {
      "const": "0.1.0-alpha.1"
    },
    "sdkVersion": {
      "const": "10.0.302"
    },
    "rollForward": {
      "const": "disable"
    },
    "allowPrerelease": {
      "const": false
    },
    "targetFramework": {
      "const": "net10.0"
    },
    "languageVersion": {
      "const": "14.0"
    }
  }
}
