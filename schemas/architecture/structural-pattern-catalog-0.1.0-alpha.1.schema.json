{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/architecture/0.1.0-alpha.1/structural-pattern-catalog.schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:structural-pattern-catalog",
  "x-program-kit-version": "0.1.0-alpha.1",
  "title": "Program Kit structural-pattern catalog",
  "description": "Versioned structural guidance with separate mechanical and human checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity",
    "version",
    "purpose",
    "patterns"
  ],
  "properties": {
    "identity": {
      "type": "string",
      "pattern": "^pkid:catalog:[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "purpose": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/pattern"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "semver": {
      "$ref": "https://schemas.orbyss.io/program-kit/artifacts/0.1.0-alpha.1/definitions.schema.json#/$defs/semanticVersion"
    },
    "pkid": {
      "$ref": "https://schemas.orbyss.io/program-kit/artifacts/0.1.0-alpha.1/definitions.schema.json#/$defs/programKitIdentifier"
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "context",
        "application",
        "consequence"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "context": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "application": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "consequence": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "name",
        "problem",
        "applicabilityCriteria",
        "tradeOffs",
        "examples",
        "mechanicalChecks",
        "humanChecks"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/pkid"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "problem": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "applicabilityCriteria": {
          "$ref": "#/$defs/stringList"
        },
        "tradeOffs": {
          "$ref": "#/$defs/stringList"
        },
        "examples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/example"
          }
        },
        "mechanicalChecks": {
          "$ref": "#/$defs/stringList"
        },
        "humanChecks": {
          "$ref": "#/$defs/stringList"
        }
      }
    }
  }
}
