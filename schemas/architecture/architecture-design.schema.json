{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/architecture/1.0.0/architecture-design.schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:architecture-design",
  "x-program-kit-version": "1.0.0",
  "title": "Program Kit architecture design document",
  "description": "The universal domain, contract, operation, component, ownership, extension, boundary, scenario, and status language.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "intent",
    "scope",
    "nonGoals",
    "assumptions",
    "unresolvedDecisions",
    "sourceTruthAuthorities",
    "domains",
    "contracts",
    "semanticModels",
    "operations",
    "components",
    "projects",
    "packages",
    "referenceRules",
    "extensions",
    "configuration",
    "featureActivations",
    "artifactDecisions",
    "representationRelationships",
    "boundaries",
    "scenarios",
    "statusClaims"
  ],
  "properties": {
    "title": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "intent": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "scope": {
      "$ref": "#/$defs/nonEmptyStringList"
    },
    "nonGoals": {
      "$ref": "#/$defs/nonEmptyStringList"
    },
    "assumptions": {
      "$ref": "#/$defs/stringList"
    },
    "unresolvedDecisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unresolvedDecision"
      }
    },
    "sourceTruthAuthorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceTruthAuthority"
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/domain"
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contract"
      }
    },
    "semanticModels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/semanticModel"
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package"
      }
    },
    "referenceRules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/referenceRule"
      }
    },
    "extensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/extension"
      }
    },
    "configuration": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/configuration"
      }
    },
    "featureActivations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/featureActivation"
      }
    },
    "artifactDecisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://schemas.orbyss.io/program-kit/architecture/1.0.0/artifact-decision.schema.json"
      }
    },
    "representationRelationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/representationRelationship"
      }
    },
    "boundaries": {
      "$ref": "#/$defs/boundaries"
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "statusClaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/statusClaim"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "nonEmptyStringList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "pkid": {
      "$ref": "https://schemas.orbyss.io/program-kit/artifacts/1.0.0/definitions.schema.json#/$defs/programKitIdentifier"
    },
    "nullablePkid": {
      "oneOf": [
        {
          "$ref": "#/$defs/pkid"
        },
        {
          "type": "null"
        }
      ]
    },
    "pkidList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/pkid"
      }
    },
    "semver": {
      "$ref": "https://schemas.orbyss.io/program-kit/artifacts/1.0.0/definitions.schema.json#/$defs/semanticVersion"
    },
    "artifactReference": {
      "$ref": "https://schemas.orbyss.io/program-kit/artifacts/1.0.0/definitions.schema.json#/$defs/artifactReference"
    },
    "artifactReferenceList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactReference"
      }
    },
    "unresolvedDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "ownerId",
        "question",
        "decisionNeededBy",
        "blockingEffect"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/pkid"
        },
        "ownerId": {
          "$ref": "#/$defs/pkid"
        },
        "question": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "decisionNeededBy": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "blockingEffect": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "sourceTruthAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "ownerId",
        "source",
        "sourcePath",
        "governs"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/pkid"
        },
        "ownerId": {
          "$ref": "#/$defs/pkid"
        },
        "source": {
          "$ref": "#/$defs/artifactReference"
        },
        "sourcePath": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "governs": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "vocabularyTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "term",
        "meaning",
        "acceptedAliases"
      ],
      "properties": {
        "term": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "meaning": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "acceptedAliases": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "purpose",
        "vocabulary"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "pattern": "^pkid:domain:[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "purpose": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "vocabulary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/vocabularyTerm"
          }
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "ownerDomainId",
        "kind",
        "version",
        "schema",
        "meaning",
        "compatibilityPolicy"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/pkid"
        },
        "ownerDomainId": {
          "$ref": "#/$defs/pkid"
        },
        "kind": {
          "enum": [
            "request",
            "response",
            "failure",
            "contribution",
            "configuration",
            "service",
            "value"
          ]
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "schema": {
          "$ref": "#/$defs/artifactReference"
        },
        "meaning": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "compatibilityPolicy": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "semanticModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "ownerDomainId",
        "meaning",
        "termContractIds",
        "invariants"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/pkid"
        },
        "ownerDomainId": {
          "$ref": "#/$defs/pkid"
        },
        "meaning": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "termContractIds": {
          "$ref": "#/$defs/pkidList"
        },
        "invariants": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "operationInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contracts",
        "allowsNoInput",
        "validationSemantics"
      ],
      "properties": {
        "contracts": {
          "$ref": "#/$defs/artifactReferenceList"
        },
        "allowsNoInput": {
          "type": "boolean"
        },
        "validationSemantics": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "operationOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contracts",
        "allowsNoOutput",
        "isStreaming",
        "completionSemantics"
      ],
      "properties": {
        "contracts": {
          "$ref": "#/$defs/artifactReferenceList"
        },
        "allowsNoOutput": {
          "type": "boolean"
        },
        "isStreaming": {
          "type": "boolean"
        },
        "completionSemantics": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "sideEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownerId",
        "effect",
        "commitBoundary",
        "compensationPolicy"
      ],
      "properties": {
        "ownerId": {
          "$ref": "#/$defs/pkid"
        },
        "effect": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "commitBoundary": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "compensationPolicy": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "operationSideEffects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isSideEffectFree",
        "effects"
      ],
      "properties": {
        "isSideEffectFree": {
          "type": "boolean"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sideEffect"
          }
        }
      }
    },
    "operationAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isRequired",
        "requirementIds",
        "evaluationPoint",
        "denialSemantics"
      ],
      "properties": {
        "isRequired": {
          "type": "boolean"
        },
        "requirementIds": {
          "$ref": "#/$defs/pkidList"
        },
        "evaluationPoint": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "denialSemantics": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "operationFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "code",
        "meaning",
        "isRetryable",
        "detailsContract"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/pkid"
        },
        "code": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "meaning": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "isRetryable": {
          "type": "boolean"
        },
        "detailsContract": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifactReference"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "operationFailures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaredFailures",
        "undeclaredFailurePolicy"
      ],
      "properties": {
        "declaredFailures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operationFailure"
          }
        },
        "undeclaredFailurePolicy": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "operationCancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isSupported",
        "acceptanceSemantics",
        "propagationSemantics",
        "completionRaceSemantics"
      ],
      "properties": {
        "isSupported": {
          "type": "boolean"
        },
        "acceptanceSemantics": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "propagationSemantics": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "completionRaceSemantics": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "operationIdempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "keySemantics",
        "duplicateSemantics"
      ],
      "properties": {
        "kind": {
          "enum": [
            "non-idempotent",
            "naturally-idempotent",
            "idempotency-key",
            "conditional"
          ]
        },
        "keySemantics": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "duplicateSemantics": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "operationCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimensions",
        "changePolicy",
        "migrationReferences"
      ],
      "properties": {
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://schemas.orbyss.io/program-kit/artifacts/1.0.0/definitions.schema.json#/$defs/compatibilityDimension"
          }
        },
        "changePolicy": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "migrationReferences": {
          "$ref": "#/$defs/artifactReferenceList"
        }
      }
    },
    "operationObservability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signals",
        "correlationSemantics",
        "sensitiveDataPolicy"
      ],
      "properties": {
        "signals": {
          "$ref": "#/$defs/nonEmptyStringList"
        },
        "correlationSemantics": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sensitiveDataPolicy": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "operationResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource",
        "ownerId",
        "acquisition",
        "release",
        "ownershipTransfers"
      ],
      "properties": {
        "resource": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "ownerId": {
          "$ref": "#/$defs/pkid"
        },
        "acquisition": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "release": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "ownershipTransfers": {
          "type": "boolean"
        }
      }
    },
    "operationResourceOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resources",
        "disposalSemantics"
      ],
      "properties": {
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operationResource"
          }
        },
        "disposalSemantics": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "ownerDomainId",
        "purpose",
        "input",
        "output",
        "sideEffects",
        "authority",
        "failures",
        "cancellation",
        "idempotency",
        "compatibility",
        "observability",
        "resourceOwnership"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/pkid"
        },
        "ownerDomainId": {
          "$ref": "#/$defs/pkid"
        },
        "purpose": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "input": {
          "$ref": "#/$defs/operationInput"
        },
        "output": {
          "$ref": "#/$defs/operationOutput"
        },
        "sideEffects": {
          "$ref": "#/$defs/operationSideEffects"
        },
        "authority": {
          "$ref": "#/$defs/operationAuthority"
        },
        "failures": {
          "$ref": "#/$defs/operationFailures"
        },
        "cancellation": {
          "$ref": "#/$defs/operationCancellation"
        },
        "idempotency": {
          "$ref": "#/$defs/operationIdempotency"
        },
        "compatibility": {
          "$ref": "#/$defs/operationCompatibility"
        },
        "observability": {
          "$ref": "#/$defs/operationObservability"
        },
        "resourceOwnership": {
          "$ref": "#/$defs/operationResourceOwnership"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "ownerId",
        "kind",
        "purpose",
        "providesContractIds",
        "consumesContractIds",
        "isActivatable",
        "compatibilityBoundary"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/pkid"
        },
        "ownerId": {
          "$ref": "#/$defs/pkid"
        },
        "kind": {
          "enum": [
            "domain-core",
            "feature",
            "provider",
            "focused-helper",
            "bridge",
            "host",
            "design-time-source",
            "read-projection",
            "evaluated-artifact"
          ]
        },
        "purpose": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "providesContractIds": {
          "$ref": "#/$defs/pkidList"
        },
        "consumesContractIds": {
          "$ref": "#/$defs/pkidList"
        },
        "isActivatable": {
          "type": "boolean"
        },
        "compatibilityBoundary": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "ownerId",
        "projectPath",
        "componentIds",
        "projectReferenceIds",
        "packageId"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/pkid"
        },
        "ownerId": {
          "$ref": "#/$defs/pkid"
        },
        "projectPath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\).+$"
        },
        "componentIds": {
          "allOf": [
            {
              "$ref": "#/$defs/pkidList"
            },
            {
              "minItems": 1
            }
          ]
        },
        "projectReferenceIds": {
          "$ref": "#/$defs/pkidList"
        },
        "packageId": {
          "$ref": "#/$defs/nullablePkid"
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "ownerId",
        "version",
        "projectIds",
        "packageDependencyIds",
        "publicContractIds",
        "compatibilityBoundary"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/pkid"
        },
        "ownerId": {
          "$ref": "#/$defs/pkid"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "projectIds": {
          "allOf": [
            {
              "$ref": "#/$defs/pkidList"
            },
            {
              "minItems": 1
            }
          ]
        },
        "packageDependencyIds": {
          "$ref": "#/$defs/pkidList"
        },
        "publicContractIds": {
          "$ref": "#/$defs/pkidList"
        },
        "compatibilityBoundary": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "sourceTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "path"
      ],
      "properties": {
        "artifact": {
          "$ref": "#/$defs/artifactReference"
        },
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "referenceRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "ownerId",
        "disposition",
        "referencingScope",
        "referencedScope",
        "ownerInput",
        "rationale"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/pkid"
        },
        "ownerId": {
          "$ref": "#/$defs/pkid"
        },
        "disposition": {
          "enum": [
            "allowed",
            "forbidden"
          ]
        },
        "referencingScope": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "referencedScope": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "ownerInput": {
          "$ref": "#/$defs/sourceTrace"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "replacementSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cardinality",
        "selectionRule",
        "fallbackSemantics",
        "failureSemantics"
      ],
      "properties": {
        "cardinality": {
          "enum": [
            "exactly-one",
            "zero-or-one"
          ]
        },
        "selectionRule": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "fallbackSemantics": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "failureSemantics": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "additiveSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cardinality",
        "stableOrdering",
        "aggregationSemantics",
        "partialOrFailFastSemantics"
      ],
      "properties": {
        "cardinality": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "stableOrdering": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "aggregationSemantics": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "partialOrFailFastSemantics": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "eventSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deliveryGuarantee",
        "orderingScope",
        "retrySemantics",
        "duplicationSemantics",
