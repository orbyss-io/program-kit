{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/architecture/1.0.0/artifact-decision.schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:artifact-decision",
  "x-program-kit-version": "1.0.0",
  "title": "Program Kit artifact decision",
  "description": "The answered nine-question intent-to-artifact decision.",
  "$comment": "SupportedArtifactKindOwnershipResolver is the canonical identity-kind and owner-kind mapping. ArtifactDecisionValidator enforces that mapping; schema structure alone does not infer semantic ownership.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity",
    "ownerId",
    "requestedOutcome",
    "artifactKind",
    "executableBehavior",
    "valueLifecycle",
    "agentRetrieval",
    "agentProcedure",
    "humanCommunication",
    "generatedNavigation",
    "representation",
    "governance",
    "dataHandling",
    "rationale"
  ],
  "properties": {
    "identity": {
      "$ref": "#/$defs/pkid"
    },
    "ownerId": {
      "$ref": "#/$defs/pkid"
    },
    "requestedOutcome": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "artifactKind": {
      "$ref": "#/$defs/supportedArtifactKind"
    },
    "executableBehavior": {
      "$ref": "#/$defs/executableBehavior"
    },
    "valueLifecycle": {
      "$ref": "#/$defs/valueLifecycle"
    },
    "agentRetrieval": {
      "$ref": "#/$defs/agentRetrieval"
    },
    "agentProcedure": {
      "$ref": "#/$defs/agentProcedure"
    },
    "humanCommunication": {
      "$ref": "#/$defs/humanCommunication"
    },
    "generatedNavigation": {
      "$ref": "#/$defs/generatedNavigation"
    },
    "representation": {
      "$ref": "#/$defs/representation"
    },
    "governance": {
      "$ref": "#/$defs/governance"
    },
    "dataHandling": {
      "$ref": "#/$defs/dataHandling"
    },
    "rationale": {
      "$ref": "#/$defs/nonEmptyString"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "pkid": {
      "$ref": "https://schemas.orbyss.io/program-kit/artifacts/1.0.0/definitions.schema.json#/$defs/programKitIdentifier"
    },
    "artifactReference": {
      "$ref": "https://schemas.orbyss.io/program-kit/artifacts/1.0.0/definitions.schema.json#/$defs/artifactReference"
    },
    "supportedArtifactKind": {
      "type": "string",
      "description": "A closed artifact-kind selection whose canonical ownership rule is resolved by SupportedArtifactKindOwnershipResolver.",
      "enum": [
        "source-code",
        "project-configuration",
        "package-configuration",
        "schema",
        "schema-instance",
        "configuration",
        "generated-manifest",
        "generated-catalog",
        "generated-index",
        "provider-neutral-agent-instruction",
        "provider-neutral-agent-capability",
        "human-document",
        "human-decision-record",
        "test-specification",
        "test-profile",
        "test-fixture",
        "generated-code",
        "generated-document",
        "contract-defined-ephemeral-state",
        "open-api-document",
        "open-console-document",
        "open-worker-document",
        "version-component",
        "version-selection",
        "version-map",
        "migration-definition",
        "migration-impact-assessment",
        "json-serialization-profile",
        "json-serialization-contribution",
        "canonical-json-value",
        "task-definition",
        "task-schedule-descriptor",
        "host-composition",
        "local-publish-manifest",
        "generated-health-configuration"
      ]
    },
    "executableBehavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isRequired",
        "rationale"
      ],
      "properties": {
        "isRequired": {
          "type": "boolean"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "valueLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uses",
        "rationale"
      ],
      "properties": {
        "uses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "validated",
              "exchanged",
              "persisted",
              "compared",
              "digested"
            ]
          }
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "agentRetrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isRequired",
        "retrievalBoundary",
        "rationale"
      ],
      "properties": {
        "isRequired": {
          "type": "boolean"
        },
        "retrievalBoundary": {
          "type": "string"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "isRequired": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "retrievalBoundary": {
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "retrievalBoundary": {
                "maxLength": 0
              }
            }
          }
        }
      ]
    },
    "agentProcedure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isRequired",
        "humanStartBoundary",
        "procedureBoundary",
        "rationale"
      ],
      "properties": {
        "isRequired": {
          "type": "boolean"
        },
        "humanStartBoundary": {
          "type": "string"
        },
        "procedureBoundary": {
          "type": "string"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "isRequired": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "humanStartBoundary": {
                "minLength": 1
              },
              "procedureBoundary": {
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "humanStartBoundary": {
                "maxLength": 0
              },
              "procedureBoundary": {
                "maxLength": 0
              }
            }
          }
        }
      ]
    },
    "humanCommunication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isRequired",
        "audience",
        "decisionAuthorityBoundary",
        "rationale"
      ],
      "properties": {
        "isRequired": {
          "type": "boolean"
        },
        "audience": {
          "type": "string"
        },
        "decisionAuthorityBoundary": {
          "type": "string"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "isRequired": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "audience": {
                "minLength": 1
              },
              "decisionAuthorityBoundary": {
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "audience": {
                "maxLength": 0
              },
              "decisionAuthorityBoundary": {
                "maxLength": 0
              }
            }
          }
        }
      ]
    },
    "generatedNavigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isRequired",
        "sourceIds",
        "generationRule",
        "rationale"
      ],
      "properties": {
        "isRequired": {
          "type": "boolean"
        },
        "sourceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pkid"
          }
        },
        "generationRule": {
          "type": "string"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "isRequired": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "sourceIds": {
                "minItems": 1
              },
              "generationRule": {
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "sourceIds": {
                "maxItems": 0
              },
              "generationRule": {
                "maxLength": 0
              }
            }
          }
        }
      ]
    },
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "canonicalArtifactId",
        "projectionRule",
        "lossPolicy"
      ],
      "properties": {
        "role": {
          "enum": [
            "canonical",
            "projection",
            "ephemeral"
          ]
        },
        "canonicalArtifactId": {
          "oneOf": [
            {
              "$ref": "#/$defs/pkid"
            },
            {
              "type": "null"
            }
          ]
        },
        "projectionRule": {
          "type": "string"
        },
        "lossPolicy": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "canonical"
              }
            }
          },
          "then": {
            "properties": {
              "canonicalArtifactId": {
                "type": "null"
              },
              "projectionRule": {
                "maxLength": 0
              },
              "lossPolicy": {
                "maxLength": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "projection"
              }
            }
          },
          "then": {
            "properties": {
              "canonicalArtifactId": {
                "$ref": "#/$defs/pkid"
              },
              "projectionRule": {
                "minLength": 1
              },
              "lossPolicy": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "ephemeral"
              }
            }
          },
          "then": {
            "properties": {
              "canonicalArtifactId": {
                "type": "null"
              },
              "projectionRule": {
                "maxLength": 0
              },
              "lossPolicy": {
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactIdentity",
        "ownerId",
        "schema",
        "provenancePolicy",
        "digestPolicy",
        "consumerIds",
        "compatibilityPolicy",
        "migrationPolicy"
      ],
      "properties": {
        "artifactIdentity": {
          "$ref": "#/$defs/pkid"
        },
        "ownerId": {
          "$ref": "#/$defs/pkid"
        },
        "schema": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifactReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "provenancePolicy": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "digestPolicy": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "consumerIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pkid"
          }
        },
        "compatibilityPolicy": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "migrationPolicy": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "dataHandling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "containsSensitiveData",
        "redactionPolicy",
        "externalizationPolicy",
        "containsEphemeralData",
        "ephemeralDataPolicy"
      ],
      "properties": {
        "containsSensitiveData": {
          "type": "boolean"
        },
        "redactionPolicy": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "externalizationPolicy": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "containsEphemeralData": {
          "type": "boolean"
        },
        "ephemeralDataPolicy": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  }
}
