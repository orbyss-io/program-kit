{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/task-schedules/0.1.0-alpha.1/delay-once.schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:delay-once-schedule-descriptor",
  "x-program-kit-version": "0.1.0-alpha.1",
  "title": "DelayOnceScheduleDescriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "delay"
  ],
  "properties": {
    "delay": {
      "type": "string",
      "pattern": "^(?:[0-9]+\\.)?(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,7})?$"
    }
  }
}
