{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/task-schedules/0.1.0-alpha.1/anchored-fixed-interval.schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:anchored-fixed-interval-schedule-descriptor",
  "x-program-kit-version": "0.1.0-alpha.1",
  "title": "AnchoredFixedIntervalScheduleDescriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "anchor",
    "period"
  ],
  "properties": {
    "anchor": {
      "type": "string",
      "format": "date-time"
    },
    "period": {
      "type": "string",
      "pattern": "^(?:[0-9]+\\.)?(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,7})?$",
      "not": {
        "const": "00:00:00"
      }
    }
  }
}
