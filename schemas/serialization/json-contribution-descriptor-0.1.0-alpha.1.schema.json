{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/serialization/0.1.0-alpha.1/json-contribution-descriptor.schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:json-contribution-descriptor",
  "x-program-kit-version": "0.1.0-alpha.1",
  "title": "JsonSerializationContributionDescriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reference",
    "owningPackage",
    "applicableProfileId",
    "applicableProfileRange",
    "kind",
    "targetTypeFamilies",
    "before",
    "after"
  ],
  "properties": {
    "reference": {
      "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/contributionReference"
    },
    "owningPackage": {
      "allOf": [
        {
          "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/programKitIdentifier"
        },
        {
          "pattern": "^pkid:package:"
        }
      ]
    },
    "applicableProfileId": {
      "allOf": [
        {
          "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/programKitIdentifier"
        },
        {
          "pattern": "^pkid:profile:"
        }
      ]
    },
    "applicableProfileRange": {
      "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/semanticVersionRange"
    },
    "kind": {
      "enum": [
        "typed-converter",
        "converter-factory",
        "type-info-resolver"
      ]
    },
    "targetTypeFamilies": {
      "description": "Ordered JsonTargetTypeIdentity values that exactly match retained runtime Type claims; converter factories may use open generic definitions.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "before": {
      "$ref": "#/$defs/contributionIdentities"
    },
    "after": {
      "$ref": "#/$defs/contributionIdentities"
    }
  },
  "$defs": {
    "contributionIdentities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "allOf": [
          {
            "$ref": "definitions-0.1.0-alpha.1.schema.json#/$defs/programKitIdentifier"
          },
          {
            "pattern": "^pkid:json-contribution:"
          }
        ]
      }
    }
  }
}
