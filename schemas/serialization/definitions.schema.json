{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orbyss.io/program-kit/serialization/1.0.0/definitions.schema.json",
  "x-program-kit-identity": "pkid:schema:program-kit:serialization-definitions",
  "x-program-kit-version": "1.0.0",
  "title": "Serialization JSON definitions",
  "$defs": {
    "programKitIdentifier": {
      "type": "string",
      "pattern": "^pkid:[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "semanticVersionRange": {
      "type": "string",
      "minLength": 1
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "profileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "version",
        "digest"
      ],
      "properties": {
        "identity": {
          "allOf": [
            {
              "$ref": "#/$defs/programKitIdentifier"
            },
            {
              "pattern": "^pkid:profile:"
            }
          ]
        },
        "version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "digest": {
          "$ref": "#/$defs/sha256Digest"
        }
      }
    },
    "contributionReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "version",
        "digest"
      ],
      "properties": {
        "identity": {
          "allOf": [
            {
              "$ref": "#/$defs/programKitIdentifier"
            },
            {
              "pattern": "^pkid:json-contribution:"
            }
          ]
        },
        "version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "digest": {
          "$ref": "#/$defs/sha256Digest"
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceGeneratedMetadataOnly",
        "schemaDeclaredPropertyNames",
        "caseSensitiveReads",
        "disallowComments",
        "disallowTrailingCommas",
        "disallowUnmappedMembers",
        "writeNullProperties",
        "strictNumbers",
        "disallowReferencePreservation",
        "requireNfcStrings"
      ],
      "properties": {
        "sourceGeneratedMetadataOnly": {
          "const": true
        },
        "schemaDeclaredPropertyNames": {
          "const": true
        },
        "caseSensitiveReads": {
          "const": true
        },
        "disallowComments": {
          "const": true
        },
        "disallowTrailingCommas": {
          "const": true
        },
        "disallowUnmappedMembers": {
          "const": true
        },
        "writeNullProperties": {
          "const": true
        },
        "strictNumbers": {
          "const": true
        },
        "disallowReferencePreservation": {
          "const": true
        },
        "requireNfcStrings": {
          "const": true
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxUtf8Bytes",
        "maxDepth",
        "maxTokens",
        "maxObjectMembers",
        "maxBufferedObjectBytes"
      ],
      "properties": {
        "maxUtf8Bytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "maxTokens": {
          "type": "integer",
          "minimum": 1
        },
        "maxObjectMembers": {
          "type": "integer",
          "minimum": 1
        },
        "maxBufferedObjectBytes": {
          "description": "Maximum complete canonical bytes retained while sorting one object, including braces, commas, names, separators, and values.",
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
