{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.program-kit.dev/v1/authority-grant.schema.json",
  "title": "Program Kit Authority Grant v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "canonicalProfile",
    "identity",
    "issuerAssertion",
    "subjects",
    "operations",
    "effects",
    "conditions",
    "validity",
    "revocationReference",
    "provenance"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "program-kit.authority-grant/v1"
    },
    "canonicalProfile": {
      "$ref": "common.schema.json#/$defs/canonicalProfile"
    },
    "identity": {
      "$ref": "common.schema.json#/$defs/governedIdentity"
    },
    "issuerAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "issuer",
        "assurance"
      ],
      "properties": {
        "provider": {
          "$ref": "common.schema.json#/$defs/governedIdentity"
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "assurance": {
          "type": "string",
          "enum": [
            "repository-record-presence"
          ]
        }
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/typedSubject"
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "explain",
          "session-install",
          "session-remove",
          "construct",
          "evaluate"
        ]
      }
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "none",
          "candidate-only",
          "committed"
        ]
      }
    },
    "requestBinding": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "lockBinding": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "value"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "value": {
            "$ref": "common.schema.json#/$defs/safeValue"
          }
        }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notBefore",
        "notAfter"
      ],
      "properties": {
        "notBefore": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "notAfter": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    "revocationReference": {
      "$ref": "common.schema.json#/$defs/artifactReference"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/artifactReference"
    }
  },
  "anyOf": [
    {
      "required": [
        "requestBinding"
      ]
    },
    {
      "required": [
        "lockBinding"
      ]
    }
  ]
}
