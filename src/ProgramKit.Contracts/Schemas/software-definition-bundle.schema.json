{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.program-kit.dev/v1/software-definition-bundle.schema.json",
  "title": "Program Kit Software-definition Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "canonicalProfile",
    "identity",
    "semanticRecords",
    "implementationRecords",
    "relationships",
    "profiles",
    "selections",
    "dispositions"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "program-kit.software-definition-bundle/v1"
    },
    "canonicalProfile": {
      "$ref": "common.schema.json#/$defs/canonicalProfile"
    },
    "identity": {
      "$ref": "common.schema.json#/$defs/governedIdentity"
    },
    "semanticRecords": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/artifactReference"
      }
    },
    "implementationRecords": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/artifactReference"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationshipAssertion"
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/governedIdentity"
      }
    },
    "selections": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/exactSelection"
      }
    },
    "dispositions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/disposition"
      }
    }
  },
  "$defs": {
    "relationshipAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "from",
        "to",
        "contract",
        "cardinality",
        "trace"
      ],
      "properties": {
        "identity": {
          "$ref": "common.schema.json#/$defs/governedIdentity"
        },
        "from": {
          "$ref": "common.schema.json#/$defs/governedIdentity"
        },
        "to": {
          "$ref": "common.schema.json#/$defs/governedIdentity"
        },
        "contract": {
          "$ref": "common.schema.json#/$defs/governedIdentity"
        },
        "cardinality": {
          "type": "string",
          "enum": [
            "one-to-one",
            "one-to-many",
            "many-to-one",
            "many-to-many"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mapping": {
          "$ref": "common.schema.json#/$defs/governedIdentity"
        },
        "trace": {
          "$ref": "common.schema.json#/$defs/traceReference"
        }
      }
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "state",
        "trace"
      ],
      "properties": {
        "subject": {
          "$ref": "common.schema.json#/$defs/governedIdentity"
        },
        "state": {
          "type": "string",
          "enum": [
            "required",
            "selected",
            "unsupported",
            "deferred",
            "excluded"
          ]
        },
        "trace": {
          "$ref": "common.schema.json#/$defs/traceReference"
        }
      }
    }
  }
}
