{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.program-kit.dev/v1/session-provider-manifest.schema.json",
  "title": "Program Kit Session Provider Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "canonicalProfile",
    "providerIdentity",
    "adapterIdentity",
    "definitionBinding",
    "bindingKind",
    "supportedScopes",
    "providerSurface",
    "projectionDescriptors",
    "requiredOperations",
    "diagnosticCatalog",
    "conformanceProfile",
    "supportClaim"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "program-kit.session-provider-manifest/v1"
    },
    "canonicalProfile": {
      "$ref": "https://schemas.program-kit.dev/v1/common.schema.json#/$defs/canonicalProfile"
    },
    "providerIdentity": {
      "$ref": "https://schemas.program-kit.dev/v1/common.schema.json#/$defs/governedIdentity"
    },
    "adapterIdentity": {
      "$ref": "https://schemas.program-kit.dev/v1/common.schema.json#/$defs/governedIdentity"
    },
    "definitionBinding": {
      "$ref": "https://schemas.program-kit.dev/v1/common.schema.json#/$defs/governedIdentity"
    },
    "bindingKind": {
      "type": "string",
      "enum": [
        "shell-cli"
      ]
    },
    "supportedScopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "const": "workspace"
      }
    },
    "providerSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerName",
        "surfaceName",
        "surfaceRevision",
        "testedVersions",
        "discovery",
        "reloadBehavior",
        "structuredResultTransport"
      ],
      "properties": {
        "providerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "surfaceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "surfaceRevision": {
          "$ref": "https://schemas.program-kit.dev/v1/common.schema.json#/$defs/revision"
        },
        "testedVersions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          }
        },
        "discovery": {
          "type": "string",
          "enum": [
            "repository-skill"
          ]
        },
        "reloadBehavior": {
          "type": "string",
          "enum": [
            "automatic-or-fresh-session"
          ]
        },
        "structuredResultTransport": {
          "type": "string",
          "const": "json-stdout"
        }
      }
    },
    "projectionDescriptors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/projectionDescriptor"
      }
    },
    "requiredOperations": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "explain",
          "construct",
          "evaluate",
          "session-explain",
          "session-install",
          "session-verify",
          "session-remove"
        ]
      }
    },
    "diagnosticCatalog": {
      "$ref": "https://schemas.program-kit.dev/v1/common.schema.json#/$defs/governedIdentity"
    },
    "conformanceProfile": {
      "$ref": "https://schemas.program-kit.dev/v1/common.schema.json#/$defs/governedIdentity"
    },
    "supportClaim": {
      "type": "string",
      "enum": [
        "supported",
        "incompatible",
        "not-evaluated"
      ]
    }
  },
  "$defs": {
    "projectionDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "logicalPath",
        "mediaType",
        "ownership",
        "claimClass",
        "removalPolicy"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "session-capability",
            "provider-metadata"
          ]
        },
        "logicalPath": {
          "$ref": "https://schemas.program-kit.dev/v1/common.schema.json#/$defs/logicalPath"
        },
        "mediaType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 150
        },
        "ownership": {
          "type": "string",
          "const": "generated-owned"
        },
        "claimClass": {
          "type": "string",
          "const": "canonical-byte"
        },
        "removalPolicy": {
          "type": "string",
          "const": "exact-admitted-digest-only"
        }
      }
    }
  }
}

