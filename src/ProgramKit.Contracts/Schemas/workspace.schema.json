{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.program-kit.dev/v1/workspace.schema.json",
  "title": "Program Kit Workspace Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "distribution", "factory"],
  "properties": {
    "schema": { "const": "program-kit.workspace/v1" },
    "distribution": { "$ref": "distribution-binding.schema.json" },
    "factory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selections"],
      "properties": {
        "selections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["alias", "provider", "targetProfile", "selectionAuthority"],
            "properties": {
              "alias": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
              "provider": { "$ref": "common.schema.json#/$defs/governedIdentity" },
              "targetProfile": { "$ref": "common.schema.json#/$defs/governedIdentity" },
              "selectionAuthority": { "$ref": "common.schema.json#/$defs/governedIdentity" }
            }
          }
        },
        "defaultSelection": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
      }
    }
  }
}
