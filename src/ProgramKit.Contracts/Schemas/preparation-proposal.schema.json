{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.program-kit.dev/v1/preparation-proposal.schema.json",
  "title": "Program Kit Preparation Proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "canonicalProfile", "requestBinding", "closureDigest", "liveStateDigest", "subjects", "operation", "constructionMode", "maximumEffect", "explanation", "authorityRequirements", "ungrantedProjection", "evidence", "digest"],
  "properties": {
    "schema": { "const": "program-kit.preparation-proposal/v1" },
    "canonicalProfile": { "$ref": "common.schema.json#/$defs/canonicalProfile" },
    "requestBinding": { "$ref": "common.schema.json#/$defs/digest" },
    "closureDigest": { "$ref": "common.schema.json#/$defs/digest" },
    "liveStateDigest": { "$ref": "common.schema.json#/$defs/digest" },
    "subjects": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/governedIdentity" } },
    "operation": { "const": "construct" },
    "constructionMode": { "enum": ["new", "repair"] },
    "maximumEffect": { "enum": ["candidate-only", "committed"] },
    "explanation": { "type": "object" },
    "authorityRequirements": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "ungrantedProjection": { "type": "object" },
    "evidence": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/evidenceReference" } },
    "digest": { "$ref": "common.schema.json#/$defs/digest" }
  }
}
