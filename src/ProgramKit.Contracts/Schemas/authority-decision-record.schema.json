{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.program-kit.dev/v1/authority-decision-record.schema.json",
  "title": "Program Kit Human Authority Decision Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "canonicalProfile", "proposal", "reviewer", "decision", "subjects", "operations", "effects", "conditions", "validity", "provenance", "recordedAt"],
  "properties": {
    "schema": { "const": "program-kit.authority-decision-record/v1" },
    "canonicalProfile": { "$ref": "common.schema.json#/$defs/canonicalProfile" },
    "proposal": { "$ref": "common.schema.json#/$defs/artifactReference" },
    "reviewer": { "type": "string", "minLength": 1, "maxLength": 300 },
    "decision": { "enum": ["approve", "deny"] },
    "subjects": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/governedIdentity" } },
    "operations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "const": "construct" } },
    "effects": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["candidate-only", "committed"] } },
    "conditions": { "type": "array", "items": { "type": "object" } },
    "validity": { "type": "object", "additionalProperties": false, "required": ["notBefore", "notAfter"], "properties": { "notBefore": { "type": "string", "format": "date-time" }, "notAfter": { "type": "string", "format": "date-time" } } },
    "provenance": { "$ref": "common.schema.json#/$defs/artifactReference" },
    "recordedAt": { "type": "string", "format": "date-time" }
  }
}
