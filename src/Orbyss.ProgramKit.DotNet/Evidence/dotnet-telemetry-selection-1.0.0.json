  "policies": {
    "propagation": "W3C Trace Context only; baggage forwarding is disabled unless a future exact allowlisting adapter is selected",
    "httpInstrumentation": "framework/OpenTelemetry instrumentation exactly once; no custom HTTP server or client spans",
    "httpDiagnostics": "method, path, status, and duration only; no headers or bodies",
    "exceptions": "recorded by selected ASP.NET Core instrumentation; response behavior remains outside telemetry",
    "exportFailure": "bounded drop-and-report; application success is unchanged",
    "authority": "non-authoritative diagnostics only; never audit, compliance, authorization, or business-event truth"
  }
