<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Orbyss.ProgramKit.Architecture</PackageId>
    <Description>Universal architecture, operation, extension, artifact-decision, and structural-pattern contracts for Orbyss Program Kit.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Orbyss.ProgramKit.Artifacts\Orbyss.ProgramKit.Artifacts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\schemas\architecture\**\*.json"
                      LogicalName="Orbyss.ProgramKit.Architecture.Schemas.%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\schemas\architecture\**\*.json"
          Pack="true"
          PackagePath="schemas/architecture/%(RecursiveDir)"
          Link="Schemas/Architecture/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
