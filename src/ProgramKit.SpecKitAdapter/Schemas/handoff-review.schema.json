{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.program-kit.dev/v1/spec-kit-handoff-review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "handoff", "reviewer", "decision", "reviewedFields", "limitations", "recordedAt", "digest"],
  "properties": {
    "schema": { "const": "program-kit.spec-kit-handoff-review/v1" },
    "handoff": { "type": "object" },
    "reviewer": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["approved", "rejected"] },
    "reviewedFields": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^/" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "recordedAt": { "type": "string", "format": "date-time" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
