<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Orbyss.ProgramKit.Tasks.Core</PackageId>
    <Description>Domain-neutral task meaning, typed execution contracts, lifecycle views, and schedule occurrence contracts.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Orbyss.ProgramKit.Artifacts.Diagnostics" />
    <Using Include="Orbyss.ProgramKit.Artifacts.Primitives" />
    <Using Include="Orbyss.ProgramKit.Artifacts.References" />
    <Using Include="Orbyss.ProgramKit.Artifacts.Schemas" />
    <Using Include="System.Collections.Immutable" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Orbyss.ProgramKit.Artifacts\Orbyss.ProgramKit.Artifacts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\schemas\tasks\**\*.json"
                      LogicalName="Orbyss.ProgramKit.Tasks.Core.Schemas.%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\schemas\tasks\**\*.json"
          Pack="true"
          PackagePath="schemas/tasks/%(RecursiveDir)"
          Link="Schemas/Tasks/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
