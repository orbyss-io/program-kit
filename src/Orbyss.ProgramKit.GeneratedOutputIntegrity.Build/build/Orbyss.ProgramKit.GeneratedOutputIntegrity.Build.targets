<Project>
  <PropertyGroup>
    <ProgramKitGeneratedOutputIntegrityTaskAssembly
      Condition="'$(ProgramKitGeneratedOutputIntegrityTaskAssembly)' == ''">$(MSBuildThisFileDirectory)..\tools\net10.0\Orbyss.ProgramKit.GeneratedOutputIntegrity.Build.dll</ProgramKitGeneratedOutputIntegrityTaskAssembly>
    <ProgramKitGeneratedOutputIntegrityAttestation
      Condition="'$(ProgramKitGeneratedOutputIntegrityAttestation)' == ''">$(IntermediateOutputPath)program-kit-generated-output-integrity\ProgramKitGeneratedIntegrityAttestation.g.cs</ProgramKitGeneratedOutputIntegrityAttestation>
  </PropertyGroup>

  <UsingTask
    TaskName="Orbyss.ProgramKit.GeneratedOutputIntegrity.Build.Operations.Execution.VerifyGeneratedOutputTask"
    AssemblyFile="$(ProgramKitGeneratedOutputIntegrityTaskAssembly)" />

  <Target Name="ProgramKitVerifyGeneratedOutput"
          BeforeTargets="CoreCompile">
    <VerifyGeneratedOutputTask
      RootPath="$(MSBuildProjectDirectory)"
      AttestationPath="$(ProgramKitGeneratedOutputIntegrityAttestation)" />
    <ItemGroup>
      <Compile Include="$(ProgramKitGeneratedOutputIntegrityAttestation)"
               ProgramKitGeneratedOutputIntegrityAttestation="true" />
    </ItemGroup>
  </Target>
</Project>
