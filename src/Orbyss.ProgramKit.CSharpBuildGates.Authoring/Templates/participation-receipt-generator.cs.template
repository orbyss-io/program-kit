using System.Text;
using Microsoft.CodeAnalysis;
using Microsoft.CodeAnalysis.Text;

namespace {{ROOT_NAMESPACE}};

[Generator(LanguageNames.CSharp)]
public sealed class {{RECEIPT_GENERATOR_CLASS}} : IIncrementalGenerator
{
    private const string NonceProperty =
        "build_property.ProgramKitCompilerInvocationNonce";
    private const string ProjectProperty =
        "build_property.MSBuildProjectName";
    private const string ProfileProperty =
        "build_property.ProgramKitCSharpGateVerificationProfile";

    public void Initialize(IncrementalGeneratorInitializationContext context)
    {
        context.RegisterSourceOutput(
            context.AnalyzerConfigOptionsProvider,
            static (productionContext, optionsProvider) =>
            {
                if (!optionsProvider.GlobalOptions.TryGetValue(
                        NonceProperty,
                        out var nonce) ||
                    nonce.Length != 32 ||
                    nonce.Any(character => !Uri.IsHexDigit(character)))
                {
                    return;
                }

                _ = optionsProvider.GlobalOptions.TryGetValue(
                    ProjectProperty,
                    out var project);
                _ = optionsProvider.GlobalOptions.TryGetValue(
                    ProfileProperty,
                    out var profile);
                var source = string.Concat(
                    "// <auto-generated/>\n",
                    "// PKCG participation-receipt analyzer={{PROJECT_NAME}}",
                    " nonce=", nonce.ToLowerInvariant(),
                    " project=", project ?? string.Empty,
                    " profile=", profile ?? string.Empty,
                    "\n");
                productionContext.AddSource(
                    "{{PROJECT_NAME}}ParticipationReceipt." +
                    nonce.ToLowerInvariant() +
                    ".g.cs",
                    SourceText.From(source, Encoding.UTF8));
            });
    }
}
