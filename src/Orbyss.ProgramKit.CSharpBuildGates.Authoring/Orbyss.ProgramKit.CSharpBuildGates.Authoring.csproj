<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Orbyss.ProgramKit.CSharpBuildGates.Authoring</PackageId>
    <RootNamespace>Orbyss.ProgramKit.CSharpBuildGates.Authoring</RootNamespace>
    <Description>Inert Roslyn authoring helpers, optional recipes, and transactional consumer-owned analyzer scaffolding.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <DevelopmentDependency>true</DevelopmentDependency>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Orbyss.ProgramKit.CSharpBuildGates.Contracts\Orbyss.ProgramKit.CSharpBuildGates.Contracts.csproj" />
    <Reference Include="Microsoft.CodeAnalysis"
               HintPath="$(MSBuildToolsPath)\Roslyn\bincore\Microsoft.CodeAnalysis.dll"
               Private="false" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp"
               HintPath="$(MSBuildToolsPath)\Roslyn\bincore\Microsoft.CodeAnalysis.CSharp.dll"
               Private="false" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <EmbeddedResource Include="Recipes\*.json"
                      LogicalName="Orbyss.ProgramKit.CSharpBuildGates.Authoring.Recipes.%(Filename)%(Extension)" />
    <None Include="Recipes\*.json" Pack="true" PackagePath="recipes/" />
    <EmbeddedResource Include="Templates\*.template"
                      LogicalName="Orbyss.ProgramKit.CSharpBuildGates.Authoring.Templates.%(Filename)%(Extension)"
                      WithCulture="false" />
    <None Include="Templates\*.template" Pack="true" PackagePath="templates/" />
  </ItemGroup>
</Project>
