<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Orbyss.ProgramKit.Tasks.Schedules</PackageId>
    <Description>Provider-neutral typed one-shot, fixed-delay, and anchored fixed-interval task schedule helpers.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Orbyss.ProgramKit.Tasks.Core\Orbyss.ProgramKit.Tasks.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\schemas\task-schedules\**\*.json"
                      LogicalName="Orbyss.ProgramKit.Tasks.Schedules.Schemas.%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\schemas\task-schedules\**\*.json"
          Pack="true"
          PackagePath="schemas/task-schedules/%(RecursiveDir)"
          Link="Schemas/TaskSchedules/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
