<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Orbyss.ProgramKit.SecretResolution</PackageId>
    <Description>Provider-neutral typed secret reference, resolution, lifecycle, rotation, and consumer-reaction contracts for Orbyss Program Kit.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Orbyss.ProgramKit.Artifacts\Orbyss.ProgramKit.Artifacts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Orbyss.ProgramKit.Artifacts.Compatibility" />
    <Using Include="Orbyss.ProgramKit.Artifacts.Diagnostics" />
    <Using Include="Orbyss.ProgramKit.Artifacts.Envelopes" />
    <Using Include="Orbyss.ProgramKit.Artifacts.Primitives" />
    <Using Include="Orbyss.ProgramKit.Artifacts.References" />
    <Using Include="Orbyss.ProgramKit.Artifacts.Schemas" />
    <Using Include="Orbyss.ProgramKit.Artifacts.Validation" />
    <Using Include="System.Collections.Immutable" />
    <Using Include="System.Text.Json.Serialization" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\schemas\secret-resolution\1.0.0\*.json"
                      LogicalName="Orbyss.ProgramKit.SecretResolution.Schemas.v1_0_0.%(Filename)%(Extension)" />
    <None Include="..\..\schemas\secret-resolution\**\*.json"
          Pack="true"
          PackagePath="schemas/secret-resolution/"
          Link="Schemas/SecretResolution/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
