<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Orbyss.ProgramKit.Artifacts</PackageId>
    <Description>Universal artifact identity, integrity, provenance, compatibility, version, and migration contracts for Orbyss Program Kit.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Orbyss.ProgramKit.Artifacts.Compatibility" />
    <Using Include="Orbyss.ProgramKit.Artifacts.Diagnostics" />
    <Using Include="Orbyss.ProgramKit.Artifacts.Envelopes" />
    <Using Include="Orbyss.ProgramKit.Artifacts.Migrations" />
    <Using Include="Orbyss.ProgramKit.Artifacts.Primitives" />
    <Using Include="Orbyss.ProgramKit.Artifacts.References" />
    <Using Include="Orbyss.ProgramKit.Artifacts.Schemas" />
    <Using Include="Orbyss.ProgramKit.Artifacts.Validation" />
    <Using Include="Orbyss.ProgramKit.Artifacts.Versioning" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\schemas\artifacts\**\*.json"
                      LogicalName="Orbyss.ProgramKit.Artifacts.Schemas.%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\schemas\versioning\**\*.json"
                      LogicalName="Orbyss.ProgramKit.Artifacts.Schemas.%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\schemas\artifacts\**\*.json"
          Pack="true"
          PackagePath="schemas/artifacts/%(RecursiveDir)"
          Link="Schemas/Artifacts/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\schemas\versioning\**\*.json"
          Pack="true"
          PackagePath="schemas/versioning/%(RecursiveDir)"
          Link="Schemas/Versioning/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
