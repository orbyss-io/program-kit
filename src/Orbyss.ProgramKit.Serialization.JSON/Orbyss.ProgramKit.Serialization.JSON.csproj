<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Orbyss.ProgramKit.Serialization.JSON</PackageId>
    <RootNamespace>Orbyss.ProgramKit.Serialization.Json</RootNamespace>
    <Description>Typed, profile-bound System.Text.Json serialization and strict canonical JSON mechanics for Orbyss Program Kit.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Orbyss.ProgramKit.Artifacts\Orbyss.ProgramKit.Artifacts.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\schemas\serialization\**\*.schema.json"
                      LogicalName="Orbyss.ProgramKit.Serialization.JSON.Schemas.%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\schemas\serialization\**\*.json"
          Pack="true"
          PackagePath="schemas/serialization/"
          Link="Schemas/Serialization/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
