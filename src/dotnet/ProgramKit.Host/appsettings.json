{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ProgramKit": {
    "Boot": {
      "EagerShellActivation": true,
      "FailOnShellActivationError": true
    },
    "Web": {
      "Profile": "None"
    }
  },
  "Nuplane": {
    "Setup": {
      "AutomaticReconciliation": false,
      "Feeds": [
        {
          "Name": "application-bundle",
          "DirectoryPath": "packages",
          "IncludePatterns": [ "*" ],
          "Directory": {
            "Watch": false
          }
        }
      ]
    },
    "Loading": {
      "Enabled": true,
      "SharedAssemblies": [
        { "Name": "CShells.Abstractions", "PublicKeyToken": null, "MajorVersion": 0 },
        { "Name": "CShells.AspNetCore.Abstractions", "PublicKeyToken": null, "MajorVersion": 0 },
        { "Name": "ProgramKit.Tasks.Abstractions", "PublicKeyToken": null, "MajorVersion": 0 }
      ]
    }
  }
}
