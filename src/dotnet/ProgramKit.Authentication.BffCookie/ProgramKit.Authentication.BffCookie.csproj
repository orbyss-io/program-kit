<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Confidential OIDC BFF-cookie authentication as a CShells web and middleware feature.</Description>
    <PackageId>ProgramKit.Authentication.BffCookie</PackageId>
    <PackageTags>program-kit;cshells;authentication;oidc;bff</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="CShells.AspNetCore.Abstractions" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ProgramKit.Authentication/ProgramKit.Authentication.csproj" />
    <ProjectReference Include="../ProgramKit.WebDefaults/ProgramKit.WebDefaults.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
