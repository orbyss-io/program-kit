<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Optional shell-owned OpenAPI document endpoint for Program Kit applications.</Description>
    <PackageId>ProgramKit.Web.OpenApi</PackageId>
    <PackageTags>program-kit;cshells;aspnetcore;openapi</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="CShells.AspNetCore.Abstractions" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
