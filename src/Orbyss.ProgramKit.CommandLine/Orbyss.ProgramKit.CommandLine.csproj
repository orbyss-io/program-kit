<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>program-kit</ToolCommandName>
    <PackageId>Orbyss.ProgramKit.CommandLine</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Deterministic scriptable command transport for Orbyss Program Kit operations.</Description>
    <StartupObject>Orbyss.ProgramKit.CommandLine.Hosting.ProgramKitTool</StartupObject>
    <BaseOutputPath
      Condition="'$(ProgramKitCommandLineSelfPack)' == 'true'">bin\ProgramKitSelfPack\</BaseOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Orbyss.ProgramKit.OpenConsole\Orbyss.ProgramKit.OpenConsole.csproj" />
    <ProjectReference Include="..\Orbyss.ProgramKit.Workbench\Orbyss.ProgramKit.Workbench.csproj" />
    <ProjectReference Include="..\Orbyss.ProgramKit.CSharpBuildGates.Testing\Orbyss.ProgramKit.CSharpBuildGates.Testing.csproj" />
    <ProjectReference Include="..\Orbyss.ProgramKit.DotNet\Orbyss.ProgramKit.DotNet.csproj" />
    <ProjectReference Include="..\Orbyss.ProgramKit.Operations\Orbyss.ProgramKit.Operations.csproj" />
    <ProjectReference Include="..\Orbyss.ProgramKit.SecretResolution\Orbyss.ProgramKit.SecretResolution.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <EmbeddedResource Include="Evidence\**\*.json"
                      LogicalName="Orbyss.ProgramKit.CommandLine.Evidence.%(Filename)%(Extension)" />
    <None Include="Evidence\**\*.json"
          Pack="true"
          PackagePath="contentFiles/any/any/Evidence/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\.config\dotnet-tools.json"
          Link=".config\dotnet-tools.json"
          Pack="true"
          PackagePath="contentFiles/any/any/.config/dotnet-tools.json"
          CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Operations\Serialization\Profiles\json-local-operations-1.0.0.json" />
    <EmbeddedResource Include="Operations\Serialization\Profiles\json-csharp-build-gates-1.0.0.json" />
  </ItemGroup>
</Project>
