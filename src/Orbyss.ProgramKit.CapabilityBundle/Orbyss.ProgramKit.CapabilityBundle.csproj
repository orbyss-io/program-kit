<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Orbyss.ProgramKit.CapabilityBundle</PackageId>
    <Description>Exact-byte content bundle for the four distributable Orbyss Program Kit development capabilities.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="..\..\.agent-capabilities\capability-bundle-manifest.json"
          Link="Payload\.agent-capabilities\capability-bundle-manifest.json"
          Pack="true"
          PackagePath="contentFiles/any/any/.agent-capabilities/" />
    <None Include="..\..\.agent-capabilities\capabilities\develop-software\CAPABILITY.md"
          Link="Payload\.agent-capabilities\capabilities\develop-software\CAPABILITY.md"
          Pack="true"
          PackagePath="contentFiles/any/any/.agent-capabilities/capabilities/develop-software/" />
    <None Include="..\..\.agent-capabilities\capabilities\design-csharp-build-gate\CAPABILITY.md"
          Link="Payload\.agent-capabilities\capabilities\design-csharp-build-gate\CAPABILITY.md"
          Pack="true"
          PackagePath="contentFiles/any/any/.agent-capabilities/capabilities/design-csharp-build-gate/" />
    <None Include="..\..\.agent-capabilities\capabilities\design-software\CAPABILITY.md"
          Link="Payload\.agent-capabilities\capabilities\design-software\CAPABILITY.md"
          Pack="true"
          PackagePath="contentFiles/any/any/.agent-capabilities/capabilities/design-software/" />
    <None Include="..\..\.agent-capabilities\capabilities\implement-software-plan\CAPABILITY.md"
          Link="Payload\.agent-capabilities\capabilities\implement-software-plan\CAPABILITY.md"
          Pack="true"
          PackagePath="contentFiles/any/any/.agent-capabilities/capabilities/implement-software-plan/" />
    <None Include="..\..\.agent-capabilities\provider-adapters\codex\develop-software\SKILL.md"
          Link="Payload\.agent-capabilities\provider-adapters\codex\develop-software\SKILL.md"
          Pack="true"
          PackagePath="contentFiles/any/any/.agent-capabilities/provider-adapters/codex/develop-software/" />
    <None Include="..\..\.agent-capabilities\provider-adapters\codex\design-csharp-build-gate\SKILL.md"
          Link="Payload\.agent-capabilities\provider-adapters\codex\design-csharp-build-gate\SKILL.md"
          Pack="true"
          PackagePath="contentFiles/any/any/.agent-capabilities/provider-adapters/codex/design-csharp-build-gate/" />
    <None Include="..\..\.agent-capabilities\provider-adapters\codex\design-software\SKILL.md"
          Link="Payload\.agent-capabilities\provider-adapters\codex\design-software\SKILL.md"
          Pack="true"
          PackagePath="contentFiles/any/any/.agent-capabilities/provider-adapters/codex/design-software/" />
    <None Include="..\..\.agent-capabilities\provider-adapters\codex\implement-software-plan\SKILL.md"
          Link="Payload\.agent-capabilities\provider-adapters\codex\implement-software-plan\SKILL.md"
          Pack="true"
          PackagePath="contentFiles/any/any/.agent-capabilities/provider-adapters/codex/implement-software-plan/" />
    <None Include="..\..\.agent-capabilities\provider-adapters\claude\develop-software\SKILL.md"
          Link="Payload\.agent-capabilities\provider-adapters\claude\develop-software\SKILL.md"
          Pack="true"
          PackagePath="contentFiles/any/any/.agent-capabilities/provider-adapters/claude/develop-software/" />
    <None Include="..\..\.agent-capabilities\provider-adapters\claude\design-csharp-build-gate\SKILL.md"
          Link="Payload\.agent-capabilities\provider-adapters\claude\design-csharp-build-gate\SKILL.md"
          Pack="true"
          PackagePath="contentFiles/any/any/.agent-capabilities/provider-adapters/claude/design-csharp-build-gate/" />
    <None Include="..\..\.agent-capabilities\provider-adapters\claude\design-software\SKILL.md"
