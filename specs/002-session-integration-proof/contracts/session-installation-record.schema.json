{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.program-kit.dev/v1/session-installation-record.schema.json",
  "title": "Program Kit Session Installation Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "canonicalProfile",
    "installationIdentity",
    "requestIdentity",
    "requestCoreIdentity",
    "workspaceIdentity",
    "scope",
    "definition",
    "provider",
    "adapter",
    "cliRelease",
    "projectionSet",
    "publication",
    "state",
    "sessionAvailability",
    "admissionReceipt"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "program-kit.session-installation-record/v1"
    },
    "canonicalProfile": {
      "$ref": "https://schemas.program-kit.dev/v1/common.schema.json#/$defs/canonicalProfile"
    },
    "installationIdentity": {
      "$ref": "https://schemas.program-kit.dev/v1/common.schema.json#/$defs/governedIdentity"
    },
    "requestIdentity": {
      "$ref": "https://schemas.program-kit.dev/v1/common.schema.json#/$defs/digest"
    },
    "requestCoreIdentity": {
      "$ref": "https://schemas.program-kit.dev/v1/common.schema.json#/$defs/digest"
    },
    "workspaceIdentity": {
      "$ref": "https://schemas.program-kit.dev/v1/common.schema.json#/$defs/governedIdentity"
    },
    "scope": {
      "type": "string",
      "const": "workspace"
    },
    "definition": {
      "$ref": "https://schemas.program-kit.dev/v1/common.schema.json#/$defs/governedIdentity"
    },
    "provider": {
      "$ref": "https://schemas.program-kit.dev/v1/common.schema.json#/$defs/governedIdentity"
    },
    "adapter": {
      "$ref": "https://schemas.program-kit.dev/v1/common.schema.json#/$defs/governedIdentity"
    },
    "cliRelease": {
      "$ref": "#/$defs/cliObservation"
    },
    "projectionSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setDigest",
        "artifacts"
      ],
      "properties": {
        "setDigest": {
          "$ref": "https://schemas.program-kit.dev/v1/common.schema.json#/$defs/digest"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/installedArtifact"
          }
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "journal",
        "expectedLiveState",
        "observedLiveState",
        "publicationState"
      ],
      "properties": {
        "journal": {
          "$ref": "https://schemas.program-kit.dev/v1/common.schema.json#/$defs/artifactReference"
        },
        "expectedLiveState": {
          "$ref": "https://schemas.program-kit.dev/v1/common.schema.json#/$defs/digest"
        },
        "observedLiveState": {
          "$ref": "https://schemas.program-kit.dev/v1/common.schema.json#/$defs/digest"
        },
        "publicationState": {
          "type": "string",
          "const": "committed"
        }
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "admitted",
        "drifted",
        "stale",
        "incompatible",
        "partial",
        "removed"
      ]
    },
    "sessionAvailability": {
      "type": "string",
      "enum": [
        "not-evaluated",
        "reload-required",
        "available",
        "unavailable"
      ]
    },
    "admissionReceipt": {
      "$ref": "https://schemas.program-kit.dev/v1/common.schema.json#/$defs/artifactReference"
    },
    "removalReceipt": {
      "$ref": "https://schemas.program-kit.dev/v1/common.schema.json#/$defs/artifactReference"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "removed"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "removalReceipt"
        ]
      }
    }
  ],
  "$defs": {
    "cliObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageId",
        "packageVersion",
        "packageDigest",
        "executableDigest",
        "reportedVersion",
        "claimClass"
      ],
      "properties": {
        "packageId": {
          "type": "string",
          "const": "Orbyss.ProgramKit.Cli"
        },
        "packageVersion": {
          "$ref": "https://schemas.program-kit.dev/v1/common.schema.json#/$defs/revision"
        },
        "packageDigest": {
          "$ref": "https://schemas.program-kit.dev/v1/common.schema.json#/$defs/digest"
        },
        "executableDigest": {
          "$ref": "https://schemas.program-kit.dev/v1/common.schema.json#/$defs/digest"
        },
        "reportedVersion": {
          "$ref": "https://schemas.program-kit.dev/v1/common.schema.json#/$defs/revision"
        },
        "claimClass": {
          "type": "string",
          "const": "verified-equivalent"
        }
      }
    },
    "installedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "logicalPath",
        "mediaType",
        "digest",
        "ownership",
        "producer",
        "definitionBinding",
        "claimClass"
      ],
      "properties": {
        "identity": {
          "$ref": "https://schemas.program-kit.dev/v1/common.schema.json#/$defs/governedIdentity"
        },
        "logicalPath": {
          "$ref": "https://schemas.program-kit.dev/v1/common.schema.json#/$defs/logicalPath"
        },
        "mediaType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 150
        },
        "digest": {
          "$ref": "https://schemas.program-kit.dev/v1/common.schema.json#/$defs/digest"
        },
        "ownership": {
          "type": "string",
          "const": "generated-owned"
        },
        "producer": {
          "$ref": "https://schemas.program-kit.dev/v1/common.schema.json#/$defs/governedIdentity"
        },
        "definitionBinding": {
          "$ref": "https://schemas.program-kit.dev/v1/common.schema.json#/$defs/governedIdentity"
        },
        "claimClass": {
          "type": "string",
          "const": "canonical-byte"
        }
      }
    }
  }
}
