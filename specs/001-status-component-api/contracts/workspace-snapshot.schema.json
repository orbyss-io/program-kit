{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.program-kit.dev/v1/workspace-snapshot.schema.json",
  "title": "Program Kit Workspace Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "canonicalProfile",
    "rootBundle",
    "closureDigest",
    "evidenceDigest",
    "freshness",
    "identities",
    "semanticCoverage",
    "bindings",
    "selections",
    "relationships",
    "seams",
    "artifacts",
    "provenance",
    "gates",
    "reviews",
    "waivers",
    "evidence",
    "receipts",
    "support",
    "retention",
    "diagnosticState",
    "trace"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "program-kit.workspace-snapshot/v1"
    },
    "canonicalProfile": {
      "$ref": "common.schema.json#/$defs/canonicalProfile"
    },
    "rootBundle": {
      "$ref": "common.schema.json#/$defs/artifactReference"
    },
    "closureDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "evidenceDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "constructionIdentity": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "freshness": {
      "type": "string",
      "enum": [
        "current",
        "stale",
        "drifted",
        "unsupported",
        "unavailable",
        "incomplete"
      ]
    },
    "identities": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/governedIdentity"
      }
    },
    "semanticCoverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverage"
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "selections": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/exactSelection"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationshipView"
      }
    },
    "seams": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/seamView"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactView"
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/artifactReference"
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/gateResult"
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review"
      }
    },
    "waivers": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/waiverReference"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/evidenceReference"
      }
    },
    "receipts": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/artifactReference"
      }
    },
    "support": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/supportState"
      }
    },
    "retention": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/retentionState"
      }
    },
    "diagnosticState": {
      "$ref": "#/$defs/diagnosticState"
    },
    "trace": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/traceReference"
      }
    }
  },
  "$defs": {
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "state",
        "trace"
      ],
      "properties": {
        "subject": {
          "$ref": "common.schema.json#/$defs/typedSubject"
        },
        "state": {
          "type": "string",
          "enum": [
            "declared",
            "custom-bounded",
            "unsupported",
            "unknown"
          ]
        },
        "trace": {
          "$ref": "common.schema.json#/$defs/traceReference"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "subject",
        "contract",
        "implementation",
        "profile"
      ],
      "properties": {
        "role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "subject": {
          "$ref": "common.schema.json#/$defs/governedIdentity"
        },
        "contract": {
          "$ref": "common.schema.json#/$defs/governedIdentity"
        },
        "implementation": {
          "$ref": "common.schema.json#/$defs/governedIdentity"
        },
        "profile": {
          "$ref": "common.schema.json#/$defs/governedIdentity"
        }
      }
    },
    "relationshipView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion",
        "from",
        "to",
        "contract",
        "status",
        "trace"
      ],
      "properties": {
        "assertion": {
          "$ref": "common.schema.json#/$defs/governedIdentity"
        },
        "from": {
          "$ref": "common.schema.json#/$defs/governedIdentity"
        },
        "to": {
          "$ref": "common.schema.json#/$defs/governedIdentity"
        },
        "contract": {
          "$ref": "common.schema.json#/$defs/governedIdentity"
        },
        "status": {
          "type": "string",
          "enum": [
            "direct",
            "adapted",
            "incompatible"
          ]
        },
        "trace": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/traceReference"
          }
        }
      }
    },
    "seamView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seam",
        "owner",
        "contributions",
        "status"
      ],
      "properties": {
        "seam": {
          "$ref": "common.schema.json#/$defs/governedIdentity"
        },
        "owner": {
          "$ref": "common.schema.json#/$defs/governedIdentity"
        },
        "contributions": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/governedIdentity"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "resolved",
            "blocked"
          ]
        }
      }
    },
    "artifactView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "producer",
        "claimClass",
        "state",
        "trace"
      ],
      "properties": {
        "artifact": {
          "$ref": "common.schema.json#/$defs/artifactReference"
        },
        "producer": {
          "$ref": "common.schema.json#/$defs/governedIdentity"
        },
        "claimClass": {
          "type": "string",
          "enum": [
            "canonical-byte",
            "verified-equivalent",
            "custom-bounded"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "exact",
            "missing",
            "modified",
            "stale",
            "colliding",
            "interrupted",
            "unavailable"
          ]
        },
        "trace": {
          "$ref": "common.schema.json#/$defs/traceReference"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "scope",
        "decision",
        "authority",
        "evidence"
      ],
      "properties": {
        "identity": {
          "$ref": "common.schema.json#/$defs/governedIdentity"
        },
        "scope": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/typedSubject"
          }
        },
        "decision": {
          "type": "string",
          "enum": [
            "accepted",
            "rejected",
            "needs-revision"
          ]
        },
        "authority": {
          "$ref": "common.schema.json#/$defs/governedIdentity"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/evidenceReference"
          }
        }
      }
    },
    "supportState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "profile",
        "state"
      ],
      "properties": {
        "subject": {
          "$ref": "common.schema.json#/$defs/governedIdentity"
        },
        "profile": {
          "$ref": "common.schema.json#/$defs/governedIdentity"
        },
        "state": {
          "type": "string",
          "enum": [
            "supported",
            "stale",
            "expired",
            "unavailable"
          ]
        }
      }
    },
    "retentionState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "policy",
        "availability"
      ],
      "properties": {
        "subject": {
          "$ref": "common.schema.json#/$defs/governedIdentity"
        },
        "policy": {
          "$ref": "common.schema.json#/$defs/governedIdentity"
        },
        "availability": {
          "type": "string",
          "enum": [
            "available",
            "unavailable",
            "expired"
          ]
        }
      }
    },
    "diagnosticState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "effect",
        "disposition",
        "collectionDigest",
        "unresolvedCount",
        "redactedCount"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "succeeded",
            "needs-input",
            "blocked",
            "cancelled",
            "faulted"
          ]
        },
        "effect": {
          "type": "string",
          "enum": [
            "none",
            "candidate-only",
            "committed",
            "indeterminate"
          ]
        },
        "disposition": {
          "type": "string",
          "enum": [
            "complete",
            "retry",
            "provide-input",
            "request-approval",
            "repair",
            "revise",
            "stop"
          ]
        },
        "collectionDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "unresolvedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "redactedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
